    {
      "type": "header",
      "content": "Spacing Bottom Section (Mobile)"
    },
    {
      "type": "range", "id": "spb_xs", "label": "Padding Bottom", "min": 0, "max": 20, "step": 1, "default": 0
    },
    {
      "type": "range", "id": "smb_xs", "label": "Margin Bottom",  "min": 0, "max": 20, "step": 1, "default": 0
