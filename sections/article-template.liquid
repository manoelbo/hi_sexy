<article class="article py-10" itemscope itemtype="http://schema.org/BlogPosting">
  <div class="container">
    <!-- Link superior para voltar ao blog -->
    <div class="mb-6">
      <a href="{{ blog.url }}" class="back-to-blog">←&nbsp;Voltar para {{ blog.title }}</a>
    </div>

    <div class="row justify-content-center">
      <div class="{% if section.settings.show_sidebar and section.settings.sidebar_position == 'side' %}col-lg-9{% else %}col-lg-7{% endif %} mx-auto">
        <h1 class="display-4 mb-4" itemprop="headline">
          {{ article.title }}
        </h1>

        <div class="article-meta mb-6">
          <p class="text-muted">
            {% assign author_1 = article.metafields.custom.autor.value %}
            {% assign author_2 = article.metafields.custom.autor_2.value %}

            {% if author_1 != blank or author_2 != blank %}
              <span itemprop="author" itemscope itemtype="http://schema.org/Person">
                {% if author_1 != blank %}
                  <span itemprop="name">{{ author_1.nome.value }}</span>
                {% endif %}

                {% if author_1 != blank and author_2 != blank %}
                  e
                {% endif %}

                {% if author_2 != blank %}
                  <span itemprop="name">{{ author_2.nome.value }}</span>
                {% endif %}
              </span>
            {% endif %}
            •
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
              {{ article.published_at | date: '%-d' }} de
              {% case article.published_at | date: "%-m" %}
                {% when '1' -%}
                  janeiro
                {% when '2' -%}
                  fevereiro
                {% when '3' -%}
                  março
                {% when '4' -%}
                  abril
                {% when '5' -%}
                  maio
                {% when '6' -%}
                  junho
                {% when '7' -%}
                  julho
                {% when '8' -%}
                  agosto
                {% when '9' -%}
                  setembro
                {% when '10' -%}
                  outubro
                {% when '11' -%}
                  novembro
                {% when '12' -%}
                  dezembro
              {% endcase %}
              de {{ article.published_at | date: '%Y' }}
            </time>
            •
            <span class="estimated-read-time">
              {% assign words = article.content | strip_html | split: ' ' | size %}
              {% assign minutes = words | divided_by: 100.0 | ceil %}
              {{ minutes }} min de leitura
            </span>
            {% if article.tags.size > 0 %}
              •
              {% for tag in article.tags %}
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="text-decoration-none" itemprop="keywords">
                  {{- tag -}}
                </a>
                {%- unless forloop.last %}, {% endunless %}
              {% endfor %}
            {% endif %}
          </p>
        </div>

        {% if article.image %}
          <div class="article-header article-content mb-8">
            <img
              class="img-fluid w-100 hyper-card mt-0 pt-0"
              src="{{ article.image | image_url: width: 1200 }}"
              alt="{{ article.metafields.custom.t_tulo_card_e_seo | default: article.title | escape }}"
              width="1200"
              height="{{ article.image.height }}"
              loading="lazy"
              itemprop="image"
            >
          </div>
        {% endif %}

        <div class="article-content rte" itemprop="articleBody">
          {{ article.content }}
        </div>

        <div class="share-buttons mt-6 mb-6">
          <div class="d-flex align-items-center gap-3">
            <span class="text-muted">Compartilhar:</span>

            <!-- Copiar URL -->
            <!-- Copiar URL -->
            <button
              class="btn btn-outline-secondary btn-sm"
              onclick="navigator.clipboard.writeText(window.location.href); this.innerHTML='URL Copiada!'; setTimeout(() => this.innerHTML='Copiar URL', 2000)"
            >
              Copiar URL
            </button>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/shareArticle?mini=true&url={{ shop.url }}{{ article.url }}&title={{ article.title | url_encode }}"
              target="_blank"
              class="btn btn-outline-primary btn-sm"
              rel="noopener"
            >
              <i class="bi bi-linkedin"></i> LinkedIn
            </a>

            <!-- Twitter/X -->
            <a
              href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url }}"
              target="_blank"
              class="btn btn-outline-dark btn-sm"
              rel="noopener"
            >
              <i class="bi bi-twitter-x"></i> X
            </a>
          </div>
        </div>

        <!-- Link inferior para voltar ao blog -->
        <div class="mt-8 mb-6">
          <a href="{{ blog.url }}" class="back-to-blog">←&nbsp;Voltar para {{ blog.title }}</a>
        </div>

        <!-- Seção dos autores no final -->
        {% assign author_1 = article.metafields.custom.autor.value %}
        {% assign author_2 = article.metafields.custom.autor_2.value %}

        {% if author_1 != blank or author_2 != blank %}
          <div class="author-section mt-8 mb-6 rte pb-6">
            <!-- Primeiro autor -->
            {% if author_1 != blank %}
              <div class="row align-items-center {% if author_2 != blank %}mb-4{% endif %}">
                <div class="col-auto">
                  {% if author_1.foto.value != blank %}
                    <img
                      src="{{ author_1.foto.value | image_url }}"
                      alt="{{ author_1.nome.value }}"
                      class="author-avatar rounded-circle"
                      width="120"
                      height="120"
                      style="object-fit: cover;"
                    >
                  {% endif %}
                </div>
                <div class="col">
                  <div class="author-info">
                    <div class="author-name fs-4 fw-medium mb-2">{{ author_1.nome.value }}</div>
                    {% if author_1.bio.value != blank %}
                      <p class="author-bio text-muted mb-0">{{ author_1.bio.value }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}

            <!-- Segundo autor -->
            {% if author_2 != blank %}
              <div class="row align-items-center">
                <div class="col-auto">
                  {% if author_2.foto.value != blank %}
                    <img
                      src="{{ author_2.foto.value | image_url }}"
                      alt="{{ author_2.nome.value }}"
                      class="author-avatar rounded-circle"
                      width="120"
                      height="120"
                      style="object-fit: cover;"
                    >
                  {% endif %}
                </div>
                <div class="col">
                  <div class="author-info">
                    <div class="author-name fs-4 fw-medium mb-2">{{ author_2.nome.value }}</div>
                    {% if author_2.bio.value != blank %}
                      <p class="author-bio text-muted mb-0">{{ author_2.bio.value }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if article.metafields.custom.palavras_chave_secund_rias %}
          <div class="article-tags mt-4 author-section">
            <strong>palavras-chave:</strong>
            {{ article.metafields.custom.palavras_chave_secund_rias }}
          </div>
        {% endif %}

        {% if blog.comments_enabled? %}
          <div class="article-comments mt-10">
            <h2 class="h4 mb-6">{{ 'blogs.comments.title' | t }}</h2>

            {% paginate article.comments by 5 %}
              {% for comment in article.comments %}
                <div class="comment mb-6 p-4 bg-light rounded">
                  <div class="comment-content">
                    {{ comment.content }}
                  </div>
                  <p class="comment-meta mt-3 mb-0 small text-muted">
                    {{ comment.author }} • {{ comment.created_at | date: '%d/%m/%Y' }}
                  </p>
                </div>
              {% endfor %}

              {% render 'pagination', paginate: paginate %}
            {% endpaginate %}

            <div class="comment-form mt-8">
              <h3 class="h5 mb-4">{{ 'blogs.comments.form_title' | t }}</h3>
              {% form 'new_comment', article %}
                {% if form.errors %}
                  <div class="alert alert-danger">
                    {{ form.errors | default_errors }}
                  </div>
                {% endif %}

                <div class="row g-3">
                  <div class="col-md-6">
                    <input
                      type="text"
                      class="form-control"
                      name="comment[author]"
                      placeholder="{{ 'blogs.comments.name' | t }}"
                      value="{{ form.author }}"
                      required
                    >
                  </div>
                  <div class="col-md-6">
                    <input
                      type="email"
                      class="form-control"
                      name="comment[email]"
                      placeholder="{{ 'blogs.comments.email' | t }}"
                      value="{{ form.email }}"
                      required
                    >
                  </div>
                  <div class="col-12">
                    <textarea
                      class="form-control"
                      name="comment[body]"
                      rows="4"
                      placeholder="{{ 'blogs.comments.message' | t }}"
                      required
                    ></textarea>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-primary">{{ 'blogs.comments.post' | t }}</button>
                  </div>
                </div>
              {% endform %}
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Sidebar (se a posição for 'side') -->
      {% if section.settings.show_sidebar and section.settings.sidebar_position == 'side' %}
        <div class="col-lg-3">
          <div class="sidebar-courses">
            <p class="fs-4 fw-bold mb-4 mt-4 mt-lg-0 text-uppercase pb-8">
              {{ section.settings.sidebar_title | default: 'Cursos Relacionados' }}
            </p>
            {% for product in section.settings.featured_courses %}
              <div
                class="category-card mb-4"
                data-aos="fade-down"
                data-aos-delay="{{ 100 | times: forloop.index | plus: 10 }}"
              >
                <a href="{{ product.url }}" class="click-card text-center pb-4">
                  <div class="content-container hyper-card">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image | image_url: width: 600 | image_tag }}
                    {% endif %}

                    <div class="hyper-card-content">
                      {% if product.title != blank %}
                        <h1 class="display-8 {% if product.description == blank %}p-0 m-0{% endif %}">
                          {{ product.title }}
                        </h1>
                      {% endif %}

                      {% if product.metafields.custom.excerpt != blank %}
                        <p class="mt-6 pb-0 fs-7 mb-0">
                          {{ product.metafields.custom.excerpt }}
                        </p>
                      {% else %}
                        <p class="mt-6 pb-0 fs-7 mb-0">
                          {{ product.description }}
                        </p>
                      {% endif %}
                    </div>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Cursos relacionados horizontais (se a posição for 'bottom') -->
    {% if section.settings.show_sidebar and section.settings.sidebar_position == 'bottom' %}
      <div class="related-courses-horizontal mt-8">
        <p class="fs-4 fw-bold mb-4 text-uppercase">
          {{ section.settings.sidebar_title | default: 'Cursos Relacionados' }}
        </p>
        <div class="row">
          {% for product in section.settings.featured_courses %}
            <div class="col-md-4 mb-4">
              <div class="category-card">
                <a href="{{ product.url }}" class="click-card text-center pb-4">
                  <div class="content-container hyper-card">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image | image_url: width: 600 | image_tag }}
                    {% endif %}
                    <div class="hyper-card-content">
                      {% if product.title != blank %}
                        <h1 class="display-8">{{ product.title }}</h1>
                      {% endif %}
                     {% if product.metafields.custom.excerpt != blank %}
  <p class="mt-6 pb-0 fs-7 mb-0">{{ product.metafields.custom.excerpt | metafield_tag | strip_html }}</p>
{% else %}
  <p class="mt-6 pb-0 fs-7 mb-0">{{ product.description | strip_html }}</p>
{% endif %}
                    </div>
                  </div>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</article>

{% if template contains 'article' %}
  {% assign seo_title = article.metafields.custom.t_tulo_card_e_seo | default: article.title %}
  {% assign seo_description = article.metafields.custom.descri_o_card_e_seo | default: article.excerpt %}
  {% assign seo_image = article.metafields.custom.imagem_para_redes_sociais | default: article.image %}

  {% comment %}SEO Meta Tags{% endcomment %}
  <div style="display: none;">
    <title>{{ seo_title }}</title>
    <meta name="description" content="{{ seo_description }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ seo_title }}">
    <meta property="og:description" content="{{ seo_description }}">
    {% if seo_image %}
      <meta property="og:image" content="{{ seo_image | image_url }}">
    {% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo_title }}">
    <meta name="twitter:description" content="{{ seo_description }}">
    {% if seo_image %}
      <meta name="twitter:image" content="{{ seo_image | image_url }}">
    {% endif %}

    {% if article.metafields.custom.palavra_chave_principal %}
      <meta
        name="keywords"
        content="{{ article.metafields.custom.palavra_chave_principal }}, {{ article.metafields.custom.palavras_chave_secund_rias }}"
      >
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Article Template",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Mostrar Cursos Relacionados",
      "default": true
    },
    {
      "type": "select",
      "id": "sidebar_position",
      "label": "Posição dos Cursos Relacionados",
      "options": [
        {
          "value": "side",
          "label": "Lateral (Sidebar)"
        },
        {
          "value": "bottom",
          "label": "Abaixo do Artigo"
        }
      ],
      "default": "side"
    },
    {
      "type": "text",
      "id": "sidebar_title",
      "label": "Título da Seção de Cursos",
      "default": "Cursos Relacionados"
    },
    {
      "type": "product_list",
      "id": "featured_courses",
      "label": "Cursos Relacionados",
      "limit": 3
    }
  ]
}
{% endschema %}
