<script>
  document.addEventListener('DOMContentLoaded', function () {
    const loadMoreButtons = document.querySelectorAll('.load-more-button');

    loadMoreButtons.forEach((button) => {
      button.addEventListener('click', async function () {
        const nextUrl = this.dataset.nextUrl;
        const blogHandle = this.dataset.blogHandle;
        const container = document.getElementById('blog-posts-container');
        // Pega o layout atual do primeiro artigo para manter consistência
        const firstArticle = container.querySelector('[class*="col-"]');
        const layoutClasses = firstArticle ? firstArticle.className : '';

        try {
          const response = await fetch(nextUrl);
          const data = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(data, 'text/html');

          // Encontra os novos artigos
          const newArticles = doc.querySelectorAll('#blog-posts-container > div:not(.text-center)');

          // Adiciona os novos artigos ao container
          newArticles.forEach((article) => {
            // Aplica as mesmas classes de layout do primeiro artigo
            article.className = layoutClasses;

            // Adiciona a classe h-100 ao container interno
            const innerContainer = article.querySelector('div');
            if (innerContainer) {
              innerContainer.classList.add('h-100');
            }

            container.insertBefore(article, button.parentElement);

            // Inicializa animação AOS para o novo card
            if (typeof AOS !== 'undefined') {
              AOS.refresh();
              article.offsetHeight;
            }
          });

          // Atualiza ou remove o botão de load more
          const nextPageButton = doc.querySelector('.load-more-button');
          if (nextPageButton) {
            button.dataset.nextUrl = nextPageButton.dataset.nextUrl;
          } else {
            button.parentElement.remove();
          }
        } catch (error) {
          console.error('Erro ao carregar mais posts:', error);
        }
      });
    });
  });
</script>
