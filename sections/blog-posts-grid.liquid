<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('blog-posts-container');
    if (!container) return;

    // Delegação de evento para o botão (funciona mesmo após inserir novos nós)
    container.addEventListener('click', async function (e) {
      const button = e.target.closest('.load-more-button');
      if (!button) return;

      const wrapper = button.closest('.load-more-wrapper') || button.parentElement;
      const nextUrlRaw = button.dataset.nextUrl; // normalmente "?page=2"
      const sectionId = button.dataset.sectionId;

      if (!nextUrlRaw || !sectionId) return;

      // Constrói URL absoluta e acrescenta section_id (Section Rendering API)
      const nextUrl = new URL(nextUrlRaw, window.location.href);
      nextUrl.searchParams.set('section_id', sectionId);

      button.disabled = true;
      const originalLabel = button.textContent;
      button.textContent = 'Carregando...';

      try {
        const res = await fetch(nextUrl.toString(), { credentials: 'same-origin' });
        const html = await res.text();

        // Usa um wrapper temporário para parsear o HTML retornado da seção
        const temp = document.createElement('div');
        temp.innerHTML = html;

        // Encontra somente os itens de post dentro do container da seção carregada
        const incomingContainer = temp.querySelector('#blog-posts-container');
        if (!incomingContainer) throw new Error('Container da seção não encontrado na resposta.');

        const incomingItems = Array.from(incomingContainer.children)
          .filter(el => !el.classList.contains('load-more-wrapper') && !el.querySelector('.load-more-button'));

        // Insere os novos cards antes do wrapper/botão atual
        incomingItems.forEach(el => {
          container.insertBefore(el, wrapper);
          if (typeof AOS !== 'undefined') {
            AOS.refresh();
            el.offsetHeight; // força reflow para AOS
          }
        });

        // Atualiza ou remove o botão conforme a existência de próxima página
        const nextBtnInResponse = temp.querySelector('.load-more-button');
        if (nextBtnInResponse && nextBtnInResponse.dataset.nextUrl) {
          button.dataset.nextUrl = nextBtnInResponse.dataset.nextUrl;
          button.disabled = false;
          button.textContent = originalLabel || 'Carregar mais posts';
        } else {
          wrapper.remove();
        }
      } catch (error) {
        console.error('Erro ao carregar mais posts:', error);
        button.disabled = false;
        button.textContent = 'Tentar novamente';
      }
    });
  });
</script>
