<section
  class="px-lg-12 px-md-4 px-4 pb-lg-{{section.settings.spb_lg}} mb-lg-{{section.settings.smb_lg}} pb-{{section.settings.spb_xs}} mb-{{section.settings.smb_xs}}"
  {% if section.settings.bg_gradient != blank %}
    style="background: {{ section.settings.bg_gradient }}"
  {% else %}
    style="background-color: {{section.settings.bg_color }}"
  {% endif %}
  data-section-id="{{ section.id }}"
>
  <div class="position-relative zi-1 text-xl-start container">
    {%- if section.settings.title != blank and section.settings.show_title -%}
      <div class="row align-items-center">
        <div class="col-12">
          <div class="mb-{{ section.settings.mb_sm }} mt-{{ section.settings.mt_sm }} pb-{{ section.settings.pb_sm }} pt-{{ section.settings.pt_sm }} mb-lg-{{ section.settings.mb_lg }} mt-lg-{{ section.settings.mt_lg }} pb-lg-{{ section.settings.pb_lg }} pt-lg-{{ section.settings.pt_lg }}">
            <div class="row {{section.settings.align_desktop}} {{section.settings.align_mobile}}">
              <div class="col-lg-12">
                <h2
                  class="blog-highlights-title {{ section.settings.title_size }} {{ section.settings.title_alignment }}"
                >
                  {{ section.settings.title }}
                </h2>

                {%- if section.settings.subtitle != blank and section.settings.show_subtitle -%}
                  <div
                    class="blog-highlights-subtitle fs-{{ section.settings.subtitle_size }} {{ section.settings.subtitle_alignment }}"
                  >
                    {{ section.settings.subtitle }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {% comment %}Determina qual blog usar baseado no contexto{% endcomment %}
    {% if template == 'blog' %}
      {% assign current_blog = blog %}
    {% else %}
      {% if section.settings.blog != blank %}
        {% assign current_blog = blogs[section.settings.blog] %}
      {% else %}
        {% assign current_blog = null %}
      {% endif %}
    {% endif %}

    <div
      class="row g-4"
      id="blog-posts-container"
    >
      {% if current_blog != null %}
        {%- paginate current_blog.articles by 6 -%}
          {%- for article in current_blog.articles -%}
            <div class="{{ section.settings.layout }} {{section.settings.content_align_desktop}} {{section.settings.content_align_mobile}}">
              <div
                class="h-100"
                data-aos="fade-down"
                data-aos-delay="{{ 100 | times: forloop.index | plus: 50 }}"
              >
                {% render 'article-card', article: article %}
              </div>
            </div>
          {%- endfor -%}

          {%- if paginate.next -%}
            <div class="col-12 text-center mt-4 mb-4 load-more-wrapper">
              <button
                class="btn rounded-black btn-border btn-border me-2 mb-3 load-more-button"
                data-blog-handle="{{ current_blog.handle }}"
                data-next-url="{{ paginate.next.url }}"
                data-section-id="{{ section.id }}"
              >
                Carregar mais posts
              </button>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      {% else %}
        <div class="col-12 text-center">
          <p>Por favor, selecione um blog nas configurações da seção.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

