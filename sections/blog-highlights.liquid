<section
  class="blog-highlights px-lg-12 px-md-4 px-4 mb-{{ section.settings.mb_sm }} mt-{{ section.settings.mt_sm }} pb-{{ section.settings.pb_sm }} pt-{{ section.settings.pt_sm }} mb-lg-{{ section.settings.mb_lg }} mt-lg-{{ section.settings.mt_lg }} pb-lg-{{ section.settings.pb_lg }} pt-lg-{{ section.settings.pt_lg }}"
  {% if section.settings.bg_gradient != blank %}
    style="background: {{ section.settings.bg_gradient }}"
  {% else %}
    style="background-color: {{section.settings.bg_color }}"
  {% endif %}
>
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-12 col-lg-3">
        <h2 class="display-4 text-uppercase mb-4 mb-lg-0">
          {{ section.settings.title }}
        </h2>
      </div>
      <div class="col-12 col-lg-9">
        <div class="row flex-nowrap overflow-auto pb-4 blog-cards">
          {% if section.settings.auto_select %}
            {% assign articles = blogs[section.settings.blog].articles | limit: 5 %}
          {% else %}
            {% assign articles = section.blocks | map: 'settings' | map: 'article' %}
          {% endif %}

          {% for article in articles %}
            <div
              class="col-9 col-sm-6 col-md-4 col-lg-3 category-card"
              data-aos="fade-down"
              data-aos-delay="{{ 100 | times: forloop.index | plus: 10 }}"
            >
              <a href="{{ article.url }}" class="text-center pb-4 pb-lg-8">
                {% if article.image %}
                  <div class="card-top pb-4 pb-lg-8">
                    <img
                      src="{{ article.image | img_url: '400x400', crop: 'center' }}"
                      alt="{{ article.title }}"
                      class="img-fluid"
                      loading="lazy"
                    >
                  </div>
                {% endif %}
                <div class="card-content">
                  <h3 class="mb-4 text-uppercase {{ section.settings.title_size }}">
                    {{ article.title }}
                  </h3>
                  <p class="mb-0 remove-br-lg {{ section.settings.text_size }} {{ section.settings.font_color }}">
                    {{ article.published_at | date: '%d/%m/%Y' }}
                  </p>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Highlights",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da Seção",
      "default": "Últimas Notícias"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "checkbox",
      "id": "auto_select",
      "label": "Seleção Automática",
      "default": true,
      "info": "Se ativado, seleciona automaticamente os 5 artigos mais recentes"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Tamanho do Título",
      "options": [
        {
          "value": "h6",
          "label": "Pequeno"
        },
        {
          "value": "h5",
          "label": "Médio"
        },
        {
          "value": "h4",
          "label": "Grande"
        }
      ],
      "default": "h6"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Tamanho do Texto",
      "options": [
        {
          "value": "fs-6",
          "label": "Pequeno"
        },
        {
          "value": "fs-5",
          "label": "Médio"
        },
        {
          "value": "fs-4",
          "label": "Grande"
        }
      ],
      "default": "fs-6"
    },
    {
      "type": "select",
      "id": "font_color",
      "label": "Cor do Texto",
      "options": [
        {
          "value": "text-dark",
          "label": "Escuro"
        },
        {
          "value": "text-light",
          "label": "Claro"
        }
      ],
      "default": "text-dark"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de Fundo"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Gradiente de Fundo"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Artigo",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Artigo"
        }
      ],
      "limit": 5
    }
  ],
  "templates": ["index", "page", "blog"],
  "presets": [
    {
      "name": "Blog Highlights",
      "settings": {}
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .blog-cards {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .blog-cards::-webkit-scrollbar {
    display: none;
  }
{% endstylesheet %}
