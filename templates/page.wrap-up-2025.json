    "html_DLtnVP": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<!-- ===== Section: Como funciona ===== -->\n<section class=\"wrapup-steps\" aria-labelledby=\"steps-title\">\n  <div class=\"wrapup-steps__container\">\n    <h2 id=\"steps-title\" class=\"wrapup-steps__title\">Como funciona</h2>\n    <p class=\"wrapup-steps__subtitle\">\n      Quatro etapas práticas que transformam reflexão em ação estratégica\n    </p>\n\n    <div class=\"steps-grid\">\n      <!-- Card 1 -->\n      <article class=\"step-card\">\n        <span class=\"step-card__badge\">1</span>\n        <div class=\"step-card__icon\">\n          <!-- Sparkles -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M12 3l1.6 3.7L17 8.2l-3.4 1.5L12 13l-1.6-3.3L7 8.2l3.4-1.5L12 3Zm6.25 4.5.95 2.2 2.2.95-2.2.95-.95 2.2-.95-2.2-2.2-.95 2.2-.95.95-2.2ZM5.75 14.5l.85 2 2 .85-2 .85-.85 2-.85-2-2-.85 2-.85.85-2Z\"></path>\n          </svg>\n        </div>\n        <h3 class=\"step-card__title\">Celebrate &amp; Learn</h3>\n        <p class=\"step-card__text\">\n          Reconheça conquistas, identifique aprendizados e\n          transforme tensões em insights acionáveis para o futuro.\n        </p>\n      </article>\n\n      <!-- Card 2 -->\n      <article class=\"step-card\">\n        <span class=\"step-card__badge\">2</span>\n        <div class=\"step-card__icon\">\n          <!-- Megaphone -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M21 8.5v7a1 1 0 0 1-1.42.91L16 15.2V6.8l3.58-1.21A1 1 0 0 1 21 6.5v2Zm-7 6.2L6 13v4.5A2.5 2.5 0 0 0 8.5 20H10a1 1 0 0 0 1-1v-1.2l3 .1v-3.2ZM14 6v12l-8-2.7V8.7L14 6Z\"></path>\n          </svg>\n        </div>\n        <h3 class=\"step-card__title\">Future Lens</h3>\n        <p class=\"step-card__text\">\n          Construa uma visão compartilhada de 2026 com cenários,\n          tendências e direcionadores estratégicos claros.\n        </p>\n      </article>\n\n      <!-- Card 3 -->\n      <article class=\"step-card\">\n        <span class=\"step-card__badge\">3</span>\n        <div class=\"step-card__icon\">\n          <!-- Target -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm0 17a7 7 0 1 1 7-7 7.008 7.008 0 0 1-7 7Zm0-11a4 4 0 1 0 4 4 4.005 4.005 0 0 0-4-4Zm0 5.5A1.5 1.5 0 1 1 13.5 12 1.5 1.5 0 0 1 12 13.5Z\"></path>\n          </svg>\n        </div>\n        <h3 class=\"step-card__title\">Priorizar &amp; Decidir</h3>\n        <p class=\"step-card__text\">\n          Use matriz impacto × esforço para priorizar iniciativas e\n          definir objetivos com resultados-chave (OKRs).\n        </p>\n      </article>\n\n      <!-- Card 4 -->\n      <article class=\"step-card\">\n        <span class=\"step-card__badge\">4</span>\n        <div class=\"step-card__icon\">\n          <!-- Calendar -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2Zm14 8H3v10h18V10Z\"></path>\n          </svg>\n        </div>\n        <h3 class=\"step-card__title\">Plano de 90 dias</h3>\n        <p class=\"step-card__text\">\n          Crie um roadmap acionável com marcos, responsáveis,\n          rituais e indicadores para começar 2026 com clareza.\n        </p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<style>\n  :root{\n    --hi-orange:#FF7700;\n    --bg:#f6f8fa;         /* fundo da seção */\n    --title:#0f172a;      /* slate-900 */\n    --muted:#475569;      /* slate-600 */\n    --card:#ffffff;\n    --badge-bg:#ffefe2;   /* pêssego claro */\n    --shadow:0 12px 30px rgba(15,23,42,.08);\n    --radius:16px;\n    --radius-sm:12px;\n  }\n\n  .wrapup-steps{\n    background: var(--bg);\n    padding: clamp(48px, 7vw, 96px) 16px;\n  }\n  .wrapup-steps__container{\n    max-width: 1160px;\n    margin: 0 auto;\n    text-align: center;\n  }\n  .wrapup-steps, .wrapup-steps *{\n    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, \"Helvetica Neue\", Arial;\n  }\n\n  .wrapup-steps__title{\n    margin: 0 0 10px;\n    font-weight: 900;\n    color: var(--title);\n    letter-spacing: -.01em;\n    line-height: 1.05;\n    font-size: clamp(1.9rem, 4.5vw, 3rem);\n  }\n  .wrapup-steps__subtitle{\n    margin: 0 auto clamp(28px, 5vw, 40px);\n    max-width: 820px;\n    color: var(--muted);\n    font-size: clamp(1rem, 2vw, 1.125rem);\n    line-height: 1.8;\n  }\n\n  .steps-grid{\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0,1fr));\n    gap: clamp(16px, 3.4vw, 28px);\n    padding: 0 clamp(4px, 1.2vw, 8px);\n  }\n\n  .step-card{\n    position: relative;\n    background: var(--card);\n    border-radius: var(--radius);\n    box-shadow: var(--shadow);\n    padding: clamp(18px, 2.6vw, 28px) clamp(18px, 2.6vw, 32px);\n    text-align: left;\n  }\n  .step-card__badge{\n    position: absolute;\n    top: 14px;\n    right: 14px;\n    background: var(--badge-bg);\n    color: var(--hi-orange);\n    font-weight: 800;\n    font-size: .95rem;\n    line-height: 1;\n    padding: 8px 10px;\n    border-radius: 999px;\n    box-shadow: 0 1px 0 rgba(0,0,0,.03) inset;\n  }\n\n  .step-card__icon{\n    width: 44px; height: 44px;\n    display: inline-flex;\n    align-items: center; justify-content: center;\n    border-radius: 12px;\n    background: var(--hi-orange);\n    margin-bottom: 18px;\n    box-shadow: 0 6px 16px rgba(255,119,0,.25);\n  }\n  .step-card__icon svg{ width: 24px; height: 24px; display:block; }\n\n  .step-card__title{\n    margin: 0 0 10px;\n    font-weight: 900;\n    color: var(--title);\n    font-size: clamp(1.1rem, 2.4vw, 1.5rem);\n    letter-spacing: -.01em;\n  }\n  .step-card__text{\n    margin: 0;\n    color: var(--muted);\n    font-size: clamp(1rem, 1.6vw, 1.05rem);\n    line-height: 1.85;\n  }\n\n  /* Responsivo */\n  @media (max-width: 980px){\n    .steps-grid{ grid-template-columns: 1fr; }\n    .step-card__badge{ top: 12px; right: 12px; }\n  }\n</style>\n<!-- ===== /Section ===== -->",
