    "html_n6Mjbx": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<!-- ===== Section: Valor que entregamos ===== -->\n<section class=\"wrapup-value\" aria-labelledby=\"value-title\">\n  <div class=\"wrapup-value__container\">\n    <!-- Coluna esquerda -->\n    <header class=\"value-left\">\n      <h2 id=\"value-title\" class=\"value-title\">Valor que<br> entregamos</h2>\n      <p class=\"value-sub\">\n        Entregáveis táticos que transformam<br>\n        visão em execução\n      </p>\n    </header>\n\n    <!-- Coluna direita -->\n    <div class=\"value-right\" role=\"list\">\n      <div class=\"value-item\" role=\"listitem\">\n        <span class=\"check\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10Zm-1.2-6.2 6.3-6.3-1.4-1.4-4.9 4.9-2.1-2.1-1.4 1.4 3.5 3.5Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span class=\"value-text\">Direcionadores estratégicos claros para 2026</span>\n      </div>\n\n      <div class=\"value-item\" role=\"listitem\">\n        <span class=\"check\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10Zm-1.2-6.2 6.3-6.3-1.4-1.4-4.9 4.9-2.1-2.1-1.4 1.4 3.5 3.5Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span class=\"value-text\">Objetivos com resultados-chave (OKRs) definidos</span>\n      </div>\n\n      <div class=\"value-item\" role=\"listitem\">\n        <span class=\"check\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10Zm-1.2-6.2 6.3-6.3-1.4-1.4-4.9 4.9-2.1-2.1-1.4 1.4 3.5 3.5Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span class=\"value-text\">Roadmap de 90 dias com marcos e responsáveis</span>\n      </div>\n\n      <div class=\"value-item\" role=\"listitem\">\n        <span class=\"check\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10Zm-1.2-6.2 6.3-6.3-1.4-1.4-4.9 4.9-2.1-2.1-1.4 1.4 3.5 3.5Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span class=\"value-text\">Aprendizados de 2025 transformados em ações</span>\n      </div>\n\n      <div class=\"value-item\" role=\"listitem\">\n        <span class=\"check\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10Zm-1.2-6.2 6.3-6.3-1.4-1.4-4.9 4.9-2.1-2.1-1.4 1.4 3.5 3.5Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span class=\"value-text\">Time alinhado com próximos passos claros e rituais estabelecidos</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  :root{\n    --hi-orange:#FF7700;\n    --title:#0f172a;      /* slate-900 */\n    --muted:#475569;      /* slate-600 */\n  }\n\n  .wrapup-value{\n    background:#fff;\n    padding: clamp(40px, 6vw, 84px) 16px 40px;\n  }\n  .wrapup-value__container{\n    max-width: 1160px;\n    margin: 0 auto;\n    display:grid;\n    grid-template-columns: .95fr 1.05fr;\n    gap: clamp(16px, 5vw, 64px);\n    align-items: start;\n  }\n  .wrapup-value, .wrapup-value *{\n    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, \"Helvetica Neue\", Arial;\n  }\n\n  /* Esquerda */\n  .value-title{\n    margin: 0 0 18px;\n    font-weight: 900;\n    color: var(--title);\n    letter-spacing: -.01em;\n    line-height: 1.03;\n    font-size: clamp(1.9rem, 4.6vw, 3.1rem);\n  }\n  .value-sub{\n    margin: 0;\n    color: var(--muted);\n    font-size: clamp(1rem, 1.8vw, 1.125rem);\n    line-height: 1.9;\n  }\n\n  /* Direita */\n  .value-right{\n    display:flex;\n    flex-direction: column;\n    gap: 18px;\n    padding-top: clamp(4px, .6vw, 8px);\n  }\n  .value-item{\n    display:grid;\n    grid-template-columns: 28px 1fr;\n    align-items: start;\n    gap: 12px;\n    color: var(--title);\n    font-size: clamp(1rem, 1.7vw, 1.0625rem);\n  }\n  .check{\n    width: 24px; height: 24px;\n    border: 2px solid var(--hi-orange);\n    color: var(--hi-orange);\n    border-radius: 999px;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    margin-top: 2px;\n  }\n  .check svg{ width: 16px; height: 16px; display:block; }\n  .value-text{ line-height: 1.9; color:#1f2937; } /* slate-800 */\n\n  /* Responsivo */\n  @media (max-width: 980px){\n    .wrapup-value__container{\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n<!-- ===== /Section ===== -->",
