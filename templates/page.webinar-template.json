      "settings": {
        "html": "<!-- ============================================================\n     HYPER ISLAND BRASIL — Webinar: Estratégia e Pensamento Crítico com IA\n     Versão LIGHT — Shopify embed (sem menu/footer)\n     ============================================================ -->\n\n<style>\n  /* ── Reset ───────────────────────────────────────────────── */\n  .hiw *,\n  .hiw *::before,\n  .hiw *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* ── Tokens ──────────────────────────────────────────────── */\n  .hiw {\n    --c-bg:        #ffffff;\n    --c-surface:   #f7f6f4;\n    --c-surface2:  #f0ede9;\n    --c-border:    #e2ddd8;\n    --c-border2:   #d0cbc4;\n    --c-text:      #1a1714;\n    --c-text-2:    #4a4540;\n    --c-text-3:    #857e78;\n    --c-orange:    #f05a28;\n    --c-orange-dk: #d44a1a;\n    --c-orange-lt: rgba(240,90,40,0.08);\n    --c-orange-bd: rgba(240,90,40,0.2);\n    --radius:      6px;\n    --max:         1200px;\n    --px:          clamp(1.25rem, 5vw, 4.5rem);\n\n    background: var(--c-bg);\n    color: var(--c-text);\n    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* ── HERO ────────────────────────────────────────────────── */\n  .hiw-hero {\n    position: relative;\n    min-height: 480px;\n    display: flex;\n    align-items: flex-end;\n    overflow: hidden;\n  }\n\n  .hiw-hero__bg {\n    position: absolute;\n    inset: 0;\n    background-image: url('https://hyperisland.com/hubfs/GLOBAL%20-%20Website%20Images/Backgrounds/energizer-1.jpg?width=860&t=1762419530782');\n    background-size: cover;\n    background-position: center 30%;\n  }\n\n  /* light overlay — darker at bottom so text is readable */\n  .hiw-hero__overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      160deg,\n      rgba(255,255,255,0.08) 0%,\n      rgba(20,15,10,0.52) 50%,\n      rgba(10,8,5,0.90) 100%\n    );\n  }\n\n  .hiw-hero__content {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    max-width: var(--max);\n    margin: 0 auto;\n    padding: clamp(3rem, 8vw, 6.5rem) var(--px) 3.5rem;\n  }\n\n  .hiw-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.45rem;\n    background: var(--c-orange);\n    color: #fff;\n    font-size: 0.68rem;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    padding: 0.3rem 0.8rem;\n    border-radius: 3px;\n    margin-bottom: 1.4rem;\n  }\n\n  .hiw-badge__dot {\n    width: 5px;\n    height: 5px;\n    background: #fff;\n    border-radius: 50%;\n    animation: hiw-blink 1.6s ease-in-out infinite;\n  }\n\n  @keyframes hiw-blink {\n    0%, 100% { opacity: 1; }\n    50%       { opacity: 0.3; }\n  }\n\n  /* H1 — inherits Shopify theme styles, zero font override */\n  .hiw-hero__title {\n    font-size: clamp(2.2rem, 5vw, 4.4rem);\n    font-weight: 700;\n    line-height: 1.06;\n    letter-spacing: -0.02em;\n    color: #ffffff;\n    max-width: 760px;\n    margin-bottom: 1.1rem;\n  }\n\n  .hiw-hero__sub {\n    font-size: clamp(1rem, 1.6vw, 1.15rem);\n    color: rgba(255,255,255,0.82);\n    font-weight: 300;\n    max-width: 560px;\n    line-height: 1.6;\n    margin-bottom: 2rem;\n  }\n\n  .hiw-meta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem 1.75rem;\n  }\n\n  .hiw-meta__item {\n    display: flex;\n    align-items: center;\n    gap: 0.45rem;\n    font-size: 0.875rem;\n    color: rgba(255,255,255,0.78);\n  }\n\n  .hiw-meta__item svg { color: var(--c-orange); flex-shrink: 0; }\n\n  /* ── MAIN GRID ───────────────────────────────────────────── */\n  .hiw-main {\n    max-width: var(--max);\n    margin: 0 auto;\n    padding: 5rem var(--px);\n    display: grid;\n    grid-template-columns: 1fr 400px;\n    gap: 5rem;\n    align-items: start;\n  }\n\n  @media (max-width: 880px) {\n    .hiw-main {\n      grid-template-columns: 1fr;\n      gap: 3rem;\n      padding: 3rem var(--px);\n    }\n    .hiw-form-col { order: -1; }\n  }\n\n  /* ── CONTENT ─────────────────────────────────────────────── */\n  .hiw-eyebrow {\n    font-size: 0.67rem;\n    font-weight: 800;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--c-orange);\n    margin-bottom: 0.6rem;\n  }\n\n  .hiw-intro {\n    font-size: clamp(1rem, 1.5vw, 1.13rem);\n    color: var(--c-text-2);\n    line-height: 1.8;\n    margin-bottom: 3rem;\n  }\n\n  .hiw-intro strong { color: var(--c-text); font-weight: 600; }\n\n  .hiw-block { margin-bottom: 3rem; }\n\n  .hiw-block__heading {\n    font-size: 1.15rem;\n    font-weight: 700;\n    color: var(--c-text);\n    letter-spacing: -0.01em;\n    margin-bottom: 1.25rem;\n    padding-bottom: 0.75rem;\n    border-bottom: 2px solid var(--c-border);\n  }\n\n  .hiw-list {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 0.9rem;\n  }\n\n  .hiw-list li {\n    display: grid;\n    grid-template-columns: 24px 1fr;\n    gap: 0.8rem;\n    align-items: start;\n    font-size: 0.96rem;\n    color: var(--c-text-2);\n    line-height: 1.65;\n  }\n\n  .hiw-check {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    background: var(--c-orange-lt);\n    border: 1.5px solid var(--c-orange-bd);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    margin-top: 1px;\n  }\n\n  .hiw-check svg { width: 10px; height: 10px; color: var(--c-orange); }\n\n  /* facilitators */\n  .hiw-facs {\n    display: flex;\n    flex-direction: column;\n    gap: 0.6rem;\n    margin-bottom: 0;\n  }\n\n  .hiw-fac {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    padding: 1rem 1.2rem;\n    background: var(--c-surface);\n    border: 1px solid var(--c-border);\n    border-radius: var(--radius);\n    text-decoration: none;\n    transition: border-color 0.2s, background 0.2s;\n  }\n\n  .hiw-fac:hover {\n    border-color: var(--c-orange);\n    background: var(--c-orange-lt);\n  }\n\n  .hiw-fac__av {\n    width: 48px;\n    height: 48px;\n    border-radius: 50%;\n    object-fit: cover;\n    object-position: top center;\n    border: 2px solid var(--c-border);\n    flex-shrink: 0;\n    overflow: hidden;\n    display: block;\n  }\n\n  .hiw-fac__name  { font-size: 0.92rem; font-weight: 600; color: var(--c-text); }\n  .hiw-fac__role  { font-size: 0.74rem; color: var(--c-text-3); margin-top: 1px; }\n  .hiw-fac__arr   { margin-left: auto; color: var(--c-text-3); font-size: 0.9rem; }\n\n  /* ── FORM CARD ───────────────────────────────────────────── */\n  .hiw-form-card {\n    position: sticky;\n    top: 2rem;\n    background: var(--c-bg);\n    border: 1.5px solid var(--c-border);\n    border-radius: 8px;\n    overflow: hidden;\n    box-shadow: 0 4px 32px rgba(0,0,0,0.07), 0 1px 4px rgba(0,0,0,0.04);\n  }\n\n  .hiw-form-card__hd {\n    background: var(--c-orange);\n    padding: 1.5rem 1.75rem;\n  }\n\n  .hiw-form-card__hd-title {\n    font-size: 1.05rem;\n    font-weight: 700;\n    color: #fff;\n    margin-bottom: 0.25rem;\n    line-height: 1.3;\n  }\n\n  .hiw-form-card__hd-sub {\n    font-size: 0.78rem;\n    color: rgba(255,255,255,0.85);\n    display: flex;\n    align-items: center;\n    gap: 0.4rem;\n  }\n\n  .hiw-form-card__hd-sub::before {\n    content: '';\n    display: inline-block;\n    width: 5px;\n    height: 5px;\n    background: rgba(255,255,255,0.7);\n    border-radius: 50%;\n    animation: hiw-blink 1.6s ease-in-out infinite;\n  }\n\n  .hiw-form-card__body {\n    padding: 1.75rem;\n    background: var(--c-surface);\n  }\n\n  /* HubSpot form overrides — light theme */\n  .hiw-form-card__body .hs-form fieldset {\n    max-width: 100% !important;\n  }\n  .hiw-form-card__body .hs-form .hs-form-field {\n    margin-bottom: 1rem !important;\n  }\n  .hiw-form-card__body .hs-form label {\n    font-size: 0.82rem !important;\n    font-weight: 600 !important;\n    color: var(--c-text-2) !important;\n    margin-bottom: 0.3rem !important;\n    display: block !important;\n  }\n  .hiw-form-card__body .hs-form input[type=\"text\"],\n  .hiw-form-card__body .hs-form input[type=\"email\"],\n  .hiw-form-card__body .hs-form input[type=\"tel\"],\n  .hiw-form-card__body .hs-form select,\n  .hiw-form-card__body .hs-form textarea {\n    background: #ffffff !important;\n    border: 1.5px solid var(--c-border2) !important;\n    color: var(--c-text) !important;\n    border-radius: var(--radius) !important;\n    padding: 0.65rem 0.9rem !important;\n    width: 100% !important;\n    font-size: 0.9rem !important;\n    outline: none !important;\n    transition: border-color 0.2s, box-shadow 0.2s !important;\n    box-shadow: none !important;\n    appearance: none !important;\n  }\n  .hiw-form-card__body .hs-form input:focus,\n  .hiw-form-card__body .hs-form select:focus,\n  .hiw-form-card__body .hs-form textarea:focus {\n    border-color: var(--c-orange) !important;\n    box-shadow: 0 0 0 3px rgba(240,90,40,0.12) !important;\n  }\n  .hiw-form-card__body .hs-form .hs-button,\n  .hiw-form-card__body .hs-form input[type=\"submit\"] {\n    background: var(--c-orange) !important;\n    color: #fff !important;\n    border: none !important;\n    padding: 0.9rem 1.5rem !important;\n    font-size: 0.88rem !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.06em !important;\n    text-transform: uppercase !important;\n    border-radius: var(--radius) !important;\n    width: 100% !important;\n    cursor: pointer !important;\n    transition: background 0.2s, transform 0.15s !important;\n    margin-top: 0.5rem !important;\n  }\n  .hiw-form-card__body .hs-form .hs-button:hover,\n  .hiw-form-card__body .hs-form input[type=\"submit\"]:hover {\n    background: var(--c-orange-dk) !important;\n    transform: translateY(-1px) !important;\n  }\n  .hiw-form-card__body .hs-form .hs-error-msgs {\n    list-style: none !important;\n  }\n  .hiw-form-card__body .hs-form .hs-error-msg {\n    color: #c0392b !important;\n    font-size: 0.78rem !important;\n    margin-top: 0.25rem !important;\n  }\n\n  /* Loading state */\n  .hiw-form-loading {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.6rem;\n    padding: 2.5rem 1rem;\n    color: var(--c-text-3);\n    font-size: 0.85rem;\n  }\n\n  .hiw-form-loading__spinner {\n    width: 18px;\n    height: 18px;\n    border: 2px solid var(--c-border);\n    border-top-color: var(--c-orange);\n    border-radius: 50%;\n    animation: hiw-spin 0.7s linear infinite;\n  }\n\n  @keyframes hiw-spin {\n    to { transform: rotate(360deg); }\n  }\n\n  .hiw-form-card__ft {\n    padding: 1rem 1.75rem 1.4rem;\n    display: flex;\n    align-items: flex-start;\n    gap: 0.55rem;\n    border-top: 1px solid var(--c-border);\n    background: var(--c-bg);\n  }\n\n  .hiw-form-card__ft svg { color: var(--c-text-3); flex-shrink: 0; margin-top: 1px; }\n\n  .hiw-form-card__ft-txt {\n    font-size: 0.73rem;\n    color: var(--c-text-3);\n    line-height: 1.55;\n  }\n\n  /* ── DIVIDER ─────────────────────────────────────────────── */\n  .hiw-div {\n    max-width: var(--max);\n    margin: 0 auto;\n    padding: 0 var(--px);\n  }\n  .hiw-div hr { border: none; border-top: 1px solid var(--c-border); }\n\n  /* ── METHODOLOGY ─────────────────────────────────────────── */\n  .hiw-method {\n    background: var(--c-surface);\n    border-top: 1px solid var(--c-border);\n    border-bottom: 1px solid var(--c-border);\n    padding: 5rem var(--px);\n  }\n\n  .hiw-method__inner {\n    max-width: var(--max);\n    margin: 0 auto;\n  }\n\n  .hiw-method__hd {\n    text-align: center;\n    margin-bottom: 3.5rem;\n  }\n\n  .hiw-method__hd h2 {\n    font-size: clamp(1.6rem, 3vw, 2.4rem);\n    font-weight: 700;\n    letter-spacing: -0.02em;\n    color: var(--c-text);\n    margin-bottom: 0.6rem;\n  }\n\n  .hiw-method__hd p {\n    font-size: 0.97rem;\n    color: var(--c-text-3);\n    max-width: 520px;\n    margin: 0 auto;\n    line-height: 1.7;\n  }\n\n  .hiw-pillars {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.25rem;\n  }\n\n  @media (max-width: 720px) {\n    .hiw-pillars { grid-template-columns: 1fr; }\n  }\n\n  .hiw-pillar {\n    background: var(--c-bg);\n    border: 1.5px solid var(--c-border);\n    border-radius: 8px;\n    padding: 2.25rem 1.75rem;\n    position: relative;\n    overflow: hidden;\n    transition: border-color 0.25s, box-shadow 0.25s;\n  }\n\n  .hiw-pillar:hover {\n    border-color: var(--c-orange-bd);\n    box-shadow: 0 6px 28px rgba(240,90,40,0.08);\n  }\n\n  .hiw-pillar__bar {\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 3px;\n    background: var(--c-orange);\n    transform: scaleY(0);\n    transform-origin: top;\n    transition: transform 0.35s ease;\n    border-radius: 0 0 0 8px;\n  }\n\n  .hiw-pillar:hover .hiw-pillar__bar { transform: scaleY(1); }\n\n  .hiw-pillar__num {\n    font-size: 0.62rem;\n    font-weight: 800;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--c-orange);\n    margin-bottom: 1rem;\n  }\n\n  .hiw-pillar__title {\n    font-size: 0.95rem;\n    font-weight: 700;\n    color: var(--c-text);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    margin-bottom: 0.85rem;\n    line-height: 1.3;\n  }\n\n  .hiw-pillar__text {\n    font-size: 0.87rem;\n    color: var(--c-text-3);\n    line-height: 1.75;\n  }\n\n  /* ── CTA STRIP ───────────────────────────────────────────── */\n  .hiw-cta {\n    max-width: var(--max);\n    margin: 0 auto;\n    padding: 4.5rem var(--px);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 2rem;\n    flex-wrap: wrap;\n  }\n\n  .hiw-cta__text h3 {\n    font-size: clamp(1.3rem, 2.5vw, 1.9rem);\n    font-weight: 700;\n    letter-spacing: -0.015em;\n    color: var(--c-text);\n    margin-bottom: 0.3rem;\n  }\n\n  .hiw-cta__text p {\n    font-size: 0.95rem;\n    color: var(--c-text-3);\n  }\n\n  .hiw-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    background: var(--c-orange);\n    color: #fff;\n    font-size: 0.82rem;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    text-decoration: none;\n    padding: 0.85rem 2rem;\n    border-radius: var(--radius);\n    transition: background 0.2s, transform 0.15s;\n    flex-shrink: 0;\n  }\n\n  .hiw-btn:hover {\n    background: var(--c-orange-dk);\n    transform: translateY(-1px);\n  }\n\n\n  .hiw-fac__av img,\n  img.hiw-fac__av {\n    width: 48px;\n    height: 48px;\n    border-radius: 50%;\n    object-fit: cover;\n    object-position: top center;\n    display: block;\n    flex-shrink: 0;\n  }\n\n  /* ── Fade-in animations ──────────────────────────────────── */\n  @keyframes hiw-up {\n    from { opacity: 0; transform: translateY(20px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n\n  .hiw-anim { opacity: 0; }\n  .hiw-anim.hiw-in {\n    animation: hiw-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;\n  }\n  .hiw-anim:nth-child(2) { animation-delay: 0.08s; }\n  .hiw-anim:nth-child(3) { animation-delay: 0.16s; }\n  .hiw-anim:nth-child(4) { animation-delay: 0.24s; }\n</style>\n\n<!-- ══════════════════════════════════════════════════════════ -->\n<div class=\"hiw\">\n\n  <!-- HERO -->\n  <section class=\"hiw-hero\">\n    <div class=\"hiw-hero__bg\"></div>\n    <div class=\"hiw-hero__overlay\"></div>\n    <div class=\"hiw-hero__content\">\n      <div class=\"hiw-badge\">\n        <span class=\"hiw-badge__dot\"></span>\n        Webinar ao vivo · 16 de Abril\n      </div>\n\n      <h1 class=\"hiw-hero__title\">\n        Estratégia e Pensamento<br>Crítico com IA\n      </h1>\n\n      <p class=\"hiw-hero__sub\">\n        A IA não substitui o julgamento — ela transforma a forma como chegamos a ele.\n      </p>\n\n      <div class=\"hiw-meta\">\n        <span class=\"hiw-meta__item\">\n          <svg width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"></rect><path d=\"M16 2v4M8 2v4M3 10h18\"></path>\n          </svg>\n          16 de Abril de 2025\n        </span>\n        <span class=\"hiw-meta__item\">\n          <svg width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path>\n          </svg>\n          19h00 · Horário de Brasília\n        </span>\n        <span class=\"hiw-meta__item\">\n          <svg width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n            <path d=\"M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.894L15 14\"></path><rect x=\"3\" y=\"8\" width=\"12\" height=\"8\" rx=\"2\"></rect>\n          </svg>\n          Online · 45–60 minutos\n        </span>\n      </div>\n    </div>\n  </section>\n\n  <!-- MAIN GRID -->\n  <div class=\"hiw-main\">\n\n    <!-- Content -->\n    <div>\n      <p class=\"hiw-eyebrow\">Sobre o webinar</p>\n      <p class=\"hiw-intro\">\n        A maioria dos times está usando IA para ir <strong>mais rápido</strong> — mas não necessariamente para ir <strong>mais longe</strong>. Este webinar mostra como a combinação de <strong>pensamento prospectivo + pensamento crítico com IA</strong> ajuda líderes a tomar decisões melhores em cenários de complexidade e incerteza.<br><br>\n        Em tempos de policrise, o objetivo não é a certeza falsa — é a <strong>resiliência pela adaptabilidade</strong>. A prospectiva estratégica é uma mentalidade essencial de liderança: revelar premissas, ampliar perspectivas e testar decisões. A IA, combinada com pensamento humano crítico, pode acelerar esse processo.\n      </p>\n\n      <div class=\"hiw-block hiw-anim\">\n        <h3 class=\"hiw-block__heading\">O que você vai explorar</h3>\n        <ul class=\"hiw-list\">\n          <li>\n            <span class=\"hiw-check\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 12 12\">\n                <polyline points=\"1.5,6 4.5,9 10.5,3\"></polyline>\n              </svg>\n            </span>\n            <span>Por que a <strong>prospectiva estratégica</strong> é uma disciplina prática de liderança — resiliência e adaptabilidade acima de previsão.</span>\n          </li>\n          <li>\n            <span class=\"hiw-check\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 12 12\">\n                <polyline points=\"1.5,6 4.5,9 10.5,3\"></polyline>\n              </svg>\n            </span>\n            <span>Como usar IA para <strong>revelar premissas ocultas</strong>, ampliar perspectivas e explorar consequências — método prático \"Flip the Future\".</span>\n          </li>\n          <li>\n            <span class=\"hiw-check\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 12 12\">\n                <polyline points=\"1.5,6 4.5,9 10.5,3\"></polyline>\n              </svg>\n            </span>\n            <span>Como o <strong>Hyper Island Futures Agent</strong> pode acelerar a percepção de sinais, exploração de cenários e construção de opções estratégicas.</span>\n          </li>\n        </ul>\n      </div>\n\n      <div class=\"hiw-block hiw-anim\">\n        <h3 class=\"hiw-block__heading\">Para quem é</h3>\n        <ul class=\"hiw-list\">\n          <li>\n            <span class=\"hiw-check\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 12 12\">\n                <polyline points=\"1.5,6 4.5,9 10.5,3\"></polyline>\n              </svg>\n            </span>\n            <span>Líderes de <strong>estratégia, inovação, transformação e pessoas</strong>.</span>\n          </li>\n          <li>\n            <span class=\"hiw-check\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 12 12\">\n                <polyline points=\"1.5,6 4.5,9 10.5,3\"></polyline>\n              </svg>\n            </span>\n            <span>Times <strong>experimentando com IA</strong> que têm dificuldade em transformar esses experimentos em valor duradouro.</span>\n          </li>\n          <li>\n            <span class=\"hiw-check\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 12 12\">\n                <polyline points=\"1.5,6 4.5,9 10.5,3\"></polyline>\n              </svg>\n            </span>\n            <span>Pessoas curiosas sobre como <strong>aplicar IA além da produtividade</strong> — em estratégia, cenários e decisões complexas.</span>\n          </li>\n        </ul>\n      </div>\n\n      <div class=\"hiw-block hiw-anim\">\n        <p class=\"hiw-eyebrow\">Facilitadores</p>\n        <div class=\"hiw-facs\">\n          <a class=\"hiw-fac\" href=\"https://www.linkedin.com/in/drtimlucas/\" target=\"_blank\" rel=\"noopener\">\n            <img class=\"hiw-fac__av\" src=\"data:image/png;base64,\" alt=\"Tim Lucas\">\n            <div>\n              <div class=\"hiw-fac__name\">Tim Lucas</div>\n              <div class=\"hiw-fac__role\">Facilitador · Hyper Island</div>\n            </div>\n            <span class=\"hiw-fac__arr\">↗</span>\n          </a>\n          <a class=\"hiw-fac\" href=\"https://www.linkedin.com/in/sabryna-alsfasser/\" target=\"_blank\" rel=\"noopener\">\n            <img class=\"hiw-fac__av\" src=\"data:image/png;base64,\" alt=\"Sabryna Alsfasser\">\n            <div>\n              <div class=\"hiw-fac__name\">Sabryna Alsfasser</div>\n              <div class=\"hiw-fac__role\">Facilitadora · Hyper Island</div>\n            </div>\n            <span class=\"hiw-fac__arr\">↗</span>\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Form Column -->\n    <div class=\"hiw-form-col hiw-anim\">\n      <div class=\"hiw-form-card\">\n        <div class=\"hiw-form-card__hd\">\n          <div class=\"hiw-form-card__hd-title\">Garanta sua vaga · Gratuito</div>\n          <div class=\"hiw-form-card__hd-sub\">16 de Abril às 19h00 · Online ao vivo</div>\n        </div>\n        <div class=\"hiw-form-card__body\">\n          <!-- Loading state shown while HubSpot loads -->\n          <div class=\"hiw-form-loading\" id=\"hiw-form-loading\">\n            <div class=\"hiw-form-loading__spinner\"></div>\n            <span>Carregando formulário…</span>\n          </div>\n          <!-- HubSpot mounts here -->\n          <div id=\"hiw-hs-form\"></div>\n        </div>\n        <div class=\"hiw-form-card__ft\">\n          <svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n          </svg>\n          <span class=\"hiw-form-card__ft-txt\">\n            Seus dados estão seguros. Usamos apenas para envio do link e conteúdos relevantes da Hyper Island.\n          </span>\n        </div>\n      </div>\n    </div>\n\n  </div>\n<!-- /hiw-main -->\n\n  <div class=\"hiw-div\"><hr></div>\n\n  <!-- METHODOLOGY -->\n  <section class=\"hiw-method\">\n    <div class=\"hiw-method__inner\">\n      <div class=\"hiw-method__hd\">\n        <p class=\"hiw-eyebrow\">Nossa metodologia</p>\n        <h2>The Hyper Island Way</h2>\n        <p>Sem aulas passivas. Sem teoria pela teoria. Um programa construído sobre desafios reais, colaboração ao vivo e aplicação prática.</p>\n      </div>\n      <div class=\"hiw-pillars\">\n        <div class=\"hiw-pillar hiw-anim\">\n          <div class=\"hiw-pillar__bar\"></div>\n          <div class=\"hiw-pillar__num\">01</div>\n          <div class=\"hiw-pillar__title\">Abraçe o<br>não-convencional</div>\n          <p class=\"hiw-pillar__text\">Na Hyper Island, vamos além das palestras convencionais — perspectivas frescas e ideias ousadas que conectam tecnologia, crescimento e liderança de forma significativa.</p>\n        </div>\n        <div class=\"hiw-pillar hiw-anim\">\n          <div class=\"hiw-pillar__bar\"></div>\n          <div class=\"hiw-pillar__num\">02</div>\n          <div class=\"hiw-pillar__title\">Aprendizado<br>reflexivo e imersivo</div>\n          <p class=\"hiw-pillar__text\">Jornadas de aprendizagem práticas com 20% de teoria e 80% de prática real — conteúdo aplicável desde o primeiro momento.</p>\n        </div>\n        <div class=\"hiw-pillar hiw-anim\">\n          <div class=\"hiw-pillar__bar\"></div>\n          <div class=\"hiw-pillar__num\">03</div>\n          <div class=\"hiw-pillar__title\">Cresça junto,<br>lidere junto</div>\n          <p class=\"hiw-pillar__text\">Alunos da Hyper Island crescem em uma comunidade colaborativa — explorando, compartilhando e co-criando em uma jornada coletiva de crescimento e conexão.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA STRIP -->\n  <div class=\"hiw-cta\">\n    <div class=\"hiw-cta__text\">\n      <h3>Ficou com alguma dúvida?</h3>\n      <p>Nossa equipe está pronta para te ajudar a encontrar a melhor solução.</p>\n    </div>\n    <a href=\"https://hyperisland.com/brasil/contato\" class=\"hiw-btn\">\n      Falar com a equipe\n      <svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n        <path d=\"M5 12h14M13 6l6 6-6 6\"></path>\n      </svg>\n    </a>\n  </div>\n\n</div><!-- /hiw -->\n\n<!-- ── HubSpot: carrega dinamicamente e cria o form no onload ── -->\n<script>\n(function () {\n  var loading = document.getElementById('hiw-form-loading');\n  var target  = document.getElementById('hiw-hs-form');\n\n  function createForm() {\n    if (loading) loading.style.display = 'none';\n    hbspt.forms.create({\n      portalId:  \"1588780\",\n      formId:    \"d508fd04-5bba-42ad-848b-ca9bc34697ce\",\n      region:    \"na1\",\n      target:    \"#hiw-hs-form\"\n    });\n  }\n\n  // If hbspt already exists (e.g. another form on the same page loaded it first)\n  if (typeof hbspt !== 'undefined') {\n    createForm();\n    return;\n  }\n\n  // Otherwise: inject the script and wait for it\n  var s = document.createElement('script');\n  s.charset = 'utf-8';\n  s.type    = 'text/javascript';\n  s.src     = '//js.hsforms.net/forms/embed/v2.js';\n  s.onload  = createForm;\n  s.onerror = function () {\n    if (loading) loading.innerHTML = '<span style=\"color:#c0392b;font-size:0.82rem\">Não foi possível carregar o formulário. Por favor, recarregue a página.</span>';\n  };\n  document.head.appendChild(s);\n})();\n</script>\n\n<!-- ── Intersection Observer para animações ─────────────────── -->\n<script>\n(function () {\n  var els = document.querySelectorAll('.hiw-anim');\n  if (!els.length || !window.IntersectionObserver) {\n    els.forEach(function (el) { el.classList.add('hiw-in'); });\n    return;\n  }\n  var io = new IntersectionObserver(function (entries) {\n    entries.forEach(function (e) {\n      if (e.isIntersecting) { e.target.classList.add('hiw-in'); io.unobserve(e.target); }\n    });\n  }, { threshold: 0.08 });\n  els.forEach(function (el) { io.observe(el); });\n})();\n</script>",
