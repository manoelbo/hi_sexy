          "settings": {
            "title": "Mais do que teoria de MBA",
            "text": "Aqui você não encontra fórmulas prontas. Encontra experiências, ferramentas práticas e um espaço seguro para experimentar e evoluir. É formação com profundidade e aplicação imediata.",
            "header": "",
            "svg": "",
            "bg_color": "",
            "bg_gradient": ""
          }
        }
