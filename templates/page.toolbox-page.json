hed.splitText(term.length);\n          const wrap = document.createElement('span');\n          wrap.className = 'search-highlight';\n          wrap.textContent = matched.textContent;\n          matched.parentNode.replaceChild(wrap, matched);\n        }\n      } else if (node.nodeType === 1 && node.childNodes && !['SCRIPT','STYLE','NOSCRIPT'].includes(node.tagName)) {\n        node.childNodes.forEach(child => highlightTerm(child, term));\n      }\n    }\n  })();\n</script></section>",
