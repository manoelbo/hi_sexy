          }
        },
        "card_7jaitn": {
          "type": "card",
          "settings": {
            "img": "shopify://shop_images/Funcoes_e_responsabilidades.png",
            "category_id": "Equipes",
            "title": "Funções e responsabilidades",
            "text": "Definir funções e responsabilidades é essencial para mover sua equipe de “storming” para “normal”, ou ajudar as equipes de “desempenho” a voltarem, ou, se manterem no caminho certo. Isso pode ajudá-los a entender melhor o papel de cada um e a aprender quem é responsável pelo o quê.",
            "url": "shopify://metaobjects/toolbox_new/funcoes-e-responsabilidades",
            "target": false
          }
        },
        "card_qhD9dX": {
          "type": "card",
          "settings": {
            "img": "shopify://shop_images/Retrospectiva_da_equipe.png",
            "category_id": "Equipes",
            "title": "Retrospectiva da equipe",
            "text": "Retrospectivas de equipe são reuniões normalmente realizadas no final de um projeto, \"sprint\", semana, mês ou temporada com o objetivo de identificar o que funcionou bem, o que poderia ser melhorado e descobrir áreas desafiadoras que toda a equipe pode aprender e melhorar.  Você precisa de mais suporte para implementar ferramentas de equipe em seu local de trabalho?",
            "url": "shopify://metaobjects/toolbox_new/retrospectiva-da-equipe",
            "target": false
          }
        },
        "card_qtBKeV": {
          "type": "card",
          "settings": {
            "img": "shopify://shop_images/O_Modelo_de_Coaching_GROW.png",
            "category_id": "Equipes",
            "title": "O Modelo de Coaching \"GROW\"",
            "text": "O modelo \"GROW\" é uma estrutura de coaching usada em conversas, reuniões e liderança diária para desbloquear potências e possibilidades. É uma estrutura simples e eficaz para estruturar suas sessões de coaching e mentoring, sendo fácil de usar para reuniões presenciais e online.",
            "url": "shopify://metaobjects/toolbox_new/o-modelo-de-coaching-grow",
            "target": false
          }
        },
        "card_6hbLTr": {
