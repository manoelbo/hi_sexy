    "html_ByBF3r": {
      "type": "html",
      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Login para Acesso</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <!-- HubSpot Forms JS -->\n    <script charset=\"utf-8\" src=\"//js.hsforms.net/forms/embed/v2.js\"></script>\n    <style>\n        .blur-background {\n            filter: blur(5px);\n            pointer-events: none;\n            user-select: none;\n            transition: filter 0.3s ease;\n        }\n        .modal-container {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            z-index: 1000;\n            background-color: rgba(0, 0, 0, 0.5);\n            backdrop-filter: blur(2px);\n        }\n        .modal-content {\n            animation: fadeIn 0.5s ease-out;\n            transform-origin: center;\n        }\n        @keyframes fadeIn {\n            from { opacity: 0; transform: scale(0.95); }\n            to { opacity: 1; transform: scale(1); }\n        }\n        .input-highlight {\n            transition: all 0.3s ease;\n            box-shadow: 0 0 0 0px rgba(255, 119, 0, 0);\n        }\n        .input-highlight:focus {\n            box-shadow: 0 0 0 3px rgba(255, 119, 0, 0.3);\n            border-color: #FF7700 !important;\n        }\n        .hs-form iframe {\n            width: 100% !important;\n        }\n        .hs-form fieldset {\n            max-width: 100% !important;\n            border: none !important;\n            padding: 0 !important;\n            margin: 0 !important;\n        }\n        .hs-form-required {\n            display: none !important;\n        }\n        .hs-error-msgs {\n            margin-top: 0.25rem !important;\n        }\n        .hs-error-msg {\n            color: #ef4444 !important;\n            font-size: 0.75rem !important;\n        }\n        @keyframes fadeInUp {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in-up {\n            animation: fadeInUp 0.3s ease-out forwards;\n        }\n        .hyper-orange {\n            color: #FF7700;\n        }\n        .hyper-orange-bg {\n            background-color: #FF7700;\n        }\n        .hyper-orange-border {\n            border-color: #FF7700;\n        }\n        .hyper-orange-hover:hover {\n            background-color: #e56a00;\n        }\n        .hyper-orange-focus:focus {\n            border-color: #FF7700;\n            box-shadow: 0 0 0 3px rgba(255, 119, 0, 0.3);\n        }\n        /* Custom styles for the new form */\n        .hs-email-input {\n            position: relative;\n            margin-bottom: 1.5rem;\n        }\n        .hs-email-input input {\n            width: 100%;\n            padding: 0.75rem 1rem 0.75rem 2.5rem;\n            border-radius: 0.5rem;\n            border: 1px solid #d1d5db;\n            font-size: 0.95rem;\n            transition: all 0.3s ease;\n        }\n        .hs-email-input input:focus {\n            border-color: #FF7700;\n            box-shadow: 0 0 0 3px rgba(255, 119, 0, 0.2);\n            outline: none;\n        }\n        .hs-email-input .input-icon {\n            position: absolute;\n            left: 1rem;\n            top: 50%;\n            transform: translateY(-50%);\n            color: #9ca3af;\n        }\n        .hs-submit-btn {\n            width: 100%;\n            padding: 0.75rem 1rem;\n            background-color: #FF7700;\n            color: white;\n            border: none;\n            border-radius: 0.5rem;\n            font-weight: 500;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n        }\n        .hs-submit-btn:hover {\n            background-color: #e56a00;\n        }\n        .hs-submit-btn:active {\n            transform: scale(0.98);\n        }\n        /* Left align form content */\n        .form-content-left {\n            text-align: left !important;\n        }\n        .form-content-left .hs-form-field {\n            text-align: left !important;\n        }\n        .form-content-left label {\n            text-align: left !important;\n        }\n        .form-content-left input {\n            text-align: left !important;\n        }\n        #hubspot-form-container {\n            text-align: left;\n        }\n/* ========== unifica Nome e E-mail ========== */\n#hubspot-form-container input[type=\"text\"],\n#hubspot-form-container input[type=\"email\"] {\n  width: 100% !important;\n  padding: 0.75rem 1rem !important;\n  border: 1px solid #d1d5db !important;\n  border-radius: 0.5rem !important;\n  font-size: 0.95rem !important;\n  transition: all 0.3s ease !important;\n  text-align: left !important;\n}\n\n#hubspot-form-container input[type=\"text\"]:focus,\n#hubspot-form-container input[type=\"email\"]:focus {\n  border-color: #FF7700 !important;\n  box-shadow: 0 0 0 3px rgba(255, 119, 0, 0.2) !important;\n  outline: none;\n}\n/* ── Estiliza o botão de submit para ficar “clicável” ── */\n#hubspot-form-container input[type=\"submit\"],\n#hubspot-form-container button[type=\"submit\"] {\n  display: inline-block;               /* garante que seja um bloco clicável */\n  width: 20%;                         /* ou ajuste conforme quiser */\n  padding: 0.50rem 0.75rem;               /* espaçamento interno */\n  background-color: #FF7700;           /* cor de fundo */\n  color: #ffffff;                      /* cor do texto */\n  border: none;                        /* sem borda padrão */\n  border-radius: 0.5rem;               /* cantos arredondados */\n  font-size: 1rem;                     /* tamanho da fonte */\n  font-weight: 500;                    /* peso da fonte */\n  text-align: center;                  /* centraliza o texto/ícone */\n  cursor: pointer;                     /* muda o cursor ao passar o mouse */\n  transition: background-color 0.3s ease, transform 0.1s ease;\n}\n\n/* Hover e active para dar feedback visual */\n#hubspot-form-container input[type=\"submit\"]:hover,\n#hubspot-form-container button[type=\"submit\"]:hover {\n  background-color: #e56a00;\n}\n#hubspot-form-container input[type=\"submit\"]:active,\n#hubspot-form-container button[type=\"submit\"]:active {\n  transform: scale(0.98);\n}\n\n    </style>\n\n\n    <!-- Este div seria o conteúdo do seu site existente -->\n    <div id=\"main-content\" class=\"blur-background min-h-screen p-8\">\n        <!-- Todo o conteúdo do seu site viria aqui -->\n        <div class=\"max-w-4xl mx-auto\">\n         \n        </div>\n    </div>\n\n    <!-- Modal de Login -->\n    <div id=\"modal\" class=\"modal-container\">\n        <div class=\"modal-content bg-white p-8 rounded-xl shadow-2xl w-full max-w-md mx-4\">\n            <div class=\"text-center mb-6\">\n                <div class=\"mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-orange-100 mb-4\">\n                    <i class=\"fas fa-lock-open hyper-orange text-2xl\"></i>\n                </div>\n                <h2 class=\"text-2xl font-bold text-gray-800\">Acesso Restrito</h2>\n                <p class=\"mt-2 text-gray-600\">Faça Login para aproveitar mais de 120 ferramentas de forma gratuita</p>\n            </div>\n            \n            <!-- Formulário do HubSpot -->\n            <div id=\"hubspot-form-container\" class=\"form-content-left\"></div>\n            \n            <div class=\"mt-6 text-center text-sm text-gray-500\">\n                <p>Não compartilhamos seus dados. <br> Ao continuar, você concorda com nossos <a href=\"https://www.hyperisland.com.br/pages/politica-de-privacidade\" class=\"font-medium hyper-orange hover:text-orange-700\">Termos de Serviço</a>.</p>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const mainContent = document.getElementById('main-content');\n            const modal = document.getElementById('modal');\n            \n            // Verifica se já tem email armazenado (pode usar localStorage ou sessionStorage)\n            const storedEmail = localStorage.getItem('unlockEmail');\n            if (storedEmail) {\n                unlockContent();\n            }\n            \n            // Inicializa o formulário do HubSpot\n            hbspt.forms.create({\n                portalId: \"1588780\",\n                formId: \"727aa803-2e33-481e-aeb4-6a019e249824\",\n                region: \"na1\",\n                target: \"#hubspot-form-container\",\n                onFormReady: function($form) {\n                    // Force left alignment for all form elements\n                    $form.classList.add('form-content-left');\n                    \n                    // Customize the email input\n                    const emailInput = $form.querySelector('input[type=\"email\"]');\n                    if (emailInput) {\n                        const emailContainer = emailInput.closest('.hs_email');\n                        emailContainer.classList.add('hs-email-input');\n                        \n                        // Add icon before the input\n                        const icon = document.createElement('div');\n                        icon.className = 'input-icon';\n                        icon.innerHTML = '<i class=\"fas fa-envelope\"></i>';\n                        emailContainer.insertBefore(icon, emailInput);\n                        \n                        // Style the input\n                        emailInput.classList.add('input-highlight');\n                        emailInput.placeholder = 'seu@email.com';\n                        emailInput.style.textAlign = 'left';\n                    }\n                    \n                    // Customize the submit button\n                    const submitBtn = $form.querySelector('input[type=\"submit\"]');\n                    if (submitBtn) {\n                        submitBtn.classList.remove('hs-button');\n                        submitBtn.classList.add('hs-submit-btn');\n                        submitBtn.value = 'Acessar Agora';\n                        \n                        // Add arrow icon to button\n                        const arrowIcon = document.createElement('i');\n                        arrowIcon.className = 'fas fa-arrow-right';\n                        submitBtn.appendChild(arrowIcon);\n                    }\n                    \n                    // Left align all labels and inputs\n                    const labels = $form.querySelectorAll('label');\n                    labels.forEach(label => {\n                        label.style.textAlign = 'left';\n                        label.style.display = 'block';\n                    });\n                    \n                    const inputs = $form.querySelectorAll('input, textarea, select');\n                    inputs.forEach(input => {\n                        input.style.textAlign = 'left';\n                    });\n                },\n                onFormSubmit: function($form) {\n                    // Quando o formulário é enviado com sucesso\n                    const emailInput = $form.querySelector('input[type=\"email\"]');\n                    if (emailInput) {\n                        const email = emailInput.value.trim();\n                        localStorage.setItem('unlockEmail', email);\n                        unlockContent();\n                        showSuccessFeedback(email);\n                    }\n                },\n                css: `\n                    .hs-form fieldset { \n                        max-width: 100% !important; \n                        border: none !important;\n                        padding: 0 !important;\n                        margin: 0 !important;\n                        text-align: left !important;\n                    }\n                    .hs-form label {\n                        font-size: 0.875rem !important;\n                        font-weight: 500 !important;\n                        color: #374151 !important;\n                        margin-bottom: 0.5rem !important;\n                        display: block !important;\n                        text-align: left !important;\n                    }\n                    .hs-form-required {\n                        display: none !important;\n                    }\n                    .hs-error-msgs {\n                        margin-top: 0.25rem !important;\n                        text-align: left !important;\n                    }\n                    .hs-error-msg {\n                        color: #ef4444 !important;\n                        font-size: 0.75rem !important;\n                        text-align: left !important;\n                    }\n                    .hs-input {\n                        text-align: left !important;\n                    }\n                    .hs-form .hs-form-field {\n                        text-align: left !important;\n                    }\n                `\n            });\n            \n            function unlockContent() {\n                // Remove o blur e restaura interação\n                mainContent.classList.remove('blur-background');\n                \n                // Fecha o modal com animação\n                modal.style.animation = 'fadeIn 0.3s reverse';\n                setTimeout(() => {\n                    modal.style.display = 'none';\n                }, 300);\n            }\n            \n            function showSuccessFeedback(email) {\n                // Cria um elemento de feedback\n                const feedback = document.createElement('div');\n                feedback.className = 'fixed bottom-4 right-4 bg-white p-4 rounded-lg shadow-lg border-l-4 border-green-500 flex items-start max-w-xs animate-fade-in-up';\n                feedback.innerHTML = `\n                    <div class=\"mr-3 text-green-500\">\n                        <i class=\"fas fa-check-circle text-xl\"></i>\n                    </div>\n                    <div>\n                        <h4 class=\"font-semibold text-gray-800\">Acesso liberado!</h4>\n                        <p class=\"text-sm text-gray-600 mt-1\">Bem-vindo, ${email.split('@')[0]}!</p>\n                    </div>\n                    <button class=\"ml-4 text-gray-400 hover:text-gray-600\" onclick=\"this.parentElement.remove()\">\n                        <i class=\"fas fa-times\"></i>\n                    </button>\n                `;\n                \n                document.body.appendChild(feedback);\n                \n                // Remove após 5 segundos\n                setTimeout(() => {\n                    feedback.style.opacity = '0';\n                    feedback.style.transform = 'translateY(10px)';\n                    setTimeout(() => feedback.remove(), 300);\n                }, 5000);\n            }\n        });\n    </script>",
        "bg_color": "",
        "container": "container",
        "text_align": "text-center",
        "title": "",
        "title_size": "h2",
        "description": "",
        "description_size": "fs-6",
        "pt": 0,
        "pb": 0,
        "mt": 0,
        "mb": 0
      }
    }
