      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Liderando Futuros Digitais</title>\n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Google Fonts -->\n  <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n  <!-- Font Awesome para ícones -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <style>\n    body { font-family: 'Poppins', sans-serif; }\n  </style>\n\n\n\n <!-- Hero Section -->\n<section class=\"relative bg-cover bg-center pb-2\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0634/7023/9966/files/capa.jpg?v=1742943248');\">\n  <div class=\"absolute inset-0 bg-orange-700 bg-opacity-75\"></div>\n  <div class=\"relative container mx-auto px-4 py-24 text-center text-white\">\n    <div class=\"flex justify-center mb-6\">\n      <span class=\"bg-orange-500 bg-opacity-30 px-3 py-1 rounded-full text-sm flex items-center\">\n        <i class=\"fa-solid fa-award mr-2\"></i>\n        CPD Acreditado no Reino Unido\n      </span>\n    </div>\n    <h1 class=\"text-4xl md:text-5xl font-bold mb-4\">\n      Liderando Futuros <span class=\"text-white-400\">Digitais</span>\n    </h1>\n    <p class=\"text-lg mb-6\">Teesside University • Hyper Island • Grupo Unis</p>\n    <p class=\"max-w-xl mx-auto mb-8\">\n      Desenvolva habilidades de foresight para liderar a transformação digital e criar estratégias inovadoras para o futuro dos negócios.\n    </p>\n    <div class=\"flex justify-center space-x-4 mb-16\">\n      <a href=\"#\" class=\"bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white px-6 py-3 rounded-full font-semibold\">\n        Inscreva-se Agora\n      </a>\n      <a href=\"#saiba-mais\" class=\"border border-white hover:bg-white hover:text-orange-600 text-white px-6 py-3 rounded-full font-semibold\">\n        Saiba Mais\n      </a>\n    </div>\n\n    <!-- Cards de resumo (agora dentro do Hero) -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n      <!-- Início -->\n      <div class=\"bg-white rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-3 rounded-md mb-4\">\n          <i class=\"fa-solid fa-calendar-days text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"font-semibold text-lg mb-2\">Início</h3>\n        <p class=\"text-gray-600\">19/20 de agosto<br>2025</p>\n      </div>\n      <!-- Duração -->\n      <div class=\"bg-white rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-3 rounded-md mb-4\">\n          <i class=\"fa-solid fa-book-open text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"font-semibold text-lg mb-2\">Duração</h3>\n        <p class=\"text-gray-600\">4 semanas<br>Online + Presencial</p>\n      </div>\n      <!-- Investimento -->\n      <div class=\"bg-white rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-3 rounded-md mb-4\">\n          <i class=\"fa-solid fa-dollar-sign text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"font-semibold text-lg mb-2\">Investimento</h3>\n        <p class=\"text-gray-600\">R$ 4.500</p>\n      </div>\n      <!-- Certificação -->\n      <div class=\"bg-white rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-3 rounded-md mb-4\">\n          <i class=\"fa-solid fa-award text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"font-semibold text-lg mb-2\">Certificação</h3>\n        <p class=\"text-gray-600\">10 créditos<br>Nível 7 (UK)</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n  <!-- Foresight Section -->\n  <section id=\"saiba-mais\" class=\"bg-gray-50 py-13\">\n    <div class=\"container mx-auto px-4 text-center max-w-3xl\">\n      <h2 class=\"text-4xl font-bold mb-4\">Foresight para Transformação Digital</h2>\n      <p class=\"text-gray-600 mb-8\">\n        A Transformação Digital é um processo que utiliza tecnologia para ajudar empresas e a sociedade a alcançar objetivos como melhorar a qualidade dos serviços digitais, aumentar a geração de receita e promover uma cultura inovadora. Este curso rápido e acreditado oferece aos participantes as habilidades para explorar cenários futuros organizacionais, propor estratégias e desenvolver planos de ação pessoais.\n      </p>\n      <p class=\"text-gray-600\">\n        Nossa abordagem de aprendizado combina atividades práticas com um ambiente dinâmico e colaborativo, criando uma experiência educacional poderosa e envolvente.\n      </p>\n    </div>\n    <div class=\"container mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center\">\n      <!-- Lista de benefícios -->\n      <div>\n        <!-- Item 1 -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <div class=\"flex items-center\">\n            <div class=\"bg-orange-100 p-3 rounded-md\">\n              <i class=\"fa-solid fa-bullseye text-orange-500 text-xl\"></i>\n            </div>\n            <p class=\"ml-4 text-gray-700\">Desenvolver um mindset de futuro para navegar na transformação digital</p>\n          </div>\n          <i class=\"fa-regular fa-circle-check text-orange-500 text-xl\"></i>\n        </div>\n        <!-- Item 2 -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <div class=\"flex items-center\">\n            <div class=\"bg-orange-100 p-3 rounded-md\">\n              <i class=\"fa-solid fa-lightbulb text-orange-500 text-xl\"></i>\n            </div>\n            <p class=\"ml-4 text-gray-700\">Aplicar ferramentas de foresight para resolver desafios de negócios</p>\n          </div>\n          <i class=\"fa-regular fa-circle-check text-orange-500 text-xl\"></i>\n        </div>\n        <!-- Item 3 -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <div class=\"flex items-center\">\n            <div class=\"bg-orange-100 p-3 rounded-md\">\n              <i class=\"fa-solid fa-chart-line text-orange-500 text-xl\"></i>\n            </div>\n            <p class=\"ml-4 text-gray-700\">Explorar cenários, tendências e incertezas estratégicas para impulsionar a inovação</p>\n          </div>\n          <i class=\"fa-regular fa-circle-check text-orange-500 text-xl\"></i>\n        </div>\n        <!-- Item 4 -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <div class=\"flex items-center\">\n            <div class=\"bg-orange-100 p-3 rounded-md\">\n              <i class=\"fa-solid fa-user-tie text-orange-500 text-xl\"></i>\n            </div>\n            <p class=\"ml-4 text-gray-700\">Desenvolver habilidades de liderança para fomentar uma cultura de transformação contínua</p>\n          </div>\n          <i class=\"fa-regular fa-circle-check text-orange-500 text-xl\"></i>\n        </div>\n        <!-- Item 5 -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <div class=\"flex items-center\">\n            <div class=\"bg-orange-100 p-3 rounded-md\">\n              <i class=\"fa-solid fa-sitemap text-orange-500 text-xl\"></i>\n            </div>\n            <p class=\"ml-4 text-gray-700\">Participar de uma experiência imersiva e interativa, criando conexões com profissionais de diferentes setores</p>\n          </div>\n          <i class=\"fa-regular fa-circle-check text-orange-500 text-xl\"></i>\n        </div>\n        <!-- Item 6 -->\n        <div class=\"flex items-center justify-between\">\n          <div class=\"flex items-center\">\n            <div class=\"bg-orange-100 p-3 rounded-md\">\n              <i class=\"fa-solid fa-award text-orange-500 text-xl\"></i>\n            </div>\n            <p class=\"ml-4 text-gray-700\">A certificação do curso é baseada na sua capacidade de identificar aplicações práticas dos aprendizados do programa</p>\n          </div>\n          <i class=\"fa-regular fa-circle-check text-orange-500 text-xl\"></i>\n        </div>\n      </div>\n      <!-- Imagem à direita -->\n      <div>\n        <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/1686052490011.png?v=1737565377\" alt=\"Aperto de mãos\" class=\"w-full rounded-xl shadow-lg\">\n      </div>\n    </div>\n  </section>\n\n  <!-- Fases do Curso -->\n  <section class=\"bg-orange-50 py-12\">\n    <div class=\"container mx-auto px-4 text-center mb-12\">\n      <h2 class=\"text-5xl font-bold\">Fases do Curso</h2>\n    </div>\n    <div class=\"container mx-auto px-4 space-y-8\">\n      <!-- Fase 1 -->\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <div class=\"flex items-center mb-4\">\n          <div class=\"bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4\">1</div>\n          <span class=\"uppercase text-sm bg-orange-100 text-orange-600 rounded-full px-2 py-1\">FASE 1</span>\n        </div>\n        <h3 class=\"text-3xl font-semibold mb-2\">Preparação Online</h3>\n        <p class=\"text-gray-600 mb-1\">2 workshops de 3 horas cada</p>\n        <p class=\"text-gray-600\">Preparação e fundamentação teórica</p>\n      </div>\n      <!-- Fase 2 -->\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <div class=\"flex items-center mb-4\">\n          <div class=\"bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4\">2</div>\n          <span class=\"uppercase text-sm bg-orange-100 text-orange-600 rounded-full px-2 py-1\">FASE 2</span>\n        </div>\n        <h3 class=\"text-3xl font-semibold mb-2\">Workshop Presencial</h3>\n        <p class=\"text-gray-600 mb-1\">2 dias em Minas Gerais (19 e 20 de agosto de 2025)</p>\n        <p class=\"text-gray-600 mb-1\">Dia 1 – Pensamento de Futuro e Tendências</p>\n        <p class=\"text-gray-600\">Dia 2 – Construção de Cenários e Aplicação</p>\n      </div>\n      <!-- Fase 3 -->\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <div class=\"flex items-center mb-4\">\n          <div class=\"bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold mr-4\">3</div>\n          <span class=\"uppercase text-sm bg-orange-100 text-orange-600 rounded-full px-2 py-1\">FASE 3</span>\n        </div>\n        <h3 class=\"text-3xl font-semibold mb-2\">Coaching e Reflexão</h3>\n        <p class=\"text-gray-600 mb-1\">Workshop online de 3 horas</p>\n        <p class=\"text-gray-600\">Aplicação prática e desenvolvimento de planos de ação</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Local do Curso -->\n  <section class=\"py-16\">\n    <div class=\"container mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center\">\n      <div>\n        <h2 class=\"text-3xl font-bold mb-4\">Local do Curso</h2>\n        <p class=\"flex items-center text-gray-700 mb-1\">\n          <i class=\"fa-solid fa-location-dot text-orange-500 mr-2\"></i>\n          <strong>Grupo Unis - Cidade Universitária</strong>\n        </p>\n        <p class=\"text-gray-600 mb-3\">\n          Avenida Alzira Barra Gazzola, 650<br>\n          Aeroporto, Varginha - MG, 37031-099\n        </p>\n        <a href=\"https://maps.app.goo.gl/zTanijYVQF98CgvK8\" target=\"_blank\" class=\"text-orange-500 font-semibold hover:underline\">\n          Ver no Google Maps\n        </a>\n      </div>\n      <div>\n        <img src=\"https://blog.unis.edu.br/hubfs/Imported_Blog_Media/tecnologia-cdu.png\" alt=\"Estudante usando laptop\" class=\"rounded-xl shadow-lg w-full\">\n      </div>\n    </div>\n  </section>\n\n  <!-- Nossos Parceiros -->\n  <section class=\"bg-gray-900 py-16\">\n    <div class=\"container mx-auto px-4 text-center mb-12\">\n      <h2 class=\"text-4xl font-bold text-white\">Nossos Parceiros</h2>\n    </div>\n    <div class=\"container mx-auto px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n      <!-- Partner 1 -->\n      <div class=\"bg-gray-800 rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-4 rounded-full mb-4\">\n          <i class=\"fa-solid fa-award text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"text-2xl font-semibold text-white mb-2\">Teesside University</h3>\n        <p class=\"text-gray-400 text-sm\">\n          Fundada em 1930, localizada em Middlesbrough, Reino Unido. Reconhecida por sua excelência acadêmica e colaboração com parceiros da indústria.\n        </p>\n      </div>\n      <!-- Partner 2 -->\n      <div class=\"bg-gray-800 rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-4 rounded-full mb-4\">\n          <i class=\"fa-solid fa-lightbulb text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"text-2xl font-semibold text-white mb-2\">Hyper Island</h3>\n        <p class=\"text-gray-400 text-sm\">\n          Fundada em 1996 na Suécia, é uma renomada escola de negócios criativos digitais conhecida por sua abordagem inovadora de aprendizado prático.\n        </p>\n      </div>\n      <!-- Partner 3 -->\n      <div class=\"bg-gray-800 rounded-xl shadow p-6 text-center\">\n        <div class=\"bg-orange-100 inline-block p-4 rounded-full mb-4\">\n          <i class=\"fa-solid fa-building text-orange-500 text-2xl\"></i>\n        </div>\n        <h3 class=\"text-2xl font-semibold text-white mb-2\">Grupo Unis</h3>\n        <p class=\"text-gray-400 text-sm\">\n          Localizado em Minas Gerais, oferece mais de 50 cursos e é conhecido por suas metodologias modernas de ensino e infraestrutura de ponta.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Contato / Garanta Sua Vaga -->\n  <section class=\"bg-orange-50 py-16\">\n    <div class=\"container mx-auto px-4 text-center mb-8\">\n      <h2 class=\"text-3xl font-bold mb-2\">Garanta Sua Vaga</h2>\n      <p class=\"text-gray-700\">Entre em contato conosco para mais informações ou para se inscrever no curso.</p>\n    </div>\n    <div class=\"container mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-8\">\n      <!-- Formulário -->\n      <form action=\"#\" method=\"POST\" class=\"bg-white rounded-xl shadow p-8 space-y-4\">\n        <div>\n          <label class=\"block text-gray-700 mb-1\">Nome Completo</label>\n          <input type=\"text\" name=\"nome\" class=\"w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-orange-500\" required=\"\">\n        </div>\n        <div>\n          <label class=\"block text-gray-700 mb-1\">E-mail</label>\n          <input type=\"email\" name=\"email\" class=\"w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-orange-500\" required=\"\">\n        </div>\n        <div>\n          <label class=\"block text-gray-700 mb-1\">Telefone</label>\n          <input type=\"tel\" name=\"telefone\" class=\"w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-orange-500\">\n        </div>\n        <div>\n          <label class=\"block text-gray-700 mb-1\">Empresa</label>\n          <input type=\"text\" name=\"empresa\" class=\"w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-orange-500\">\n        </div>\n        <div>\n          <label class=\"block text-gray-700 mb-1\">Mensagem</label>\n          <textarea name=\"mensagem\" rows=\"4\" class=\"w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-orange-500\"></textarea>\n        </div>\n        <button type=\"submit\" class=\"w-full bg-gradient-to-r from-orange-500 to-red-500 text-white py-3 rounded-full font-semibold\">\n          Enviar Mensagem\n        </button>\n      </form>\n      <!-- Informações de Contato e Destaques -->\n      <div class=\"space-y-6\">\n        <div class=\"bg-white rounded-xl shadow p-6\">\n          <h3 class=\"text-xl font-semibold mb-2\">Informações para Contato</h3>\n          <p class=\"flex items-center text-gray-700\"><i class=\"fa-solid fa-envelope text-orange-500 mr-2\"></i>Tim Lucas</p>\n          <p class=\"text-gray-600 ml-6\">Head, Hyper Island North America</p>\n          <p class=\"text-orange-500 ml-6 font-semibold\">tim.lucas@hyperisland.com</p>\n        </div>\n        <div class=\"bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-xl shadow p-6\">\n          <h3 class=\"text-xl font-semibold mb-2\">Por que escolher este curso?</h3>\n          <ul class=\"space-y-2 text-left\">\n            <li class=\"flex items-center\">\n<i class=\"fa-solid fa-star mr-2\"></i>Certificação acreditada no Reino Unido</li>\n            <li class=\"flex items-center\">\n<i class=\"fa-solid fa-star mr-2\"></i>Parceria com universidades renomadas</li>\n            <li class=\"flex items-center\">\n<i class=\"fa-solid fa-star mr-2\"></i>Metodologia prática e inovadora</li>\n            <li class=\"flex items-center\">\n<i class=\"fa-solid fa-star mr-2\"></i>Network com profissionais de todo o país</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>",
