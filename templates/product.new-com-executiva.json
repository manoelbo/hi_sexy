      "blocks": {
        "e1cdf001-ba57-4c64-8543-e5fe36210b92": {
          "type": "content",
          "settings": {
            "title": "<strong>O que devo esperar?</strong>",
            "text": "{{ product.metafields.my_fields.o_que_vou_aprender_.value }}",
