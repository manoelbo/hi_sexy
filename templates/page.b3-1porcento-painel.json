n>\n\n    <form novalidate=\"\" autocomplete=\"off\">\n      <label class=\"lbl\" for=\"f-txt\">Meu 1% é…</label>\n      <div class=\"field\">\n        <textarea id=\"f-txt\" name=\"texto\" rows=\"5\" enterkeyhint=\"send\" placeholder=\"Escreva aqui o seu compromisso\"></textarea>\n        <div class=\"meta\"><span class=\"count\" aria-live=\"polite\"></span></div>\n      </div>\n\n      <div class=\"name\">\n        <label class=\"lbl\" for=\"f-nome\">Seu nome <span style=\"opacity:.55\">· opcional</span></label>\n        <input id=\"f-nome\" name=\"nome\" type=\"text\" autocomplete=\"given-name\" enterkeyhint=\"send\" placeholder=\"Como quer aparecer no telão\">\n        <p class=\"hint\">Deixe em branco para enviar sem nome.</p>\n      </div>\n\n      <button class=\"send\" type=\"submit\" disabled>\n        <span class=\"lbl-send\">Enviar meu 1%</span>\n        <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"square\"><path d=\"M4 12h15M13 6l6 6-6 6\"></path></svg>\n        <span class=\"spin\" aria-hidden=\"true\"></span>\n      </button>\n      <p class=\"error\" role=\"alert\"></p>\n    </form>\n\n    <p class=\"note\">\n      <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2.5\" y=\"4\" width=\"19\" height=\"13\" rx=\"1\"></rect><path d=\"M8 21h8M12 17v4\"></path></svg>\n      <span>Sua resposta aparece no telão do evento assim que você enviar.</span>\n    </p>\n\n    <section class=\"done\" aria-live=\"polite\">\n      <div class=\"check\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"square\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"></path></svg></div>\n      <h2>Seu 1% já está <em>no telão.</em>\n</h2>\n      <p>Obrigado por assumir esse compromisso. Agora é colocar em prática, um pouco todos os dias.</p>\n      <div class=\"quote\">\n        <span class=\"br l\"></span>\n        <div class=\"body\">\n<p class=\"txt\"></p>\n<p class=\"who\"></p>\n</div>\n        <span class=\"br r\"></span>\n      </div>\n      <button class=\"again\" type=\"button\">\n        <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"square\"><path d=\"M12 5v14M5 12h14\"></path></svg>\n        Escrever outro compromisso\n      </button>\n    </section>\n\n    <span class=\"demo\" hidden=\"\">Modo demonstração</span>\n    <p class=\"foot\">B3 × Hyper Island · 2027</p>\n  </div>\n</div>\n</template>\n\n<script type=\"module\">\n/* =====================================================================\n   CONFIG — use exatamente os mesmos valores na página do painel\n   ===================================================================== */\nconst CONFIG = {\n  firebase: {\n    apiKey: \"AIzaSyB1srFRZ2TUChXA1Ma-S3Hdgjbwj6DJlUk\",\n    authDomain: \"b3-1porcento.firebaseapp.com\",\n    databaseURL: \"https://b3-1porcento-default-rtdb.firebaseio.com\",\n    projectId: \"b3-1porcento\",\n    appId: \"1:239134405278:web:f9c6761c07713ad8c3818f\"\n  },\n  eventId: \"b3-2027\",     // troque para reaproveitar em outro evento\n  maxChars: 180,          // limite de caracteres da resposta\n  maxName: 40\n};\n/* ===================================================================== */\n\n(() => {\n  const host = document.getElementById(\"b3pct-participante\");\n  const tpl = document.getElementById(\"b3pct-participante-tpl\");\n  if (!host || !tpl || host.shadowRoot) return;\n\n  document.title = \"1% | Compromisso Individual\";\n  if (!document.getElementById(\"b3pct-font\")) {\n    const l = document.createElement(\"link\");\n    l.id = \"b3pct-font\"; l.rel = \"stylesheet\";\n    l.href = \"https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap\";\n    document.head.appendChild(l);\n  }\n  // trava a rolagem da página do tema por trás da experiência\n  document.documentElement.style.overflow = \"hidden\";\n  document.body.style.overflow = \"hidden\";\n\n  const root = host.attachShadow({ mode: \"open\" });\n  root.appendChild(tpl.content.cloneNode(true));\n  const $ = (s) => root.querySelector(s);\n\n  const app = $(\".app\"), form = $(\"form\"), txt = $(\"#f-txt\"), nome = $(\"#f-nome\");\n  const btn = $(\".send\"), err = $(\".error\"), count = $(\".count\");\n  const DEMO = !CONFIG.firebase.apiKey || /^COLE/i.test(CONFIG.firebase.apiKey);\n  const BASE = `eventos/${CONFIG.eventId}`;\n\n  txt.maxLength = CONFIG.maxChars;\n  nome.maxLength = CONFIG.maxName;\n  if (DEMO) $(\".demo\").hidden = false;\n\n  /* ---------- armazenamento ---------- */\n  let sendFn;\n  if (DEMO) {\n    const KEY = `b3pct:${CONFIG.eventId}:respostas`;\n    sendFn = async (data) => {\n      await new Promise((r) => setTimeout(r, 450));\n      const all = JSON.parse(localStorage.getItem(KEY) || \"{}\");\n      const id = \"d\" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n      all[id] = { ...data, criadoEm: Date.now() };\n      localStorage.setItem(KEY, JSON.stringify(all));\n    };\n  } else {\n    const SDK = \"https://www.gstatic.com/firebasejs/10.14.1\";\n    const ready = Promise.all([import(`${SDK}/firebase-app.js`), import(`${SDK}/firebase-database.js`)])\n      .then(([a, d]) => {\n        const fb = a.initializeApp(CONFIG.firebase, \"b3pct-participante\");\n        const db = d.getDatabase(fb);\n        return { db, d };\n      });\n    sendFn = async (data) => {\n      const { db, d } = await ready;\n      const payload = { texto: data.texto, criadoEm: d.serverTimestamp() };\n      if (data.nome) payload.nome = data.nome;\n      await d.push(d.ref(db, `${BASE}/respostas`), payload);\n    };\n  }\n\n  /* ---------- UI ---------- */\n  const clean = (s) => s.replace(/\\s+/g, \" \").trim();\n  const update = () => {\n    const n = txt.value.length, left = CONFIG.maxChars - n;\n    count.textContent = `${n}/${CONFIG.maxChars}`;\n    count.classList.toggle(\"warn\", left <= 20);\n    btn.disabled = clean(txt.value).length < 3;\n    err.classList.remove(\"show\");\n  };\n  txt.addEventListener(\"input\", update);\n  update();\n\n  // Enter envia (Shift+Enter quebra linha no desktop)\n  const enterSend = (e) => {\n    if (e.key === \"Enter\" && !e.shiftKey && !e.isComposing) {\n      e.preventDefault();\n      if (!btn.disabled) form.requestSubmit ? form.requestSubmit() : btn.click();\n    }\n  };\n  txt.addEventListener(\"keydown\", enterSend);\n  nome.addEventListener(\"keydown\", enterSend);\n\n  let busy = false;\n  form.addEventListener(\"submit\", async (e) => {\n    e.preventDefault();\n    if (busy) return;\n    const texto = clean(txt.value).slice(0, CONFIG.maxChars);\n    const n = clean(nome.value).slice(0, CONFIG.maxName);\n    if (texto.length < 3) return;\n\n    busy = true; btn.disabled = true; btn.classList.add(\"loading\");\n    try {\n      await Promise.race([\n        sendFn({ texto, nome: n }),\n        new Promise((_, rej) => setTimeout(() => rej(new Error(\"timeout\")), 15000))\n      ]);\n      $(\".quote .txt\").textContent = texto;\n      $(\".quote .who\").textContent = n;\n      txt.blur(); nome.blur();\n      app.classList.add(\"sent\");\n      app.scrollTo({ top: 0, behavior: \"smooth\" });\n    } catch (ex) {\n      console.error(\"[1%]\", ex);\n      err.textContent = ex && ex.message === \"timeout\"\n        ? \"A conexão está lenta. Verifique sua internet e tente de novo.\"\n        : \"Não foi possível enviar agora. Tente novamente em alguns segundos.\";\n      err.classList.add(\"show\");\n      btn.disabled = false;\n    } finally {\n      busy = false; btn.classList.remove(\"loading\");\n    }\n  });\n\n  $(\".again\").addEventListener(\"click\", () => {\n    txt.value = \"\"; update();\n    app.classList.remove(\"sent\");\n    app.scrollTo({ top: 0 });\n    setTimeout(() => txt.focus(), 50);\n  });\n})();\n</script>",
