svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13\"></path></svg>\n      </button>\n    </nav>\n  </section>\n\n  <!-- FOCO -->\n  <section class=\"ovl spot\" aria-modal=\"true\" role=\"dialog\" aria-label=\"Resposta em destaque\">\n    <button class=\"nav prev\" data-do=\"prev\" aria-label=\"Anterior\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"square\"><path d=\"M15 5l-7 7 7 7\"></path></svg></button>\n    <div class=\"stage\">\n      <span class=\"br l\"></span>\n      <div class=\"body\">\n        <p class=\"eyebrow\">Meu 1% para 2027</p>\n        <p class=\"txt\"></p>\n        <p class=\"who\"></p>\n      </div>\n      <span class=\"br r\"></span>\n    </div>\n    <button class=\"nav next\" data-do=\"next\" aria-label=\"Próxima\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"square\"><path d=\"M9 5l7 7-7 7\"></path></svg></button>\n    <div class=\"bar\">\n      <span class=\"idx\"></span>\n      <div class=\"ctl\">\n        <button data-do=\"spotbig\"><svg viewbox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 3l2.6 5.8 6.4.6-4.8 4.3 1.4 6.3L12 16.8 6.4 20l1.4-6.3L3 9.4l6.4-.6z\"></path></svg><span>Destacar no mural</span></button>\n        <button class=\"danger\" data-do=\"spotdel\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13\"></path></svg><span>Excluir</span></button>\n        <button data-do=\"close\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"square\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg><span>Fechar</span></button>\n      </div>\n    </div>\n  </section>\n\n  <!-- QR -->\n  <section class=\"ovl qr\" role=\"dialog\" aria-label=\"QR code\">\n    <button class=\"x\" data-do=\"close\" aria-label=\"Fechar\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"square\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg></button>\n    <div class=\"panel\">\n      <img alt=\"QR code para responder\" hidden=\"\">\n      <div>\n        <h3>Qual é o seu 1% para fazer 2027 acontecer?</h3>\n        <p>Aponte a câmera do celular e responda.</p>\n        <p class=\"url\"></p>\n      </div>\n    </div>\n  </section>\n\n  <!-- CONFIRMAÇÃO -->\n  <section class=\"ovl conf\" role=\"dialog\" aria-label=\"Confirmar\">\n    <div class=\"panel\">\n      <h3>Reorganizar o mural?</h3>\n      <p>As posições definidas manualmente serão desfeitas e os cards voltam para a grade automática. Os destaques são mantidos.</p>\n      <div class=\"row\">\n<button class=\"cancel\" data-do=\"close\">Cancelar</button><button class=\"ok\" data-do=\"reorg-ok\">Reorganizar</button>\n</div>\n    </div>\n  </section>\n\n  <div class=\"toast\" role=\"status\">\n<span class=\"tmsg\"></span><button type=\"button\"></button>\n</div>\n</div>\n</template>\n\n<script type=\"module\">\n/* =====================================================================\n   CONFIG — mesmos valores da página do participante\n   ===================================================================== */\nconst CONFIG = {\n  firebase: {\n    apiKey: \"AIzaSyB1srFRZ2TUChXA1Ma-S3Hdgjbwj6DJlUk\",\n    authDomain: \"b3-1porcento.firebaseapp.com\",\n    databaseURL: \"https://b3-1porcento-default-rtdb.firebaseio.com\",\n    projectId: \"b3-1porcento\",\n    appId: \"1:239134405278:web:f9c6761c07713ad8c3818f\"\n  },\n  eventId: \"b3-2027\",\n  // link público da página do participante (usado no QR code do telão)\n  participantUrl: \"https://www.hyperisland.com.br/pages/b3-1porcento\",\n  // opcional: URL de uma imagem de QR code própria (ex.: subida em Arquivos do Shopify).\n  // Se ficar vazio, o QR é gerado automaticamente a partir do participantUrl.\n  qrImage: \"\"\n};\n/* ===================================================================== */\n\n(() => {\n  const host = document.getElementById(\"b3pct-painel\");\n  const tpl = document.getElementById(\"b3pct-painel-tpl\");\n  if (!host || !tpl || host.shadowRoot) return;\n\n  document.title = \"1% | Compromisso Individual\";\n  if (!document.getElementById(\"b3pct-font\")) {\n    const l = document.createElement(\"link\");\n    l.id = \"b3pct-font\"; l.rel = \"stylesheet\";\n    l.href = \"https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap\";\n    document.head.appendChild(l);\n  }\n  document.documentElement.style.overflow = \"hidden\";\n  document.body.style.overflow = \"hidden\";\n\n  const root = host.attachShadow({ mode: \"open\" });\n  root.appendChild(tpl.content.cloneNode(true));\n  const $ = (s, el = root) => el.querySelector(s);\n  const $$ = (s, el = root) => [...el.querySelectorAll(s)];\n\n  const app = $(\".app\"), board = $(\".board\"), world = $(\".world\"), sizer = $(\".sizer\");\n  const DEMO = !CONFIG.firebase.apiKey || /^COLE/i.test(CONFIG.firebase.apiKey);\n  const BASE = `eventos/${CONFIG.eventId}`;\n  const URL_OK = /^https?:\\/\\//i.test(CONFIG.participantUrl || \"\");\n\n  /* ------------------------------------------------------------------\n     ARMAZENAMENTO (Firebase ou demonstração local)\n     ------------------------------------------------------------------ */\n  function demoStore() {\n    const KR = `b3pct:${CONFIG.eventId}:respostas`, KL = `b3pct:${CONFIG.eventId}:layout`;\n    const read = (k) => { try { return JSON.parse(localStorage.getItem(k) || \"{}\"); } catch { return {}; } };\n    const subs = { r: [], l: [] };\n    const emit = () => { subs.r.forEach((f) => f(read(KR))); subs.l.forEach((f) => f(read(KL))); };\n    const write = (k, v) => { localStorage.setItem(k, JSON.stringify(v)); emit(); };\n    window.addEventListener(\"storage\", (e) => { if (e.key === KR || e.key === KL || e.key === null) emit(); });\n    return {\n      onAuth: (cb) => cb({ demo: true }),\n      login: async () => {}, logout: async () => {},\n      start(onR, onL, onConn) {\n        subs.r.push(onR); subs.l.push(onL); onR(read(KR)); onL(read(KL)); onConn(true);\n      },\n      async remove(id) { const r = read(KR), l = read(KL); delete r[id]; delete l[id]; localStorage.setItem(KL, JSON.stringify(l)); write(KR, r); },\n      async restore(id, data, lay) { const r = read(KR), l = read(KL); r[id] = data; if (lay) l[id] = lay; localStorage.setItem(KL, JSON.stringify(l)); write(KR, r); },\n      async setLayout(id, obj) { const l = read(KL); if (obj) l[id] = obj; else delete l[id]; write(KL, l); },\n      async replaceLayout(obj) { write(KL, obj || {}); },\n      add(data) { const r = read(KR); r[\"d\" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6)] = data; write(KR, r); },\n      wipe() { localStorage.removeItem(KR); localStorage.removeItem(KL); emit(); }\n    };\n  }\n\n  function firebaseStore() {\n    const SDK = \"https://www.gstatic.com/firebasejs/10.14.1\";\n    const ready = Promise.all([\n      import(`${SDK}/firebase-app.js`), import(`${SDK}/firebase-database.js`), import(`${SDK}/firebase-auth.js`)\n    ]).then(([a, d, au]) => {\n      const fb = a.initializeApp(CONFIG.firebase, \"b3pct-painel\");\n      return { d, au, db: d.getDatabase(fb), auth: au.getAuth(fb) };\n    });\n    const unsubs = [];\n    return {\n      onAuth: (cb) => ready.then(({ au, auth }) => au.onAuthStateChanged(auth, cb)),\n      login: (e, p) => ready.then(({ au, auth }) => au.signInWithEmailAndPassword(auth, e, p)),\n      logout: () => ready.then(({ au, auth }) => { unsubs.splice(0).forEach((u) => u()); return au.signOut(auth); }),\n      async start(onR, onL, onConn, onErr) {\n        const { d, db } = await ready;\n        unsubs.splice(0).forEach((u) => u());\n        unsubs.push(d.onValue(d.ref(db, `${BASE}/respostas`), (s) => onR(s.val() || {}), onErr));\n        unsubs.push(d.onValue(d.ref(db, `${BASE}/layout`), (s) => onL(s.val() || {}), onErr));\n        unsubs.push(d.onValue(d.ref(db, \".info/connected\"), (s) => onConn(!!s.val())));\n      },\n      async remove(id) { const { d, db } = await ready; return d.update(d.ref(db, BASE), { [`respostas/${id}`]: null, [`layout/${id}`]: null }); },\n      async restore(id, data, lay) { const { d, db } = await ready; return d.update(d.ref(db, BASE), { [`respostas/${id}`]: data, [`layout/${id}`]: lay || null }); },\n      async setLayout(id, obj) { const { d, db } = await ready; return d.set(d.ref(db, `${BASE}/layout/${id}`), obj || null); },\n      async replaceLayout(obj) { const { d, db } = await ready; return d.set(d.ref(db, `${BASE}/layout`), obj && Object.keys(obj).length ? obj : null); }\n    };\n  }\n\n  const store = DEMO ? demoStore() : firebaseStore();\n\n  /* ------------------------------------------------------------------\n     ESTADO\n     ------------------------------------------------------------------ */\n  const CW = 300, BIGW = 620, G = 22, PAD = 34, DOCK = 72, MAXS = 1.45;\n  let resp = new Map();     // id -> {id, texto, nome, criadoEm}\n  let lay = {};             // id -> {x, y, big}\n  let order = [];\n  let loaded = false;\n  let autoFit = true, scale = 1;\n  let zTop = 10;\n  let draggingEl = null;\n  const els = new Map();\n\n  const hash = (s) => { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return Math.abs(h); };\n\n  const ICON = {\n    exp: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"square\"><path d=\"M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7\"/></svg>',\n    big: '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 3l2.6 5.8 6.4.6-4.8 4.3 1.4 6.3L12 16.8 6.4 20l1.4-6.3L3 9.4l6.4-.6z\"/></svg>',\n    del: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"square\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13\"/></svg>'\n  };\n\n  function makeCard(r) {\n    const el = document.createElement(\"div\");\n    el.className = `card v${hash(r.id) % 4}`;\n    el.dataset.id = r.id;\n    el.tabIndex = 0;\n    el.innerHTML = `<div class=\"in\"><p class=\"txt\"></p><p class=\"who\"></p></div>\n      <div class=\"acts\">\n        <button type=\"button\" data-act=\"exp\" title=\"Expandir\">${ICON.exp}</button>\n        <button type=\"button\" data-act=\"big\" title=\"Destacar no mural\">${ICON.big}</button>\n        <button type=\"button\" data-act=\"del\" title=\"Excluir\">${ICON.del}</button>\n      </div>`;\n    $(\".txt\", el).textContent = r.texto;\n    $(\".who\", el).textContent = r.nome || \"\";\n    return el;\n  }\n\n  function setData(obj) {\n    const next = new Map();\n    for (const [id, v] of Object.entries(obj || {})) {\n      if (!v || typeof v.texto !== \"string\") continue;\n      next.set(id, { id, texto: v.texto, nome: v.nome || \"\", criadoEm: Number(v.criadoEm) || 0 });\n    }\n    const fresh = loaded ? [...next.keys()].filter((id) => !resp.has(id)) : [];\n    resp = next;\n    order = [...resp.values()].sort((a, b) => a.criadoEm - b.criadoEm || (a.id < b.id ? -1 : 1)).map((r) => r.id);\n    loaded = true;\n    render(fresh);\n  }\n\n  function render(fresh = []) {\n    // remover\n    for (const [id, el] of els) {\n      if (!resp.has(id)) {\n        els.delete(id);\n        el.classList.add(\"out\");\n        setTimeout(() => el.remove(), 360);\n      }\n    }\n    // adicionar / atualizar\n    for (const id of order) {\n      const r = resp.get(id);\n      let el = els.get(id);\n      if (!el) {\n        el = makeCard(r);\n        els.set(id, el);\n        world.appendChild(el);\n        if (fresh.includes(id)) {\n          el.classList.add(\"fresh\");\n          setTimeout(() => el.classList.add(\"settled\"), 60);\n          el.style.zIndex = ++zTop;\n        }\n      }\n      el.classList.toggle(\"big\", !!(lay[id] && lay[id].big));\n    }\n    const n = order.length;\n    $(\".stat .n\").textContent = n.toLocaleString(\"pt-BR\");\n    $(\".lbl-n\").textContent = n === 1 ? \"compromisso\" : \"compromissos\";\n    $(\".empty\").hidden = n > 0;\n    layout();\n    if (spotId) paintSpot();\n  }\n\n  /* ------------------------------------------------------------------\n     LAYOUT: masonry + posições manuais + ajuste automático à tela\n     ------------------------------------------------------------------ */\n  function masonry(items, cols) {\n    const colH = new Array(cols).fill(0);\n    const manual = items.filter((i) => i.manual);\n    const pos = new Map();\n    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n    const ext = (x, y, w, h) => { minX = Math.min(minX, x); minY = Math.min(minY, y); maxX = Math.max(maxX, x + w); maxY = Math.max(maxY, y + h); };\n    for (const m of manual) { pos.set(m.id, { x: m.x, y: m.y }); ext(m.x, m.y, m.w, m.h); }\n    for (const it of items) {\n      if (it.manual) continue;\n      const span = it.big && cols >= 2 ? 2 : 1;\n      let bc = 0, by = Infinity;\n      for (let c = 0; c <= cols - span; c++) {\n        let y = 0;\n        for (let k = 0; k < span; k++) y = Math.max(y, colH[c + k]);\n        if (y < by - 0.5) { by = y; bc = c; }\n      }\n      const x = bc * (CW + G);\n      let y = by, moved = true, guard = 0;\n      while (moved && guard++ < 80) {\n        moved = false;\n        for (const r of manual) {\n          if (x < r.x + r.w + G && x + it.w + G > r.x && y < r.y + r.h + G && y + it.h + G > r.y) { y = r.y + r.h + G; moved = true; }\n        }\n      }\n      for (let k = 0; k < span; k++) colH[bc + k] = y + it.h + G;\n      pos.set(it.id, { x, y });\n      ext(x, y, it.w, it.h);\n    }\n    if (minX === Infinity) { minX = minY = 0; maxX = maxY = 1; }\n    return { pos, minX, minY, maxX, maxY };\n  }\n\n  let layoutQueued = false;\n  function layout() {\n    if (layoutQueued) return;\n    layoutQueued = true;\n    requestAnimationFrame(() => { layoutQueued = false; doLayout(); });\n  }\n\n  function doLayout() {\n    if (app.querySelector(\".main\").hidden) return;\n    const items = [];\n    for (const id of order) {\n      const el = els.get(id); if (!el) continue;\n      const l = lay[id] || {};\n      items.push({ id, el, big: !!l.big, manual: typeof l.x === \"number\" && typeof l.y === \"number\", x: l.x, y: l.y });\n    }\n    // medir (larguras já definidas pela classe .big)\n    for (const it of items) { it.w = it.big ? BIGW : CW; it.h = it.el.offsetHeight; }\n\n    const availW = Math.max(200, board.clientWidth - PAD * 2);\n    const availH = Math.max(200, board.clientHeight - PAD * 2 - DOCK);\n    let m, ox, oy;\n\n    if (autoFit) {\n      const autoCount = items.filter((i) => !i.manual).length;\n      const maxCols = Math.max(1, Math.min(32, autoCount));\n      let best = null;\n      for (let c = 1; c <= maxCols; c++) {\n        const t = masonry(items, c);\n        const W = t.maxX - t.minX, H = t.maxY - t.minY;\n        const s = Math.min(availW / W, availH / H, MAXS);\n        if (!best || s > best.s + 1e-4) best = { s, t, W, H };\n      }\n      scale = best.s; m = best.t;\n      ox = PAD + (availW - best.W * scale) / 2 - m.minX * scale;\n      oy = PAD + Math.max(0, (availH - best.H * scale) / 2) - m.minY * scale;\n      board.classList.remove(\"scroll\");\n      sizer.style.width = sizer.style.height = \"1px\";\n    } else {\n      const cols = Math.max(1, Math.floor((availW / scale + G) / (CW + G)));\n      m = masonry(items, cols);\n      const W = m.maxX - m.minX, H = m.maxY - m.minY;\n      ox = PAD + Math.max(0, (availW - W * scale) / 2) - m.minX * scale;\n      oy = PAD - m.minY * scale;\n      board.classList.add(\"scroll\");\n      sizer.style.width = `${Math.ceil(W * scale + PAD * 2)}px`;\n      sizer.style.height = `${Math.ceil(H * scale + PAD * 2 + DOCK)}px`;\n    }\n\n    world.style.transform = `translate(${ox}px, ${oy}px) scale(${scale})`;\n    for (const it of items) {\n      if (it.el === draggingEl) continue;\n      const p = m.pos.get(it.id);\n      const firstTime = !it.el._pos;\n      if (firstTime) it.el.classList.add(\"place\");\n      it.el.style.transform = `translate(${p.x}px, ${p.y}px)`;\n      it.el._pos = p;\n      if (firstTime) requestAnimationFrame(() => requestAnimationFrame(() => it.el.classList.remove(\"place\")));\n    }\n    $(\".zoom\").textContent = `${Math.round(scale * 100)}%`;\n    $('[data-do=\"fit\"]').classList.toggle(\"on\", autoFit);\n  }\n\n  new ResizeObserver(() => layout()).observe(board);\n  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => layout());\n\n  /* ------------------------------------------------------------------\n     ARRASTAR\n     ------------------------------------------------------------------ */\n  let drag = null;\n  board.addEventListener(\"pointerdown\", (e) => {\n    const card = e.target.closest(\".card\");\n    if (!card || e.target.closest(\".acts\") || e.button !== 0 || card.classList.contains(\"out\")) return;\n    e.preventDefault();\n    card.focus({ preventScroll: true });\n    card.setPointerCapture(e.pointerId);\n    drag = { card, id: card.dataset.id, sx: e.clientX, sy: e.clientY, ox: card._pos.x, oy: card._pos.y, moved: false, pid: e.pointerId };\n  });\n  board.addEventListener(\"pointermove\", (e) => {\n    if (!drag || e.pointerId !== drag.pid) return;\n    const dx = (e.clientX - drag.sx) / scale, dy = (e.clientY - drag.sy) / scale;\n    if (!drag.moved && Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) < 5) return;\n    if (!drag.moved) {\n      drag.moved = true; draggingEl = drag.card;\n      drag.card.classList.add(\"dragging\");\n      drag.card.style.zIndex = ++zTop;\n    }\n    drag.nx = Math.round(drag.ox + dx); drag.ny = Math.round(drag.oy + dy);\n    drag.card.style.transform = `translate(${drag.nx}px, ${drag.ny}px)`;\n  });\n  const endDrag = (e) => {\n    if (!drag || (e && e.pointerId !== drag.pid)) return;\n    const d = drag; drag = null;\n    if (!d.moved) return;\n    d.card.classList.remove(\"dragging\");\n    draggingEl = null;\n    d.card._pos = { x: d.nx, y: d.ny };\n    const next = { ...(lay[d.id] || {}), x: d.nx, y: d.ny };\n    lay = { ...lay, [d.id]: next };\n    layout();\n    store.setLayout(d.id, next).catch(() => toast(\"Não foi possível salvar a posição.\"));\n  };\n  board.addEventListener(\"pointerup\", endDrag);\n  board.addEventListener(\"pointercancel\", endDrag);\n\n  board.addEventListener(\"dblclick\", (e) => {\n    const card = e.target.closest(\".card\");\n    if (card && !e.target.closest(\".acts\")) openSpot(card.dataset.id);\n  });\n  board.addEventListener(\"click\", (e) => {\n    const b = e.target.closest(\".acts button\"); if (!b) return;\n    const id = b.closest(\".card\").dataset.id;\n    if (b.dataset.act === \"exp\") openSpot(id);\n    if (b.dataset.act === \"big\") toggleBig(id);\n    if (b.dataset.act === \"del\") del(id);\n  });\n  board.addEventListener(\"wheel\", (e) => {\n    if (!(e.ctrlKey || e.metaKey)) return;\n    e.preventDefault();\n    zoom(e.deltaY < 0 ? 1.1 : 1 / 1.1);\n  }, { passive: false });\n\n  /* ------------------------------------------------------------------\n     AÇÕES\n     ------------------------------------------------------------------ */\n  function toggleBig(id) {\n    const cur = lay[id] || {};\n    const next = { ...cur };\n    if (cur.big) delete next.big; else next.big = true;\n    const val = Object.keys(next).length ? next : null;\n    lay = { ...lay }; if (val) lay[id] = val; else delete lay[id];\n    render();\n    store.setLayout(id, val).catch(() => toast(\"Não foi possível salvar o destaque.\"));\n  }\n\n  function del(id) {\n    const r = resp.get(id); if (!r) return;\n    const data = { texto: r.texto, criadoEm: r.criadoEm }; if (r.nome) data.nome = r.nome;\n    const l = lay[id] || null;\n    store.remove(id).catch(() => toast(\"Não foi possível excluir. Verifique a conexão.\"));\n    toast(\"Resposta excluída.\", \"Desfazer\", () => store.restore(id, data, l).catch(() => toast(\"Não foi possível restaurar.\")));\n  }\n\n  function zoom(f) {\n    autoFit = false;\n    scale = Math.min(2, Math.max(0.15, scale * f));\n    layout();\n  }\n\n  function exportCSV() {\n    if (!order.length) { toast(\"Ainda não há respostas para exportar.\"); return; }\n    const safe = (v) => {\n      v = String(v ?? \"\");\n      if (/^[=+\\-@\\t\\r]/.test(v)) v = \"'\" + v;            // evita fórmulas no Excel\n      return /[\";\\r\\n]/.test(v) ? `\"${v.replace(/\"/g, '\"\"')}\"` : v;\n    };\n    const rows = [[\"#\", \"Data\", \"Hora\", \"Nome\", \"Resposta\", \"Destaque\"]];\n    order.forEach((id, i) => {\n      const r = resp.get(id), d = new Date(r.criadoEm);\n      rows.push([i + 1, d.toLocaleDateString(\"pt-BR\"), d.toLocaleTimeString(\"pt-BR\"), r.nome, r.texto, lay[id] && lay[id].big ? \"sim\" : \"\"]);\n    });\n    const csv = \"﻿\" + rows.map((r) => r.map(safe).join(\";\")).join(\"\\r\\n\");\n    const blob = new Blob([csv], { type: \"text/csv;charset=utf-8\" });\n    const a = document.createElement(\"a\");\n    const t = new Date(), p = (n) => String(n).padStart(2, \"0\");\n    a.href = URL.createObjectURL(blob);\n    a.download = `b3-1porcento-respostas-${t.getFullYear()}-${p(t.getMonth() + 1)}-${p(t.getDate())}-${p(t.getHours())}${p(t.getMinutes())}.csv`;\n    root.appendChild(a); a.click(); a.remove();\n    setTimeout(() => URL.revokeObjectURL(a.href), 2000);\n    toast(`${order.length} respostas exportadas.`);\n  }\n\n  function toggleFS() {\n    if (document.fullscreenElement) document.exitFullscreen();\n    else (document.documentElement.requestFullscreen || document.documentElement.webkitRequestFullscreen || (() => {})).call(document.documentElement);\n  }\n  document.addEventListener(\"fullscreenchange\", () => { poke(); layout(); });\n\n  /* ------------------------------------------------------------------\n     OVERLAYS\n     ------------------------------------------------------------------ */\n  const ovl = { spot: $(\".spot\"), qr: $(\".qr\"), conf: $(\".conf\") };\n  const openOvl = (k) => ovl[k].classList.add(\"open\");\n  const closeAll = () => { Object.values(ovl).forEach((o) => o.classList.remove(\"open\")); spotId = null; };\n  const anyOpen = () => Object.values(ovl).some((o) => o.classList.contains(\"open\"));\n\n  let spotId = null;\n  function openSpot(id) { if (!resp.has(id)) return; spotId = id; paintSpot(); openOvl(\"spot\"); }\n  function paintSpot() {\n    if (!resp.has(spotId)) {\n      if (!order.length) { closeAll(); return; }\n      spotId = order[Math.min(order.length - 1, Math.max(0, spotIdxCache))];\n    }\n    const i = order.indexOf(spotId), r = resp.get(spotId);\n    spotIdxCache = i;\n    const t = $(\".spot .txt\");\n    t.textContent = r.texto;\n    t.className = \"txt\" + (r.texto.length > 130 ? \" s\" : r.texto.length > 70 ? \" m\" : \"\");\n    $(\".spot .who\").textContent = r.nome || \"\";\n    $(\".spot .idx\").textContent = `${String(i + 1).padStart(2, \"0\")} / ${String(order.length).padStart(2, \"0\")}`;\n    $('[data-do=\"spotbig\"]').classList.toggle(\"on\", !!(lay[spotId] && lay[spotId].big));\n  }\n  let spotIdxCache = 0;\n  const stepSpot = (d) => { if (!order.length) return; const i = order.indexOf(spotId); spotId = order[(i + d + order.length) % order.length]; paintSpot(); };\n\n  if (URL_OK) {\n    const src = CONFIG.qrImage || `https://api.qrserver.com/v1/create-qr-code/?size=600x600&margin=0&color=0a0349&bgcolor=ffffff&data=${encodeURIComponent(CONFIG.participantUrl)}`;\n    $$(\"img\").forEach((im) => {\n      // plano B: se a imagem do QR não carregar, o link fica em destaque\n      im.addEventListener(\"error\", () => {\n        im.hidden = true; $(\".empty .qrbox\").hidden = true;\n        $(\".qr .url\").style.fontSize = \"clamp(22px, 2.4vw, 44px)\";\n      }, { once: true });\n      im.src = src; im.hidden = false;\n    });\n    $(\".empty .qrbox\").hidden = false;\n    const short = CONFIG.participantUrl.replace(/^https?:\\/\\/(www\\.)?/i, \"\").replace(/\\/$/, \"\");\n    $(\".qr .url\").textContent = short;\n    $(\".empty .url\").textContent = short;\n  } else {\n    $(\".qr .url\").textContent = \"Configure participantUrl no código do painel para gerar o QR code.\";\n    $(\".qr .panel\").classList.add(\"missing\");\n  }\n\n  /* ------------------------------------------------------------------\n     TOAST\n     ------------------------------------------------------------------ */\n  let toastT;\n  function toast(msg, action = \"\", fn = null) {\n    const t = $(\".toast\"), b = $(\"button\", t);\n    $(\".tmsg\", t).textContent = msg;\n    b.textContent = action;\n    b.onclick = fn ? () => { fn(); t.classList.remove(\"show\"); } : null;\n    t.classList.add(\"show\");\n    clearTimeout(toastT);\n    toastT = setTimeout(() => t.classList.remove(\"show\"), action ? 7000 : 3200);\n  }\n\n  /* ------------------------------------------------------------------\n     BOTÕES, TECLADO E INATIVIDADE\n     ------------------------------------------------------------------ */\n  root.addEventListener(\"click\", (e) => {\n    const b = e.target.closest(\"[data-do]\"); if (!b) return;\n    const k = b.dataset.do;\n    if (k === \"fit\") { autoFit = !autoFit; layout(); }\n    if (k === \"zin\") zoom(1.15);\n    if (k === \"zout\") zoom(1 / 1.15);\n    if (k === \"reorg\") openOvl(\"conf\");\n    if (k === \"reorg-ok\") {\n      const next = {};\n      for (const [id, v] of Object.entries(lay)) if (v && v.big) next[id] = { big: true };\n      lay = next; closeAll(); render();\n      store.replaceLayout(next).catch(() => toast(\"Não foi possível reorganizar.\"));\n    }\n    if (k === \"qr\") openOvl(\"qr\");\n    if (k === \"csv\") exportCSV();\n    if (k === \"fs\") toggleFS();\n    if (k === \"logout\") store.logout();\n    if (k === \"close\") closeAll();\n    if (k === \"prev\") stepSpot(-1);\n    if (k === \"next\") stepSpot(1);\n    if (k === \"spotbig\" && spotId) { toggleBig(spotId); paintSpot(); }\n    if (k === \"spotdel\" && spotId) { const id = spotId; stepSpot(1); if (spotId === id) closeAll(); del(id); }\n    if (k === \"seed\") seed();\n    if (k === \"wipe\" && DEMO) { store.wipe(); toast(\"Respostas de demonstração apagadas.\"); }\n  });\n  // fechar overlay clicando no fundo\n  Object.values(ovl).forEach((o) => o.addEventListener(\"click\", (e) => { if (e.target === o) closeAll(); }));\n\n  document.addEventListener(\"keydown\", (e) => {\n    if ($(\".main\").hidden) return;\n    const a = root.activeElement;\n    if (a && (a.tagName === \"INPUT\" || a.tagName === \"TEXTAREA\")) return;\n    if (e.metaKey || e.ctrlKey || e.altKey) return;\n    const k = e.key;\n    if (k === \"Escape\") { closeAll(); return; }\n    if (ovl.spot.classList.contains(\"open\")) {\n      if (k === \"ArrowRight\") stepSpot(1);\n      if (k === \"ArrowLeft\") stepSpot(-1);\n      if (k === \"Delete\" || k === \"Backspace\") { e.preventDefault(); $('[data-do=\"spotdel\"]').click(); }\n      if (k === \"d\" || k === \"D\") $('[data-do=\"spotbig\"]').click();\n      return;\n    }\n    if (k === \"f\" || k === \"F\") toggleFS();\n    if (k === \"q\" || k === \"Q\") ovl.qr.classList.contains(\"open\") ? closeAll() : openOvl(\"qr\");\n    if (k === \"a\" || k === \"A\") { autoFit = !autoFit; layout(); }\n    if (k === \"h\" || k === \"H\") app.classList.toggle(\"nodock\");\n    if (k === \"+\" || k === \"=\") zoom(1.15);\n    if (k === \"-\" || k === \"_\") zoom(1 / 1.15);\n    if ((k === \"Enter\" || k === \" \") && a && a.classList && a.classList.contains(\"card\")) { e.preventDefault(); openSpot(a.dataset.id); }\n    if ((k === \"Delete\" || k === \"Backspace\") && a && a.classList && a.classList.contains(\"card\")) { e.preventDefault(); del(a.dataset.id); }\n  });\n\n  let idleT;\n  function poke() {\n    app.classList.remove(\"idle\");\n    clearTimeout(idleT);\n    if (document.fullscreenElement) idleT = setTimeout(() => { if (!drag) app.classList.add(\"idle\"); }, 2800);\n  }\n  [\"pointermove\", \"pointerdown\", \"keydown\", \"wheel\"].forEach((ev) => document.addEventListener(ev, poke, { passive: true }));\n\n  /* ------------------------------------------------------------------\n     MODO DEMONSTRAÇÃO\n     ------------------------------------------------------------------ */\n  const SAMPLES = [\n    \"Vou reservar 30 minutos toda sexta para aprender algo novo sobre IA.\",\n    \"Dar feedback na hora, sem esperar a avaliação semestral.\",\n    \"Começar toda reunião do meu time pelo problema do cliente.\",\n    \"Simplificar um processo da minha área por mês.\",\n    \"Ouvir mais antes de propor soluções.\",\n    \"Compartilhar o que aprendo com uma pessoa de outra área toda semana.\",\n    \"Testar uma ideia pequena antes de pedir o projeto grande.\",\n    \"Proteger duas manhãs por semana para trabalho focado, sem reuniões.\",\n    \"Perguntar nas minhas 1:1 o que eu posso tirar do caminho de cada pessoa.\",\n    \"Errar mais rápido e contar para o time o que aprendi.\",\n    \"Chegar nas reuniões com uma decisão proposta, não só com o problema.\",\n    \"Conversar com um cliente por mês para entender o dia a dia dele.\",\n    \"Cuidar da minha energia: dormir melhor para decidir melhor.\",\n    \"Trocar o \\\"não dá\\\" por \\\"como poderia dar?\\\"\",\n    \"Documentar decisões para o time não depender de mim.\",\n    \"Mentorar alguém em início de carreira ao longo de 2027.\",\n    \"Automatizar uma tarefa repetitiva por trimestre.\",\n    \"Reconhecer em público uma conquista do time toda semana.\",\n    \"Dizer não para o que não está nas prioridades de 2027.\",\n    \"Levar dados, e não só opinião, para as discussões importantes.\",\n    \"Convidar alguém de outra diretoria para os nossos rituais.\",\n    \"Fazer uma retrospectiva honesta ao fim de cada projeto e aplicar pelo menos um aprendizado no próximo, mesmo que seja pequeno.\",\n    \"Explicar o porquê, não só o quê.\",\n    \"Encerrar o dia com 5 minutos planejando o dia seguinte.\"\n  ];\n  const NAMES = [\"Ana\", \"Bruno\", \"Carla\", \"Diego\", \"Fernanda\", \"\", \"Gustavo\", \"Helena\", \"\", \"Juliana\", \"Leonardo\", \"Mariana\", \"Pedro\", \"\", \"Rafaela\", \"Thiago\"];\n  let seeding = false;\n  function seed() {\n    if (seeding) return; seeding = true;\n    let i = 0;\n    const tick = () => {\n      const t = SAMPLES[Math.floor(Math.random() * SAMPLES.length)];\n      const n = NAMES[Math.floor(Math.random() * NAMES.length)];\n      const d = { texto: t, criadoEm: Date.now() }; if (n) d.nome = n;\n      store.add(d);\n      if (++i < 12) setTimeout(tick, 550); else seeding = false;\n    };\n    tick();\n  }\n\n  /* ------------------------------------------------------------------\n     AUTENTICAÇÃO E INÍCIO\n     ------------------------------------------------------------------ */\n  const loginEl = $(\".login\"), mainEl = $(\".main\"), msg = $(\".login .msg\");\n  if (DEMO) $$(\".demo-only\").forEach((x) => (x.hidden = false));\n  if (DEMO) $('[data-do=\"logout\"]').hidden = true;\n\n  const AUTH_MSG = {\n    \"auth/invalid-credential\": \"E-mail ou senha incorretos.\",\n    \"auth/wrong-password\": \"E-mail ou senha incorretos.\",\n    \"auth/user-not-found\": \"E-mail ou senha incorretos.\",\n    \"auth/invalid-email\": \"Digite um e-mail válido.\",\n    \"auth/too-many-requests\": \"Muitas tentativas. Aguarde alguns minutos.\",\n    \"auth/network-request-failed\": \"Sem conexão com a internet.\"\n  };\n\n  $(\".login form\").addEventListener(\"submit\", async (e) => {\n    e.preventDefault();\n    const b = $(\".login .go\");\n    b.disabled = true; msg.textContent = \"\";\n    try { await store.login($(\"#l-email\").value.trim(), $(\"#l-pass\").value); }\n    catch (ex) { msg.textContent = AUTH_MSG[ex.code] || \"Não foi possível entrar. Tente novamente.\"; }\n    finally { b.disabled = false; }\n  });\n\n  const authReady = store.onAuth((user) => {\n    if (!user) {\n      mainEl.hidden = true; loginEl.hidden = false;\n      resp = new Map(); lay = {}; order = []; loaded = false;\n      els.forEach((el) => el.remove()); els.clear();\n      return;\n    }\n    loginEl.hidden = true; mainEl.hidden = false;\n    store.start(\n      (obj) => setData(obj),\n      (obj) => { lay = obj || {}; render(); },\n      (on) => { $(\".live\").classList.toggle(\"off\", !on); },\n      (err) => {\n        console.error(\"[1% painel]\", err);\n        store.logout();\n        msg.textContent = \"Este usuário não tem permissão para ver as respostas. Confira o UID nas regras do Firebase.\";\n      }\n    );\n    layout();\n  });\n  if (authReady && authReady.catch) authReady.catch((ex) => {\n    console.error(\"[1% painel]\", ex);\n    mainEl.hidden = true; loginEl.hidden = false;\n    msg.textContent = \"Não foi possível conectar ao Firebase. Confira o bloco CONFIG e a conexão com a internet.\";\n  });\n})();\n</script>",
