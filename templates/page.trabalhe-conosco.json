      "settings": {
        "html": "<!--\n  HYPER ISLAND · TRABALHE CONOSCO\n  ───────────────────────────────\n  Bloco para colar em uma seção de HTML personalizado do Shopify.\n  • Sem menu e sem footer.\n  • Sem fonte própria: todos os títulos são <h1>/<h2>/<h3> sem font-family nem peso definidos,\n    então recebem a fonte de títulos do tema. Textos e rótulos herdam a fonte de corpo do tema.\n  • Todo o CSS está escopado em #hi-jobs — não altera o resto do tema.\n  • Links diretos para cada vaga: /pages/SUA-PAGINA#social-media  e  /pages/SUA-PAGINA#estagio\n-->\n\n<style>\n#hi-jobs {\n  --hij-bg: #F3F0ED;\n  --hij-bg-2: #E8E4DC;\n  --hij-ink: #111111;\n  --hij-muted: #5F5E5A;\n  --hij-line: #D3D1C7;\n  --hij-orange: #FF7300;\n  --hij-cream: #F3F0ED;\n  --hij-ink-muted: #B4B2A9;\n  --hij-body: var(--font-body-family, inherit);\n  --hij-ease: cubic-bezier(0.2, 0.8, 0.2, 1);\n  --hij-offset: 96px; /* espaço para o header fixo do tema ao rolar até uma âncora */\n\n  background: var(--hij-bg);\n  color: var(--hij-ink);\n  font-family: var(--hij-body);\n  line-height: 1.6;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n#hi-jobs *, #hi-jobs *::before, #hi-jobs *::after { box-sizing: border-box; }\n#hi-jobs h1, #hi-jobs h2, #hi-jobs h3, #hi-jobs p, #hi-jobs ul, #hi-jobs dl, #hi-jobs dd { margin: 0; padding: 0; }\n#hi-jobs a { color: inherit; }\n#hi-jobs button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }\n#hi-jobs svg { display: block; }\n#hi-jobs :focus-visible { outline: 3px solid var(--hij-orange); outline-offset: 3px; }\n\n#hi-jobs .hij-wrap {\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: clamp(56px, 9vw, 128px) clamp(20px, 5vw, 64px) clamp(64px, 9vw, 128px);\n}\n\n/* ───────── Rótulos ───────── */\n#hi-jobs .hij-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.65rem;\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n}\n#hi-jobs .hij-eyebrow::before {\n  content: \"\";\n  width: 9px;\n  height: 9px;\n  background: var(--hij-orange);\n  flex-shrink: 0;\n}\n#hi-jobs .hij-status::before { border-radius: 50%; animation: hij-pulse 2.2s ease-out infinite; }\n@keyframes hij-pulse {\n  0% { box-shadow: 0 0 0 0 rgba(255, 115, 0, 0.55); }\n  70% { box-shadow: 0 0 0 10px rgba(255, 115, 0, 0); }\n  100% { box-shadow: 0 0 0 0 rgba(255, 115, 0, 0); }\n}\n\n/* ───────── Tela 1 · Escolha da vaga ───────── */\n#hi-jobs .hij-title {\n  font-size: clamp(3.25rem, 11vw, 9rem);\n  line-height: 0.88;\n  letter-spacing: -0.01em;\n  text-transform: uppercase;\n  margin: 0.32em 0 0.3em;\n  max-width: 11ch;\n}\n#hi-jobs .hij-lede {\n  font-size: clamp(1.05rem, 1.6vw, 1.3rem);\n  color: var(--hij-muted);\n  max-width: 34ch;\n}\n\n#hi-jobs .hij-list {\n  list-style: none;\n  margin-top: clamp(44px, 7vw, 88px);\n  border-top: 2px solid var(--hij-ink);\n}\n#hi-jobs .hij-card {\n  position: relative;\n  isolation: isolate;\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  align-items: center;\n  gap: clamp(16px, 3vw, 40px);\n  padding: clamp(26px, 3.6vw, 44px) clamp(6px, 1.5vw, 24px);\n  border-bottom: 2px solid var(--hij-ink);\n  text-decoration: none;\n  transition: color 0.35s var(--hij-ease);\n}\n#hi-jobs .hij-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  background: var(--hij-ink);\n  transform: scaleY(0);\n  transform-origin: bottom;\n  transition: transform 0.45s var(--hij-ease);\n}\n#hi-jobs .hij-card-num {\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: var(--hij-muted);\n  align-self: start;\n  padding-top: 0.5em;\n  transition: color 0.35s var(--hij-ease);\n}\n#hi-jobs .hij-card-title {\n  display: block;\n  font-size: clamp(1.7rem, 4.4vw, 3.5rem);\n  line-height: 0.95;\n  text-transform: uppercase;\n}\n#hi-jobs .hij-card-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem 1.2rem;\n  margin-top: 0.85rem;\n  font-size: 0.78rem;\n  font-weight: 600;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--hij-muted);\n  transition: color 0.35s var(--hij-ease);\n}\n#hi-jobs .hij-card-cta {\n  width: clamp(52px, 6vw, 76px);\n  height: clamp(52px, 6vw, 76px);\n  border-radius: 50%;\n  border: 2px solid currentColor;\n  display: grid;\n  place-items: center;\n  transition: background 0.35s var(--hij-ease), border-color 0.35s var(--hij-ease), color 0.35s var(--hij-ease);\n}\n#hi-jobs .hij-card-cta svg { width: 42%; height: 42%; transition: transform 0.35s var(--hij-ease); }\n\n@media (hover: hover) {\n  #hi-jobs .hij-card:hover { color: var(--hij-cream); }\n  #hi-jobs .hij-card:hover::before { transform: scaleY(1); }\n  #hi-jobs .hij-card:hover .hij-card-num { color: var(--hij-orange); }\n  #hi-jobs .hij-card:hover .hij-card-meta { color: var(--hij-ink-muted); }\n  #hi-jobs .hij-card:hover .hij-card-cta { background: var(--hij-orange); border-color: var(--hij-orange); color: var(--hij-ink); }\n  #hi-jobs .hij-card:hover .hij-card-cta svg { transform: translateX(4px); }\n}\n#hi-jobs .hij-card:focus-visible { outline-offset: -3px; }\n#hi-jobs .hij-card:active .hij-card-cta { transform: scale(0.94); }\n\n#hi-jobs .hij-hint {\n  margin-top: 1.25rem;\n  font-size: 0.85rem;\n  color: var(--hij-muted);\n}\n\n/* ───────── Tela 2 · Detalhe da vaga ───────── */\n#hi-jobs .hij-panel { scroll-margin-top: var(--hij-offset); }\n#hi-jobs .hij-panel + .hij-panel { margin-top: 96px; } /* só aparece sem JavaScript */\n\n#hi-jobs .hij-topbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--hij-line);\n}\n#hi-jobs .hij-back {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.6rem;\n  min-height: 44px;\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  text-decoration: none;\n}\n#hi-jobs .hij-back svg { width: 18px; height: 18px; transition: transform 0.3s var(--hij-ease); }\n#hi-jobs .hij-back:hover svg { transform: translateX(-4px); }\n\n#hi-jobs .hij-switch {\n  display: inline-flex;\n  padding: 4px;\n  border: 1.5px solid var(--hij-ink);\n  border-radius: 999px;\n  gap: 2px;\n}\n#hi-jobs .hij-switch a {\n  display: inline-flex;\n  align-items: center;\n  min-height: 40px;\n  padding: 0 1.1rem;\n  border-radius: 999px;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  text-decoration: none;\n  white-space: nowrap;\n  transition: background 0.25s var(--hij-ease), color 0.25s var(--hij-ease);\n}\n#hi-jobs .hij-switch a[aria-current=\"page\"] { background: var(--hij-ink); color: var(--hij-cream); }\n#hi-jobs .hij-switch a:not([aria-current=\"page\"]):hover { background: var(--hij-bg-2); }\n\n#hi-jobs .hij-head { padding: clamp(40px, 6vw, 72px) 0 0; }\n#hi-jobs .hij-h2 {\n  font-size: clamp(2.6rem, 7.5vw, 6.25rem);\n  line-height: 0.9;\n  text-transform: uppercase;\n  margin: 0.35em 0 0;\n  max-width: 14ch;\n}\n#hi-jobs .hij-h2:focus { outline: none; }\n\n#hi-jobs .hij-facts {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  margin-top: clamp(32px, 5vw, 56px);\n  border-top: 2px solid var(--hij-ink);\n  border-bottom: 2px solid var(--hij-ink);\n}\n#hi-jobs .hij-fact { padding: 20px 20px 20px 0; }\n#hi-jobs .hij-fact + .hij-fact { padding-left: 20px; border-left: 1px solid var(--hij-line); }\n#hi-jobs .hij-fact dt {\n  font-size: 0.7rem;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--hij-muted);\n  margin-bottom: 0.35rem;\n}\n#hi-jobs .hij-fact dd {\n  font-size: clamp(1.15rem, 1.8vw, 1.5rem);\n  font-weight: var(--hij-head-weight, 700);\n  line-height: 1.1;\n  text-transform: uppercase;\n}\n\n#hi-jobs .hij-body {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 360px;\n  gap: clamp(40px, 6vw, 88px);\n  align-items: start;\n  margin-top: clamp(24px, 4vw, 48px);\n}\n\n#hi-jobs .hij-block {\n  padding: clamp(28px, 3.5vw, 40px) 0;\n  border-top: 1px solid var(--hij-line);\n}\n#hi-jobs .hij-block:first-child { border-top: 0; padding-top: 8px; }\n#hi-jobs .hij-block h3 { margin-bottom: 1.1rem; }\n#hi-jobs .hij-block p { font-size: 1.02rem; color: #2C2C2A; max-width: 62ch; }\n#hi-jobs .hij-block p + p { margin-top: 0.9rem; }\n#hi-jobs .hij-lead { font-size: clamp(1.1rem, 1.6vw, 1.3rem) !important; line-height: 1.55; color: var(--hij-ink) !important; }\n\n#hi-jobs .hij-bullets { list-style: none; display: grid; gap: 0.7rem; max-width: 62ch; }\n#hi-jobs .hij-bullets li {\n  position: relative;\n  padding-left: 1.5rem;\n  font-size: 1rem;\n  color: #2C2C2A;\n}\n#hi-jobs .hij-bullets li::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0.62em;\n  width: 7px;\n  height: 7px;\n  background: var(--hij-orange);\n}\n#hi-jobs .hij-bullets strong { color: var(--hij-ink); }\n\n/* Card lateral */\n#hi-jobs .hij-aside {\n  position: sticky;\n  top: calc(var(--hij-offset) - 24px);\n  background: var(--hij-ink);\n  color: var(--hij-cream);\n  padding: 32px;\n  border-radius: 6px;\n}\n#hi-jobs .hij-aside .hij-aside-title {\n  color: var(--hij-cream);\n  font-size: clamp(1.6rem, 2.4vw, 2.1rem);\n  line-height: 0.95;\n  text-transform: uppercase;\n  margin: 0.8rem 0 0.9rem;\n}\n#hi-jobs .hij-aside p { font-size: 0.92rem; color: var(--hij-ink-muted); }\n#hi-jobs .hij-aside .hij-eyebrow { color: var(--hij-cream); }\n#hi-jobs .hij-actions { display: grid; gap: 10px; margin-top: 24px; }\n#hi-jobs .hij-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.6rem;\n  min-height: 52px;\n  padding: 0 1.4rem;\n  border-radius: 999px;\n  font-size: 0.82rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  text-decoration: none;\n  text-align: center;\n  transition: background 0.25s var(--hij-ease), color 0.25s var(--hij-ease), border-color 0.25s var(--hij-ease), transform 0.2s var(--hij-ease);\n}\n#hi-jobs .hij-btn svg { width: 18px; height: 18px; flex-shrink: 0; }\n#hi-jobs .hij-btn:active { transform: scale(0.98); }\n#hi-jobs .hij-btn-primary { background: var(--hij-orange); color: var(--hij-ink); }\n#hi-jobs .hij-btn-primary:hover { background: #FF8C2E; }\n#hi-jobs .hij-btn-ghost { border: 1.5px solid rgba(243, 240, 237, 0.35); color: var(--hij-cream); }\n#hi-jobs .hij-btn-ghost:hover { border-color: var(--hij-cream); }\n#hi-jobs .hij-about {\n  margin-top: 28px;\n  padding-top: 22px;\n  border-top: 1px solid rgba(243, 240, 237, 0.14);\n}\n#hi-jobs .hij-about h4 {\n  margin: 0 0 0.5rem;\n  font-size: 0.7rem;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--hij-cream);\n}\n#hi-jobs .hij-about p { font-size: 0.85rem; line-height: 1.6; }\n\n/* Inscrição */\n#hi-jobs .hij-apply {\n  scroll-margin-top: var(--hij-offset);\n  margin-top: clamp(48px, 7vw, 96px);\n  padding-top: clamp(40px, 5vw, 64px);\n  border-top: 2px solid var(--hij-ink);\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: clamp(28px, 4vw, 48px);\n}\n#hi-jobs .hij-apply-copy {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 20px 40px;\n}\n#hi-jobs .hij-apply-title {\n  max-width: 12ch;\n  font-size: clamp(2.2rem, 5vw, 4.2rem);\n  line-height: 0.9;\n  text-transform: uppercase;\n  margin: 0.4em 0 0;\n}\n#hi-jobs .hij-apply-copy p { color: var(--hij-muted); max-width: 40ch; }\n#hi-jobs .hij-apply-copy a { font-weight: 700; text-underline-offset: 3px; }\n#hi-jobs .hij-apply-side { display: grid; gap: 14px; justify-items: start; max-width: 40ch; }\n#hi-jobs .hij-deadline {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.55rem;\n  min-height: 40px;\n  padding: 0 1rem;\n  border: 1.5px solid currentColor;\n  border-radius: 999px;\n  font-family: var(--hij-body);\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n#hi-jobs .hij-deadline svg { width: 16px; height: 16px; flex-shrink: 0; }\n\n#hi-jobs .hij-form {\n  position: relative;\n  background: #FFFFFF;\n  border-radius: 8px;\n  min-height: 620px;\n  overflow: hidden;\n  box-shadow: 0 1px 0 rgba(17, 17, 17, 0.04), 0 18px 48px -24px rgba(17, 17, 17, 0.18);\n}\n#hi-jobs .hij-form [data-tf-live], #hi-jobs .hij-form iframe { width: 100%; }\n#hi-jobs .hij-form-loading {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  align-content: center;\n  justify-items: center;\n  gap: 14px;\n  padding: 24px;\n  text-align: center;\n  font-size: 0.85rem;\n  color: var(--hij-muted);\n  pointer-events: none;\n  transition: opacity 0.3s var(--hij-ease);\n}\n#hi-jobs .hij-spinner {\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  border: 3px solid var(--hij-line);\n  border-top-color: var(--hij-orange);\n  animation: hij-spin 0.9s linear infinite;\n}\n@keyframes hij-spin { to { transform: rotate(360deg); } }\n#hi-jobs .hij-form.is-loaded .hij-form-loading { opacity: 0; }\n#hi-jobs .hij-form.is-slow .hij-form-loading { pointer-events: auto; }\n\n/* Barra fixa de inscrição (mobile) */\n#hi-jobs .hij-bar {\n  position: fixed;\n  left: 12px;\n  right: 12px;\n  bottom: calc(12px + env(safe-area-inset-bottom, 0px));\n  z-index: 40;\n  display: none;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 10px 10px 20px;\n  background: var(--hij-ink);\n  color: var(--hij-cream);\n  border-radius: 999px;\n  box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.5);\n  transform: translateY(140%);\n  transition: transform 0.4s var(--hij-ease);\n}\n#hi-jobs .hij-bar-label {\n  min-width: 0;\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n#hi-jobs .hij-bar .hij-btn { min-height: 44px; padding: 0 1.1rem; flex-shrink: 0; }\n#hi-jobs .hij-bar.is-visible { transform: translateY(0); }\n\n/* ───────── Estados controlados por JavaScript ───────── */\n#hi-jobs.is-js .hij-panel:not(.is-active) { display: none; }\n#hi-jobs.is-js:not(.is-detail) .hij-detail { display: none; }\n#hi-jobs.is-js.is-detail .hij-home { display: none; }\n#hi-jobs:not(.is-js) .hij-switch, #hi-jobs:not(.is-js) .hij-back { display: none; }\n\n#hi-jobs .hij-panel.is-active .hij-rise {\n  animation: hij-rise 0.7s var(--hij-ease) both;\n  animation-delay: calc(var(--i, 0) * 70ms);\n}\n@keyframes hij-rise {\n  from { opacity: 0; transform: translateY(22px); }\n  to { opacity: 1; transform: none; }\n}\n::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.35s; }\n\n/* ───────── Responsivo ───────── */\n@media (max-width: 960px) {\n  #hi-jobs .hij-body { grid-template-columns: 1fr; }\n  #hi-jobs .hij-aside { position: static; }\n  #hi-jobs .hij-bar { display: flex; }\n}\n@media (max-width: 600px) {\n  #hi-jobs .hij-card { grid-template-columns: 1fr auto; }\n  #hi-jobs .hij-card-num { grid-column: 1 / -1; padding-top: 0; }\n  #hi-jobs .hij-topbar { flex-direction: column; align-items: stretch; }\n  #hi-jobs .hij-switch { width: 100%; }\n  #hi-jobs .hij-switch a { flex: 1; justify-content: center; padding: 0 0.6rem; }\n  #hi-jobs .hij-facts { grid-template-columns: 1fr 1fr; }\n  #hi-jobs .hij-fact, #hi-jobs .hij-fact + .hij-fact { padding: 16px 12px 16px 0; border-left: 0; }\n  #hi-jobs .hij-fact:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--hij-line); }\n  #hi-jobs .hij-fact:nth-child(n+3) { border-top: 1px solid var(--hij-line); }\n  #hi-jobs .hij-aside { padding: 26px 22px; }\n  #hi-jobs .hij-form { min-height: 560px; border-radius: 6px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  #hi-jobs *, #hi-jobs *::before, #hi-jobs *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n</style>\n\n<div id=\"hi-jobs\">\n  <div class=\"hij-wrap\">\n\n    <!-- ═════════════ TELA 1 · ESCOLHA DA VAGA ═════════════ -->\n    <section class=\"hij-home\" aria-labelledby=\"hij-title\">\n      <span class=\"hij-eyebrow hij-status\">2 vagas abertas · Inscrições até 29/11</span>\n      <h1 class=\"hij-title\" id=\"hij-title\">Temos vagas na ilha!</h1>\n      <p class=\"hij-lede\">Para quem quer criar, testar e aprender com a gente. Escolha a vaga para ver os detalhes e se inscrever.</p>\n\n      <ul class=\"hij-list\">\n        <li>\n          <a class=\"hij-card\" href=\"#social-media\" data-hij-open=\"social-media\">\n            <span class=\"hij-card-num\">01</span>\n            <div>\n              <h2 class=\"hij-card-title\">Social Media Content Creator</h2>\n              <span class=\"hij-card-meta\"><span>Remoto</span><span>PJ</span><span>Hyper Island Americas</span></span>\n            </div>\n            <span class=\"hij-card-cta\" aria-hidden=\"true\">\n              <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M4 12h15M13 6l6 6-6 6\"></path></svg>\n            </span>\n          </a>\n        </li>\n        <li>\n          <a class=\"hij-card\" href=\"#estagio\" data-hij-open=\"estagio\">\n            <span class=\"hij-card-num\">02</span>\n            <div>\n              <h2 class=\"hij-card-title\">Estágio de Marketing</h2>\n              <span class=\"hij-card-meta\"><span>Remoto no Brasil</span><span>Estágio</span><span>Hyper Island Americas</span></span>\n            </div>\n            <span class=\"hij-card-cta\" aria-hidden=\"true\">\n              <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M4 12h15M13 6l6 6-6 6\"></path></svg>\n            </span>\n          </a>\n        </li>\n      </ul>\n      <p class=\"hij-hint\"><strong>Inscrições até 29 de novembro.</strong> Todo o processo é online. Você se inscreve aqui mesmo, sem sair da página.</p>\n    </section>\n\n    <!-- ═════════════ TELA 2 · DETALHE DAS VAGAS ═════════════ -->\n    <div class=\"hij-detail\">\n\n      <!-- ─────────── VAGA 01 · SOCIAL MEDIA ─────────── -->\n      <article class=\"hij-panel\" id=\"social-media\" data-title=\"Social Media Content Creator\" aria-labelledby=\"hij-h-sm\">\n        <div class=\"hij-topbar\">\n          <a class=\"hij-back\" href=\"#\" data-hij-back=\"\">\n            <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M20 12H5M11 6l-6 6 6 6\"></path></svg>\n            Todas as vagas\n          </a>\n          <nav class=\"hij-switch\" aria-label=\"Trocar de vaga\">\n            <a href=\"#social-media\" data-hij-open=\"social-media\" aria-current=\"page\">Vaga 1</a>\n            <a href=\"#estagio\" data-hij-open=\"estagio\">Vaga 2</a>\n          </nav>\n        </div>\n\n        <header class=\"hij-head\">\n          <span class=\"hij-eyebrow hij-rise\" style=\"--i:0\">Vaga 01 · Marketing</span>\n          <h2 class=\"hij-h2 hij-rise\" id=\"hij-h-sm\" tabindex=\"-1\" style=\"--i:1\">Social Media Content Creator</h2>\n          <dl class=\"hij-facts hij-rise\" style=\"--i:2\">\n            <div class=\"hij-fact\">\n<dt>Localização</dt>\n<dd>Remoto</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Contrato</dt>\n<dd>PJ</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Remuneração</dt>\n<dd>R$ 6.500</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Horário</dt>\n<dd>Flexível</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Inscrições até</dt>\n<dd>29/11</dd>\n</div>\n          </dl>\n        </header>\n\n        <div class=\"hij-body\">\n          <div class=\"hij-content hij-rise\" style=\"--i:3\">\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Sobre a vaga</h3>\n              <p class=\"hij-lead\">Estamos em busca de um Social Media estratégico e criativo para integrar nosso time de marketing.</p>\n              <p>Essa pessoa será responsável por gerenciar e expandir a presença da Hyper Island Americas nas redes sociais, criando conteúdos impactantes e alinhados com a nossa marca.</p>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Responsabilidades</h3>\n              <ul class=\"hij-bullets\">\n                <li>Criar e executar estratégias para redes sociais, incluindo Instagram, LinkedIn e outras plataformas.</li>\n                <li>Desenvolver conteúdos originais e criativos, com forte apelo de copywriting persuasivo.</li>\n                <li>Gerenciar o calendário editorial e garantir consistência no tom de voz da marca.</li>\n                <li>Monitorar tendências e interagir com a comunidade, fortalecendo o relacionamento com a audiência.</li>\n                <li>Analisar métricas e otimizar a performance das campanhas orgânicas.</li>\n                <li>Trabalhar em conjunto com o time de marketing para integrar as redes sociais às estratégias gerais da Hyper Island.</li>\n              </ul>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Requisitos</h3>\n              <ul class=\"hij-bullets\">\n                <li>Conhecimento avançado em copywriting e storytelling.</li>\n                <li>\n<strong>Inglês avançado</strong> (essencial para a comunicação interna e a criação de conteúdo).</li>\n                <li>Habilidade analítica para interpretar dados e ajustar estratégias.</li>\n                <li>Criatividade e capacidade de inovar nas abordagens de conteúdo.</li>\n                <li>Conhecimento de design (Canva ou Photoshop).</li>\n              </ul>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Diferenciais</h3>\n              <ul class=\"hij-bullets\">\n                <li>Experiência prévia como Social Media ou em função similar.</li>\n                <li>Espanhol avançado.</li>\n              </ul>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">O que oferecemos</h3>\n              <ul class=\"hij-bullets\">\n                <li><strong>Remuneração de R$ 6.500.</strong></li>\n                <li>Trabalho remoto e flexibilidade de horário.</li>\n                <li>Aprendizado contínuo e possibilidade de crescimento dentro da Hyper Island.</li>\n              </ul>\n            </section>\n          </div>\n\n          <aside class=\"hij-aside hij-rise\" style=\"--i:4\" aria-label=\"Resumo da vaga\">\n            <span class=\"hij-eyebrow\">Inscrições abertas até 29/11</span>\n            <h3 class=\"hij-aside-title\">Tem paixão por redes sociais?</h3>\n            <p>Se você quer impactar a educação do futuro e a transformação do trabalho, queremos conhecer você.</p>\n            <div class=\"hij-actions\">\n              <a class=\"hij-btn hij-btn-primary\" href=\"#aplicar-social-media\" data-hij-apply=\"\">\n                Quero me candidatar\n                <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M12 4v15M6 13l6 6 6-6\"></path></svg>\n              </a>\n              <a class=\"hij-btn hij-btn-ghost\" href=\"https://hyperisland.com/hubfs/Brasil/Job%20Description%20-%20Social%20Media%20Content%20Creator.pdf\" target=\"_blank\" rel=\"noopener\">\n                Job description (PDF)\n                <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"></path></svg>\n              </a>\n            </div>\n            <div class=\"hij-about\">\n              <h4>Sobre a Hyper</h4>\n              <p>Somos uma instituição global de consultoria e educação focada no desenvolvimento de habilidades para o futuro do trabalho, com experiências de aprendizagem imersivas para pessoas e organizações.</p>\n            </div>\n          </aside>\n        </div>\n\n        <section class=\"hij-apply\" id=\"aplicar-social-media\" aria-labelledby=\"hij-a-sm\">\n          <div class=\"hij-apply-copy\">\n            <div>\n              <span class=\"hij-eyebrow\">Inscrição · Social Media</span>\n              <h2 class=\"hij-apply-title\" id=\"hij-a-sm\">Bora pra ilha?</h2>\n            </div>\n            <div class=\"hij-apply-side\">\n              <span class=\"hij-deadline\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"1.5\"></rect><path d=\"M3.5 10h17M8 3v4M16 3v4\"></path></svg>Inscrições até 29/11</span>\n              <p>Preencha o formulário abaixo. Leva poucos minutos.</p>\n            </div>\n          </div>\n          <div class=\"hij-form\" data-hij-form=\"01M6H98KCQYFDRS6RS6FRXAKP9\">\n            <div class=\"hij-form-loading\" role=\"status\">\n              <span class=\"hij-spinner\" aria-hidden=\"true\"></span>\n              <span class=\"hij-form-msg\">Carregando o formulário…</span>\n            </div>\n          </div>\n        </section>\n      </article>\n\n      <!-- ─────────── VAGA 02 · ESTÁGIO ─────────── -->\n      <article class=\"hij-panel\" id=\"estagio\" data-title=\"Estágio de Marketing\" aria-labelledby=\"hij-h-es\">\n        <div class=\"hij-topbar\">\n          <a class=\"hij-back\" href=\"#\" data-hij-back=\"\">\n            <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M20 12H5M11 6l-6 6 6 6\"></path></svg>\n            Todas as vagas\n          </a>\n          <nav class=\"hij-switch\" aria-label=\"Trocar de vaga\">\n            <a href=\"#social-media\" data-hij-open=\"social-media\">vaga 01</a>\n            <a href=\"#estagio\" data-hij-open=\"estagio\" aria-current=\"page\">vaga 02</a>\n          </nav>\n        </div>\n\n        <header class=\"hij-head\">\n          <span class=\"hij-eyebrow hij-rise\" style=\"--i:0\">Vaga 02 · Marketing Digital</span>\n          <h2 class=\"hij-h2 hij-rise\" id=\"hij-h-es\" tabindex=\"-1\" style=\"--i:1\">Estágio de Marketing</h2>\n          <dl class=\"hij-facts hij-rise\" style=\"--i:2\">\n            <div class=\"hij-fact\">\n<dt>Localização</dt>\n<dd>Remoto</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Contrato</dt>\n<dd>Estágio</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Bolsa-auxílio</dt>\n<dd>R$ 2.000</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Carga horária</dt>\n<dd>6h por dia</dd>\n</div>\n            <div class=\"hij-fact\">\n<dt>Inscrições até</dt>\n<dd>29/11</dd>\n</div>\n          </dl>\n        </header>\n\n        <div class=\"hij-body\">\n          <div class=\"hij-content hij-rise\" style=\"--i:3\">\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">O que buscamos</h3>\n              <p class=\"hij-lead\">Uma pessoa curiosa, organizada e proativa para integrar o nosso time de Marketing como estagiário(a).</p>\n              <p>Você vai participar de diferentes frentes do marketing da Hyper Island Americas, apoiando a execução de campanhas, a produção e publicação de conteúdos, a gestão de plataformas digitais e o acompanhamento de resultados.</p>\n              <p>Procuramos alguém com vontade de aprender, atenção aos detalhes e interesse em desenvolver uma visão ampla sobre marketing digital, comunicação e estratégias de crescimento em um ambiente internacional, criativo e colaborativo.</p>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Responsabilidades</h3>\n              <ul class=\"hij-bullets\">\n                <li>Apoiar a execução de campanhas e ações de marketing digital para os diferentes mercados da Hyper Island Americas.</li>\n                <li>Auxiliar na organização, atualização e segmentação de bases de contatos no CRM.</li>\n                <li>Apoiar a criação, configuração e disparo de campanhas de e-mail marketing.</li>\n                <li>Publicar e atualizar conteúdos em websites, landing pages e plataformas digitais.</li>\n                <li>Auxiliar no agendamento e na publicação de conteúdos nas redes sociais.</li>\n                <li>Apoiar a organização de materiais gráficos, apresentações e outros ativos de comunicação.</li>\n                <li>Fazer edições simples de conteúdo, como cortes de vídeos, adaptações de formatos e ajustes em peças gráficas.</li>\n                <li>Acompanhar indicadores e organizar dados em planilhas e relatórios de performance.</li>\n                <li>Realizar pesquisas de mercado, benchmarking e monitoramento de tendências.</li>\n                <li>Apoiar a organização e a divulgação de webinars, eventos e outras iniciativas de marketing.</li>\n              </ul>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Requisitos</h3>\n              <ul class=\"hij-bullets\">\n                <li>Estar cursando ensino superior em Marketing, Publicidade e Propaganda, Comunicação Social ou áreas relacionadas.</li>\n                <li>Boa comunicação escrita e verbal.</li>\n                <li>Organização, atenção aos detalhes e capacidade de gerenciar diferentes atividades.</li>\n                <li>Familiaridade com redes sociais e ferramentas digitais.</li>\n                <li>Conhecimento básico de Excel ou Google Sheets.</li>\n                <li>Interesse em marketing digital, comunicação, tecnologia e inovação.</li>\n                <li>Proatividade, curiosidade e disposição para aprender.</li>\n                <li>Disponibilidade para estágio de <strong>6 horas diárias</strong>, com horário compatível com os estudos.</li>\n              </ul>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">Diferenciais</h3>\n              <ul class=\"hij-bullets\">\n                <li>Inglês intermediário ou avançado.</li>\n                <li>Conhecimento básico de ferramentas de design, como Canva ou Photoshop.</li>\n                <li>Familiaridade com plataformas de e-mail marketing, como HubSpot.</li>\n                <li>Conhecimento básico de edição de vídeos.</li>\n                <li>Interesse em inteligência artificial e ferramentas de automação.</li>\n                <li>Espanhol intermediário ou avançado.</li>\n              </ul>\n            </section>\n            <section class=\"hij-block\">\n              <h3 class=\"hij-eyebrow\">O que oferecemos</h3>\n              <ul class=\"hij-bullets\">\n                <li><strong>Bolsa-auxílio de R$ 2.000.</strong></li>\n                <li>Trabalho remoto e flexibilidade de horário.</li>\n                <li>Experiência prática em diferentes áreas do marketing digital.</li>\n                <li>Projetos e campanhas para os mercados do Brasil, da América do Norte e da América Latina.</li>\n                <li>Contato com profissionais e equipes de diferentes países.</li>\n                <li>Ambiente criativo, colaborativo e orientado à aprendizagem contínua.</li>\n                <li>Acompanhamento e desenvolvimento profissional com o time de marketing.</li>\n                <li>Possibilidade de crescimento dentro da Hyper Island.</li>\n              </ul>\n            </section>\n          </div>\n\n          <aside class=\"hij-aside hij-rise\" style=\"--i:4\" aria-label=\"Resumo da vaga\">\n            <span class=\"hij-eyebrow\">Inscrições abertas até 29/11</span>\n            <h3 class=\"hij-aside-title\">Quer começar sua carreira em marketing?</h3>\n            <p>Se você tem curiosidade, gosta de aprender coisas novas e quer ajudar a transformar o futuro da educação e do trabalho, queremos conhecer você.</p>\n            <div class=\"hij-actions\">\n              <a class=\"hij-btn hij-btn-primary\" href=\"#aplicar-estagio\" data-hij-apply=\"\">\n                Quero me candidatar\n                <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M12 4v15M6 13l6 6 6-6\"></path></svg>\n              </a>\n              <a class=\"hij-btn hij-btn-ghost\" href=\"https://hyperisland.com/hubfs/Brasil/Job%20Description%20-%20Est%C3%A1gio%20de%20Marketing.pdf\" target=\"_blank\" rel=\"noopener\">\n                Job description (PDF)\n                <svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M8 7h9v9\"></path></svg>\n              </a>\n            </div>\n            <div class=\"hij-about\">\n              <h4>Sobre a Hyper</h4>\n              <p>Somos uma consultoria global de negócios, inovação e criatividade. Desenvolvemos líderes, equipes e culturas preparadas para o futuro, com metodologias práticas, provocativas e transformadoras.</p>\n            </div>\n          </aside>\n        </div>\n\n        <section class=\"hij-apply\" id=\"aplicar-estagio\" aria-labelledby=\"hij-a-es\">\n          <div class=\"hij-apply-copy\">\n            <div>\n              <span class=\"hij-eyebrow\">Inscrição · Estágio</span>\n              <h2 class=\"hij-apply-title\" id=\"hij-a-es\">Bora pra ilha?</h2>\n            </div>\n            <div class=\"hij-apply-side\">\n              <span class=\"hij-deadline\"><svg viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"1.5\"></rect><path d=\"M3.5 10h17M8 3v4M16 3v4\"></path></svg>Inscrições até 29/11</span>\n              <p>Preencha o formulário abaixo. Leva poucos minutos.</p>\n            </div>\n          </div>\n          <div class=\"hij-form\" data-hij-form=\"01M6HAD4A7VNTE8XJNSBJ2PPT2\">\n            <div class=\"hij-form-loading\" role=\"status\">\n              <span class=\"hij-spinner\" aria-hidden=\"true\"></span>\n              <span class=\"hij-form-msg\">Carregando o formulário…</span>\n            </div>\n          </div>\n        </section>\n      </article>\n\n      <!-- Barra fixa de inscrição (aparece só no mobile, enquanto o formulário não está na tela) -->\n      <div class=\"hij-bar\" aria-hidden=\"true\">\n        <span class=\"hij-bar-label\"></span>\n        <a class=\"hij-btn hij-btn-primary\" href=\"#\" data-hij-apply=\"\" tabindex=\"-1\">Candidatar-se</a>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById('hi-jobs');\n  if (!root || root.getAttribute('data-ready')) return;\n  root.setAttribute('data-ready', '1');\n  root.classList.add('is-js');\n\n  /* Lê a fonte de títulos do próprio tema (como ele estiliza um <h2>) e aplica nos textos de destaque que não são títulos */\n  try {\n    var probe = document.createElement('h2');\n    probe.textContent = 'Hyper Island';\n    probe.setAttribute('aria-hidden', 'true');\n    probe.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;pointer-events:none;margin:0';\n    root.parentNode.insertBefore(probe, root);\n    var cs = window.getComputedStyle(probe);\n    root.style.setProperty('--hij-head', cs.fontFamily);\n    root.style.setProperty('--hij-head-weight', cs.fontWeight);\n    probe.parentNode.removeChild(probe);\n  } catch (err) {}\n\n  var TF_SRC = 'https://embed.typeform.com/next/embed.js';\n  var panels = Array.prototype.slice.call(root.querySelectorAll('.hij-panel'));\n  var ids = panels.map(function (p) { return p.id; });\n  var bar = root.querySelector('.hij-bar');\n  var barLabel = root.querySelector('.hij-bar-label');\n  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var current = null;\n  var applyObserver = null;\n\n  /* ── Typeform: carrega o script uma vez e monta o formulário só quando a vaga é aberta ── */\n  var tfQueue = [];\n  var tfState = window.tf ? 'ready' : 'idle';\n\n  function tfRefresh() {\n    if (window.tf && typeof window.tf.load === 'function') { window.tf.load(); return; }\n    var s = document.createElement('script');\n    s.src = TF_SRC + '?r=' + Date.now();\n    s.async = true;\n    document.body.appendChild(s);\n  }\n  function withTypeform(cb) {\n    if (tfState === 'ready') { cb(); return; }\n    tfQueue.push(cb);\n    if (tfState === 'loading') return;\n    tfState = 'loading';\n    var existing = document.querySelector('script[src*=\"embed.typeform.com/next/embed.js\"]');\n    var done = function () { tfState = 'ready'; tfQueue.splice(0).forEach(function (f) { f(); }); };\n    if (existing && window.tf) { done(); return; }\n    var s = existing || document.createElement('script');\n    s.addEventListener('load', done);\n    s.addEventListener('error', done);\n    if (!existing) { s.src = TF_SRC; s.async = true; document.body.appendChild(s); }\n    setTimeout(function () { if (tfState !== 'ready') done(); }, 6000);\n  }\n  function mountForm(panel) {\n    var box = panel.querySelector('[data-hij-form]');\n    if (!box || box.getAttribute('data-mounted')) return;\n    box.setAttribute('data-mounted', '1');\n    var holder = document.createElement('div');\n    holder.setAttribute('data-tf-live', box.getAttribute('data-hij-form'));\n    box.appendChild(holder);\n\n    var finish = function () {\n      box.classList.add('is-loaded');\n      var frame = box.querySelector('iframe');\n      if (frame && frame.offsetHeight > 320) box.style.minHeight = '0';\n    };\n    var mo = new MutationObserver(function () {\n      if (box.querySelector('iframe')) { mo.disconnect(); setTimeout(finish, 600); }\n    });\n    mo.observe(box, { childList: true, subtree: true });\n    setTimeout(function () {\n      if (!box.classList.contains('is-loaded')) {\n        box.classList.add('is-slow');\n        var msg = box.querySelector('.hij-form-msg');\n        if (msg) msg.innerHTML = 'O formulário está demorando para carregar.<br>Verifique sua conexão ou <a href=\"\" onclick=\"location.reload();return false;\">recarregue a página</a>.';\n      }\n    }, 12000);\n\n    withTypeform(tfRefresh);\n  }\n\n  /* ── Navegação entre as telas ── */\n  function idFromHash() {\n    var h = decodeURIComponent((location.hash || '').replace('#', ''));\n    if (ids.indexOf(h) > -1) return h;\n    var parent = h.indexOf('aplicar-') === 0 ? h.replace('aplicar-', '') : null;\n    return parent && ids.indexOf(parent) > -1 ? parent : null;\n  }\n  function scrollToEl(el, smooth) {\n    if (!el) return;\n    el.scrollIntoView({ behavior: smooth && !reduce ? 'smooth' : 'auto', block: 'start' });\n  }\n  function watchApply(panel) {\n    if (applyObserver) applyObserver.disconnect();\n    if (!bar) return;\n    bar.classList.remove('is-visible');\n    if (!panel || !('IntersectionObserver' in window)) return;\n    barLabel.textContent = panel.getAttribute('data-title');\n    bar.querySelector('a').setAttribute('href', '#aplicar-' + panel.id);\n    var apply = panel.querySelector('.hij-apply');\n    var head = panel.querySelector('.hij-head');\n    var seen = { apply: false, head: true };\n    applyObserver = new IntersectionObserver(function (entries) {\n      entries.forEach(function (e) { seen[e.target === apply ? 'apply' : 'head'] = e.isIntersecting; });\n      bar.classList.toggle('is-visible', !seen.apply && !seen.head);\n    }, { threshold: 0 });\n    applyObserver.observe(apply);\n    applyObserver.observe(head);\n  }\n  function render(id, opts) {\n    opts = opts || {};\n    if (id === current && !opts.force) return;\n    var apply = function () {\n      current = id;\n      root.classList.toggle('is-detail', !!id);\n      panels.forEach(function (p) { p.classList.toggle('is-active', p.id === id); });\n    };\n    if (document.startViewTransition && !reduce && opts.animate) {\n      var vt = document.startViewTransition(apply);\n      if (vt && vt.ready) vt.ready.catch(function () {});\n    }\n    else apply();\n\n    var panel = id ? document.getElementById(id) : null;\n    if (panel) mountForm(panel);\n    watchApply(panel);\n\n    if (opts.push) {\n      var url = id ? '#' + id : location.pathname + location.search;\n      history.pushState({ hij: id }, '', url);\n    }\n    if (opts.scroll !== false) {\n      requestAnimationFrame(function () {\n        var rect = root.getBoundingClientRect();\n        if (rect.top < 0 || rect.top > window.innerHeight * 0.4 || opts.scroll === 'always') scrollToEl(id ? panel : root, opts.animate);\n        if (panel && opts.focus) {\n          var h = panel.querySelector('.hij-h2');\n          if (h) h.focus({ preventScroll: true });\n        }\n      });\n    }\n  }\n\n  root.addEventListener('click', function (e) {\n    var open = e.target.closest('[data-hij-open]');\n    if (open) {\n      e.preventDefault();\n      render(open.getAttribute('data-hij-open'), { push: true, animate: true, focus: true, scroll: 'always' });\n      return;\n    }\n    var back = e.target.closest('[data-hij-back]');\n    if (back) {\n      e.preventDefault();\n      var leaving = current;\n      render(null, { push: true, animate: true, scroll: 'always' });\n      var card = leaving && root.querySelector('.hij-card[data-hij-open=\"' + leaving + '\"]');\n      if (card) card.focus({ preventScroll: true });\n      return;\n    }\n    var go = e.target.closest('[data-hij-apply]');\n    if (go && current) {\n      e.preventDefault();\n      scrollToEl(document.getElementById('aplicar-' + current), true);\n    }\n  });\n\n  function syncFromUrl() {\n    var id = idFromHash();\n    render(id, { animate: true, scroll: !!id });\n    if (location.hash.indexOf('#aplicar-') === 0) {\n      setTimeout(function () { scrollToEl(document.getElementById(location.hash.slice(1)), false); }, 50);\n    }\n  }\n  window.addEventListener('popstate', syncFromUrl);\n  window.addEventListener('hashchange', syncFromUrl);\n\n  /* Estado inicial (respeita links diretos como #social-media ou #estagio) */\n  var initial = idFromHash();\n  render(initial, { force: true, scroll: initial ? 'always' : false });\n  if (initial && location.hash.indexOf('#aplicar-') === 0) {\n    setTimeout(function () { scrollToEl(document.getElementById(location.hash.slice(1)), false); }, 100);\n  }\n})();\n</script>",
