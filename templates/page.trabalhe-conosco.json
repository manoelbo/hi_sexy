      "settings": {
        "html": "<!--\n  NOTA DE ENTREGA\n  ───────────────\n  Landing page: Trilha de Desenvolvimento de Liderança — Hyper Island Brasil\n  CSS escopado em .hi-ldp | Sem header, menu nem footer\n  Shopify decide as fontes (inherit do tema)\n  Integração HubSpot: portalId 1588780 — substitua o formId pelo real antes de publicar\n-->\n\n<style>\n/* ===== SCOPE + RESET ===== */\n.hi-ldp *, .hi-ldp *::before, .hi-ldp *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n.hi-ldp {\n  --black:        #111111;\n  --black-deep:   #000000;\n  --white:        #FFFFFF;\n  --bg-light:     #F5F5F2;\n  --bg-dark:      #0D0D0D;\n  --orange:       #FF7300;\n  --orange-soft:  #FFF1E6;\n  --text-secondary: #666666;\n  --border:       #D9D9D6;\n  --border-dark:  rgba(255,255,255,0.10);\n\n  --radius-sm:  2px;\n  --radius-pill: 100px;\n  --transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);\n\n  color: var(--black);\n  background: var(--white);\n  -webkit-font-smoothing: antialiased;\n  overflow-x: hidden;\n}\n\n/* ===== CONTAINER ===== */\n.hi-ldp .ldp-container {\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 40px;\n}\n@media (max-width: 768px) {\n  .hi-ldp .ldp-container { padding: 0 20px; }\n}\n\n/* ===== UTILITIES ===== */\n.hi-ldp .ldp-eyebrow {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.20em;\n  text-transform: uppercase;\n  color: var(--orange);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 20px;\n}\n.hi-ldp .ldp-eyebrow::before {\n  content: '';\n  display: block;\n  width: 28px;\n  height: 2px;\n  background: var(--orange);\n  flex-shrink: 0;\n}\n\n.hi-ldp .ldp-reveal {\n  opacity: 0;\n  transform: translateY(24px);\n  transition: opacity 0.65s ease, transform 0.65s ease;\n}\n.hi-ldp .ldp-reveal.ldp-visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n.hi-ldp .ldp-delay-1 { transition-delay: 0.1s; }\n.hi-ldp .ldp-delay-2 { transition-delay: 0.2s; }\n.hi-ldp .ldp-delay-3 { transition-delay: 0.3s; }\n.hi-ldp .ldp-delay-4 { transition-delay: 0.4s; }\n\n/* ===== BUTTONS ===== */\n.hi-ldp .ldp-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  text-decoration: none;\n  padding: 15px 32px;\n  border-radius: var(--radius-pill);\n  cursor: pointer;\n  border: 2px solid transparent;\n  transition: var(--transition);\n  white-space: nowrap;\n}\n.hi-ldp .ldp-btn-primary {\n  background: var(--black);\n  color: var(--white);\n  border-color: var(--black);\n}\n.hi-ldp .ldp-btn-primary:hover {\n  background: var(--orange);\n  border-color: var(--orange);\n}\n.hi-ldp .ldp-btn-orange {\n  background: var(--orange);\n  color: var(--white);\n  border-color: var(--orange);\n}\n.hi-ldp .ldp-btn-orange:hover {\n  background: var(--black);\n  border-color: var(--black);\n}\n.hi-ldp .ldp-btn-outline-white {\n  background: transparent;\n  color: var(--white);\n  border-color: rgba(255,255,255,0.45);\n}\n.hi-ldp .ldp-btn-outline-white:hover {\n  background: var(--white);\n  color: var(--black);\n  border-color: var(--white);\n}\n.hi-ldp .ldp-btn-white {\n  background: var(--white);\n  color: var(--black);\n  border-color: var(--white);\n}\n.hi-ldp .ldp-btn-white:hover {\n  background: var(--orange);\n  border-color: var(--orange);\n  color: var(--white);\n}\n\n/* ===================================================\n   1. HERO\n=================================================== */\n.hi-ldp .ldp-hero {\n  background: var(--black-deep);\n  position: relative;\n  min-height: 100vh;\n  display: flex;\n  align-items: flex-end;\n  overflow: hidden;\n}\n\n/* Fundo texturizado com gradiente — sem imagem, pure CSS */\n.hi-ldp .ldp-hero__bg {\n  position: absolute;\n  inset: 0;\n  background:\n    radial-gradient(ellipse 80% 60% at 70% 30%, rgba(255,115,0,0.12) 0%, transparent 60%),\n    radial-gradient(ellipse 50% 40% at 20% 80%, rgba(255,115,0,0.06) 0%, transparent 50%),\n    var(--black-deep);\n  z-index: 0;\n}\n\n/* Grade editorial de linhas finas */\n.hi-ldp .ldp-hero__grid {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  background-image:\n    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);\n  background-size: 80px 80px;\n}\n\n/* Linha laranja base */\n.hi-ldp .ldp-hero__bottom-line {\n  position: absolute;\n  bottom: 0; left: 0; right: 0;\n  height: 3px;\n  background: var(--orange);\n  z-index: 3;\n}\n\n/* ETIQUETA LATERAL — elemento de assinatura */\n.hi-ldp .ldp-hero__side-tag {\n  position: absolute;\n  right: 0;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 2;\n  writing-mode: vertical-rl;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.3em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.18);\n  padding: 24px 16px;\n  border-left: 1px solid rgba(255,255,255,0.07);\n  user-select: none;\n}\n\n.hi-ldp .ldp-hero__inner {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  padding: 120px 0 80px;\n}\n\n.hi-ldp .ldp-hero__content {\n  max-width: 760px;\n}\n\n.hi-ldp .ldp-hero__title {\n  font-size: clamp(48px, 7vw, 96px);\n  font-weight: 900;\n  line-height: 1.0;\n  letter-spacing: -0.03em;\n  text-transform: uppercase;\n  color: var(--white);\n  margin-bottom: 28px;\n}\n.hi-ldp .ldp-hero__title em {\n  font-style: normal;\n  color: var(--orange);\n}\n\n.hi-ldp .ldp-hero__subtitle {\n  font-size: 18px;\n  line-height: 1.65;\n  color: rgba(255,255,255,0.70);\n  max-width: 560px;\n  margin-bottom: 40px;\n  font-weight: 400;\n}\n\n/* Bullets rápidos */\n.hi-ldp .ldp-hero__bullets {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-bottom: 44px;\n}\n.hi-ldp .ldp-hero__bullet {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  color: rgba(255,255,255,0.80);\n  letter-spacing: 0.02em;\n}\n.hi-ldp .ldp-hero__bullet::before {\n  content: '';\n  display: block;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--orange);\n  flex-shrink: 0;\n}\n\n.hi-ldp .ldp-hero__ctas {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n  align-items: center;\n}\n\n.hi-ldp .ldp-hero__vagas {\n  margin-top: 28px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.38);\n}\n.hi-ldp .ldp-hero__vagas::before {\n  content: '';\n  display: block;\n  width: 20px;\n  height: 1px;\n  background: var(--orange);\n}\n\n@media (max-width: 768px) {\n  .hi-ldp .ldp-hero__side-tag { display: none; }\n  .hi-ldp .ldp-hero__inner { padding: 80px 0 70px; }\n  .hi-ldp .ldp-hero__ctas { flex-direction: column; align-items: flex-start; }\n  .hi-ldp .ldp-btn { width: 100%; justify-content: center; }\n}\n\n/* ===================================================\n   2. CONTEXTO / DOR\n=================================================== */\n.hi-ldp .ldp-context {\n  padding: 100px 0;\n  background: var(--bg-light);\n  border-top: 1px solid var(--border);\n}\n.hi-ldp .ldp-context__inner {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 80px;\n  align-items: center;\n}\n.hi-ldp .ldp-context__title {\n  font-size: clamp(30px, 3.5vw, 52px);\n  font-weight: 900;\n  letter-spacing: -0.03em;\n  text-transform: uppercase;\n  line-height: 1.0;\n  margin-bottom: 32px;\n}\n.hi-ldp .ldp-context__body p {\n  font-size: 16px;\n  line-height: 1.80;\n  color: var(--text-secondary);\n  margin-bottom: 20px;\n}\n.hi-ldp .ldp-context__body p:last-child { margin-bottom: 0; }\n.hi-ldp .ldp-context__body strong { color: var(--black); font-weight: 600; }\n\n/* Painel de tensões */\n.hi-ldp .ldp-context__tensions {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  border: 1px solid var(--border);\n}\n.hi-ldp .ldp-tension {\n  padding: 24px 28px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: flex-start;\n  gap: 16px;\n  background: var(--white);\n  transition: var(--transition);\n}\n.hi-ldp .ldp-tension:last-child { border-bottom: none; }\n.hi-ldp .ldp-tension:hover { background: var(--orange-soft); }\n.hi-ldp .ldp-tension__dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--orange);\n  flex-shrink: 0;\n  margin-top: 6px;\n}\n.hi-ldp .ldp-tension__text {\n  font-size: 15px;\n  line-height: 1.60;\n  color: var(--black);\n  font-weight: 500;\n}\n\n@media (max-width: 1024px) {\n  .hi-ldp .ldp-context__inner { grid-template-columns: 1fr; gap: 40px; }\n}\n\n/* ===================================================\n   3. O QUE É A TRILHA\n=================================================== */\n.hi-ldp .ldp-what {\n  padding: 100px 0;\n  background: var(--black-deep);\n  color: var(--white);\n}\n.hi-ldp .ldp-what__header {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 60px;\n  align-items: end;\n  margin-bottom: 72px;\n  padding-bottom: 48px;\n  border-bottom: 1px solid var(--border-dark);\n}\n.hi-ldp .ldp-what__title {\n  font-size: clamp(30px, 3.5vw, 52px);\n  font-weight: 900;\n  letter-spacing: -0.03em;\n  text-transform: uppercase;\n  line-height: 1.0;\n  color: var(--white);\n}\n.hi-ldp .ldp-what__intro {\n  font-size: 16px;\n  line-height: 1.75;\n  color: rgba(255,255,255,0.68);\n}\n.hi-ldp .ldp-what__intro strong { color: var(--white); font-weight: 600; }\n\n/* Cards dos componentes */\n.hi-ldp .ldp-components {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 0;\n  border: 1px solid var(--border-dark);\n}\n.hi-ldp .ldp-component-card {\n  padding: 36px 28px;\n  border-right: 1px solid var(--border-dark);\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  position: relative;\n  overflow: hidden;\n  transition: var(--transition);\n}\n.hi-ldp .ldp-component-card:last-child { border-right: none; }\n.hi-ldp .ldp-component-card:hover { background: rgba(255,115,0,0.08