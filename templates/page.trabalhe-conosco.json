ransform: uppercase;\n  line-height: 1.0;\n  color: var(--white);\n  margin-bottom: 16px;\n}\n.hi-ldp .ldp-value__intro {\n  font-size: 16px;\n  line-height: 1.75;\n  color: rgba(255,255,255,0.60);\n  max-width: 560px;\n}\n.hi-ldp .ldp-value__inner {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 40px;\n  align-items: stretch;\n}\n.hi-ldp .ldp-value__avulso {\n  display: flex;\n  flex-direction: column;\n  border: 1px solid var(--border-dark);\n  height: 100%;\n}\n.hi-ldp .ldp-value__avulso-label {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: var(--text-secondary);\n  padding: 16px 24px;\n  border-bottom: 1px solid var(--border-dark);\n  background: rgba(255,255,255,0.02);\n}\n.hi-ldp .ldp-value__item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 20px 24px;\n  border-bottom: 1px solid var(--border-dark);\n  transition: var(--transition);\n}\n.hi-ldp .ldp-value__item:last-of-type { border-bottom: none; }\n.hi-ldp .ldp-value__item:hover { background: rgba(255,255,255,0.03); }\n.hi-ldp .ldp-value__item-info {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.hi-ldp .ldp-value__item-name {\n  font-size: 14px;\n  font-weight: 700;\n  color: rgba(255,255,255,0.85);\n  line-height: 1.2;\n}\n.hi-ldp .ldp-value__item-sub {\n  font-size: 11px;\n  color: rgba(255,255,255,0.35);\n  letter-spacing: 0.04em;\n}\n.hi-ldp .ldp-value__item-price {\n  font-size: 16px;\n  font-weight: 800;\n  color: rgba(255,255,255,0.55);\n  white-space: nowrap;\n  letter-spacing: -0.01em;\n}\n.hi-ldp .ldp-value__total-avulso {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 20px 24px;\n  background: rgba(255,255,255,0.04);\n  border-top: 2px solid rgba(255,255,255,0.10);\n}\n.hi-ldp .ldp-value__total-label {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.40);\n}\n.hi-ldp .ldp-value__total-price {\n  font-size: 22px;\n  font-weight: 900;\n  color: rgba(255,255,255,0.40);\n  letter-spacing: -0.02em;\n  text-decoration: line-through;\n  text-decoration-color: rgba(255,255,255,0.20);\n}\n.hi-ldp .ldp-value__trilha {\n  background: var(--orange);\n  padding: 44px 40px;\n  display: flex;\n  flex-direction: column;\n  gap: 28px;\n  position: relative;\n  overflow: hidden;\n  height: 100%;\n}\n.hi-ldp .ldp-value__trilha::before {\n  content: none;\n}\n.hi-ldp .ldp-value__trilha-badge {\n  display: inline-block;\n  background: var(--black);\n  color: var(--white);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.20em;\n  text-transform: uppercase;\n  padding: 6px 14px;\n  border-radius: 2px;\n  align-self: flex-start;\n}\n.hi-ldp .ldp-value__trilha-title {\n  font-size: 22px;\n  font-weight: 900;\n  text-transform: uppercase;\n  color: var(--black);\n  line-height: 1.1;\n  letter-spacing: -0.02em;\n}\n.hi-ldp .ldp-value__trilha-includes {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.hi-ldp .ldp-value__trilha-includes li {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 13px;\n  font-weight: 600;\n  color: rgba(0,0,0,0.75);\n}\n.hi-ldp .ldp-value__trilha-includes li::before {\n  content: '✓';\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  background: var(--black);\n  color: var(--orange);\n  border-radius: 50%;\n  font-size: 10px;\n  font-weight: 900;\n  flex-shrink: 0;\n}\n.hi-ldp .ldp-value__trilha-pricing {\n  border-top: 1px solid rgba(0,0,0,0.15);\n  padding-top: 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.hi-ldp .ldp-value__trilha-price-label {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: rgba(0,0,0,0.55);\n}\n.hi-ldp .ldp-value__trilha-price {\n  font-size: clamp(44px, 6vw, 64px);\n  font-weight: 900;\n  line-height: 1;\n  color: var(--black);\n  letter-spacing: -0.03em;\n}\n.hi-ldp .ldp-value__trilha-economy {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: var(--black);\n  color: var(--orange);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  padding: 8px 16px;\n  border-radius: 2px;\n  align-self: flex-start;\n  margin-top: 4px;\n}\n.hi-ldp .ldp-value__trilha-economy::before {\n  content: '↓';\n  font-size: 14px;\n}\n.hi-ldp .ldp-value__trilha-cta {\n  background: var(--black);\n  color: var(--white);\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  text-decoration: none;\n  padding: 16px 28px;\n  border-radius: var(--radius-pill);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  transition: var(--transition);\n  border: 2px solid transparent;\n}\n.hi-ldp .ldp-value__trilha-cta:hover {\n  background: rgba(0,0,0,0.80);\n}\n@media (max-width: 1024px) {\n  .hi-ldp .ldp-value__inner { grid-template-columns: 1fr; gap: 28px; }\n}\n@media (max-width: 600px) {\n  .hi-ldp .ldp-value__trilha { padding: 36px 28px; }\n  .hi-ldp .ldp-value__item { padding: 16px 20px; }\n  .hi-ldp .ldp-value__total-avulso { padding: 16px 20px; }\n  .hi-ldp .ldp-value__avulso-label { padding: 14px 20px; }\n}\n\n@media (max-width: 1024px) {\n  .hi-ldp .ldp-form-section__inner { grid-template-columns: 1fr; gap: 48px; }\n}\n\n/* ===== REDUCED MOTION ===== */\n@media (prefers-reduced-motion: reduce) {\n  .hi-ldp .ldp-reveal { opacity: 1; transform: none; }\n}\n</style>\n\n<!-- ============================================================\n     META SEO (Shopify injeta as tags de head — estes são hints)\n     Meta title:        Trilha de Desenvolvimento de Liderança | Hyper Island Brasil\n     Meta description:  Uma jornada exclusiva de até 12 meses para líderes que querem\n                        desenvolver comunicação executiva, visão de futuro,\n                        liderança na era da IA e acompanhamento com coaching individual.\n============================================================ -->\n\n<div class=\"hi-ldp\">\n\n  <!-- ============================================================\n       1. HERO\n  ============================================================ -->\n  <section class=\"ldp-hero\" aria-label=\"Trilha de Desenvolvimento de Liderança\">\n\n    <div class=\"ldp-hero__bg\"></div>\n    <div class=\"ldp-hero__grid\" aria-hidden=\"true\"></div>\n    <div class=\"ldp-hero__bottom-line\" aria-hidden=\"true\"></div>\n    <div class=\"ldp-hero__side-tag\" aria-hidden=\"true\">Hyper Island Brasil · Produto Exclusivo · 2026</div>\n\n    <div class=\"ldp-hero__inner\">\n      <div class=\"ldp-container\">\n        <div class=\"ldp-hero__content ldp-reveal\">\n\n          <div class=\"ldp-eyebrow\" style=\"color:var(--orange);\">\n            Desenvolvimento de Liderança\n          </div>\n\n          <h1 class=\"ldp-hero__title\">\n            Trilha de<br>\n            Desenvolvimento<br>\n            de <em>Liderança</em>\n          </h1>\n\n          <p class=\"ldp-hero__subtitle\">\n            Uma jornada exclusiva de até 12 meses para líderes que querem desenvolver\n            comunicação estratégica, visão de futuro, repertório sobre IA e\n            acompanhamento individual em cada etapa do processo.\n          </p>\n\n          <div class=\"ldp-hero__bullets\">\n            <div class=\"ldp-hero__bullet\">3 cursos online ao vivo da Hyper Island</div>\n            <div class=\"ldp-hero__bullet\">3 sessões individuais de coaching</div>\n            <div class=\"ldp-hero__bullet\">Até 12 meses de desenvolvimento acompanhado</div>\n            <div class=\"ldp-hero__bullet\">Um único investimento</div>\n          </div>\n\n          <div class=\"ldp-hero__ctas\">\n            <a href=\"#formulario\" class=\"ldp-btn ldp-btn-white\">Quero saber mais</a>\n            <a href=\"#pilares\" class=\"ldp-btn ldp-btn-outline-white\">Ver a trilha completa</a>\n          </div>\n\n          <div class=\"ldp-hero__vagas\">Vagas limitadas · Método exclusivo Hyper Island</div>\n\n        </div>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- ============================================================\n       2. CONTEXTO / DOR\n  ============================================================ -->\n  <section class=\"ldp-context\" aria-label=\"Por que esta trilha existe\">\n    <div class=\"ldp-container\">\n      <div class=\"ldp-context__inner\">\n\n        <div class=\"ldp-reveal\">\n          <div class=\"ldp-eyebrow\">O desafio de liderar hoje</div>\n          <h2 class=\"ldp-context__title\">\n            Liderar hoje exige\n            repertório, clareza\n            e acompanhamento.\n          </h2>\n          <div class=\"ldp-context__body\">\n            <p>\n              O contexto de liderança mudou. Times mais diversos, decisões mais rápidas,\n              pressão por inovação, novas tecnologias e cenários de incerteza constante\n              tornaram o papel do líder mais complexo do que em qualquer outro momento.\n            </p>\n            <p>\n              O problema é que o desenvolvimento costuma acontecer de forma fragmentada:\n              <strong>cursos isolados, treinamentos pontuais</strong> e pouco espaço para\n              integrar o aprendizado à realidade do dia a dia.\n            </p>\n            <p>\n              A Trilha de Desenvolvimento de Liderança foi criada para mudar isso.\n              Uma jornada intencional, estruturada e acompanhada para líderes que querem\n              <strong>evoluir de forma consistente</strong>.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-context__tensions\">\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Comunicar com clareza e influência em contextos de alta pressão</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Tomar decisões estratégicas em cenários de incerteza e mudança acelerada</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Compreender o impacto da IA no trabalho e na gestão de pessoas</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Conectar aprendizados teóricos à realidade concreta dos desafios de liderança</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Desenvolver uma liderança mais consciente, consistente e adaptável</div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       3. O QUE É A TRILHA\n  ============================================================ -->\n  <section class=\"ldp-what\" aria-label=\"O que é a Trilha de Desenvolvimento de Liderança\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-what__header ldp-reveal\">\n        <div>\n          <div class=\"ldp-eyebrow\">A jornada completa</div>\n          <h2 class=\"ldp-what__title\">\n            Uma jornada completa para\n            desenvolver sua liderança\n            em até 12 meses.\n          </h2>\n        </div>\n        <p class=\"ldp-what__intro\">\n          A Trilha reúne <strong>três cursos online ao vivo da Hyper Island</strong> com\n          <strong>três sessões individuais de coaching</strong>. Ao longo da jornada,\n          você desenvolve competências essenciais para liderar com mais clareza, visão\n          estratégica e capacidade de ação em contextos de transformação.\n        </p>\n      </div>\n\n      <div class=\"ldp-components\">\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-1\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">01</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Curso Online Ao Vivo</div>\n          <h3 class=\"ldp-component-card__title\">Comunicação Executiva</h3>\n          <p class=\"ldp-component-card__text\">\n            Clareza, influência e presença para comunicar decisões, alinhar\n            stakeholders e conduzir conversas difíceis com mais impacto.\n          </p>\n        </article>\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">02</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Curso Online Ao Vivo</div>\n          <h3 class=\"ldp-component-card__title\">Explorando Futuros</h3>\n          <p class=\"ldp-component-card__text\">\n            Leitura de sinais de mudança, construção de cenários e tomada de\n            decisão estratégica diante da incerteza.\n          </p>\n        </article>\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-3\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">03</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Curso Online Ao Vivo</div>\n          <h3 class=\"ldp-component-card__title\">Liderar na Era da IA</h3>\n          <p class=\"ldp-component-card__text\">\n            Repertório prático para liderar em ambientes cada vez mais\n            tecnológicos e compreender o impacto da IA nos times.\n          </p>\n        </article>\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-4\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">04</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Individual · Até 12 meses</div>\n          <h3 class=\"ldp-component-card__title\">3 Sessões de Coaching Individual</h3>\n          <p class=\"ldp-component-card__text\">\n            Acompanhamento personalizado para conectar os aprendizados à\n            sua realidade e fortalecer a evolução ao longo da jornada.\n          </p>\n        </article>\n\n      </div>\n\n      <div style=\"margin-top:48px; text-align:center;\" class=\"ldp-reveal\">\n        <a href=\"#formulario\" class=\"ldp-btn ldp-btn-orange\">Quero saber mais sobre a trilha</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       3.5 VALOR DA TRILHA — comparativo\n  ============================================================ -->\n  <section class=\"ldp-value\" aria-label=\"Valor da Trilha de Desenvolvimento de Liderança\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-value__header ldp-reveal\">\n        <div class=\"ldp-eyebrow\">Por que a trilha vale mais</div>\n        <h2 class=\"ldp-value__title\">\n          Tudo que você precisa,<br>\n          por muito menos do que<br>\n          comprando por partes.\n        </h2>\n        <p class=\"ldp-value__intro\">\n          Se você fosse contratar cada treinamento de forma avulsa, o investimento total chegaria a\n          R$ 12.370. Com a Trilha de Desenvolvimento de Liderança, você tem acesso a\n          tudo isso por R$ 8.990.\n        </p>\n      </div>\n\n      <div class=\"ldp-value__inner\">\n\n        <!-- Coluna esquerda: itens avulsos -->\n        <div class=\"ldp-reveal\" style=\"display:f