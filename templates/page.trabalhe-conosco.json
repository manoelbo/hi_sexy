rcase;\n  padding: 8px 16px;\n  border-radius: 2px;\n  align-self: flex-start;\n  margin-top: 4px;\n}\n.hi-ldp .ldp-value__trilha-economy::before {\n  content: '↓';\n  font-size: 14px;\n}\n.hi-ldp .ldp-value__trilha-cta {\n  background: var(--black);\n  color: var(--white);\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  text-decoration: none;\n  padding: 16px 28px;\n  border-radius: var(--radius-pill);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  transition: var(--transition);\n  border: 2px solid transparent;\n}\n.hi-ldp .ldp-value__trilha-cta:hover {\n  background: rgba(0,0,0,0.80);\n}\n@media (max-width: 1024px) {\n  .hi-ldp .ldp-value__inner { grid-template-columns: 1fr; gap: 28px; }\n}\n@media (max-width: 600px) {\n  .hi-ldp .ldp-value__trilha { padding: 36px 28px; }\n  .hi-ldp .ldp-value__item { padding: 16px 20px; }\n  .hi-ldp .ldp-value__total-avulso { padding: 16px 20px; }\n  .hi-ldp .ldp-value__avulso-label { padding: 14px 20px; }\n}\n\n@media (max-width: 1024px) {\n  .hi-ldp .ldp-form-section__inner { grid-template-columns: 1fr; gap: 48px; }\n}\n\n/* ===== REDUCED MOTION ===== */\n@media (prefers-reduced-motion: reduce) {\n  .hi-ldp .ldp-reveal { opacity: 1; transform: none; }\n}\n</style>\n\n<!-- ============================================================\n     META SEO (Shopify injeta as tags de head — estes são hints)\n     Meta title:        Trilha de Desenvolvimento de Liderança | Hyper Island Brasil\n     Meta description:  Uma jornada exclusiva de até 12 meses para líderes que querem\n                        desenvolver comunicação executiva, visão de futuro,\n                        liderança na era da IA e acompanhamento com coaching individual.\n============================================================ -->\n\n<div class=\"hi-ldp\">\n\n  <!-- ============================================================\n       1. HERO\n  ============================================================ -->\n  <section class=\"ldp-hero\" aria-label=\"Trilha de Desenvolvimento de Liderança\">\n\n    <div class=\"ldp-hero__bg\"></div>\n    <div class=\"ldp-hero__grid\" aria-hidden=\"true\"></div>\n    <div class=\"ldp-hero__bottom-line\" aria-hidden=\"true\"></div>\n    <div class=\"ldp-hero__side-tag\" aria-hidden=\"true\">Hyper Island Brasil · Produto Exclusivo · 2026</div>\n\n    <div class=\"ldp-hero__inner\">\n      <div class=\"ldp-container\">\n        <div class=\"ldp-hero__content ldp-reveal\">\n\n          <div class=\"ldp-eyebrow\" style=\"color:var(--orange);\">\n            Desenvolvimento de Liderança\n          </div>\n\n          <h1 class=\"ldp-hero__title\">\n            Trilha de<br>\n            Desenvolvimento<br>\n            de <em>Liderança</em>\n          </h1>\n\n          <p class=\"ldp-hero__subtitle\">\n            Uma jornada exclusiva de até 12 meses para líderes que querem desenvolver\n            comunicação estratégica, visão de futuro, repertório sobre IA e\n            acompanhamento individual em cada etapa do processo.\n          </p>\n\n          <div class=\"ldp-hero__bullets\">\n            <div class=\"ldp-hero__bullet\">3 cursos online ao vivo da Hyper Island</div>\n            <div class=\"ldp-hero__bullet\">3 sessões individuais de coaching</div>\n            <div class=\"ldp-hero__bullet\">Até 12 meses de desenvolvimento acompanhado</div>\n            <div class=\"ldp-hero__bullet\">Um único investimento</div>\n          </div>\n\n          <div class=\"ldp-hero__ctas\">\n            <a href=\"#formulario\" class=\"ldp-btn ldp-btn-white\">Quero saber mais</a>\n            <a href=\"#pilares\" class=\"ldp-btn ldp-btn-outline-white\">Ver a trilha completa</a>\n          </div>\n\n          <div class=\"ldp-hero__vagas\">Vagas limitadas · Método exclusivo Hyper Island</div>\n\n        </div>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- ============================================================\n       2. CONTEXTO / DOR\n  ============================================================ -->\n  <section class=\"ldp-context\" aria-label=\"Por que esta trilha existe\">\n    <div class=\"ldp-container\">\n      <div class=\"ldp-context__inner\">\n\n        <div class=\"ldp-reveal\">\n          <div class=\"ldp-eyebrow\">O desafio de liderar hoje</div>\n          <h2 class=\"ldp-context__title\">\n            Liderar hoje exige\n            repertório, clareza\n            e acompanhamento.\n          </h2>\n          <div class=\"ldp-context__body\">\n            <p>\n              O contexto de liderança mudou. Times mais diversos, decisões mais rápidas,\n              pressão por inovação, novas tecnologias e cenários de incerteza constante\n              tornaram o papel do líder mais complexo do que em qualquer outro momento.\n            </p>\n            <p>\n              O problema é que o desenvolvimento costuma acontecer de forma fragmentada:\n              <strong>cursos isolados, treinamentos pontuais</strong> e pouco espaço para\n              integrar o aprendizado à realidade do dia a dia.\n            </p>\n            <p>\n              A Trilha de Desenvolvimento de Liderança foi criada para mudar isso.\n              Uma jornada intencional, estruturada e acompanhada para líderes que querem\n              <strong>evoluir de forma consistente</strong>.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-context__tensions\">\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Comunicar com clareza e influência em contextos de alta pressão</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Tomar decisões estratégicas em cenários de incerteza e mudança acelerada</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Compreender o impacto da IA no trabalho e na gestão de pessoas</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Conectar aprendizados teóricos à realidade concreta dos desafios de liderança</div>\n            </div>\n            <div class=\"ldp-tension\">\n              <div class=\"ldp-tension__dot\"></div>\n              <div class=\"ldp-tension__text\">Desenvolver uma liderança mais consciente, consistente e adaptável</div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       3. O QUE É A TRILHA\n  ============================================================ -->\n  <section class=\"ldp-what\" aria-label=\"O que é a Trilha de Desenvolvimento de Liderança\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-what__header ldp-reveal\">\n        <div>\n          <div class=\"ldp-eyebrow\">A jornada completa</div>\n          <h2 class=\"ldp-what__title\">\n            Uma jornada completa para\n            desenvolver sua liderança\n            em até 12 meses.\n          </h2>\n        </div>\n        <p class=\"ldp-what__intro\">\n          A Trilha reúne <strong>três cursos online ao vivo da Hyper Island</strong> com\n          <strong>três sessões individuais de coaching</strong>. Ao longo da jornada,\n          você desenvolve competências essenciais para liderar com mais clareza, visão\n          estratégica e capacidade de ação em contextos de transformação.\n        </p>\n      </div>\n\n      <div class=\"ldp-components\">\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-1\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">01</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Curso Online Ao Vivo</div>\n          <h3 class=\"ldp-component-card__title\">Comunicação Executiva</h3>\n          <p class=\"ldp-component-card__text\">\n            Clareza, influência e presença para comunicar decisões, alinhar\n            stakeholders e conduzir conversas difíceis com mais impacto.\n          </p>\n        </article>\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">02</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Curso Online Ao Vivo</div>\n          <h3 class=\"ldp-component-card__title\">Explorando Futuros</h3>\n          <p class=\"ldp-component-card__text\">\n            Leitura de sinais de mudança, construção de cenários e tomada de\n            decisão estratégica diante da incerteza.\n          </p>\n        </article>\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-3\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">03</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Curso Online Ao Vivo</div>\n          <h3 class=\"ldp-component-card__title\">Liderar na Era da IA</h3>\n          <p class=\"ldp-component-card__text\">\n            Repertório prático para liderar em ambientes cada vez mais\n            tecnológicos e compreender o impacto da IA nos times.\n          </p>\n        </article>\n\n        <article class=\"ldp-component-card ldp-reveal ldp-delay-4\">\n          <div class=\"ldp-component-card__num\" aria-hidden=\"true\">04</div>\n          <div class=\"ldp-component-card__marker\" aria-hidden=\"true\"></div>\n          <div class=\"ldp-component-card__tag\">Individual · Até 12 meses</div>\n          <h3 class=\"ldp-component-card__title\">3 Sessões de Coaching Individual</h3>\n          <p class=\"ldp-component-card__text\">\n            Acompanhamento personalizado para conectar os aprendizados à\n            sua realidade e fortalecer a evolução ao longo da jornada.\n          </p>\n        </article>\n\n      </div>\n\n      <div style=\"margin-top:48px; text-align:center;\" class=\"ldp-reveal\">\n        <a href=\"#formulario\" class=\"ldp-btn ldp-btn-orange\">Quero saber mais sobre a trilha</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       3.5 VALOR DA TRILHA — comparativo\n  ============================================================ -->\n  <section class=\"ldp-value\" aria-label=\"Valor da Trilha de Desenvolvimento de Liderança\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-value__header ldp-reveal\">\n        <div class=\"ldp-eyebrow\">Por que a trilha vale mais</div>\n        <h2 class=\"ldp-value__title\">\n          Tudo que você precisa,<br>\n          por muito menos do que<br>\n          comprando por partes.\n        </h2>\n        <p class=\"ldp-value__intro\">\n          Se você fosse contratar cada treinamento de forma avulsa, o investimento total chegaria a\n          R$ 12.370. Com a Trilha de Desenvolvimento de Liderança, você tem acesso a\n          tudo isso por R$ 8.990.\n        </p>\n      </div>\n\n      <div class=\"ldp-value__inner\">\n\n        <!-- Coluna esquerda: itens avulsos -->\n        <div class=\"ldp-reveal\" style=\"display:flex;flex-direction:column;\">\n          <div class=\"ldp-value__avulso\">\n            <div class=\"ldp-value__avulso-label\">Se comprado separadamente</div>\n\n            <div class=\"ldp-value__item\">\n              <div class=\"ldp-value__item-info\">\n                <div class=\"ldp-value__item-name\">Comunicação Executiva</div>\n                <div class=\"ldp-value__item-sub\">Curso online ao vivo · Hyper Island</div>\n              </div>\n              <div class=\"ldp-value__item-price\">R$ 2.990</div>\n            </div>\n\n            <div class=\"ldp-value__item\">\n              <div class=\"ldp-value__item-info\">\n                <div class=\"ldp-value__item-name\">Explorando Futuros</div>\n                <div class=\"ldp-value__item-sub\">Curso online ao vivo · Hyper Island</div>\n              </div>\n              <div class=\"ldp-value__item-price\">R$ 2.990</div>\n            </div>\n\n            <div class=\"ldp-value__item\">\n              <div class=\"ldp-value__item-info\">\n                <div class=\"ldp-value__item-name\">Liderar na Era da IA</div>\n                <div class=\"ldp-value__item-sub\">Curso online ao vivo · Hyper Island</div>\n              </div>\n              <div class=\"ldp-value__item-price\">R$ 3.690</div>\n            </div>\n\n            <div class=\"ldp-value__item\">\n              <div class=\"ldp-value__item-info\">\n                <div class=\"ldp-value__item-name\">3 Sessões de Coaching Individual</div>\n                <div class=\"ldp-value__item-sub\">R$ 900 cada · total de 3 sessões</div>\n              </div>\n              <div class=\"ldp-value__item-price\">R$ 2.700</div>\n            </div>\n\n            <div class=\"ldp-value__total-avulso\">\n              <div class=\"ldp-value__total-label\">Total avulso</div>\n              <div class=\"ldp-value__total-price\">R$ 12.370</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Coluna direita: card da trilha -->\n        <div class=\"ldp-reveal ldp-delay-2\" style=\"display:flex;flex-direction:column;\">\n          <div class=\"ldp-value__trilha\">\n            <div class=\"ldp-value__trilha-badge\">Trilha de Liderança</div>\n            <div class=\"ldp-value__trilha-title\">\n              Os três cursos e o coaching,<br>em uma única jornada.\n            </div>\n            <ul class=\"ldp-value__trilha-includes\">\n              <li>Comunicação Executiva</li>\n              <li>Explorando Futuros</li>\n              <li>Liderar na Era da IA</li>\n              <li>3 sessões de coaching individual</li>\n              <li>Até 12 meses para conclusão</li>\n            </ul>\n            <div class=\"ldp-value__trilha-pricing\">\n              <div class=\"ldp-value__trilha-price-label\">Por apenas</div>\n              <div class=\"ldp-value__trilha-price\">R$ 8.990</div>\n              <div class=\"ldp-value__trilha-economy\">Economia de R$ 3.380</div>\n            </div>\n            <a href=\"#formulario\" class=\"ldp-value__trilha-cta\">Quero conhecer a Trilha →</a>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       4. PILARES DA TRILHA\n  ============================================================ -->\n  <section class=\"ldp-pillars\" id=\"pilares\" aria-label=\"Pilares da Trilha de Liderança\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-pillars__header ldp-reveal\">\n        <div>\n          <div class=\"ldp-eyebrow\">Os quatro pilares</div>\n          <h2 class=\"ldp-pillars__title\">\n            O que cada etapa\n            desenvolve em você.\n          </h2>\n        </div>\n        <p class=\"ldp-pillars__intro\">\n          Cada componente da trilha foi escolhido para desenvolver uma dimensão\n          essencial da liderança atual. Juntos, formam uma jornada integrada\n          e progressiva.\n        </p>\n      </div>\n\n      <div class=\"ldp-pillars__grid\">\n\n        <article class=\"ldp-pillar-card ldp-reveal ldp-delay-1\">\n          <div class=\"ldp-pillar-card__icon\">Comunicação</div>\n          <h3 class=\"ldp-pillar-card__title\">Comunicação Executiva</h3>\n          <p class=\"ldp-pillar-card__text\">\n            Desenvolva clareza, influência e presença para comunicar ideias,\n            conduzir conversas importantes, apresentar decisões e alinhar\n            stakeholders com mais impacto.\n          </p>\n          <ul class=\"ldp-pillar-card__list\">\n            <li>Comunicação estratégica e presença executiva</li>\n            <li>Conversas difíceis e alinhamento de stakeholders</li>\n            <li>Apresentações de impacto e influência</li>\n          </ul>\n        </article>\n\n        <article class=\"ldp-pillar-card ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-pillar-card__icon\">Futuros</div>\n          <h3 class=\"ldp-pillar-card__title\">Explorando Futuros</h3>\n          <p class=\"ldp-pillar-card__text\">\n            Amplie sua capacidade de ler sinais de mudança, construir cenários\n            e tomar decisões mais estratégicas diante da incerteza.\n          </p>\n          <ul class=\"ldp-pillar-card__list\">\n            <li>Análise de sinais de mudança e tendências</li>\n            <li>Construção de cenários futuros</li>\n            <li>Tomada de decisão em contextos incertos</li>\n          </ul>\n        </article>\n\n        <article class=\"ldp-pillar-card ldp-reveal ldp-delay-3\">\n          <div class=\"ldp-pillar-card__icon\">Inteligência Artificial</div>\n          <h3 class=\"ldp-pillar-card__title\">Liderar na Era da IA</h3>\n          <p class=\"ldp-pillar-card__text\">\n            Entenda como a inteligência artificial transforma o trabalho, os times\n            e o papel da liderança. Desenvolva repertório para liderar em ambientes\n            cada vez mais tecnológicos.\n          </p>\n          <ul class=\"ldp-pillar-card__list\">\n            <li>Impacto da IA na gestão e nos modelos de trabalho</li>\n            <li>Novas competências de liderança em contextos tecnológicos</li>\n            <li>Tomada de decisão com inteligência artificial</li>\n          </ul>\n        </article>\n\n        <article class=\"ldp-pillar-card ldp-reveal ldp-delay-4\">\n          <div class=\"ldp-pillar-card__icon\">Coaching</div>\n          <h3 class=\"ldp-pillar-card__title\">Coaching Individual</h3>\n          <p class=\"ldp-pillar-card__text\">\n            Conecte os aprendizados à sua realidade. Em três sessões individuais,\n            você aprofunda reflexões, trabalha desafios reais e acompanha sua\n            evolução ao longo da jornada.\n          </p>\n          <ul class=\"ldp-pillar-card__list\">\n            <li>Aplicação prática dos aprendizados nos desafios reais</li>\n            <li>Fortalecimento de autoliderança e plano de desenvolvimento</li>\n            <li>Acompanhamento personalizado ao longo de até 12 meses</li>\n          </ul>\n        </article>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       5. PARA QUEM É\n  ============================================================ -->\n  <section class=\"ldp-audience\" aria-label=\"Para quem é a trilha\">\n    <div class=\"ldp-container\">\n      <div class=\"ldp-audience__inner\">\n\n        <div class=\"ldp-reveal\">\n          <div class=\"ldp-eyebrow\">O público certo</div>\n          <h2 class=\"ldp-audience__title\">\n            Para líderes que querem\n            se desenvolver com\n            profundidade.\n          </h2>\n          <p class=\"ldp-audience__body\">\n            A experiência foi pensada para quem quer desenvolver uma\n            <strong>liderança mais completa</strong>, conectada aos desafios atuais\n            e preparada para tomar decisões com mais consciência.\n          </p>\n          <div class=\"ldp-audience__tags\">\n            <span class=\"ldp-audience__tag\">Líderes de equipe</span>\n            <span class=\"ldp-audience__tag\">Gestores em crescimento</span>\n            <span class=\"ldp-audience__tag\">Executivos e heads</span>\n            <span class=\"ldp-audience__tag\">Transição para liderança</span>\n            <span class=\"ldp-audience__tag\">Profissionais de influência</span>\n          </div>\n        </div>\n\n        <div class=\"ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-audience__panel\">\n            <div class=\"ldp-audience__panel-label\">A trilha é para você se…</div>\n            <div class=\"ldp-audience__row\">Quer se comunicar com mais clareza e influência</div>\n            <div class=\"ldp-audience__row\">Precisa pensar mais estrategicamente sobre o futuro</div>\n            <div class=\"ldp-audience__row\">Quer entender o impacto da IA na sua liderança</div>\n            <div class=\"ldp-audience__row\">Busca mais do que um treinamento pontual</div>\n            <div class=\"ldp-audience__row\">Quer desenvolvimento acompanhado ao longo do tempo</div>\n            <div class=\"ldp-audience__row\">Precisa de espaço para reflexão e aplicação prática</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       6. BENEFÍCIOS\n  ============================================================ -->\n  <section class=\"ldp-benefits\" aria-label=\"Benefícios da Trilha de Liderança\">\n    <div class=\"ldp-container\">\n      <header class=\"ldp-benefits__header ldp-reveal\">\n        <div class=\"ldp-eyebrow\" style=\"justify-content:center;\">O que você desenvolve</div>\n        <h2 class=\"ldp-benefits__title\">O que você leva ao longo da jornada.</h2>\n        <p class=\"ldp-benefits__intro\">\n          Competências concretas, conexões reais e um plano de desenvolvimento\n          mais consistente para continuar evoluindo depois da trilha.\n        </p>\n      </header>\n\n      <div class=\"ldp-benefits__grid\">\n\n        <div class=\"ldp-benefit-item ldp-reveal ldp-delay-1\">\n          <div class=\"ldp-benefit-item__num\">01</div>\n          <div class=\"ldp-benefit-item__title\">Comunicação mais clara e influente</div>\n          <p class=\"ldp-benefit-item__text\">Segurança para conduzir conversas importantes, alinhar stakeholders e apresentar ideias com impacto.</p>\n        </div>\n\n        <div class=\"ldp-benefit-item ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-benefit-item__num\">02</div>\n          <div class=\"ldp-benefit-item__title\">Visão de futuro aplicada ao negócio</div>\n          <p class=\"ldp-benefit-item__text\">Capacidade de interpretar sinais de mudança e construir cenários estratégicos relevantes.</p>\n        </div>\n\n        <div class=\"ldp-benefit-item ldp-reveal ldp-delay-3\">\n          <div class=\"ldp-benefit-item__num\">03</div>\n          <div class=\"ldp-benefit-item__title\">Repertório prático sobre IA e liderança</div>\n          <p class=\"ldp-benefit-item__text\">Compreensão do impacto da inteligência artificial e das novas competências que isso exige dos líderes.</p>\n        </div>\n\n        <div class=\"ldp-benefit-item ldp-reveal\">\n          <div class=\"ldp-benefit-item__num\">04</div>\n          <div class=\"ldp-benefit-item__title\">Aprendizado conectado à sua realidade</div>\n          <p class=\"ldp-benefit-item__text\">Sessões de coaching que traduzem o aprendizado dos cursos para os desafios concretos do seu dia a dia.</p>\n        </div>\n\n        <div class=\"ldp-benefit-item ldp-reveal ldp-delay-1\">\n          <div class=\"ldp-benefit-item__num\">05</div>\n          <div class=\"ldp-benefit-item__title\">Plano de desenvolvimento individual</div>\n          <p class=\"ldp-benefit-item__text\">Uma trajetória mais clara, com marcos, reflexões e intenções de evolução que você pode continuar seguindo.</p>\n        </div>\n\n        <div class=\"ldp-benefit-item ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-benefit-item__num\">06</div>\n          <div class=\"ldp-benefit-item__title\">Troca com outros líderes</div>\n          <p class=\"ldp-benefit-item__text\">Contato com profissionais de diferentes setores e contextos que enriquecem as perspectivas ao longo dos cursos.</p>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       7. COMO FUNCIONA — TIMELINE\n  ============================================================ -->\n  <section class=\"ldp-how\" aria-label=\"Como a jornada acontece\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-how__header ldp-reveal\">\n        <div class=\"ldp-eyebrow\">Passo a passo</div>\n        <h2 class=\"ldp-how__title\">Como a jornada acontece.</h2>\n      </div>\n\n      <div class=\"ldp-timeline\">\n\n        <div class=\"ldp-timeline-step ldp-reveal ldp-delay-1\">\n          <div class=\"ldp-timeline-step__dot\">01</div>\n          <div class=\"ldp-timeline-step__content\">\n            <div class=\"ldp-timeline-step__label\">Início</div>\n            <div class=\"ldp-timeline-step__title\">Inscrição na Trilha</div>\n            <p class=\"ldp-timeline-step__text\">\n              Você entra em contato com a equipe da Hyper Island, confirma a sua vaga\n              e recebe todas as informações sobre o cronograma, os cursos e as sessões\n              de coaching.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"ldp-timeline-step ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-timeline-step__dot\">02</div>\n          <div class=\"ldp-timeline-step__content\">\n            <div class=\"ldp-timeline-step__label\">Cursos online ao vivo</div>\n            <div class=\"ldp-timeline-step__title\">Três cursos Hyper Island</div>\n            <p class=\"ldp-timeline-step__text\">\n              Participação nos três cursos online ao vivo: Comunicação Executiva,\n              Explorando Futuros e Liderar na Era da IA. Cada curso combina\n              aprendizagem ativa, troca entre participantes e prática aplicada.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"ldp-timeline-step ldp-reveal ldp-delay-3\">\n          <div class=\"ldp-timeline-step__dot\">03</div>\n          <div class=\"ldp-timeline-step__content\">\n            <div class=\"ldp-timeline-step__label\">Ao longo de até 12 meses</div>\n            <div class=\"ldp-timeline-step__title\">3 sessões individuais de coaching</div>\n            <p class=\"ldp-timeline-step__text\">\n              Sessões individuais realizadas ao longo da jornada para integrar os\n              aprendizados, trabalhar desafios reais e acompanhar sua evolução de\n              forma personalizada.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"ldp-timeline-step ldp-reveal ldp-delay-4\">\n          <div class=\"ldp-timeline-step__dot\">04</div>\n          <div class=\"ldp-timeline-step__content\">\n            <div class=\"ldp-timeline-step__label\">Durante e depois</div>\n            <div class=\"ldp-timeline-step__title\">Aplicação prática e evolução acompanhada</div>\n            <p class=\"ldp-timeline-step__text\">\n              Os aprendizados de cada curso são levados para os desafios reais\n              do dia a dia. O coaching garante que você tenha suporte para\n              aplicar, refletir e continuar evoluindo.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- ============================================================\n       9. SOBRE A HYPER ISLAND\n  ============================================================ -->\n  <section class=\"ldp-about\" aria-label=\"Sobre a Hyper Island\">\n    <div class=\"ldp-container\">\n      <div class=\"ldp-about__inner\">\n\n        <div class=\"ldp-reveal\">\n          <div class=\"ldp-eyebrow\">Quem está por trás</div>\n          <h2 class=\"ldp-about__title\">\n            Aprenda com a\n            <em>Hyper Island.</em>\n          </h2>\n          <div class=\"ldp-about__body\">\n            <p>\n              A Hyper Island é uma escola global de negócios e consultoria de\n              transformação fundada na Suécia em 1996. Com atuação em mais de\n              seis países, desenvolve <strong>líderes, times e organizações</strong>\n              para lidar com mudanças, inovação e transformação.\n            </p>\n            <p>\n              Nossa abordagem combina aprendizagem experiencial, colaboração ativa,\n              reflexão e aplicação prática para transformar conhecimento em ação\n              real — em qualquer contexto, setor ou desafio.\n            </p>\n            <p>\n              No Brasil, trabalhamos com organizações como Itaú, Grupo Boticário,\n              Mondelez, Stellantis, Bradesco, Netflix e centenas de líderes que buscam\n              desenvolvimento mais intencional e consistente.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"ldp-reveal ldp-delay-2\">\n          <div class=\"ldp-about__stats\">\n            <div class=\"ldp-about__stat\">\n              <div class=\"ldp-about__stat-num\">30<span>+</span>\n</div>\n              <div class=\"ldp-about__stat-label\">Anos de história</div>\n            </div>\n            <div class=\"ldp-about__stat\">\n              <div class=\"ldp-about__stat-num\">6</div>\n              <div class=\"ldp-about__stat-label\">Hubs globais</div>\n            </div>\n            <div class=\"ldp-about__stat\">\n              <div class=\"ldp-about__stat-num\">2k<span>+</span>\n</div>\n              <div class=\"ldp-about__stat-label\">Empresas impactadas</div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       10. FAQ\n  ============================================================ -->\n  <section class=\"ldp-faq\" aria-label=\"Perguntas frequentes sobre a Trilha de Liderança\">\n    <div class=\"ldp-container\">\n      <div class=\"ldp-faq__header ldp-reveal\">\n        <div class=\"ldp-eyebrow\">Perguntas frequentes</div>\n        <h2 class=\"ldp-faq__title\">Tudo o que você precisa saber.</h2>\n        <p class=\"ldp-faq__intro\">\n          Respostas diretas sobre a Trilha de Desenvolvimento de Liderança,\n          formato, coaching e como participar.\n        </p>\n      </div>\n\n      <div class=\"ldp-faq__list ldp-reveal ldp-delay-1\">\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">A trilha é online?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>Sim. Os três cursos acontecem <strong>online ao vivo</strong>, com interação em tempo real, práticas e troca entre participantes. As sessões de coaching são realizadas individualmente, também de forma online.</p>\n          </div>\n        </details>\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">As sessões de coaching são individuais?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>Sim. A trilha inclui <strong>3 sessões individuais de coaching</strong> ao longo de até 12 meses, realizadas com um coach dedicado ao seu desenvolvimento. O objetivo é conectar os aprendizados dos cursos aos seus desafios reais de liderança.</p>\n          </div>\n        </details>\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">Preciso fazer os três cursos?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>Sim. A proposta da trilha é justamente integrar os três cursos em uma jornada completa e progressiva. Cada curso desenvolve uma dimensão complementar da liderança, e o conjunto deles forma uma experiência mais consistente do que qualquer ação isolada.</p>\n          </div>\n        </details>\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">Para quem essa trilha é indicada?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>A trilha é voltada para <strong>líderes, gestores, executivos e profissionais em posição de influência</strong> que querem desenvolver comunicação estratégica, visão de futuro, repertório sobre inteligência artificial e maior consciência sobre sua liderança.</p>\n          </div>\n        </details>\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">As vagas são limitadas?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>Sim. As vagas são <strong>intencionalmente limitadas</strong> para garantir a qualidade da experiência, profundidade nas trocas nos cursos ao vivo e acompanhamento individual no coaching.</p>\n          </div>\n        </details>\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">Como faço para saber valores e condições?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>Preencha o formulário abaixo ou entre em contato com a equipe da Hyper Island. Nossa equipe comercial irá apresentar as informações completas sobre <strong>investimento, datas e disponibilidade de vagas</strong>.</p>\n          </div>\n        </details>\n\n        <details class=\"ldp-faq__item\">\n          <summary class=\"ldp-faq__question\">Existe algum pré-requisito para participar?</summary>\n          <div class=\"ldp-faq__answer\">\n            <p>Não há pré-requisito formal. A trilha é desenhada para <strong>líderes com experiência de gestão</strong> que querem se desenvolver de forma mais completa e acompanhada. Se você lidera pessoas, projetos ou decisões, a trilha foi pensada para o seu contexto.</p>\n          </div>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       11. FORMULÁRIO FINAL\n  ============================================================ -->\n  <section class=\"ldp-form-section\" id=\"formulario\" aria-label=\"Formulário de interesse na Trilha de Liderança\">\n    <div class=\"ldp-container\">\n\n      <div class=\"ldp-reveal\" style=\"max-width:720px; margin-bottom:52px;\">\n        <div class=\"ldp-eyebrow\">Comece agora</div>\n        <h2 class=\"ldp-form-section__title\">\n          Comece sua jornada de\n          desenvolvimento de\n          <em>liderança.</em>\n        </h2>\n        <p class=\"ldp-form-section__text\">\n          Preencha o formulário e nossa equipe entrará em contato com mais\n          informações sobre a Trilha de Desenvolvimento de Liderança: datas,\n          investimento e disponibilidade de vagas.\n        </p>\n\n      </div>\n\n      <div class=\"ldp-reveal ldp-delay-1\">\n        <div class=\"ldp-tf-wrap\">\n          <div data-tf-live=\"01M1C5EA0GGTRN4YP56WGBSNP6\"></div>\n<script src=\"//embed.typeform.com/next/embed.js\"></script>\n        </div>\n        <p class=\"ldp-form__microcopy\">\n          As vagas são limitadas. O contato será feito pela equipe da Hyper Island.\n        </p>\n      </div>\n\n    </div>\n  </section>\n\n</div><!-- /.hi-ldp -->\n\n<!-- ============================================================\n     SCHEMA JSON-LD — SEO + AI Search\n============================================================ -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Course\",\n      \"name\": \"Trilha de Desenvolvimento de Liderança\",\n      \"description\": \"Uma jornada exclusiva de até 12 meses para líderes que querem desenvolver comunicação executiva, visão de futuro, liderança na era da IA e acompanhamento individual com coaching.\",\n      \"provider\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Hyper Island Brasil\",\n        \"url\": \"https://www.hyperisland.com.br\"\n      },\n      \"educationalLevel\": \"Executive\",\n      \"courseMode\": \"Online\",\n      \"inLanguage\": \"pt-BR\",\n      \"offers\": {\n        \"@type\": \"Offer\",\n        \"availability\": \"https://schema.org/LimitedAvailability\",\n        \"category\": \"Leadership Development\"\n      }\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"A trilha de liderança da Hyper Island é online?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Sim. Os três cursos acontecem online ao vivo, com interação em tempo real. As sessões de coaching são realizadas individualmente, também de forma online.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"O que inclui a Trilha de Desenvolvimento de Liderança da Hyper Island?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"A trilha inclui três cursos online ao vivo (Comunicação Executiva, Explorando Futuros e Liderar na Era da IA) mais três sessões individuais de coaching ao longo de até 12 meses, tudo em um único investimento.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Para quem é a Trilha de Desenvolvimento de Liderança?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Para líderes, gestores, executivos e profissionais em posição de influência que querem desenvolver comunicação estratégica, visão de futuro, repertório sobre IA e maior consciência sobre sua liderança.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>\n\n<!-- ============================================================\n     JAVASCRIPT — Scroll Reveal\n============================================================ -->\n<script>\n(function hiLdp() {\n  'use strict';\n\n  function initReveal() {\n    var els = document.querySelectorAll('.hi-ldp .ldp-reveal');\n    if (!els.length) return;\n\n    if ('IntersectionObserver' in window) {\n      var observer = new IntersectionObserver(function(entries) {\n        entries.forEach(function(entry) {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('ldp-visible');\n            observer.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.10 });\n\n      els.forEach(function(el) { observer.observe(el); });\n    } else {\n      els.forEach(function(el) { el.classList.add('ldp-visible'); });\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initReveal);\n  } else {\n    initReveal();\n  }\n})();\n</script>",
