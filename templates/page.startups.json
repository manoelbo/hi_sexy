    "html_em9Lh7": {
      "type": "html",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Programa de Aceleração para Startups | Hyper Island</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://kit.fontawesome.com/a076d05399.js\" crossorigin=\"anonymous\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        \n        body {\n            font-family: 'Inter', sans-serif;\n            color: #333;\n        }\n        \n        .highlight {\n            color: #FF7700;\n        }\n        \n        .btn-primary {\n            background-color: #FF7700;\n            transition: all 0.3s ease;\n        }\n        \n        .btn-primary:hover {\n            background-color: #e66900;\n            transform: translateY(-2px);\n            box-shadow: 0 4px 12px rgba(255, 119, 0, 0.2);\n        }\n        \n        .timeline {\n            position: relative;\n            max-width: 800px;\n            margin: 0 auto;\n        }\n        \n        .timeline::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 50px;\n            height: 100%;\n            width: 2px;\n            background-color: #FF7700;\n        }\n        \n        .timeline-item {\n            position: relative;\n            padding-left: 80px;\n            margin-bottom: 40px;\n        }\n        \n        .timeline-icon {\n            position: absolute;\n            left: 30px;\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            background-color: #FF7700;\n            color: white;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: bold;\n        }\n        \n        .mentor-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);\n        }\n        \n        .benefit-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 10px 25px rgba(255, 119, 0, 0.1);\n        }\n    </style>\n\n\n   \n    <!-- Benefits Section -->\n    <section class=\"py-16 bg-gray-50\">\n        <div class=\"max-w-6xl mx-auto px-4 md:px-8\">\n            <h1 class=\"text-4xl font-bold text-center mb-12\">O que sua startup vai ganhar no programa</h1>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n                <!-- Benefit 1 -->\n                <div class=\"benefit-card bg-white p-8 rounded-xl transition-all duration-300\">\n                    <div class=\"w-14 h-14 bg-orange-100 rounded-full flex items-center justify-center mb-6\">\n                        <i class=\"fas fa-user-tie text-2xl text-[#FF7700]\"></i>\n                    </div>\n                    <h2 class=\"text-xl font-semibold mb-3\">Mentorias especializadas</h2>\n                    <p class=\"text-gray-600\">\n                        Consultores da Hyper Island de diversas áreas te ajudam a superar desafios específicos do seu negócio.\n                    </p>\n                </div>\n                \n                <!-- Benefit 2 -->\n                <div class=\"benefit-card bg-white p-8 rounded-xl transition-all duration-300\">\n                    <div class=\"w-14 h-14 bg-orange-100 rounded-full flex items-center justify-center mb-6\">\n                        <i class=\"fas fa-graduation-cap text-2xl text-[#FF7700]\"></i>\n                    </div>\n                    <h2 class=\"text-xl font-semibold mb-3\">Cursos e eventos gratuitos</h2>\n                    <p class=\"text-gray-600\">\n                        Participação em cursos e eventos exclusivos da Hyper Island Brasil e North America.\n                    </p>\n                </div>\n                \n                <!-- Benefit 3 -->\n                <div class=\"benefit-card bg-white p-8 rounded-xl transition-all duration-300\">\n                    <div class=\"w-14 h-14 bg-orange-100 rounded-full flex items-center justify-center mb-6\">\n                        <i class=\"fas fa-users text-2xl text-[#FF7700]\"></i>\n                    </div>\n                    <h2 class=\"text-xl font-semibold mb-3\">Networking e certificado</h2>\n                    <p class=\"text-gray-600\">\n                        Acesso à rede da Hyper Island e certificado reconhecido ao final do programa.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    \n    <!-- How It Works Section -->\n    <section class=\"py-16 bg-white\">\n        <div class=\"max-w-6xl mx-auto px-4 md:px-8\">\n            <h2 class=\"text-4xl font-bold text-center mb-12\">Como funciona o programa</h2>\n            \n            <div class=\"timeline\">\n                <!-- Step 1 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-icon\">1</div>\n                    <div class=\"bg-gray-50 p-6 rounded-lg\">\n                        <h3 class=\"font-semibold text-xl mb-2\">Inscrição</h3>\n                        <p class=\"text-gray-500 mb-2\">Até 30 de junho</p>\n                        <p class=\"text-gray-600\">\n                            Preencha o formulário com informações sobre sua startup para participar do processo seletivo.\n                        </p>\n                    </div>\n                </div>\n                \n                <!-- Step 2 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-icon\">2</div>\n                    <div class=\"bg-gray-50 p-6 rounded-lg\">\n                        <h3 class=\"font-semibold text-xl mb-2\">Seleção</h3>\n                        <p class=\"text-gray-500 mb-2\">Julho</p>\n                        <p class=\"text-gray-600\">\n                            Nossa equipe analisará todas as startups inscritas para selecionar as mais promissoras.\n                        </p>\n                    </div>\n                </div>\n                \n                <!-- Step 3 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-icon\">3</div>\n                    <div class=\"bg-gray-50 p-6 rounded-lg\">\n                        <h3 class=\"font-semibold text-xl mb-2\">Aceleração</h3>\n                        <p class=\"text-gray-500 mb-2\">Agosto a Maio</p>\n                        <p class=\"text-gray-600\">\n                            10 meses intensivos de mentorias personalizadas, workshops e desenvolvimento do seu negócio.\n                        </p>\n                    </div>\n                </div>\n                \n                <!-- Step 4 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-icon\">4</div>\n                    <div class=\"bg-gray-50 p-6 rounded-lg\">\n                        <h3 class=\"font-semibold text-xl mb-2\">Graduação</h3>\n                        <p class=\"text-gray-500 mb-2\">Junho</p>\n                        <p class=\"text-gray-600\">\n                            Cerimônia de formatura com entrega de certificado e apresentação dos resultados alcançados.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    \n    <!-- Mentors Section -->\n    <section class=\"py-16 bg-gray-50\">\n        <div class=\"max-w-6xl mx-auto px-4 md:px-8\">\n            <div class=\"text-center mb-12\">\n                <span class=\"text-[#FF7700] font-semibold\">Mentores Hyper Island</span>\n                <h2 class=\"text-3xl font-bold mt-2\">Conheça nossos mentores</h2>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <!-- Mentor 1 -->\n                <div class=\"mentor-card bg-white p-6 rounded-xl transition-all duration-300\">\n                    <div class=\"flex items-center mb-4\">\n                        <img src=\"https://randomuser.me/api/portraits/women/43.jpg\" alt=\"Mentor\" class=\"w-16 h-16 rounded-full object-cover mr-4\">\n                        <div>\n                            <h3 class=\"font-semibold text-lg\">Ana Silva</h3>\n                            <p class=\"text-sm text-gray-500\">Especialista em Growth</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600\">\n                        Ex-Google, ajudou mais de 50 startups a escalarem suas operações com estratégias de crescimento comprovadas.\n                    </p>\n                </div>\n                \n                <!-- Mentor 2 -->\n                <div class=\"mentor-card bg-white p-6 rounded-xl transition-all duration-300\">\n                    <div class=\"flex items-center mb-4\">\n                        <img src=\"https://randomuser.me/api/portraits/men/32.jpg\" alt=\"Mentor\" class=\"w-16 h-16 rounded-full object-cover mr-4\">\n                        <div>\n                            <h3 class=\"font-semibold text-lg\">Carlos Mendes</h3>\n                            <p class=\"text-sm text-gray-500\">Especialista em Finanças</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600\">\n                        Investidor anjo com experiência em valuation e estruturação financeira para startups em fase inicial.\n                    </p>\n                </div>\n                \n                <!-- Mentor 3 -->\n                <div class=\"mentor-card bg-white p-6 rounded-xl transition-all duration-300\">\n                    <div class=\"flex items-center mb-4\">\n                        <img src=\"https://randomuser.me/api/portraits/women/65.jpg\" alt=\"Mentor\" class=\"w-16 h-16 rounded-full object-cover mr-4\">\n                        <div>\n                            <h3 class=\"font-semibold text-lg\">Mariana Costa</h3>\n                            <p class=\"text-sm text-gray-500\">Especialista em Produto</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600\">\n                        Líder de produto com passagem por startups unicórnio, especialista em UX e desenvolvimento ágil.\n                    </p>\n                </div>\n                \n                <!-- Mentor 4 -->\n                <div class=\"mentor-card bg-white p-6 rounded-xl transition-all duration-300\">\n                    <div class=\"flex items-center mb-4\">\n                        <img src=\"https://randomuser.me/api/portraits/men/75.jpg\" alt=\"Mentor\" class=\"w-16 h-16 rounded-full object-cover mr-4\">\n                        <div>\n                            <h3 class=\"font-semibold text-lg\">Ricardo Almeida</h3>\n                            <p class=\"text-sm text-gray-500\">Especialista em Tech</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600\">\n                        CTO serial com experiência em arquitetura escalável e contratação de times técnicos de alta performance.\n                    </p>\n                </div>\n                \n                <!-- Mentor 5 -->\n                <div class=\"mentor-card bg-white p-6 rounded-xl transition-all duration-300\">\n                    <div class=\"flex items-center mb-4\">\n                        <img src=\"https://randomuser.me/api/portraits/women/33.jpg\" alt=\"Mentor\" class=\"w-16 h-16 rounded-full object-cover mr-4\">\n                        <div>\n                            <h3 class=\"font-semibold text-lg\">Fernanda Oliveira</h3>\n                            <p class=\"text-sm text-gray-500\">Especialista em Marketing</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600\">\n                        Especialista em marketing digital e branding para startups, com cases de sucesso em diversos setores.\n                    </p>\n                </div>\n                \n                <!-- Mentor 6 -->\n                <div class=\"mentor-card bg-white p-6 rounded-xl transition-all duration-300\">\n                    <div class=\"flex items-center mb-4\">\n                        <img src=\"https://randomuser.me/api/portraits/men/55.jpg\" alt=\"Mentor\" class=\"w-16 h-16 rounded-full object-cover mr-4\">\n                        <div>\n                            <h3 class=\"font-semibold text-lg\">Pedro Santos</h3>\n                            <p class=\"text-sm text-gray-500\">Especialista em Vendas</p>\n                        </div>\n                    </div>\n                    <p class=\"text-gray-600\">\n                        Executivo de vendas com experiência em B2B e B2C, ajudou startups a estruturarem funis de vendas eficientes.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    \n    <!-- Registration Form Section -->\n    <section id=\"inscricao\" class=\"py-16\">\n        <div class=\"max-w-4xl mx-auto px-4 md:px-8\">\n            <div class=\"text-center mb-12\">\n                <h2 class=\"text-3xl font-bold mb-3\">Pronto para acelerar sua startup?</h2>\n                <p class=\"text-lg text-gray-600\">\n                    Preencha o formulário abaixo para participar do processo seletivo. O programa tem vagas limitadas.\n                </p>\n            </div>\n            \n            <!-- HubSpot Form -->\n            <div class=\"bg-white p-8 rounded-xl shadow-sm\">\n                <script src=\"https://js.hsforms.net/forms/embed/1588780.js\" defer></script>\n                <div class=\"hs-form-frame\" data-region=\"na1\" data-form-id=\"30e69048-c88a-4dea-a14a-c20d71a5b1a4\" data-portal-id=\"1588780\"></div>\n            </div>\n        </div>\n    </section>",
