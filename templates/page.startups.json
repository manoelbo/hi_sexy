fas fa-users mr-2\"></i> Conhecer mentores\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- How It Works Section -->\n    <section class=\"py-12 bg-white\">\n        <div class=\"max-w-6xl mx-auto px-4 md:px-8\">\n            <h2 class=\"text-2xl font-bold text-center mb-8\">Como agendar sua mentoria</h2>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n                <!-- Step 1 -->\n                <div class=\"text-center px-6\">\n                    <div class=\"w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n                        <span class=\"text-2xl font-bold text-[#FF7700]\">1</span>\n                    </div>\n                    <h3 class=\"font-semibold text-lg mb-2\">Escolha seu mentor</h3>\n                    <p class=\"text-gray-600\">\n                        Selecione entre nossos especialistas em diferentes áreas de atuação.\n                    </p>\n                </div>\n                \n                <!-- Step 2 -->\n                <div class=\"text-center px-6\">\n                    <div class=\"w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n                        <span class=\"text-2xl font-bold text-[#FF7700]\">2</span>\n                    </div>\n                    <h3 class=\"font-semibold text-lg mb-2\">Selecione o horário</h3>\n                    <p class=\"text-gray-600\">\n                        Veja a disponibilidade em tempo real e escolha o melhor horário para você.\n                    </p>\n                </div>\n                \n                <!-- Step 3 -->\n                <div class=\"text-center px-6\">\n                    <div class=\"w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n                        <span class=\"text-2xl font-bold text-[#FF7700]\">3</span>\n                    </div>\n                    <h3 clas