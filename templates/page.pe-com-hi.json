        "html": "<!--\n  Planejamento Estratégico com Hyper Island\n  Sessão de Arquitetura do Planejamento Estratégico 2027\n  CSS escopado em .hi-sp2027 | Sem header, menu nem footer | Fontes herdadas do tema Shopify\n-->\n\n<style>\n/* ===== ESCOPO + RESET LOCAL ===== */\n.hi-sp2027,\n.hi-sp2027 *,\n.hi-sp2027 *::before,\n.hi-sp2027 *::after {\n  box-sizing: border-box;\n}\n\n.hi-sp2027 h1,\n.hi-sp2027 h2,\n.hi-sp2027 h3,\n.hi-sp2027 p,\n.hi-sp2027 ul,\n.hi-sp2027 ol,\n.hi-sp2027 li,\n.hi-sp2027 figure,\n.hi-sp2027 blockquote {\n  margin: 0;\n  padding: 0;\n}\n\n.hi-sp2027 ul,\n.hi-sp2027 ol {\n  list-style: none;\n}\n\n.hi-sp2027 {\n  --sp-black: #111111;\n  --sp-ink: #0B0B0B;\n  --sp-white: #FFFFFF;\n  --sp-paper: #F5F4EF;\n  --sp-orange: #FF6B00;\n  --sp-orange-ink: #C24F00;\n  --sp-muted: #5C5C58;\n  --sp-line: #D8D7D0;\n  --sp-line-dark: rgba(255, 255, 255, 0.14);\n  --sp-ease: cubic-bezier(0.4, 0, 0.2, 1);\n\n  display: block;\n  width: 100%;\n  font-family: inherit;\n  color: var(--sp-black);\n  background: var(--sp-paper);\n  -webkit-font-smoothing: antialiased;\n  overflow-x: hidden;\n  line-height: 1.5;\n}\n\n/* ===== CONTAINER ===== */\n.hi-sp2027 .sp-container {\n  width: 100%;\n  max-width: 1320px;\n  margin: 0 auto;\n  padding: 0 48px;\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-container { padding: 0 32px; }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-container { padding: 0 22px; }\n}\n\n/* ===== TIPOGRAFIA BASE ===== */\n.hi-sp2027 .sp-eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.2;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--sp-orange-ink);\n  margin-bottom: 28px;\n}\n.hi-sp2027 .sp-eyebrow::before {\n  content: '';\n  display: block;\n  width: 32px;\n  height: 2px;\n  background: var(--sp-orange);\n  flex-shrink: 0;\n}\n.hi-sp2027 .sp-eyebrow--light { color: var(--sp-orange); }\n\n.hi-sp2027 .sp-h2 {\n  font-family: inherit;\n  font-size: clamp(32px, 4.2vw, 60px);\n  font-weight: 800;\n  line-height: 1.02;\n  letter-spacing: -0.03em;\n  text-transform: none;\n  color: var(--sp-black);\n  max-width: 16ch;\n}\n\n.hi-sp2027 .sp-lead {\n  font-family: inherit;\n  font-size: 18px;\n  line-height: 1.7;\n  color: var(--sp-muted);\n  max-width: 58ch;\n}\n.hi-sp2027 .sp-lead + .sp-lead { margin-top: 18px; }\n.hi-sp2027 .sp-lead strong { color: var(--sp-black); font-weight: 700; }\n\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-lead { font-size: 16px; }\n}\n\n/* ===== BOTÃO ===== */\n.hi-sp2027 a.sp-btn,\n.hi-sp2027 a.sp-btn:visited {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  min-height: 56px;\n  padding: 16px 34px;\n  font-family: inherit;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.2;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  text-decoration: none;\n  color: var(--sp-white);\n  background: var(--sp-black);\n  border: 2px solid var(--sp-black);\n  border-radius: 100px;\n  cursor: pointer;\n  transition: background 0.22s var(--sp-ease), border-color 0.22s var(--sp-ease), color 0.22s var(--sp-ease);\n  white-space: nowrap;\n}\n.hi-sp2027 a.sp-btn .sp-btn__arrow {\n  display: inline-block;\n  transition: transform 0.22s var(--sp-ease);\n}\n.hi-sp2027 a.sp-btn:hover {\n  background: var(--sp-orange);\n  border-color: var(--sp-orange);\n  color: var(--sp-black);\n}\n.hi-sp2027 a.sp-btn:hover .sp-btn__arrow { transform: translateY(3px); }\n.hi-sp2027 a.sp-btn:focus-visible {\n  outline: 3px solid var(--sp-orange);\n  outline-offset: 4px;\n}\n\n.hi-sp2027 .sp-cta-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 18px 28px;\n}\n.hi-sp2027 .sp-cta-note {\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--sp-muted);\n}\n\n@media (max-width: 640px) {\n  .hi-sp2027 a.sp-btn { width: 10