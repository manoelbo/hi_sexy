100%;\n  height: auto;\n}\n.hi-sp2027 .sp-hero__art-caption {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top: 1px solid var(--sp-black);\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--sp-black);\n}\n\n/* Faixa de informações */\n.hi-sp2027 .sp-hero__facts {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  border-top: 1px solid var(--sp-line);\n}\n.hi-sp2027 .sp-hero__fact {\n  padding: 26px 28px 30px 0;\n  border-right: 1px solid var(--sp-line);\n}\n.hi-sp2027 .sp-hero__fact + .sp-hero__fact { padding-left: 28px; }\n.hi-sp2027 .sp-hero__fact:last-child { border-right: none; }\n.hi-sp2027 .sp-hero__fact-label {\n  display: block;\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--sp-muted);\n  margin-bottom: 8px;\n}\n.hi-sp2027 .sp-hero__fact-value {\n  display: block;\n  font-family: inherit;\n  font-size: 18px;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n  color: var(--sp-black);\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-hero__inner {\n    grid-template-columns: 1fr;\n    min-height: 0;\n    gap: 56px;\n    padding: 96px 0 72px;\n  }\n  .hi-sp2027 .sp-hero__art { justify-self: start; max-width: 420px; }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-hero__inner { padding: 72px 0 56px; gap: 48px; }\n  .hi-sp2027 .sp-hero__title { margin-bottom: 28px; }\n  .hi-sp2027 .sp-hero__text { margin-bottom: 36px; }\n  .hi-sp2027 .sp-hero__text p { font-size: 17px; }\n  .hi-sp2027 .sp-hero__art { max-width: 100%; }\n  .hi-sp2027 .sp-hero__facts { grid-template-columns: 1fr; }\n  .hi-sp2027 .sp-hero__fact,\n  .hi-sp2027 .sp-hero__fact + .sp-hero__fact {\n    padding: 20px 0;\n    border-right: none;\n    border-bottom: 1px solid var(--sp-line);\n  }\n  .hi-sp2027 .sp-hero__fact:last-child { border-bottom: none; }\n}\n\n/* ===================================================\n   SEÇÕES (base)\n=================================================== */\n.hi-sp2027 .sp-section {\n  padding: 128px 0;\n  border-bottom: 1px solid var(--sp-line);\n}\n.hi-sp2027 .sp-section--white { background: var(--sp-white); }\n.hi-sp2027 .sp-section--paper { background: var(--sp-paper); }\n\n.hi-sp2027 .sp-split {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);\n  gap: 72px;\n  align-items: start;\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-section { padding: 96px 0; }\n  .hi-sp2027 .sp-split { grid-template-columns: 1fr; gap: 36px; }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-section { padding: 72px 0; }\n}\n\n/* ===================================================\n   2. O QUE É A SESSÃO\n=================================================== */\n.hi-sp2027 .sp-about__head { margin-bottom: 88px; }\n.hi-sp2027 .sp-about__quote {\n  font-family: inherit;\n  font-size: clamp(20px, 2vw, 26px);\n  font-weight: 700;\n  line-height: 1.35;\n  letter-spacing: -0.015em;\n  color: var(--sp-black);\n  padding-left: 22px;\n  border-left: 3px solid var(--sp-orange);\n  margin-bottom: 28px;\n  max-width: 34ch;\n}\n\n.hi-sp2027 .sp-steps4 {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  border-top: 2px solid var(--sp-black);\n}\n.hi-sp2027 .sp-step4 {\n  position: relative;\n  padding: 32px 28px 8px 0;\n}\n.hi-sp2027 .sp-step4 + .sp-step4 {\n  padding-left: 28px;\n  border-left: 1px solid var(--sp-line);\n}\n.hi-sp2027 .sp-step4::before {\n  content: '';\n  position: absolute;\n  top: -2px;\n  left: 0;\n  width: 0;\n  height: 2px;\n  background: var(--sp-orange);\n  transition: width 0.4s var(--sp-ease);\n}\n.hi-sp2027 .sp-step4:hover::before { width: 100%; }\n.hi-sp2027 .sp-step4__num {\n  display: block;\n  font-family: inherit;\n  font-size: 56px;\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -0.04em;\n  color: var(--sp-orange-ink);\n  margin-bottom: 36px;\n}\n.hi-sp2027 .sp-step4__title {\n  font-family: inherit;\n  font-size: 20px;\n  font-weight: 800;\n  line-height: 1.2;\n  letter-spacing: -0.015em;\n  text-transform: none;\n  color: var(--sp-black);\n  margin-bottom: 12px;\n}\n.hi-sp2027 .sp-step4__text {\n  font-family: inherit;\n  font-size: 15px;\n  line-height: 1.65;\n  color: var(--sp-muted);\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-about__head { margin-bottom: 64px; }\n  .hi-sp2027 .sp-steps4 { grid-template-columns: repeat(2, 1fr); }\n  .hi-sp2027 .sp-step4 { padding-bottom: 36px; }\n  .hi-sp2027 .sp-step4:nth-child(3) { padding-left: 0; border-left: none; }\n  .hi-sp2027 .sp-step4:nth-child(n+3) { border-top: 1px solid var(--sp-line); }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-steps4 { grid-template-columns: 1fr; }\n  .hi-sp2027 .sp-step4,\n  .hi-sp2027 .sp-step4 + .sp-step4 {\n    padding: 28px 0;\n    border-left: none;\n  }\n  .hi-sp2027 .sp-step4 + .sp-step4 { border-top: 1px solid var(--sp-line); }\n  .hi-sp2027 .sp-step4__num { font-size: 44px; margin-bottom: 20px; }\n}\n\n/* ===================================================\n   3. O QUE VOCÊ LEVA\n=================================================== */\n.hi-sp2027 .sp-takeaways__head {\n  display: grid;\n  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);\n  gap: 72px;\n  align-items: end;\n  margin-bottom: 64px;\n}\n.hi-sp2027 .sp-takeaways__head .sp-h2 { max-width: 18ch; }\n\n.hi-sp2027 .sp-grid6 {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  border-top: 1px solid var(--sp-black);\n  border-left: 1px solid var(--sp-line);\n}\n.hi-sp2027 .sp-cell {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  gap: 48px;\n  min-height: 220px;\n  padding: 28px 32px 32px;\n  border-right: 1px solid var(--sp-line);\n  border-bottom: 1px solid var(--sp-line);\n  background: var(--sp-white);\n  transition: background 0.25s var(--sp-ease);\n}\n.hi-sp2027 .sp-cell:hover { background: #FFF4EB; }\n.hi-sp2027 .sp-cell__index {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--sp-muted);\n}\n.hi-sp2027 .sp-cell__index::after {\n  content: '';\n  width: 10px;\n  height: 10px;\n  background: var(--sp-orange);\n}\n.hi-sp2027 .sp-cell__text {\n  font-family: inherit;\n  font-size: clamp(20px, 1.8vw, 26px);\n  font-weight: 700;\n  line-height: 1.22;\n  letter-spacing: -0.02em;\n  color: var(--sp-black);\n  max-width: 18ch;\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-takeaways__head { grid-template-columns: 1fr; gap: 24px; margin-bottom: 48px; }\n  .hi-sp2027 .sp-grid6 { grid-template-columns: repeat(2, 1fr); }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-grid6 { grid-template-columns: 1fr; }\n  .hi-sp2027 .sp-cell { min-height: 0; gap: 28px; padding: 24px 22px 28px; }\n}\n\n.hi-sp2027 .sp-section-cta { margin-top: 56px; }\n\n/* ===================================================\n   4. PARA QUEM É\n=================================================== */\n.hi-sp2027 .sp-fit__sticky {\n  position: sticky;\n  top: 120px;\n}\n.hi-sp2027 .sp-fit__list {\n  border-top: 2px solid var(--sp-black);\n  counter-reset: spfit;\n}\n.hi-sp2027 .sp-fit__item {\n  display: grid;\n  grid-template-columns: 56px 1fr;\n  gap: 16px;\n  align-items: baseline;\n  padding: 24px 0;\n  border-bottom: 1px solid var(--sp-line);\n  font-family: inherit;\n  font-size: 19px;\n  font-weight: 600;\n  line-height: 1.45;\n  letter-spacing: -0.01em;\n  color: var(--sp-black);\n  counter-increment: spfit;\n}\n.hi-sp2027 .sp-fit__item::before {\n  content: counter(spfit, decimal-leading-zero);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  color: var(--sp-orange-ink);\n}\n.hi-sp2027 .sp-fit__note {\n  display: grid;\n  grid-template-columns: 56px 1fr;\n  gap: 16px;\n  margin-top: 40px;\n}\n.hi-sp2027 .sp-fit__note-mark {\n  width: 40px;\n  height: 40px;\n  border: 1px solid var(--sp-black);\n  border-radius: 50%;\n  position: relative;\n}\n.hi-sp2027 .sp-fit__note-mark::after {\n  content: '';\n  position: absolute;\n  inset: 9px;\n  border-radius: 50%;\n  background: var(--sp-orange);\n}\n.hi-sp2027 .sp-fit__note p {\n  font-family: inherit;\n  font-size: 16px;\n  line-height: 1.7;\n  color: var(--sp-muted);\n  max-width: 56ch;\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-fit__sticky { position: static; }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-fit__item { grid-template-columns: 40px 1fr; font-size: 17px; padding: 20px 0; }\n  .hi-sp2027 .sp-fit__note { grid-template-columns: 1fr; gap: 18px; }\n}\n\n/* ===================================================\n   5. COMO FUNCIONA\n=================================================== */\n.hi-sp2027 .sp-how__head { margin-bottom: 72px; }\n\n.hi-sp2027 .sp-how__steps {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 48px;\n  position: relative;\n}\n.hi-sp2027 .sp-how__steps::before {\n  content: '';\n  position: absolute;\n  top: 28px;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: var(--sp-black);\n}\n.hi-sp2027 .sp-how__step { position: relative; }\n.hi-sp2027 .sp-how__dot {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  background: var(--sp-paper);\n  border: 1px solid var(--sp-black);\n  font-family: inherit;\n  font-size: 15px;\n  font-weight: 800;\n  letter-spacing: 0.02em;\n  color: var(--sp-black);\n  margin-bottom: 36px;\n  transition: background 0.25s var(--sp-ease), border-color 0.25s var(--sp-ease);\n}\n.hi-sp2027 .sp-how__step:hover .sp-how__dot {\n  background: var(--sp-orange);\n  border-color: var(--sp-orange);\n}\n.hi-sp2027 .sp-how__title {\n  font-family: inherit;\n  font-size: 24px;\n  font-weight: 800;\n  line-height: 1.15;\n  letter-spacing: -0.02em;\n  text-transform: none;\n  color: var(--sp-black);\n  margin-bottom: 14px;\n}\n.hi-sp2027 .sp-how__text {\n  font-family: inherit;\n  font-size: 16px;\n  line-height: 1.7;\n  color: var(--sp-muted);\n  max-width: 34ch;\n}\n\n.hi-sp2027 .sp-how__foot {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 32px;\n  margin-top: 80px;\n  padding-top: 36px;\n  border-top: 1px solid var(--sp-line);\n}\n.hi-sp2027 .sp-how__disclaimer {\n  font-family: inherit;\n  font-size: 14px;\n  line-height: 1.65;\n  color: var(--sp-muted);\n  max-width: 56ch;\n}\n.hi-sp2027 .sp-how__disclaimer strong {\n  display: block;\n  color: var(--sp-black);\n  font-weight: 700;\n  margin-bottom: 2px;\n}\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-how__head { margin-bottom: 56px; }\n  .hi-sp2027 .sp-how__steps { grid-template-columns: 1fr; gap: 0; }\n  .hi-sp2027 .sp-how__steps::before {\n    top: 0;\n    bottom: 0;\n    left: 28px;\n    right: auto;\n    width: 1px;\n    height: auto;\n  }\n  .hi-sp2027 .sp-how__step {\n    display: grid;\n    grid-template-columns: 56px 1fr;\n    gap: 28px;\n    padding-bottom: 48px;\n  }\n  .hi-sp2027 .sp-how__step:last-child { padding-bottom: 0; }\n  .hi-sp2027 .sp-how__dot { margin-bottom: 0; }\n  .hi-sp2027 .sp-how__body { padding-top: 12px; }\n  .hi-sp2027 .sp-how__foot { margin-top: 56px; }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-how__steps::before { left: 22px; }\n  .hi-sp2027 .sp-how__step { grid-template-columns: 44px 1fr; gap: 20px; }\n  .hi-sp2027 .sp-how__dot { width: 44px; height: 44px; font-size: 13px; }\n  .hi-sp2027 .sp-how__body { padding-top: 8px; }\n  .hi-sp2027 .sp-how__title { font-size: 21px; }\n}\n\n/* ===================================================\n   6. FORMULÁRIO\n=================================================== */\n.hi-sp2027 .sp-form {\n  position: relative;\n  background: var(--sp-ink);\n  color: var(--sp-white);\n  padding: 128px 0;\n  scroll-margin-top: 80px;\n  border-top: 4px solid var(--sp-orange);\n}\n.hi-sp2027 .sp-form__inner {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);\n  gap: 72px;\n  align-items: start;\n}\n.hi-sp2027 .sp-form__title {\n  font-family: inherit;\n  font-size: clamp(32px, 4vw, 56px);\n  font-weight: 800;\n  line-height: 1.04;\n  letter-spacing: -0.03em;\n  text-transform: none;\n  color: var(--sp-white);\n  margin-bottom: 28px;\n  max-width: 14ch;\n}\n.hi-sp2027 .sp-form__title:focus { outline: none; }\n.hi-sp2027 .sp-form__title em {\n  font-style: normal;\n  color: var(--sp-orange);\n}\n.hi-sp2027 .sp-form__text {\n  font-family: inherit;\n  font-size: 17px;\n  line-height: 1.7;\n  color: rgba(255, 255, 255, 0.72);\n  max-width: 44ch;\n  margin-bottom: 44px;\n}\n.hi-sp2027 .sp-form__meta {\n  border-top: 1px solid var(--sp-line-dark);\n}\n.hi-sp2027 .sp-form__meta li {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 0;\n  border-bottom: 1px solid var(--sp-line-dark);\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: rgba(255, 255, 255, 0.55);\n}\n.hi-sp2027 .sp-form__meta li span:last-child { color: var(--sp-white); text-align: right; }\n\n.hi-sp2027 .sp-form__panel {\n  background: var(--sp-white);\n  color: var(--sp-black);\n  padding: 12px;\n  border-top: 4px solid var(--sp-orange);\n}\n.hi-sp2027 .sp-form__embed {\n  width: 100%;\n  min-height: 620px;\n}\n.hi-sp2027 .sp-form__embed iframe { max-width: 100%; }\n\n@media (max-width: 1024px) {\n  .hi-sp2027 .sp-form { padding: 96px 0; }\n  .hi-sp2027 .sp-form__inner { grid-template-columns: 1fr; gap: 48px; }\n  .hi-sp2027 .sp-form__title { max-width: 18ch; }\n}\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-form { padding: 72px 0; }\n  .hi-sp2027 .sp-form__text { font-size: 16px; margin-bottom: 32px; }\n  .hi-sp2027 .sp-form__panel { padding: 6px; }\n  .hi-sp2027 .sp-form__embed { min-height: 580px; }\n}\n\n/* ===================================================\n   7. ENCERRAMENTO\n=================================================== */\n.hi-sp2027 .sp-close {\n  background: var(--sp-paper);\n  padding: 136px 0 120px;\n}\n.hi-sp2027 .sp-close__inner {\n  display: grid;\n  grid-template-columns: 80px minmax(0, 1fr);\n  gap: 40px;\n  align-items: start;\n}\n.hi-sp2027 .sp-close__mark {\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  border: 1px solid var(--sp-black);\n  position: relative;\n  margin-top: 10px;\n}\n.hi-sp2027 .sp-close__mark::after {\n  content: '';\n  position: absolute;\n  top: -1px;\n  right: -1px;\n  width: 32px;\n  height: 32px;\n  border-radius: 0 32px 0 0;\n  background: var(--sp-orange);\n}\n.hi-sp2027 .sp-close__quote {\n  font-family: inherit;\n  font-size: clamp(30px, 4.4vw, 64px);\n  font-weight: 800;\n  line-height: 1.06;\n  letter-spacing: -0.035em;\n  color: var(--sp-black);\n  max-width: 20ch;\n}\n.hi-sp2027 .sp-close__sign {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-top: 40px;\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--sp-black);\n}\n.hi-sp2027 .sp-close__sign::before {\n  content: '';\n  width: 48px;\n  height: 2px;\n  background: var(--sp-orange);\n}\n\n@media (max-width: 640px) {\n  .hi-sp2027 .sp-close { padding: 88px 0 80px; }\n  .hi-sp2027 .sp-close__inner { grid-template-columns: 1fr; gap: 28px; }\n  .hi-sp2027 .sp-close__mark { width: 48px; height: 48px; margin-top: 0; }\n  .hi-sp2027 .sp-close__mark::after { width: 24px; height: 24px; border-radius: 0 24px 0 0; }\n}\n\n/* ===== MOVIMENTO REDUZIDO ===== */\n@media (prefers-reduced-motion: reduce) {\n  .hi-sp2027.sp-js .sp-reveal,\n  .hi-sp2027.sp-js .sp-reveal.sp-in {\n    opacity: 1;\n    transform: none;\n    transition: none;\n  }\n  .hi-sp2027 *,\n  .hi-sp2027 *::before,\n  .hi-sp2027 *::after {\n    transition-duration: 0.01ms !important;\n    animation-duration: 0.01ms !important;\n  }\n}\n</style>\n\n<div class=\"hi-sp2027\" id=\"hi-sp2027\">\n\n  <!-- ============================================================\n       1. HERO\n  ============================================================ -->\n  <section class=\"sp-hero\" aria-labelledby=\"sp-hero-title\">\n    <div class=\"sp-container\">\n\n      <div class=\"sp-hero__inner\">\n\n        <div class=\"sp-hero__content sp-reveal\">\n          <p class=\"sp-eyebrow\">Planejamento Estratégico 2027</p>\n\n          <h1 class=\"sp-hero__title\" id=\"sp-hero-title\">\n            <span>Planejamento Estratégico 2027</span>\n            <span class=\"sp-hero__title-accent\">Comece desenhando a conversa certa.</span>\n          </h1>\n\n          <div class=\"sp-hero__text\">\n            <p>Uma sessão gratuita de 60 minutos com a Hyper Island para ajudar sua liderança a estruturar o próximo ciclo de planejamento estratégico.</p>\n            <p>A partir do contexto, dos desafios e das prioridades da sua organização, vamos construir uma primeira arquitetura para o processo.</p>\n          </div>\n\n          <div class=\"sp-cta-row\">\n            <a href=\"#sp-formulario\" class=\"sp-btn\" data-sp-scroll=\"\">\n              Quero agendar minha sessão <span class=\"sp-btn__arrow\" aria-hidden=\"true\">↓</span>\n            </a>\n            <span class=\"sp-cta-note\">Sessão gratuita • Vagas limitadas</span>\n          </div>\n        </div>\n\n        <figure class=\"sp-hero__art sp-reveal sp-d2\" aria-hidden=\"true\">\n          <svg viewbox=\"0 0 500 560\" xmlns=\"http://www.w3.org/2000/svg\" focusable=\"false\">\n            <!-- grade fina -->\n            <g stroke=\"#D8D7D0\" stroke-width=\"1\" fill=\"none\">\n              <line x1=\"0\" y1=\"140\" x2=\"500\" y2=\"140\"></line>\n              <line x1=\"0\" y1=\"280\" x2=\"500\" y2=\"280\"></line>\n              <line x1=\"0\" y1=\"420\" x2=\"500\" y2=\"420\"></line>\n              <line x1=\"125\" y1=\"0\" x2=\"125\" y2=\"560\"></line>\n              <line x1=\"250\" y1=\"0\" x2=\"250\" y2=\"560\"></line>\n              <line x1=\"375\" y1=\"0\" x2=\"375\" y2=\"560\"></line>\n            </g>\n            <!-- moldura -->\n            <rect x=\"0.5\" y=\"0.5\" width=\"499\" height=\"559\" fill=\"none\" stroke=\"#111111\" stroke-width=\"1\"></rect>\n            <!-- arcos concêntricos -->\n            <g fill=\"none\" stroke=\"#111111\" stroke-width=\"1\">\n              <path d=\"M 0 560 A 250 250 0 0 1 250 310\"></path>\n              <path d=\"M 0 560 A 375 375 0 0 1 375 185\"></path>\n              <path d=\"M 0 560 A 500 500 0 0 1 500 60\"></path>\n            </g>\n            <!-- forma laranja principal -->\n            <path d=\"M 250 0 L 500 0 L 500 250 A 250 250 0 0 1 250 0 Z\" fill=\"#FF6B00\"></path>\n            <!-- conexões entre conversas -->\n            <g stroke=\"#111111\" stroke-width=\"1.5\" fill=\"none\">\n              <line x1=\"125\" y1=\"140\" x2=\"250\" y2=\"280\"></line>\n              <line x1=\"250\" y1=\"280\" x2=\"375\" y2=\"420\"></line>\n              <line x1=\"125\" y1=\"420\" x2=\"250\" y2=\"280\"></line>\n              <line x1=\"375\" y1=\"420\" x2=\"375\" y2=\"280\"></line>\n            </g>\n            <!-- nós -->\n            <g>\n              <circle cx=\"125\" cy=\"140\" r=\"7\" fill=\"#111111\"></circle>\n              <circle cx=\"125\" cy=\"420\" r=\"7\" fill=\"#F5F4EF\" stroke=\"#111111\" stroke-width=\"1.5\"></circle>\n              <circle cx=\"375\" cy=\"280\" r=\"7\" fill=\"#F5F4EF\" stroke=\"#111111\" stroke-width=\"1.5\"></circle>\n              <circle cx=\"375\" cy=\"420\" r=\"7\" fill=\"#111111\"></circle>\n              <circle cx=\"250\" cy=\"280\" r=\"18\" fill=\"#FF6B00\"></circle>\n              <circle cx=\"250\" cy=\"280\" r=\"30\" fill=\"none\" stroke=\"#111111\" stroke-width=\"1\"></circle>\n            </g>\n            <!-- quadrado de destaque -->\n            <rect x=\"388\" y=\"492\" width=\"44\" height=\"44\" fill=\"#111111\"></rect>\n          </svg>\n          <figcaption class=\"sp-hero__art-caption\">\n            <span>Arquitetura</span>\n            <span>Ciclo 2027</span>\n          </figcaption>\n        </figure>\n\n      </div>\n\n      <dl class=\"sp-hero__facts\">\n        <div class=\"sp-hero__fact\">\n          <dt class=\"sp-hero__fact-label\">Duração</dt>\n          <dd class=\"sp-hero__fact-value\" style=\"margin:0;\">60 minutos</dd>\n        </div>\n        <div class=\"sp-hero__fact\">\n          <dt class=\"sp-hero__fact-label\">Investimento</dt>\n          <dd class=\"sp-hero__fact-value\" style=\"margin:0;\">Sem custo</dd>\n        </div>\n        <div class=\"sp-hero__fact\">\n          <dt class=\"sp-hero__fact-label\">Formato</dt>\n          <dd class=\"sp-hero__fact-value\" style=\"margin:0;\">Conversa personalizada</dd>\n        </div>\n      </dl>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       2. O QUE É A SESSÃO\n  ============================================================ -->\n  <section class=\"sp-section sp-section--white\" aria-labelledby=\"sp-about-title\">\n    <div class=\"sp-container\">\n\n      <div class=\"sp-split sp-about__head\">\n        <div class=\"sp-reveal\">\n          <p class=\"sp-eyebrow\">A sessão</p>\n          <h2 class=\"sp-h2\" id=\"sp-about-title\">60 minutos para organizar melhor o seu planejamento</h2>\n        </div>\n        <div class=\"sp-reveal sp-d1\">\n          <p class=\"sp-about__quote\">“Precisamos fazer o planejamento estratégico” pode significar coisas muito diferentes.</p>\n          <p class=\"sp-lead\">Sua organização pode precisar alinhar a liderança, definir prioridades, revisar escolhas, explorar cenários futuros ou transformar uma estratégia já existente em ações concretas.</p>\n          <p class=\"sp-lead\"><strong>A Sessão de Arquitetura ajuda a identificar qual conversa precisa acontecer primeiro.</strong></p>\n        </div>\n      </div>\n\n      <ol class=\"sp-steps4\" aria-label=\"Etapas da sessão\">\n        <li class=\"sp-step4 sp-reveal sp-d1\">\n          <span class=\"sp-step4__num\" aria-hidden=\"true\">01</span>\n          <h3 class=\"sp-step4__title\">Entender o contexto</h3>\n          <p class=\"sp-step4__text\">O momento da organização, o ciclo atual de planejamento e o que já foi construído até aqui.</p>\n        </li>\n        <li class=\"sp-step4 sp-reveal sp-d2\">\n          <span class=\"sp-step4__num\" aria-hidden=\"true\">02</span>\n          <h3 class=\"sp-step4__title\">Identificar o desafio central</h3>\n          <p class=\"sp-step4__text\">A pergunta que o planejamento de 2027 precisa responder antes de todas as outras.</p>\n        </li>\n        <li class=\"sp-step4 sp-reveal sp-d3\">\n          <span class=\"sp-step4__num\" aria-hidden=\"true\">03</span>\n          <h3 class=\"sp-step4__title\">Estruturar as conversas necessárias</h3>\n          <p class=\"sp-step4__text\">Quais diálogos precisam acontecer, entre quais pessoas e em que sequência.</p>\n        </li>\n        <li class=\"sp-step4 sp-reveal sp-d4\">\n          <span class=\"sp-step4__num\" aria-hidden=\"true\">04</span>\n          <h3 class=\"sp-step4__title\">Desenhar uma primeira arquitetura do processo</h3>\n          <p class=\"sp-step4__text\">Um esboço de etapas, participantes e entregas para orientar os próximos passos.</p>\n        </li>\n      </ol>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       3. O QUE VOCÊ LEVA DA CONVERSA\n  ============================================================ -->\n  <section class=\"sp-section sp-section--paper\" aria-labelledby=\"sp-take-title\">\n    <div class=\"sp-container\">\n\n      <div class=\"sp-takeaways__head\">\n        <div class=\"sp-reveal\">\n          <p class=\"sp-eyebrow\">O que você leva da conversa</p>\n          <h2 class=\"sp-h2\" id=\"sp-take-title\">Ao final da sessão, você terá mais clareza sobre:</h2>\n        </div>\n        <p class=\"sp-lead sp-reveal sp-d1\">Seis pontos que costumam definir a qualidade de um processo de planejamento, organizados a partir da realidade da sua organização.</p>\n      </div>\n\n      <ul class=\"sp-grid6\">\n        <li class=\"sp-cell sp-reveal sp-d1\">\n          <span class=\"sp-cell__index\">01 / 06</span>\n          <p class=\"sp-cell__text\">Quem precisa estar envolvido</p>\n        </li>\n        <li class=\"sp-cell sp-reveal sp-d2\">\n          <span class=\"sp-cell__index\">02 / 06</span>\n          <p class=\"sp-cell__text\">Quais perguntas precisam ser respondidas</p>\n        </li>\n        <li class=\"sp-cell sp-reveal sp-d3\">\n          <span class=\"sp-cell__index\">03 / 06</span>\n          <p class=\"sp-cell__text\">Quais conversas precisam acontecer</p>\n        </li>\n        <li class=\"sp-cell sp-reveal sp-d1\">\n          <span class=\"sp-cell__index\">04 / 06</span>\n          <p class=\"sp-cell__text\">Como o processo pode ser estruturado</p>\n        </li>\n        <li class=\"sp-cell sp-reveal sp-d2\">\n          <span class=\"sp-cell__index\">05 / 06</span>\n          <p class=\"sp-cell__text\">Quais resultados o planejamento deveria produzir</p>\n        </li>\n        <li class=\"sp-cell sp-reveal sp-d3\">\n          <span class=\"sp-cell__index\">06 / 06</span>\n          <p class=\"sp-cell__text\">Quais próximos passos fazem sentido</p>\n        </li>\n      </ul>\n\n      <div class=\"sp-cta-row sp-section-cta sp-reveal\">\n        <a href=\"#sp-formulario\" class=\"sp-btn\" data-sp-scroll=\"\">\n          Quero agendar minha sessão <span class=\"sp-btn__arrow\" aria-hidden=\"true\">↓</span>\n        </a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       4. PARA QUEM É\n  ============================================================ -->\n  <section class=\"sp-section sp-section--white\" aria-labelledby=\"sp-fit-title\">\n    <div class=\"sp-container\">\n      <div class=\"sp-split\">\n\n        <div class=\"sp-fit__sticky sp-reveal\">\n          <p class=\"sp-eyebrow\">Para quem é</p>\n          <h2 class=\"sp-h2\" id=\"sp-fit-title\">Esta sessão faz sentido para você se...</h2>\n        </div>\n\n        <div>\n          <ul class=\"sp-fit__list\">\n            <li class=\"sp-fit__item sp-reveal\">Você está começando a estruturar o planejamento de 2027</li>\n            <li class=\"sp-fit__item sp-reveal\">Sua liderança precisa alinhar prioridades</li>\n            <li class=\"sp-fit__item sp-reveal\">Existem muitas iniciativas competindo por atenção e recursos</li>\n            <li class=\"sp-fit__item sp-reveal\">Sua organização precisa pensar além do curto prazo</li>\n            <li class=\"sp-fit__item sp-reveal\">Você quer envolver diferentes áreas na construção da estratégia</li>\n            <li class=\"sp-fit__item sp-reveal\">Sua equipe precisa transformar diretrizes corporativas em prioridades concretas</li>\n            <li class=\"sp-fit__item sp-reveal\">Vocês estão avaliando apoio externo para desenhar ou facilitar o processo</li>\n          </ul>\n\n          <div class=\"sp-fit__note sp-reveal\">\n            <span class=\"sp-fit__note-mark\" aria-hidden=\"true\"></span>\n            <p>A sessão é especialmente indicada para líderes, diretores e profissionais responsáveis por estratégia, transformação, marketing, people, inovação e unidades de negócio.</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       5. COMO FUNCIONA\n  ============================================================ -->\n  <section class=\"sp-section sp-section--paper\" aria-labelledby=\"sp-how-title\">\n    <div class=\"sp-container\">\n\n      <div class=\"sp-how__head sp-reveal\">\n        <p class=\"sp-eyebrow\">Como funciona</p>\n        <h2 class=\"sp-h2\" id=\"sp-how-title\">Três passos até a sua sessão</h2>\n      </div>\n\n      <ol class=\"sp-how__steps\">\n        <li class=\"sp-how__step sp-reveal sp-d1\">\n          <span class=\"sp-how__dot\" aria-hidden=\"true\">01</span>\n          <div class=\"sp-how__body\">\n            <h3 class=\"sp-how__title\">Conte seu contexto</h3>\n            <p class=\"sp-how__text\">Preencha o formulário com algumas informações sobre sua organização e o momento atual do planejamento.</p>\n          </div>\n        </li>\n        <li class=\"sp-how__step sp-reveal sp-d2\">\n          <span class=\"sp-how__dot\" aria-hidden=\"true\">02</span>\n          <div class=\"sp-how__body\">\n            <h3 class=\"sp-how__title\">Analisamos a inscrição</h3>\n            <p class=\"sp-how__text\">As solicitações passam por uma breve análise para garantir que a conversa seja relevante para o desafio apresentado.</p>\n          </div>\n        </li>\n        <li class=\"sp-how__step sp-reveal sp-d3\">\n          <span class=\"sp-how__dot\" aria-hidden=\"true\">03</span>\n          <div class=\"sp-how__body\">\n            <h3 class=\"sp-how__title\">Desenhamos juntos</h3>\n            <p class=\"sp-how__text\">Durante 60 minutos, alguém da Hyper Island explora seu contexto e ajuda a construir uma primeira arquitetura para o planejamento.</p>\n          </div>\n        </li>\n      </ol>\n\n      <div class=\"sp-how__foot sp-reveal\">\n        <p class=\"sp-how__disclaimer\">\n          <strong>Sem custo.</strong>\n          A participação está sujeita à disponibilidade e aderência da solicitação à proposta da sessão.\n        </p>\n        <a href=\"#sp-formulario\" class=\"sp-btn\" data-sp-scroll=\"\">\n          Quero agendar minha sessão <span class=\"sp-btn__arrow\" aria-hidden=\"true\">↓</span>\n        </a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       6. FORMULÁRIO\n  ============================================================ -->\n  <section class=\"sp-form\" id=\"sp-formulario\" aria-labelledby=\"sp-form-title\">\n    <div class=\"sp-container\">\n      <div class=\"sp-form__inner\">\n\n        <div class=\"sp-reveal\">\n          <p class=\"sp-eyebrow sp-eyebrow--light\">Inscrição</p>\n          <h2 class=\"sp-form__title\" id=\"sp-form-title\" tabindex=\"-1\">\n            Vamos começar a desenhar seu <em>planejamento de 2027?</em>\n          </h2>\n          <p class=\"sp-form__text\">Conte um pouco sobre o momento da sua organização. As informações abaixo ajudam nosso time a preparar uma conversa mais relevante para você.</p>\n\n          <ul class=\"sp-form__meta\" aria-label=\"Resumo da sessão\">\n            <li>\n<span>Sessão</span><span>Arquitetura do Planejamento 2027</span>\n</li>\n            <li>\n<span>Duração</span><span>60 minutos</span>\n</li>\n            <li>\n<span>Investimento</span><span>Sem custo</span>\n</li>\n            <li>\n<span>Vagas</span><span>Limitadas</span>\n</li>\n          </ul>\n        </div>\n\n        <div class=\"sp-form__panel sp-reveal sp-d1\">\n          <div class=\"sp-form__embed\" role=\"region\" aria-label=\"Formulário de inscrição para a Sessão de Arquitetura do Planejamento Estratégico 2027\">\n            <div data-tf-live=\"01M5APPKNHAYA0E1Q1PRXXTESS\"></div>\n<script src=\"//embed.typeform.com/next/embed.js\"></script>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ============================================================\n       7. ENCERRAMENTO\n  ============================================================ -->\n  <section class=\"sp-close\" aria-label=\"Mensagem final\">\n    <div class=\"sp-container\">\n      <div class=\"sp-close__inner sp-reveal\">\n        <span class=\"sp-close__mark\" aria-hidden=\"true\"></span>\n        <blockquote>\n          <p class=\"sp-close__quote\">Planejamento estratégico começa pela qualidade das conversas que uma liderança consegue ter.</p>\n          <p class=\"sp-close__sign\">Hyper Island</p>\n        </blockquote>\n      </div>\n    </div>\n  </section>\n\n</div><!-- /.hi-sp2027 -->\n\n<script>\n(function () {\n  'use strict';\n\n  var root = document.getElementById('hi-sp2027');\n  if (!root) return;\n\n  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  /* Scroll suave até o formulário */\n  var links = root.querySelectorAll('a[data-sp-scroll]');\n  var target = document.getElementById('sp-formulario');\n  var focusTarget = document.getElementById('sp-form-title');\n\n  for (var i = 0; i < links.length; i++) {\n    links[i].addEventListener('click', function (e) {\n      if (!target) return;\n      e.preventDefault();\n      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });\n      if (focusTarget) {\n        window.setTimeout(function () {\n          try { focusTarget.focus({ preventScroll: true }); } catch (err) { focusTarget.focus(); }\n        }, reduceMotion ? 0 : 600);\n      }\n    });\n  }\n\n  /* Entrada sutil dos elementos */\n  if (reduceMotion || !('IntersectionObserver' in window)) return;\n\n  root.classList.add('sp-js');\n  var items = root.querySelectorAll('.sp-reveal');\n  var observer = new IntersectionObserver(function (entries) {\n    entries.forEach(function (entry) {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('sp-in');\n        observer.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });\n\n  items.forEach(function (el) { observer.observe(el); });\n})();\n</script>",
