        "html": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Matriz Prioridade x Maturidade</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<style>\n    /* Centraliza o gráfico */\n    .chart-container {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        height: 100vh; /* Faz com que o gráfico ocupe a altura da tela */\n    }\n\n    canvas {\n        max-width: 600px;\n        max-height: 400px;\n    }\n</style>\n\n<h2>Matriz de Prioridade x Maturidade</h2><br>\n\n<div class=\"chart-container\">\n    <canvas id=\"matrizChart\"></canvas>\n</div>\n\n<script>\n    const ctx = document.getElementById('matrizChart').getContext('2d');\n    const data = {\n        datasets: [{\n            label: 'Protagonismo em solução',\n            data: [{ x: 3.00, y: 4.72 }],\n            backgroundColor: 'rgba(255, 165, 0, 0.7)',  // Laranja\n            borderColor: 'rgba(255, 165, 0, 1)',\n            borderWidth: 1,\n            pointRadius: 8\n        }, {\n            label: 'Visão Sistêmica',\n            data: [{ x: 3.12, y: 4.70 }],\n            backgroundColor: 'rgba(255, 140, 0, 0.7)',  // Tom mais escuro de laranja\n            borderColor: 'rgba(255, 140, 0, 1)',\n            borderWidth: 1,\n            pointRadius: 8\n        }, {\n            label: 'Comunicação Influente',\n            data: [{ x: 3.08, y: 4.68 }],\n            backgroundColor: 'rgba(255, 69, 0, 0.7)',  // Tom ainda mais escuro\n            borderColor: 'rgba(255, 69, 0, 1)',\n            borderWidth: 1,\n            pointRadius: 8\n        }, {\n            label: 'Inteligência Preditiva',\n            data: [{ x: 2.95, y: 4.68 }],\n            backgroundColor: 'rgba(255, 99, 71, 0.7)',  // Outro tom de laranja\n            borderColor: 'rgba(255, 99, 71, 1)',\n            borderWidth: 1,\n            pointRadius: 8\n        }]\n    };\n\n    const config = {\n        type: 'scatter',\n        data: data,\n        options: {\n            scales: {\n                x: {\n                    type: 'linear',\n                    position: 'bottom',\n                    title: {\n                        display: true,\n                        text: 'Maturidade'\n                    },\n                    min: 2.5,\n                    max: 3.5\n                },\n                y: {\n                    title: {\n                        display: true,\n                        text: 'Prioridade'\n                    },\n                    min: 4.6,\n                    max: 4.8\n                }\n            },\n            plugins: {\n                tooltip: {\n                    callbacks: {\n                        label: function(tooltipItem) {\n                            return tooltipItem.dataset.label + ': Maturidade (' + tooltipItem.raw.x + '), Prioridade (' + tooltipItem.raw.y + ')';\n                        }\n                    }\n                }\n            }\n        }\n    };\n\n    const matrizChart = new Chart(ctx, config);\n</script>",
