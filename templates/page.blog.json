        "html": "<!-- ============================================================\n     HYPER FRIDAY · Banner v2 (com data e animação sutil)\n     Cole este bloco inteiro numa seção \"Liquid personalizado\"\n     ou \"HTML personalizado\" do Shopify.\n     CSS isolado na classe .hfb2 (pode conviver com a v1 na\n     mesma página). Respeita \"reduzir movimento\" do sistema.\n     ============================================================ -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@108,900&amp;family=Montserrat:wght@200;300;400;500&amp;display=swap\">\n\n<style>\n  .hfb2 {\n    --hfb-bg: #0A0A0A;\n    --hfb-fg: #FFFFFF;\n    --hfb-muted: rgba(255, 255, 255, 0.62);\n    --hfb-line: rgba(255, 255, 255, 0.2);\n    --hfb-orange: #FF7300;\n    --hfb-dash: 12px;\n    display: block;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    background: var(--hfb-bg);\n    color: var(--hfb-fg);\n    font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    line-height: 1;\n    overflow: hidden;\n  }\n  .hfb2 *, .hfb2 *::before, .hfb2 *::after { box-sizing: border-box; margin: 0; padding: 0; line-height: inherit; text-transform: none; }\n\n  .hfb2 .hfb2__inner {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 34px max(24px, env(safe-area-inset-right, 0px)) 34px max(24px, env(safe-area-inset-left, 0px));\n    display: flex;\n    align-items: center;\n    gap: 40px;\n  }\n\n  /* Wordmark HYPER FRIDAY + ticket */\n  .hfb2 .hfb2__mark {\n    position: relative;\n    flex: none;\n    font-family: 'Archivo', 'Arial Black', sans-serif;\n    font-weight: 900;\n    font-stretch: 108%;\n    font-size: 44px;\n    line-height: 0.88;\n    letter-spacing: -0.012em;\n    white-space: nowrap;\n    color: var(--hfb-fg);\n    padding-right: 0.55em;\n  }\n  .hfb2 .hfb2__mark span { position: relative; display: block; line-height: 0.88; }\n  .hfb2 .hfb2__mark span:first-child { z-index: 1; }\n  .hfb2 .hfb2__mark span:last-child { z-index: 3; }\n  .hfb2 .hfb2__ticket {\n    position: absolute;\n    z-index: 2;\n    left: 3.71em;\n    top: 0.63em;\n    width: 0.986em;\n    height: 0.533em;\n    transform: rotate(51deg);\n    transform-origin: 50% 50%;\n    display: block;\n  }\n\n  .hfb2 .hfb2__divider {\n    flex: none;\n    width: 1px;\n    align-self: stretch;\n    background: var(--hfb-line);\n    transform-origin: 50% 50%;\n  }\n\n  /* Oferta */\n  .hfb2 .hfb2__offer { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 12px; }\n  .hfb2 .hfb2__date {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: 0.28em;\n    line-height: 1;\n    color: var(--hfb-fg);\n    text-transform: uppercase;\n  }\n  .hfb2 .hfb2__pulse {\n    position: relative;\n    flex: none;\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: var(--hfb-orange);\n  }\n  .hfb2 .hfb2__pulse::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: var(--hfb-orange);\n    opacity: 0;\n  }\n  .hfb2 .hfb2__headline {\n    font-size: 40px;\n    font-weight: 400;\n    letter-spacing: -0.02em;\n    line-height: 1.05;\n    color: var(--hfb-fg);\n  }\n  .hfb2 .hfb2__headline-light { font-weight: 200; white-space: nowrap; }\n  .hfb2 .hfb2__nowrap { white-space: nowrap; }\n  .hfb2 .hfb2__sub {\n    font-size: 15px;\n    font-weight: 400;\n    letter-spacing: 0.16em;\n    line-height: 1.4;\n    color: var(--hfb-muted);\n  }\n\n  /* Cupom (clique para copiar) com tracejado que circula */\n  .hfb2 .hfb2__coupon {\n    all: unset;\n    box-sizing: border-box;\n    position: relative;\n    flex: none;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 9px;\n    min-height: 88px;\n    padding: 0 34px;\n    cursor: pointer;\n    font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif;\n    color: var(--hfb-fg);\n    background:\n      linear-gradient(90deg, var(--hfb-orange) 50%, transparent 0) 0 0 / var(--hfb-dash) 1.5px repeat-x,\n      linear-gradient(90deg, var(--hfb-orange) 50%, transparent 0) 0 100% / var(--hfb-dash) 1.5px repeat-x,\n      linear-gradient(0deg, var(--hfb-orange) 50%, transparent 0) 0 0 / 1.5px var(--hfb-dash) repeat-y,\n      linear-gradient(0deg, var(--hfb-orange) 50%, transparent 0) 100% 0 / 1.5px var(--hfb-dash) repeat-y;\n    transition: box-shadow 0.25s ease;\n  }\n  .hfb2 .hfb2__coupon:hover { box-shadow: inset 0 0 0 999px rgba(255, 115, 0, 0.08); }\n  .hfb2 .hfb2__coupon:focus-visible { outline: 2px solid var(--hfb-orange); outline-offset: 4px; }\n  .hfb2 .hfb2__coupon-label {\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: 0.3em;\n    line-height: 1;\n    color: var(--hfb-muted);\n    text-transform: uppercase;\n  }\n  .hfb2 .hfb2__coupon-code {\n    font-size: 26px;\n    font-weight: 400;\n    letter-spacing: 0.14em;\n    line-height: 1;\n    user-select: all;\n  }\n  .hfb2 .hfb2__coupon.is-copied .hfb2__coupon-label { color: var(--hfb-orange); }\n\n  /* ---------- Movimento (só quando o usuário não pediu menos movimento) ---------- */\n  @media (prefers-reduced-motion: no-preference) {\n    /* Ambiente: ponto pulsando e tracejado circulando */\n    .hfb2 .hfb2__pulse::after { animation: hfb2-pulse 2.4s ease-out infinite; }\n    .hfb2 .hfb2__coupon { animation: hfb2-march 1.6s linear infinite; }\n\n    /* Entrada: elementos surgem em sequência quando o banner aparece */\n    .hfb2.hfb2--anim:not(.is-in) .hfb2__reveal { opacity: 0; transform: translateY(10px); }\n    .hfb2.hfb2--anim:not(.is-in) .hfb2__divider { transform: scaleY(0); }\n    .hfb2.hfb2--anim:not(.is-in) .hfb2__ticket { opacity: 0; transform: rotate(18deg) scale(1.35); }\n    .hfb2.hfb2--anim .hfb2__reveal { transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }\n    .hfb2.hfb2--anim .hfb2__divider { transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s; }\n    .hfb2.hfb2--anim .hfb2__ticket { transition: opacity 0.35s ease 0.55s, transform 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) 0.55s; }\n    .hfb2.hfb2--anim .hfb2__reveal--2 { transition-delay: 0.2s; }\n    .hfb2.hfb2--anim .hfb2__reveal--3 { transition-delay: 0.3s; }\n    .hfb2.hfb2--anim .hfb2__reveal--4 { transition-delay: 0.4s; }\n    .hfb2.hfb2--anim .hfb2__reveal--5 { transition-delay: 0.5s; }\n  }\n  @keyframes hfb2-pulse {\n    0% { transform: scale(1); opacity: 0.55; }\n    100% { transform: scale(3.2); opacity: 0; }\n  }\n  @keyframes hfb2-march {\n    from { background-position: 0 0, var(--hfb-dash) 100%, 0 var(--hfb-dash), 100% 0; }\n    to { background-position: var(--hfb-dash) 0, 0 100%, 0 0, 100% var(--hfb-dash); }\n  }\n\n  /* Tablet */\n  @media (max-width: 1024px) {\n    .hfb2 .hfb2__inner { gap: 28px; padding-top: 28px; padding-bottom: 28px; }\n    .hfb2 .hfb2__mark { font-size: 36px; }\n    .hfb2 .hfb2__date { font-size: 11px; letter-spacing: 0.24em; }\n    .hfb2 .hfb2__headline { font-size: 30px; }\n    .hfb2 .hfb2__sub { font-size: 13px; letter-spacing: 0.12em; }\n    .hfb2 .hfb2__coupon { min-height: 76px; padding: 0 24px; }\n    .hfb2 .hfb2__coupon-code { font-size: 21px; }\n  }\n\n  /* Celular */\n  @media (max-width: 760px) {\n    .hfb2 .hfb2__inner { flex-direction: column; align-items: flex-start; gap: 22px; padding: 32px max(20px, env(safe-area-inset-right, 0px)) 32px max(20px, env(safe-area-inset-left, 0px)); }\n    .hfb2 .hfb2__divider { display: none; }\n    .hfb2 .hfb2__mark { font-size: 40px; }\n    .hfb2 .hfb2__headline { font-size: 30px; }\n    .hfb2 .hfb2__sub { font-size: 13px; letter-spacing: 0.1em; }\n    .hfb2 .hfb2__coupon { width: 100%; align-items: center; min-height: 80px; }\n    .hfb2 .hfb2__coupon-code { font-size: 22px; }\n  }\n</style>\n\n<div class=\"hfb2\" role=\"region\" aria-label=\"Hyper Friday: 30% OFF nos cursos online, de 16 a 30 de novembro\">\n  <div class=\"hfb2__inner\">\n\n    <div class=\"hfb2__mark hfb2__reveal\" role=\"img\" aria-label=\"Hyper Friday\">\n      <span aria-hidden=\"true\">HYPER</span>\n      <svg class=\"hfb2__ticket\" viewbox=\"0 0 150 81\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M0 0H150V29.5A11 11 0 0 0 150 51.5V81H0V51.5A11 11 0 0 0 0 29.5Z\" fill=\"#FF7300\"></path></svg>\n      <span aria-hidden=\"true\">FRIDAY</span>\n    </div>\n\n    <div class=\"hfb2__divider\" aria-hidden=\"true\"></div>\n\n    <div class=\"hfb2__offer\">\n      <p class=\"hfb2__date hfb2__reveal hfb2__reveal--2\"><span class=\"hfb2__pulse\" aria-hidden=\"true\"></span>De 16 a 30 de novembro</p>\n      <p class=\"hfb2__headline hfb2__reveal hfb2__reveal--3\"><span class=\"hfb2__headline-light\">30% OFF</span> <span class=\"hfb2__nowrap\">nos cursos online</span></p>\n      <p class=\"hfb2__sub hfb2__reveal hfb2__reveal--4\">+ Curso Liderança Ágil de Bônus</p>\n    </div>\n\n    <button type=\"button\" class=\"hfb2__coupon hfb2__reveal hfb2__reveal--5\" data-hfb2-copy=\"HYPERFRIDAY\" aria-label=\"Copiar cupom HYPERFRIDAY\">\n      <span class=\"hfb2__coupon-label\" aria-live=\"polite\">Cupom</span>\n      <span class=\"hfb2__coupon-code\">HYPERFRIDAY</span>\n    </button>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var banners = document.querySelectorAll('.hfb2');\n    Array.prototype.forEach.call(banners, function (el) {\n      if (el.dataset.hfb2Ready) return;\n      el.dataset.hfb2Ready = '1';\n\n      /* Entrada: só anima quando o banner entra na tela */\n      if (!reduce && 'IntersectionObserver' in window) {\n        el.classList.add('hfb2--anim');\n        var io = new IntersectionObserver(function (entries) {\n          entries.forEach(function (e) {\n            if (e.isIntersecting) { el.classList.add('is-in'); io.disconnect(); }\n          });\n        }, { threshold: 0.35 });\n        io.observe(el);\n        setTimeout(function () { el.classList.add('is-in'); }, 4000);\n      }\n\n      /* Copiar cupom */\n      var btn = el.querySelector('[data-hfb2-copy]');\n      if (!btn) return;\n      var label = btn.querySelector('.hfb2__coupon-label');\n      var original = label ? label.textContent : '';\n      var timer;\n      function done() {\n        btn.classList.add('is-copied');\n        if (label) label.textContent = 'Copiado';\n        clearTimeout(timer);\n        timer = setTimeout(function () {\n          btn.classList.remove('is-copied');\n          if (label) label.textContent = original;\n        }, 2200);\n      }\n      function fallback(code) {\n        var ta = document.createElement('textarea');\n        ta.value = code;\n        ta.setAttribute('readonly', '');\n        ta.style.position = 'fixed';\n        ta.style.opacity = '0';\n        document.body.appendChild(ta);\n        ta.select();\n        try { document.execCommand('copy'); done(); } catch (e) {}\n        document.body.removeChild(ta);\n      }\n      btn.addEventListener('click', function () {\n        var code = btn.getAttribute('data-hfb2-copy');\n        if (navigator.clipboard && navigator.clipboard.writeText) {\n          navigator.clipboard.writeText(code).then(done, function () { fallback(code); });\n        } else {\n          fallback(code);\n        }\n      });\n    });\n  })();\n</script>",
