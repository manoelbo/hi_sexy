    "html_yHz6tK": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Facilitadoras</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&amp;display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', sans-serif; background: #fafbfc;}\n  </style>\n\n\n  <section class=\"w-full max-w-7xl mx-auto px-4 pt-14 pb-10\">\n    <!-- Título -->\n    <div class=\"text-center mb-2\">\n      <h2 class=\"text-4xl md:text-5xl font-bold text-[#18191F] mb-2\">\n        Suas <span class=\"text-[#f36c21]\">Facilitadoras</span>\n      </h2>\n      <p class=\"text-[#5B5D63] text-base md:text-lg max-w-3xl mx-auto\">\n        Profissionais experientes que vão guiar sua jornada de transformação com expertise e humanidade\n      </p>\n    </div>\n\n    <!-- Cards -->\n    <div class=\"mt-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6\">\n      \n      <!-- Sabryna Alsfasser -->\n      <div class=\"bg-white rounded-2xl shadow p-0 flex flex-col overflow-hidden\">\n        <img src=\"https://media.licdn.com/dms/image/v2/C4D03AQEeLblDxW45LQ/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1587057161201?e=1757548800&amp;v=beta&amp;t=RKHVVSdtts_uYlEqJaNMnDNkipfZrzFlkr-M8pUcNnA\" alt=\"Sabryna Alsfasser\" class=\"w-full h-56 object-cover rounded-t-2xl\">\n        <div class=\"p-6 flex flex-col flex-1\">\n          <span class=\"font-bold text-lg text-[#18191F]\">Sabryna Alsfasser</span>\n          <span class=\"text-[#f36c21] font-semibold text-base leading-tight\">Head of Learning Design</span>\n          <span class=\"text-[#5B5D63] text-sm mb-1\">Hyper Island</span>\n          <p class=\"text-[#18191F] text-sm mt-2 mb-3\">Especialista em design de aprendizagem com mais de 15 anos desenvolvendo líderes. Pioneira em metodologias experienciais para desenvolvimento executivo.</p>\n          <span class=\"font-semibold text-xs text-[#18191F] mb-2\">Especialidades:</span>\n          <div class=\"flex flex-wrap gap-2 mb-4\">\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Design Thinking</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Liderança Transformacional</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Facilitação Experiencial</span>\n          </div>\n          <a href=\"https://www.linkedin.com/in/sabryna-alsfasser/\" target=\"_blank\" class=\"flex items-center gap-1 text-[#f36c21] font-semibold text-sm mt-auto hover:underline\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mb-[2px]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M16 8a6 6 0 01-12 0C4 5.239 6.239 3 9 3s5 2.239 5 5-2.239 5-5 5a5.984 5.984 0 01-3.895-1.458M9 21v-6h6v6\"></path></svg>\n            Ver perfil\n          </a>\n        </div>\n      </div>\n\n      <!-- Veronica Magariños -->\n      <div class=\"bg-white rounded-2xl shadow p-0 flex flex-col overflow-hidden\">\n        <img src=\"https://media.licdn.com/dms/image/v2/D4E03AQH-UePcalxRTA/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1718237763879?e=1757548800&amp;v=beta&amp;t=AoskkZ4u3Lm66yxf5p9HbYQbni7WbnfbQqFV7gcW_pc\" alt=\"Veronica Magariños\" class=\"w-full h-56 object-cover rounded-t-2xl\">\n        <div class=\"p-6 flex flex-col flex-1\">\n          <span class=\"font-bold text-lg text-[#18191F]\">Veronica Magariños</span>\n          <span class=\"text-[#f36c21] font-semibold text-base leading-tight\">Senior Leadership Coach</span>\n          <span class=\"text-[#5B5D63] text-sm mb-1\">Hyper Island</span>\n          <p class=\"text-[#18191F] text-sm mt-2 mb-3\">Coach executiva certificada com especialização em liderança feminina. Mentora de mais de 200 executivas em processos de transformação.</p>\n          <span class=\"font-semibold text-xs text-[#18191F] mb-2\">Especialidades:</span>\n          <div class=\"flex flex-wrap gap-2 mb-4\">\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Executive Coaching</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Liderança Feminina</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Desenvolvimento Pessoal</span>\n          </div>\n          <a href=\"https://www.linkedin.com/in/veronica-magari%C3%B1os-turner/\" target=\"_blank\" class=\"flex items-center gap-1 text-[#f36c21] font-semibold text-sm mt-auto hover:underline\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mb-[2px]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M16 8a6 6 0 01-12 0C4 5.239 6.239 3 9 3s5 2.239 5 5-2.239 5-5 5a5.984 5.984 0 01-3.895-1.458M9 21v-6h6v6\"></path></svg>\n            Ver perfil\n          </a>\n        </div>\n      </div>\n\n      <!-- Sauanne Bispo -->\n      <div class=\"bg-white rounded-2xl shadow p-0 flex flex-col overflow-hidden\">\n        <img src=\"https://media.licdn.com/dms/image/v2/D4D03AQEkD-pAQ7LqSQ/profile-displayphoto-shrink_800_800/B4DZbPslH9HEAk-/0/1747241292890?e=1757548800&amp;v=beta&amp;t=V-Ga-UHYydmlZqVUelkOptsyVnZK4Np0CxkiARi7A18\" alt=\"Sauanne Bispo\" class=\"w-full h-56 object-cover rounded-t-2xl\">\n        <div class=\"p-6 flex flex-col flex-1\">\n          <span class=\"font-bold text-lg text-[#18191F]\">Sauanne Bispo</span>\n          <span class=\"text-[#f36c21] font-semibold text-base leading-tight\">Experience Designer</span>\n          <span class=\"text-[#5B5D63] text-sm mb-1\">Hyper Island</span>\n          <p class=\"text-[#18191F] text-sm mt-2 mb-3\">Designer de experiências focada em jornadas de transformação. Especialista em criar ambientes seguros para desenvolvimento pessoal e profissional.</p>\n          <span class=\"font-semibold text-xs text-[#18191F] mb-2\">Especialidades:</span>\n          <div class=\"flex flex-wrap gap-2 mb-4\">\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Design de Experiência</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Facilitação</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Transformação Organizacional</span>\n          </div>\n          <a href=\"https://www.linkedin.com/in/sauannebispo/\" target=\"_blank\" class=\"flex items-center gap-1 text-[#f36c21] font-semibold text-sm mt-auto hover:underline\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mb-[2px]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M16 8a6 6 0 01-12 0C4 5.239 6.239 3 9 3s5 2.239 5 5-2.239 5-5 5a5.984 5.984 0 01-3.895-1.458M9 21v-6h6v6\"></path></svg>\n            Ver perfil\n          </a>\n        </div>\n      </div>\n\n      <!-- Laís Rodrigues -->\n      <div class=\"bg-white rounded-2xl shadow p-0 flex flex-col overflow-hidden\">\n        <img src=\"https://media.licdn.com/dms/image/v2/D4D03AQEgUbeA6TjK1g/profile-displayphoto-shrink_800_800/0/1645030733301?e=1757548800&amp;v=beta&amp;t=RSZ0VpQXNOwym4JDkQWDJUz81kZz5n3bMuEyHP4QENQ\" alt=\"Laís Rodrigues\" class=\"w-full h-56 object-cover rounded-t-2xl\">\n        <div class=\"p-6 flex flex-col flex-1\">\n          <span class=\"font-bold text-lg text-[#18191F]\">Laís Rodrigues</span>\n          <span class=\"text-[#f36c21] font-semibold text-base leading-tight\">Partnership Manager</span>\n          <span class=\"text-[#5B5D63] text-sm mb-1\">LinkedIn</span>\n          <p class=\"text-[#18191F] text-sm mt-2 mb-3\">Estrategista de parcerias com foco em desenvolvimento de liderança. Conecta talentos e organizações para criar impacto positivo no mercado.</p>\n          <span class=\"font-semibold text-xs text-[#18191F] mb-2\">Especialidades:</span>\n          <div class=\"flex flex-wrap gap-2 mb-4\">\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Networking Estratégico</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Parcerias</span>\n            <span class=\"bg-[#fff3e6] text-[#f36c21] rounded-lg px-2 py-1 text-xs font-semibold\">Desenvolvimento de Carreira</span>\n          </div>\n          <a href=\"#\" class=\"flex items-center gap-1 text-[#f36c21] font-semibold text-sm mt-auto hover:underline cursor-default pointer-events-none opacity-60\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4 mb-[2px]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M16 8a6 6 0 01-12 0C4 5.239 6.239 3 9 3s5 2.239 5 5-2.239 5-5 5a5.984 5.984 0 01-3.895-1.458M9 21v-6h6v6\"></path></svg>\n            Ver perfil\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>",
