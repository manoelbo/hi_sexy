    "html_RkWyR7": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mais que um evento</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&amp;display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', sans-serif; background: #fff;}\n  </style>\n\n\n  <section class=\"flex justify-center py-8 px-2\">\n    <div class=\"flex flex-col md:flex-row items-center w-full max-w-4xl bg-[#fff3e6] rounded-2xl shadow px-8 py-8 md:py-10 md:px-12 gap-8\">\n      <!-- Texto -->\n      <div class=\"flex-1\">\n        <h2 class=\"text-4xl font-bold text-[#18191F] mb-6\">\n          Mais que um evento, uma <span class=\"text-[#f36c21]\">transformação</span>\n        </h2>\n        <ul class=\"flex flex-col gap-3\">\n          <!-- Item 1 -->\n          <li class=\"flex items-start gap-3\">\n            <span class=\"mt-1\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21] bg-[#fff3e6] rounded-full\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                <rect x=\"0\" y=\"0\" width=\"24\" height=\"24\" rx=\"12\" fill=\"#fff3e6\"></rect>\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4\"></path>\n                <circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke=\"#fff3e6\"></circle>\n              </svg>\n            </span>\n            <div>\n              <span class=\"font-bold text-[#18191F]\">Certificado de participação</span><br>\n              <span class=\"text-sm text-[#5B5D63]\">Reconhecimento oficial da sua jornada de desenvolvimento</span>\n            </div>\n          </li>\n          <!-- Item 2 -->\n          <li class=\"flex items-start gap-3\">\n            <span class=\"mt-1\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21] bg-[#fff3e6] rounded-full\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                <rect x=\"0\" y=\"0\" width=\"24\" height=\"24\" rx=\"12\" fill=\"#fff3e6\"></rect>\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4\"></path>\n                <circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke=\"#fff3e6\"></circle>\n              </svg>\n            </span>\n            <div>\n              <span class=\"font-bold text-[#18191F]\">Acesso ao grupo exclusivo</span><br>\n              <span class=\"text-sm text-[#5B5D63]\">Comunidade permanente para troca de experiências</span>\n            </div>\n          </li>\n          <!-- Item 3 -->\n          <li class=\"flex items-start gap-3\">\n            <span class=\"mt-1\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21] bg-[#fff3e6] rounded-full\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                <rect x=\"0\" y=\"0\" width=\"24\" height=\"24\" rx=\"12\" fill=\"#fff3e6\"></rect>\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4\"></path>\n                <circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke=\"#fff3e6\"></circle>\n              </svg>\n            </span>\n            <div>\n              <span class=\"font-bold text-[#18191F]\">Material de apoio completo</span><br>\n              <span class=\"text-sm text-[#5B5D63]\">Ferramentas e templates para aplicar no dia a dia</span>\n            </div>\n          </li>\n          <!-- Item 4 -->\n          <li class=\"flex items-start gap-3\">\n            <span class=\"mt-1\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21] bg-[#fff3e6] rounded-full\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                <rect x=\"0\" y=\"0\" width=\"24\" height=\"24\" rx=\"12\" fill=\"#fff3e6\"></rect>\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4\"></path>\n                <circle cx=\"12\" cy=\"12\" r=\"9.5\" stroke=\"#fff3e6\"></circle>\n              </svg>\n            </span>\n            <div>\n              <span class=\"font-bold text-[#18191F]\">Follow-up personalizado</span><br>\n              <span class=\"text-sm text-[#5B5D63]\">Acompanhamento individual dos seus próximos passos</span>\n            </div>\n          </li>\n        </ul>\n      </div>\n      <!-- Imagem -->\n      <div class=\"flex-shrink-0\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/DSC8214_2.jpg?v=1682692771\" alt=\"Transformação\" class=\"rounded-xl shadow-lg w-[400px] h-[250px] object-cover object-center\">\n      </div>\n    </div>\n  </section>",
