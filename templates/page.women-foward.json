      "settings": {
        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Sobre a Hyper Island &amp; LinkedIn</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&amp;display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', sans-serif; background: #fafbfc;}\n  </style>\n\n\n  <section class=\"w-full flex justify-center py-12 px-2\">\n    <div class=\"w-full max-w-6xl rounded-2xl bg-[#df570c] px-8 md:px-20 py-14 flex flex-col items-center\">\n      <h2 class=\"text-white text-3xl md:text-4xl font-bold text-center mb-8\">\n        Sobre a Hyper Island &amp; LinkedIn\n      </h2>\n      <div class=\"flex flex-col md:flex-row w-full justify-center items-start gap-12 md:gap-20\">\n        <!-- Hyper Island -->\n        <div class=\"flex-1 flex flex-col items-center text-center\">\n          <span class=\"flex items-center justify-center w-[70px] h-[70px] bg-[#e06622] rounded-2xl mb-6\">\n            <img src=\"https://media.licdn.com/dms/image/v2/D4D0BAQHYpg6-Thb-Kw/company-logo_200_200/company-logo_200_200/0/1726562591847/hyper_island_logo?e=2147483647&amp;v=beta&amp;t=3iC7IwUQ8pXPII3IvUrFRSCD21wc7bgXG9tlpNL5Eb8\" alt=\"Logo Hyper Island\" class=\"w-10 h-10 object-contain\">\n          </span>\n          <span class=\"text-white font-semibold text-2xl mb-2 block\">Hyper Island</span>\n          <span class=\"text-white text-base leading-relaxed block\">\n            Consultoria global de aprendizagem com mais de 28 anos de experiência desenvolvendo líderes e organizações em todo o mundo. Metodologia experiencial, colaborativa e desenhada para o mundo real.\n          </span>\n        </div>\n        <!-- LinkedIn -->\n        <div class=\"flex-1 flex flex-col items-center text-center\">\n          <span class=\"flex items-center justify-center w-[70px] h-[70px] bg-[#e06622] rounded-2xl mb-6\">\n            <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/LinkedIn_logo_initials.png/960px-LinkedIn_logo_initials.png\" alt=\"Logo LinkedIn\" class=\"w-10 h-10 object-contain\">\n          </span>\n          <span class=\"text-white font-semibold text-2xl mb-2 block\">LinkedIn</span>\n          <span class=\"text-white text-base leading-relaxed block\">\n            A maior rede profissional do mundo, com mais de 900 milhões de membros. Acredita no poder das conexões para impulsionar carreiras e transformar realidades. Parceria inédita para ativar o potencial feminino na liderança.\n          </span>\n        </div>\n      </div>\n    </div>\n  </section>",
