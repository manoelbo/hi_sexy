=\"0 0 24 24\" stroke=\"currentColor\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"4\" stroke-width=\"2\"></rect><path d=\"M16 2v4M8 2v4M4 10h16\" stroke-width=\"2\"></path></svg>\n          </span>\n          <div>\n            <div class=\"font-semibold\">16-18 de Outubro</div>\n            <div class=\"text-sm text-[#5B5D63]\">3 dias imersivos</div>\n          </div>\n        </div>\n        <!-- Local -->\n        <div class=\"flex items-start gap-3\">\n          <span class=\"mt-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 12.414a4 4 0 10-1.414 1.414l4.243 4.243a1 1 0 001.414-1.414z\"></path><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"></path></svg>\n          </span>\n          <div>\n            <div class=\"font-semibold\">Club Med Mogi das Cruzes</div>\n            <div class=\"text-sm text-[#5B5D63]\">Experiência completa</div>\n          </div>\n        </div>\n        <!-- Participantes -->\n        <div class=\"flex items-start gap-3\">\n          <span class=\"mt-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 20h5v-2a4 4 0 00-3-3.87M9 20h6M4 20h5M9 11a4 4 0 11-8 0 4 4 0 018 0zM21 11a4 4 0 11-8 0 4 4 0 018 0z\"></path></svg>\n          </span>\n          <div>\n            <div class=\"font-semibold\">35-40 participantes</div>\n            <div class=\"text-sm text-[#5B5D63]\">Grupo exclusivo</div>\n          </div>\n        </div>\n        <!-- Parceria -->\n        <div class=\"flex items-start gap-3\">\n          <span class=\"mt-1\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#f36c21]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-width=\"2\"></circle><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 12h8M12 8v8\"></path></svg>\n          </span>\n          <div>\n            <div class=\"font-semibold\">Hyper Island + LinkedIn</div>\n            <div class=\"text-sm text-[#5B5D63]\">Parceria inédita</div>\n          </div>\n        </div>\n      </div>\n      <!-- Botões -->\n      <div class=\"flex gap-4 w-full md:w-auto\">\n        <a href=\"#\" class=\"bg-[#f36c21] hover:bg-[#d46a13] text-white font-bold rounded-full px-8 py-4 text-lg shadow-lg transition\">\n          Garanta sua vaga\n        </a>\n        <a href=\"#\" class=\"border-2 border-[#f36c21] text-[#f36c21] font-bold rounded-full px-8 py-4 text-lg bg-white hover:bg-[#ffe4cf] transition\">\n          Conhecer programa\n        </a>\n      </div>\n    </div>\n    <!-- RIGHT -->\n    <div class=\"w-full md:w-[46%] flex items-center justify-center mt-10 md:mt-0 md:ml-16\">\n      <div class=\"relative rounded-3xl shadow-2xl overflow-hidden w-full max-w-[500px]\">\n        <!-- Badge Últimas Vagas -->\n        <span class=\"absolute top-4 right-4 z-10 bg-[#ff7675] text-white font-semibold text-sm px-4 py-1 rounded-full shadow\">Últimas vagas!</span>\n        <!-- Foto -->\n        <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/3_Jornadas_de_Transformacao2.jpg?v=1682692772\" alt=\"Women Forward\" class=\"object-cover w-full h-[400px] md:h-[420px]\">\n        <!-- Depoimento -->\n        <div class=\"absolute bottom-4 left-4 right-4 bg-[#18191F]/70 text-white text-lg font-semibold rounded-xl px-6 py-3 shadow-lg\">\n          \"Uma experiência que transforma não apenas carreiras, mas vidas inteiras\"\n        </div>\n      </div>\n    </div>\n  </section>",
