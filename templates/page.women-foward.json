    "html_KCNK6R": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>O que você vai levar</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&amp;display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', sans-serif; background: #fff;}\n  </style>\n\n\n  <section class=\"w-full max-w-6xl mx-auto px-4 pt-14 pb-10\">\n    <!-- Título -->\n    <div class=\"text-center mb-2\">\n      <h2 class=\"text-4xl md:text-5xl font-bold text-[#18191F] mb-2\">\n        O que você vai <span class=\"text-[#f36c21]\">levar</span>\n      </h2>\n      <p class=\"text-[#5B5D63] text-base md:text-lg max-w-2xl mx-auto\">\n        Resultados tangíveis e transformações duradouras que vão impactar sua carreira e sua vida pessoal\n      </p>\n    </div>\n\n    <!-- Grid dos cards -->\n    <div class=\"mt-12 grid grid-cols-1 md:grid-cols-3 gap-6\">\n      <!-- Card 1 -->\n      <div class=\"bg-[#f8fafc] rounded-2xl p-6 flex flex-col gap-2 shadow-sm\">\n        <span class=\"w-9 h-9 flex items-center justify-center bg-[#fff3e6] rounded-xl mb-2\">\n          <!-- Ícone setinha -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#fa892c]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 17l5-5 5-5\"></path>\n          </svg>\n        </span>\n        <span class=\"font-bold text-[#18191F] text-lg block\">Clareza sobre sua identidade de liderança</span>\n        <span class=\"text-[#5B5D63] text-base\">Descubra seu estilo único e seu próximo passo profissional com maior autoconhecimento</span>\n      </div>\n      <!-- Card 2 -->\n      <div class=\"bg-[#f8fafc] rounded-2xl p-6 flex flex-col gap-2 shadow-sm\">\n        <span class=\"w-9 h-9 flex items-center justify-center bg-[#fff3e6] rounded-xl mb-2\">\n          <!-- Ícone escudo -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#fa892c]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 3l7 4v5c0 5.25-7 9-7 9s-7-3.75-7-9V7l7-4z\"></path>\n          </svg>\n        </span>\n        <span class=\"font-bold text-[#18191F] text-lg block\">Ferramentas práticas para navegar desafios</span>\n        <span class=\"text-[#5B5D63] text-base\">Métodos comprovados para influenciar com autenticidade em situações complexas</span>\n      </div>\n      <!-- Card 3 -->\n      <div class=\"bg-[#f8fafc] rounded-2xl p-6 flex flex-col gap-2 shadow-sm\">\n        <span class=\"w-9 h-9 flex items-center justify-center bg-[#fff3e6] rounded-xl mb-2\">\n          <!-- Ícone network -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#fa892c]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n            <rect x=\"9\" y=\"9\" width=\"6\" height=\"6\" rx=\"1\"></rect>\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 3v3m0 12v3m9-9h-3M6 12H3m13.5 3.5l2.5 2.5M6.5 6.5L4 4m13.5 13.5L20 20\"></path>\n          </svg>\n        </span>\n        <span class=\"font-bold text-[#18191F] text-lg block\">Rede de mulheres líderes com propósito</span>\n        <span class=\"text-[#5B5D63] text-base\">Conexões genuínas que vão além do evento, criando parcerias duradouras</span>\n      </div>\n      <!-- Card 4 -->\n      <div class=\"bg-[#f8fafc] rounded-2xl p-6 flex flex-col gap-2 shadow-sm\">\n        <span class=\"w-9 h-9 flex items-center justify-center bg-[#fff3e6] rounded-xl mb-2\">\n          <!-- Ícone lâmpada -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#fa892c]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 3a7 7 0 016.11 10.43c-.28.42-.48.93-.64 1.57a1 1 0 01-.94.66h-8.06a1 1 0 01-.94-.66c-.16-.64-.36-1.15-.64-1.57A7 7 0 0112 3z\"></path><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 17h6m-4 4h2\"></path>\n          </svg>\n        </span>\n        <span class=\"font-bold text-[#18191F] text-lg block\">Inspiração para liderar com coragem</span>\n        <span class=\"text-[#5B5D63] text-base\">Energia renovada para enfrentar mudanças e transformar realidades</span>\n      </div>\n      <!-- Card 5 -->\n      <div class=\"bg-[#f8fafc] rounded-2xl p-6 flex flex-col gap-2 shadow-sm\">\n        <span class=\"w-9 h-9 flex items-center justify-center bg-[#fff3e6] rounded-xl mb-2\">\n          <!-- Ícone checklist -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#fa892c]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n            <rect x=\"5\" y=\"4\" width=\"14\" height=\"16\" rx=\"2\"></rect>\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 10l2 2 4-4\"></path>\n          </svg>\n        </span>\n        <span class=\"font-bold text-[#18191F] text-lg block\">Plano de ação concreto</span>\n        <span class=\"text-[#5B5D63] text-base\">Estratégias específicas e aplicáveis no seu contexto profissional atual</span>\n      </div>\n      <!-- Card 6 -->\n      <div class=\"bg-[#f8fafc] rounded-2xl p-6 flex flex-col gap-2 shadow-sm\">\n        <span class=\"w-9 h-9 flex items-center justify-center bg-[#fff3e6] rounded-xl mb-2\">\n          <!-- Ícone coração -->\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#fa892c]\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 21C12 21 7 16.5 7 12a5 5 0 0110 0c0 4.5-5 9-5 9z\"></path>\n          </svg>\n        </span>\n        <span class=\"font-bold text-[#18191F] text-lg block\">Reconexão com seu propósito</span>\n        <span class=\"text-[#5B5D63] text-base\">Redescubra o que realmente importa e alinhe carreira com valores pessoais</span>\n      </div>\n    </div>\n  </section>",
