      "settings": {
        "html": "<!-- =============================================\n     Future Skills Masterclass — São Paulo\n     Hyper Island Brasil — Shopify Ready\n     CSS escopado em #fs-sp | Mobile-first\n============================================= -->\n\n<style>\n#fs-sp *, #fs-sp *::before, #fs-sp *::after { margin:0; padding:0; box-sizing:border-box; }\n#fs-sp {\n  --black:#050505; --white:#F5F2EC; --accent:#FF7300;\n  --gray:#1A1A1A; --gray2:#2A2A2A; --gray-text:#888;\n  --border:rgba(245,242,236,0.12);\n  background:var(--black); color:var(--white); overflow-x:hidden;\n}\n#fs-sp .sp-ticker {\n  position:sticky; top:0; z-index:99; background:var(--accent);\n  height:36px; overflow:hidden; display:flex; align-items:center;\n  width:100vw; margin-left:calc(50% - 50vw);\n}\n#fs-sp .sp-ticker-track { display:flex; animation:spTicker 28s linear infinite; white-space:nowrap; }\n#fs-sp .sp-ticker-item { font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#fff; padding:0 28px; flex-shrink:0; }\n#fs-sp .sp-ticker-item::after { content:' ○ '; opacity:0.5; }\n@keyframes spTicker { from{transform:translateX(0)} to{transform:translateX(-50%)} }\n\n#fs-sp .sp-hero {\n  min-height:82svh; position:relative; overflow:hidden;\n  display:flex; flex-direction:column; justify-content:flex-end;\n  width:100vw; margin-left:calc(50% - 50vw);\n}\n#fs-sp .sp-hero-bg { position:absolute; inset:0; background:#000; }\n#fs-sp .sp-hero-video {\n  position:absolute; inset:0; width:100%; height:100%;\n  object-fit:cover; filter:brightness(0.38); pointer-events:none;\n}\n#fs-sp .sp-hero-glow {\n  position:absolute; inset:0;\n  background:radial-gradient(ellipse 60% 50% at 50% 80%,rgba(255,115,0,0.18) 0%,transparent 70%);\n}\n#fs-sp .sp-hero-content { position:relative; z-index:2; padding:36px 24px 56px; max-width:1280px; margin:0 auto; width:100%; }\n#fs-sp .sp-hero-eyebrow { font-size:11px; letter-spacing:0.28em; text-transform:uppercase; color:var(--accent); display:flex; align-items:center; gap:10px; margin-bottom:20px; }\n#fs-sp .sp-hero-eyebrow::before { content:''; display:block; width:24px; height:1px; background:var(--accent); }\n#fs-sp .sp-hero-title { font-size:clamp(72px,40vw,160px); font-weight:900; line-height:0.9; letter-spacing:-0.02em; margin-bottom:24px; text-transform:uppercase; }\n#fs-sp .sp-hero-title .l1 { color:var(--white); display:block; }\n#fs-sp .sp-hero-title .l2 { -webkit-text-stroke:1.5px var(--white); color:transparent; display:block; }\n#fs-sp .sp-hero-title .l3 { color:var(--accent); display:block; }\n#fs-sp .sp-hero-bottom { display:flex; flex-direction:column; gap:20px; padding-top:24px; border-top:1px solid var(--border); }\n#fs-sp .sp-hero-date { font-size:13px; letter-spacing:0.15em; text-transform:uppercase; color:var(--accent); font-weight:700; }\n#fs-sp .sp-hero-copy { font-size:15px; line-height:1.65; color:rgba(245,242,236,0.65); max-width:540px; }\n#fs-sp .sp-hero-copy strong { color:var(--white); font-weight:600; }\n#fs-sp .sp-hero-btns { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }\n\n#fs-sp .sp-btn {\n  display:inline-flex; align-items:center; gap:8px;\n  font-size:12px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;\n  text-decoration:none; padding:14px 28px; cursor:pointer; border:none; outline:none;\n  transition:all 0.2s ease; white-space:nowrap;\n  border-radius:999px;\n}\n#fs-sp .sp-btn-fill { background:var(--accent); color:#fff; }\n#fs-sp .sp-btn-fill:hover { background:#e56600; color:#fff; text-decoration:none; }\n#fs-sp .sp-btn-ghost { background:transparent; color:var(--white); border:1px solid rgba(245,242,236,0.35); }\n#fs-sp .sp-btn-ghost:hover { border-color:var(--white); color:var(--white); text-decoration:none; }\n#fs-sp .sp-btn-dark { background:var(--black); color:var(--white); border:1px solid rgba(245,242,236,0.2); }\n#fs-sp .sp-btn-dark:hover { background:var(--gray); color:var(--white); text-decoration:none; }\n#fs-sp .sp-btn-white { background:var(--white); color:var(--black); }\n#fs-sp .sp-btn-white:hover { background:#e8e4dd; color:var(--black); text-decoration:none; }\n#fs-sp .sp-arr::after { content:' →'; }\n\n\n\n#fs-sp section {\n  border-bottom:1px solid var(--border);\n  width:100vw; margin-left:calc(50% - 50vw);\n}\n#fs-sp .sp-wrap { max-width:1280px; margin:0 auto; padding:64px 24px; }\n#fs-sp .sp-label {\n  font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:var(--gray-text);\n  display:flex; align-items:center; gap:10px; margin-bottom:20px;\n}\n#fs-sp .sp-label::before { content:''; display:block; width:20px; height:1px; background:var(--gray-text); }\n#fs-sp .sp-heading { font-size:clamp(40px,7vw,88px); font-weight:900; line-height:0.92; letter-spacing:-0.01em; text-transform:uppercase; color:var(--white); margin-bottom:28px; }\n#fs-sp .sp-heading .acc { color:var(--accent); }\n\n#fs-sp .sp-video-section { background:#000; padding:0; border-bottom:1px solid var(--border); width:100vw; margin-left:calc(50% - 50vw); }\n#fs-sp .sp-video-wrap { width:85%; max-width:960px; margin:0 auto; padding:48px 0; }\n#fs-sp .sp-video-ratio { position:relative; padding-bottom:56.25%; height:0; }\n#fs-sp .sp-video-ratio iframe { position:absolute; top:0; left:0; width:100%; height:100%; border:none; }\n\n#fs-sp .sp-what { background:#ffffff; }\n#fs-sp .sp-what .sp-wrap { border-bottom:none; }\n#fs-sp .sp-what-inner { display:grid; grid-template-columns:1fr; gap:40px; }\n#fs-sp .sp-what .sp-label { color:rgba(5,5,5,0.4); }\n#fs-sp .sp-what .sp-label::before { background:rgba(5,5,5,0.25); }\n#fs-sp .sp-what .sp-heading { color:var(--black); }\n#fs-sp .sp-what-body { font-size:15px; line-height:1.75; color:rgba(5,5,5,0.65); margin-bottom:14px; }\n#fs-sp .sp-what-body strong { color:var(--black); font-weight:600; }\n#fs-sp .sp-what-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }\n#fs-sp .sp-what-img { width:100%; display:block; aspect-ratio:4/3; object-fit:cover; }\n\n#fs-sp .sp-days { background:var(--black); }\n#fs-sp .sp-days-grid { display:grid; grid-template-columns:1fr; gap:1px; background:var(--border); margin-top:40px; }\n#fs-sp .sp-day { background:var(--gray); padding:40px 28px; display:flex; flex-direction:column; gap:20px; }\n#fs-sp .sp-day-badge { display:inline-block; background:var(--accent); color:#fff; font-size:10px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; padding:4px 10px; margin-bottom:8px; align-self:flex-start; }\n#fs-sp .sp-day-title { font-size:clamp(22px,4vw,38px); font-weight:900; line-height:1.05; text-transform:uppercase; color:var(--white); letter-spacing:-0.01em; }\n#fs-sp .sp-day-body { font-size:14px; line-height:1.7; color:rgba(245,242,236,0.6); }\n#fs-sp .sp-day-topics { list-style:none; display:flex; flex-direction:column; gap:0; }\n#fs-sp .sp-day-topics li { font-size:13px; color:rgba(245,242,236,0.55); padding:10px 0; border-bottom:1px solid var(--border); display:flex; gap:12px; align-items:flex-start; }\n#fs-sp .sp-day-topics li::before { content:''; width:6px; height:6px; background:var(--accent); border-radius:50%; flex-shrink:0; margin-top:5px; }\n#fs-sp .sp-day-img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }\n#fs-sp .sp-day-btn-wrap { display:flex; gap:8px; flex-wrap:wrap; padding-top:8px; }\n\n#fs-sp .sp-fullpass { background:var(--accent); }\n#fs-sp .sp-fullpass-inner { display:flex; flex-direction:column; gap:28px; }\n#fs-sp .sp-fullpass-heading { font-size:clamp(48px,10vw,120px); font-weight:900; line-height:0.88; text-transform:uppercase; color:#fff; letter-spacing:-0.02em; }\n#fs-sp .sp-fullpass-body { font-size:15px; line-height:1.7; color:rgba(255,255,255,0.82); max-width:560px; }\n#fs-sp .sp-fullpass-body strong { color:#fff; }\n#fs-sp .sp-fullpass-btn { background:#000; color:#fff; padding:18px 40px; font-size:13px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; text-decoration:none; display:inline-flex; align-items:center; gap:8px; transition:all 0.2s; align-self:flex-start; }\n#fs-sp .sp-fullpass-btn:hover { background:#111; color:#fff; text-decoration:none; }\n\n#fs-sp .sp-pillars { background:#ffffff; }\n#fs-sp .sp-pillars-grid { display:grid; grid-template-columns:1fr; gap:1px; background:rgba(5,5,5,0.08); margin-top:40px; }\n#fs-sp .sp-pillar { background:#ffffff; padding:40px 28px; display:flex; flex-direction:column; gap:12px; }\n#fs-sp .sp-pillar-num { font-size:52px; font-weight:900; line-height:1; color:var(--accent); opacity:0.5; letter-spacing:-0.02em; }\n#fs-sp .sp-pillar-title { font-size:15px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--black); }\n#fs-sp .sp-pillar-body { font-size:13px; line-height:1.65; color:rgba(5,5,5,0.55); }\n\n#fs-sp .sp-who { background:var(--black); }\n#fs-sp .sp-who-inner { display:grid; grid-template-columns:1fr; gap:40px; }\n#fs-sp .sp-who-body { font-size:18px; font-weight:300; line-height:1.55; color:rgba(245,242,236,0.8); margin-bottom:20px; }\n#fs-sp .sp-who-body strong { color:var(--white); font-weight:700; }\n#fs-sp .sp-tags { display:flex; flex-wrap:wrap; gap:8px; }\n#fs-sp .sp-tag { font-size:11px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; padding:7px 14px; border:1px solid var(--border); color:rgba(245,242,236,0.5); }\n#fs-sp .sp-nps-box { background:var(--gray); padding:40px 28px; }\n#fs-sp .sp-nps-lbl { font-size:10px; letter-spacing:0.25em; text-transform:uppercase; color:var(--gray-text); margin-bottom:8px; }\n#fs-sp .sp-nps-num { font-size:100px; font-weight:900; line-height:1; color:var(--accent); letter-spacing:-0.03em; }\n#fs-sp .sp-nps-bar { height:4px; background:var(--gray2); margin:20px 0 20px; }\n#fs-sp .sp-nps-bar-fill { height:100%; width:96%; background:var(--accent); }\n#fs-sp .sp-nps-note { font-size:13px; line-height:1.7; color:rgba(245,242,236,0.5); }\n\n#fs-sp .sp-testimonials { background:#000000; padding:64px 24px; width:100vw;