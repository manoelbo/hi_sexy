p-syl-details\">\n            <summary class=\"sp-btn sp-btn-fill\" style=\"background:var(--black);color:var(--white);\">Baixe o Programa →</summary>\n            <div class=\"sp-syl-popup\">\n              <button onclick=\"this.closest('details').open=false\" class=\"sp-syl-close\">×</button>\n              <p class=\"sp-syl-lbl\">Download</p>\n              <p class=\"sp-syl-title\">Baixe o programa do evento</p>\n              <div id=\"hs-form-1\"></div>\n            </div>\n          </details>\n          <a href=\"mailto:learning.americas@hyperisland.com\" class=\"sp-btn\" style=\"background:transparent;color:var(--black);border:1px solid rgba(5,5,5,0.2);\">Entre em Contato</a>\n        </div>\n      </div>\n      <div>\n        <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/Copy_of_FSMC-002.jpg?v=1777494023\" alt=\"Future Skills Masterclass São Paulo\" class=\"sp-what-img\" loading=\"lazy\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-days\" id=\"ingressos\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-label\">Programa do Evento</div>\n    <h2 class=\"sp-heading\">2 Dias de<br><span class=\"acc\">Transformação</span>\n</h2>\n    <div class=\"sp-days-grid\">\n      <div class=\"sp-day\">\n        <div>\n          <span class=\"sp-day-badge\">19/08 — Dia 01</span>\n          <h3 class=\"sp-day-title\">Inovação em um Mundo Pós-IA</h3>\n          <p class=\"sp-day-body\">Explore como inovar de forma estratégica em um mundo cada vez mais conectado. Usaremos <strong>Future Foresight</strong> e design especulativo para antecipar oportunidades e desafios que estão moldando negócios e sociedade.</p>\n          <ul class=\"sp-day-topics\" style=\"margin-top:16px;\">\n            <li>Future Foresight — Antecipação de Cenários Futuros</li>\n            <li>Design Especulativo aplicado à estratégia de negócios</li>\n            <li>IA como alavanca de inovação organizacional</li>\n            <li>Pensamento sistêmico em contextos de incerteza</li>\n          </ul>\n        </div>\n        <div>\n          <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_9099.jpg?v=1777494023\" alt=\"Dia 01\" class=\"sp-day-img\" loading=\"lazy\">\n        </div>\n        <div class=\"sp-day-btn-wrap\">\n          <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-dia-1-o-futuro-da-inovacao\" class=\"sp-btn sp-btn-fill sp-arr\" target=\"_blank\">Ingresso Dia 01</a>\n          <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-full-pass\" class=\"sp-btn sp-btn-dark\" target=\"_blank\">Full Pass</a>\n        </div>\n      </div>\n\n      <div class=\"sp-day\">\n        <div>\n          <span class=\"sp-day-badge\">20/08 — Dia 02</span>\n          <h3 class=\"sp-day-title\">Liderando a Transformação Contínua</h3>\n          <p class=\"sp-day-body\">Torne-se um líder mais adaptável em um mundo de mudanças constantes. Atividades práticas para navegar pela complexidade e liderar processos de transformação na sua organização.</p>\n          <ul class=\"sp-day-topics\" style=\"margin-top:16px;\">\n            <li>Mentalidades de liderança na era da IA</li>\n            <li>Adaptabilidade e resiliência organizacional</li>\n            <li>Colaboração e dinâmicas de equipe</li>\n            <li>Tomada de decisão em cenários de incerteza</li>\n          </ul>\n        </div>\n        <div>\n          <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_1111.jpg?v=1777494024\" alt=\"Dia 02\" class=\"sp-day-img\" loading=\"lazy\">\n        </div>\n        <div class=\"sp-day-btn-wrap\">\n          <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-dia-2-conexoes-criativas\" class=\"sp-btn sp-btn-fill sp-arr\" target=\"_blank\">Ingresso Dia 02</a>\n          <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-full-pass\" class=\"sp-btn sp-btn-dark\" target=\"_blank\">Full Pass</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-fullpass\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-fullpass-inner\">\n      <div>\n        <h2 class=\"sp-fullpass-heading\">Full<br>Pass</h2>\n        <p class=\"sp-fullpass-body\" style=\"margin-top:16px;\">A experiência completa dos <strong>2 dias</strong>. Maximize o aprendizado, o networking e a transformação. Os dois dias juntos multiplicam o impacto — é a melhor forma de viver a Future Skills.</p>\n        <p style=\"font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.65);margin-top:12px;\">19 e 20 de Agosto · São Paulo</p>\n      </div>\n      <div>\n        <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-full-pass\" class=\"sp-fullpass-btn\" target=\"_blank\">Garantir Full Pass →</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-pillars\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-label\" style=\"color:rgba(5,5,5,0.4);\">Nossa Abordagem</div>\n    <h2 class=\"sp-heading\" style=\"color:var(--black);\">The Hyper<br>Island Way</h2>\n    <div class=\"sp-pillars-grid\">\n      <div class=\"sp-pillar\">\n        <div class=\"sp-pillar-num\">01</div>\n        <div class=\"sp-pillar-title\">Construa, Crie e Experimente</div>\n        <p class=\"sp-pillar-body\">Combinamos aprendizado prático com um ambiente dinâmico. Domine ferramentas e técnicas modernas — em tempo real, com desafios reais.</p>\n      </div>\n      <div class=\"sp-pillar\">\n        <div class=\"sp-pillar-num\">02</div>\n        <div class=\"sp-pillar-title\">Pronto para o Mundo Real</div>\n        <p class=\"sp-pillar-body\">Aprenda resolvendo desafios do seu contexto e amplie sua rede global. Saia com passos concretos para levar à sua equipe.</p>\n      </div>\n      <div class=\"sp-pillar\">\n        <div class=\"sp-pillar-num\">03</div>\n        <div class=\"sp-pillar-title\">Aprenda com Experts</div>\n        <p class=\"sp-pillar-body\">Trabalhamos com especialistas líderes mundiais — de estratégia de inovação a IA aplicada, criatividade e liderança.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-who\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-who-inner\">\n      <div>\n        <div class=\"sp-label\">Quem Participa</div>\n        <h2 class=\"sp-heading\">Líderes &amp;<br>Tomadores<br>de Decisão</h2>\n        <p class=\"sp-who-body\">Cerca de <strong>40 líderes</strong> de setores e empresas diversas. Estrategistas, profissionais de RH, T&amp;D, Marketing e Indústrias Criativas. <strong>Pessoas que querem passar da teoria da IA para a ação.</strong></p>\n        <div class=\"sp-tags\">\n          <span class=\"sp-tag\">CMOs &amp; Marketing</span>\n          <span class=\"sp-tag\">RH &amp; T&amp;D</span>\n          <span class=\"sp-tag\">Inovação</span>\n          <span class=\"sp-tag\">Diretores Criativos</span>\n          <span class=\"sp-tag\">Estratégia</span>\n          <span class=\"sp-tag\">Líderes Digitais</span>\n          <span class=\"sp-tag\">Founders</span>\n        </div>\n      </div>\n      <div>\n        <div class=\"sp-nps-box\">\n          <div class=\"sp-nps-lbl\">Net Promoter Score — Mexico City 2026</div>\n          <div class=\"sp-nps-num\">96</div>\n          <div class=\"sp-nps-bar\"><div class=\"sp-nps-bar-fill\"></div></div>\n          <p class=\"sp-nps-note\">Um NPS de 96 é excepcional — coloca a Future Skills entre as experiências mais amadas do mundo. Nossos participantes não apenas comparecem: eles se tornam defensores da transformação.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-testimonials\">\n  <div class=\"sp-testimonials-header\">\n    <p class=\"sp-testi-eyebrow\">Não precisa ficar só na nossa palavra…</p>\n    <h2 class=\"sp-testi-title\">O que os <span>participantes</span> dizem</h2>\n  </div>\n  <div class=\"sp-testi-track-wrap\">\n    <div cl