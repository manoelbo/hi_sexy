        "html": "<!-- =============================================\n     Future Skills Masterclass — São Paulo\n     Hyper Island Brasil — Shopify Ready\n     CSS escopado em #fs-sp | Mobile-first\n============================================= -->\n\n<style>\n#fs-sp *, #fs-sp *::before, #fs-sp *::after { margin:0; padding:0; box-sizing:border-box; }\n#fs-sp {\n  --black:#050505; --white:#F5F2EC; --accent:#FF7300;\n  --gray:#1A1A1A; --gray2:#2A2A2A; --gray-text:#888;\n  --border:rgba(245,242,236,0.12);\n  background:var(--black); color:var(--white); overflow-x:hidden;\n}\n#fs-sp .sp-ticker {\n  position:sticky; top:0; z-index:99; background:var(--accent);\n  height:36px; overflow:hidden; display:flex; align-items:center;\n  width:100vw; margin-left:calc(50% - 50vw);\n}\n#fs-sp .sp-ticker-track { display:flex; animation:spTicker 28s linear infinite; white-space:nowrap; }\n#fs-sp .sp-ticker-item { font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#fff; padding:0 28px; flex-shrink:0; }\n#fs-sp .sp-ticker-item::after { content:' ○ '; opacity:0.5; }\n@keyframes spTicker { from{transform:translateX(0)} to{transform:translateX(-50%)} }\n\n#fs-sp .sp-hero {\n  min-height:82svh; position:relative; overflow:hidden;\n  display:flex; flex-direction:column; justify-content:flex-end;\n  width:100vw; margin-left:calc(50% - 50vw);\n}\n#fs-sp .sp-hero-bg { position:absolute; inset:0; background:#000; }\n#fs-sp .sp-hero-video {\n  position:absolute; inset:0; width:100%; height:100%;\n  object-fit:cover; filter:brightness(0.38); pointer-events:none;\n}\n#fs-sp .sp-hero-glow {\n  position:absolute; inset:0;\n  background:radial-gradient(ellipse 60% 50% at 50% 80%,rgba(255,115,0,0.18) 0%,transparent 70%);\n}\n#fs-sp .sp-hero-content { position:relative; z-index:2; padding:36px 24px 56px; max-width:1280px; margin:0 auto; width:100%; }\n#fs-sp .sp-hero-eyebrow { font-size:11px; letter-spacing:0.28em; text-transform:uppercase; color:var(--accent); display:flex; align-items:center; gap:10px; margin-bottom:20px; }\n#fs-sp .sp-hero-eyebrow::before { content:''; display:block; width:24px; height:1px; background:var(--accent); }\n#fs-sp .sp-hero-title { font-size:clamp(52px,11vw,140px); font-weight:900; line-height:0.9; letter-spacing:-0.02em; margin-bottom:24px; text-transform:uppercase; }\n#fs-sp .sp-hero-title .l1 { color:var(--white); display:block; }\n#fs-sp .sp-hero-title .l2 { -webkit-text-stroke:1.5px var(--white); color:transparent; display:block; }\n#fs-sp .sp-hero-title .l3 { color:var(--accent); display:block; }\n#fs-sp .sp-hero-bottom { display:flex; flex-direction:column; gap:20px; padding-top:24px; border-top:1px solid var(--border); }\n#fs-sp .sp-hero-date { font-size:13px; letter-spacing:0.15em; text-transform:uppercase; color:var(--accent); font-weight:700; }\n#fs-sp .sp-hero-copy { font-size:15px; line-height:1.65; color:rgba(245,242,236,0.65); max-width:540px; }\n#fs-sp .sp-hero-copy strong { color:var(--white); font-weight:600; }\n#fs-sp .sp-hero-btns { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }\n\n#fs-sp .sp-btn {\n  display:inline-flex; align-items:center; gap:8px;\n  font-size:12px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;\n  text-decoration:none; padding:14px 28px; cursor:pointer; border:none; outline:none;\n  transition:all 0.2s ease; white-space:nowrap;\n  border-radius:999px;\n}\n#fs-sp .sp-btn-fill { background:var(--accent); color:#fff; }\n#fs-sp .sp-btn-fill:hover { background:#e56600; color:#fff; text-decoration:none; }\n#fs-sp .sp-btn-ghost { background:transparent; color:var(--white); border:1px solid rgba(245,242,236,0.35); }\n#fs-sp .sp-btn-ghost:hover { border-color:var(--white); color:var(--white); text-decoration:none; }\n#fs-sp .sp-btn-dark { background:var(--black); color:var(--white); border:1px solid rgba(245,242,236,0.2); }\n#fs-sp .sp-btn-dark:hover { background:var(--gray); color:var(--white); text-decoration:none; }\n#fs-sp .sp-btn-