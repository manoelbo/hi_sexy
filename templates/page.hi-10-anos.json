/files/IMG_9623.jpg?v=1777494018\"><img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_9623.jpg?v=1777494018\" alt=\"Future Skills SP\" loading=\"lazy\"></div>\n      <div class=\"sp-mas-item\" data-src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_8926.jpg?v=1777494020\"><img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_8926.jpg?v=1777494020\" alt=\"Future Skills SP\" loading=\"lazy\"></div>\n      <div class=\"sp-mas-item\" data-src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_9562.jpg?v=1777494017\"><img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_9562.jpg?v=1777494017\" alt=\"Future Skills SP\" loading=\"lazy\"></div>\n    </div>\n\n    <!-- Lightbox -->\n    <div class=\"sp-lightbox\" id=\"spLightbox\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Foto ampliada\">\n      <button class=\"sp-lb-close\" id=\"spLbClose\" aria-label=\"Fechar\">×</button>\n      <button class=\"sp-lb-nav sp-lb-prev\" id=\"spLbPrev\" aria-label=\"Anterior\">←</button>\n      <button class=\"sp-lb-nav sp-lb-next\" id=\"spLbNext\" aria-label=\"Próxima\">→</button>\n      <div class=\"sp-lb-img-wrap\">\n        <img class=\"sp-lb-img\" id=\"spLbImg\" src=\"\" alt=\"\">\n      </div>\n      <div class=\"sp-lb-counter\" id=\"spLbCounter\"></div>\n    </div>\n\n  </div>\n</section>\n\n<section class=\"sp-corp\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-corp-inner\">\n      <div>\n        <span class=\"sp-corp-badge\">Para Empresas</span>\n        <h2 class=\"sp-corp-heading\">Desconto<br>para <span>Grupos</span><br>Corporativos</h2>\n        <p class=\"sp-corp-body\">Quer levar sua equipe para a Future Skills? Oferecemos <strong>pacotes especiais com desconto progressivo</strong> para empresas que adquirem mais de uma vaga. Quanto mais pessoas, maior o desconto.</p>\n        <p class=\"sp-corp-body\">Trabalhamos também com <strong>versões customizadas do programa</strong> para equipes inteiras que queiram vivenciar a metodologia Hyper Island dentro da sua empresa.</p>\n        <div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;\">\n          <a href=\"mailto:learning.americas@hyperisland.com?subject=Pacote%20Corporativo%20Future%20Skills%20SP\" class=\"sp-btn sp-btn-fill sp-arr\" target=\"_blank\">Solicitar Proposta</a>\n          <a href=\"https://wa.me/5521976646326?text=Ol%C3%A1!%20Gostaria%20de%20saber%20mais%20sobre%20o%20pacote%20corporativo%20da%20Future%20Skills%20S%C3%A3o%20Paulo\" class=\"sp-btn sp-btn-dark\" target=\"_blank\">Falar pelo WhatsApp</a>\n        </div>\n      </div>\n      <div>\n        <div class=\"sp-corp-card\">\n          <div class=\"sp-corp-card-num\">3+</div>\n          <div class=\"sp-corp-card-label\">Vagas · Desconto Especial</div>\n          <p class=\"sp-corp-card-body\">A partir de <strong>3 participantes da mesma empresa</strong>, você já tem direito a condições exclusivas. Entre em contato para receber uma proposta personalizada para o seu grupo.</p>\n          <a href=\"https://wa.me/5521976646326?text=Ol%C3%A1!%20Gostaria%20de%20saber%20mais%20sobre%20o%20pacote%20corporativo%20da%20Future%20Skills%20S%C3%A3o%20Paulo\" class=\"sp-btn sp-btn-fill sp-arr\" target=\"_blank\">Falar com um consultor</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-cta\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-cta-inner\">\n      <div>\n        <div class=\"sp-label\">Pronto para participar?</div>\n        <h2 class=\"sp-cta-heading\">Prepare-se<br>para o<br><span>Futuro</span>\n</h2>\n        <p class=\"sp-cta-body\">Uma habilidade de cada vez. Junte-se a líderes de todo o Brasil na próxima Future Skills Masterclass. Vagas disponíveis — garanta a sua antes que esgotem.</p>\n        <div class=\"sp-cta-btns\">\n          <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-full-pass\" class=\"sp-btn sp-btn-fill sp-arr\" target=\"_blank\">Full Pass — 2 Dias</a>\n          <a href=\"mailto:learning.americas@hyperisland.com\" class=\"sp-btn sp-btn-dark\">Entre em Contato</a>\n        </div>\n      </div>\n      <div>\n        <div class=\"sp-syllabus-box\">\n          <div class=\"sp-syllabus-title\">O que você vai aprender</div>\n          <div class=\"sp-syllabus-sub\">Edição São Paulo · 2 Dias</div>\n          <div class=\"sp-syllabus-row\">\n<div class=\"sp-s-dot\"></div>Dia 1 — Inovação em um Mundo Pós-IA</div>\n          <div class=\"sp-syllabus-row\">\n<div class=\"sp-s-dot\"></div>Dia 2 — Liderando a Transformação Contínua</div>\n          <div class=\"sp-syllabus-row\">\n<div class=\"sp-s-dot\"></div>Sessões imersivas com experts internacionais</div>\n          <div class=\"sp-syllabus-row\">\n<div class=\"sp-s-dot\"></div>Rede de 40+ líderes e tomadores de decisão</div>\n          <div class=\"sp-syllabus-row\">\n<div class=\"sp-s-dot\"></div>Da teoria da IA à aplicação prática real</div>\n          <div class=\"sp-syllabus-row\">\n<div class=\"sp-s-dot\"></div>Metodologia Hyper Island — aprender fazendo</div>\n          <details class=\"sp-syl-details\">\n            <summary class=\"sp-btn sp-btn-fill sp-arr sp-syllabus-cta\">Baixar o programa completo</summary>\n            <div class=\"sp-syl-popup\">\n              <button onclick=\"this.closest('details').open=false\" class=\"sp-syl-close\">×</button>\n              <p class=\"sp-syl-lbl\">Download</p>\n              <p class=\"sp-syl-title\">Baixe o programa do evento</p>\n              <div id=\"hs-form-3\"></div>\n            </div>\n          </details>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-about\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-about-inner\">\n      <div>\n        <div class=\"sp-label\" style=\"color:rgba(255,255,255,0.6);\">Sobre a Hyper Island</div>\n        <h2 class=\"sp-heading\" style=\"color:#fff;margin-bottom:0;\">30 Anos<br>de Futuro</h2>\n      </div>\n      <div>\n        <p class=\"sp-about-body\">Em 2026, a Hyper Island completa <strong>30 anos</strong> como provedora de educação e facilitadora de experiências de aprendizagem imersivas, tanto para indivíduos quanto para empresas. Trabalhamos para ajudar pessoas a desenvolverem as habilidades para enfrentarem os desafios de uma sociedade em constante mudança.</p>\n        <div style=\"margin-top:20px;\">\n          <a href=\"https://www.hyperisland.com.br/pages/empresas\" class=\"sp-btn\" style=\"background:#000;color:#fff;border-radius:999px;\" target=\"_blank\">Conheça nossas soluções →</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sp-faq\">\n  <div class=\"sp-wrap\">\n    <div class=\"sp-label\">Perguntas Frequentes</div>\n    <h2 class=\"sp-heading\">FAQ</h2>\n    <div class=\"sp-faq-list\">\n\n      <details class=\"sp-faq-item\">\n        <summary>O evento emite certificado?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Sim. Todos os participantes recebem um <strong>certificado de participação</strong> emitido pela Hyper Island ao concluir os dois dias de evento. Para quem adquirir o ingresso de apenas um dia, o certificado cobre o módulo correspondente.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>O almoço está incluído no ingresso?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Sim. <strong>Almoço e coffee breaks</strong> estão inclusos para todos os participantes nos dois dias de evento. O objetivo é que você fique totalmente imerso na experiência — sem precisar sair para resolver refeições.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>Quem são os facilitadores?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Os facilitadores são <strong>experts com experiência global</strong> vindos de diferentes países e setores da indústria. São profissionais que combinam sólida experiência corporativa com metodologia de facilitação desenvolvida ao longo de décadas pela Hyper Island.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>Quem costuma participar do evento?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">A Future Skills reúne cerca de <strong>40 líderes e tomadores de decisão</strong> de setores diversos — Marketing, RH, Inovação, Tecnologia, Estratégia, Indústrias Criativas, Finanças e mais. O mix intencional de perfis é parte do design da experiência: as trocas entre participantes são tão valiosas quanto o conteúdo.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>Posso comprar ingresso para apenas um dia?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Sim. Você pode adquirir o <strong>ingresso individual para o Dia 01</strong> (19/08 — Inovação em um Mundo Pós-IA) ou para o <strong>Dia 02</strong> (20/08 — Liderando a Transformação Contínua) separadamente. Recomendamos o Full Pass para aproveitar a experiência completa e maximizar o networking.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>O evento é presencial ou pode ser online?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">A Future Skills é um evento <strong>100% presencial.</strong>\n</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>Qual é o idioma do evento?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">A edição de São Paulo é conduzida totalmente em <strong>Português</strong>, mesmo parte dos facilitadores sendo de outros países.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>Qual é a política de cancelamento?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Você pode cancelar com <strong>reembolso integral</strong> até 24 horas antes do evento. Para dúvidas específicas, entre em contato pelo e-mail <strong>learning.americas@hyperisland.com</strong>.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>Minha empresa pode patrocinar ou enviar um grupo?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Sim. A Hyper Island oferece <strong>condições especiais para grupos</strong> a partir de 3 participantes da mesma empresa. Também trabalhamos com versões customizadas do programa para equipes inteiras. Entre em contato pelo e-mail <strong>learning.americas@hyperisland.com</strong> para saber mais.</div>\n      </details>\n\n      <details class=\"sp-faq-item\">\n        <summary>O que devo levar para o evento?<span class=\"sp-faq-icon\">+</span></summary>\n        <div class=\"sp-faq-body\">Venha com <strong>mente aberta e disposição para colaborar</strong>. Todo o material de apoio é fornecido pela Hyper Island no local. Use roupas confortáveis — o evento é dinâmico e inclui atividades hands-on.</div>\n      </details>\n\n    </div>\n    <div style=\"text-align:center;margin-top:48px;\">\n      <a href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-full-pass\" class=\"sp-btn sp-btn-fill sp-arr\" target=\"_blank\">Garantir meu ingresso</a>\n    </div>\n  </div>\n</section>\n\n</div>\n\n<script charset=\"utf-8\" type=\"text/javascript\" src=\"//js.hsforms.net/forms/embed/v2.js\"></script>\n<script>\n(function () {\n  /* ---- Video testimonials ---- */\n  var cards = document.querySelectorAll('#fs-sp .sp-testi-card');\n  var currentPlaying = null;\n  cards.forEach(function (card) {\n    var video = card.querySelector('video');\n    card.addEventListener('click', function () {\n      if (currentPlaying && currentPlaying !== video) {\n        currentPlaying.pause();\n        currentPlaying.closest('.sp-testi-card').classList.remove('is-playing');\n      }\n      if (video.paused) {\n        video.muted = false;\n        video.play();\n        card.classList.add('is-playing');\n        currentPlaying = video;\n      } else {\n        video.pause();\n        card.classList.remove('is-playing');\n        currentPlaying = null;\n      }\n    });\n    video.addEventListener('ended', function () {\n      card.classList.remove('is-playing');\n      currentPlaying = null;\n    });\n  });\n\n  /* ---- HubSpot forms — load lazily on open ---- */\n  var hsLoaded = {};\n  var formConfigs = {\n    'hs-form-1': { portalId:'1588780', formId:'faeb6bab-888d-4b99-ac4b-0e38ead8d746', region:'na1' },\n    'hs-form-3': { portalId:'1588780', formId:'faeb6bab-888d-4b99-ac4b-0e38ead8d746', region:'na1' }\n  };\n  function loadHsForm(targetId) {\n    if (hsLoaded[targetId]) return;\n    if (!window.hbspt) { setTimeout(function(){ loadHsForm(targetId); }, 500); return; }\n    var cfg = formConfigs[targetId];\n    if (!cfg) return;\n    hbspt.forms.create({ portalId:cfg.portalId, formId:cfg.formId, region:cfg.region, target:'#' + targetId });\n    hsLoaded[targetId] = true;\n  }\n  document.querySelectorAll('#fs-sp .sp-syl-details').forEach(function(details) {\n    details.addEventListener('toggle', function() {\n      if (!details.open) return;\n      var formEl = details.querySelector('[id^=\"hs-form-\"]');\n      if (formEl) loadHsForm(formEl.id);\n    });\n  });\n\n  /* ---- Masonry Lightbox ---- */\n  var items = Array.from(document.querySelectorAll('#spMasonry .sp-mas-item'));\n  var lightbox = document.getElementById('spLightbox');\n  var lbImg   = document.getElementById('spLbImg');\n  var lbCounter = document.getElementById('spLbCounter');\n  var lbClose = document.getElementById('spLbClose');\n  var lbPrev  = document.getElementById('spLbPrev');\n  var lbNext  = document.getElementById('spLbNext');\n  var current = 0;\n\n  if (!lightbox) return; // safety guard\n\n  function openLightbox(idx) {\n    current = idx;\n    var src = items[idx].getAttribute('data-src') || items[idx].querySelector('img').src;\n    lbImg.style.opacity = '0';\n    lbImg.src = src;\n    lbImg.onload = function() { lbImg.style.opacity = '1'; };\n    lbCounter.textContent = (idx + 1) + ' / ' + items.length;\n    lightbox.classList.add('is-open');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function closeLightbox() {\n    lightbox.classList.remove('is-open');\n    document.body.style.overflow = '';\n  }\n\n  function goNext() { openLightbox((current + 1) % items.length); }\n  function goPrev() { openLightbox((current - 1 + items.length) % items.length); }\n\n  items.forEach(function(item, idx) {\n    item.addEventListener('click', function() { openLightbox(idx); });\n  });\n\n  lbClose.addEventListener('click', closeLightbox);\n  lbNext.addEventListener('click', function(e) { e.stopPropagation(); goNext(); });\n  lbPrev.addEventListener('click', function(e) { e.stopPropagation(); goPrev(); });\n\n  lightbox.addEventListener('click', function(e) {\n    if (e.target === lightbox) closeLightbox();\n  });\n\n  document.addEventListener('keydown', function(e) {\n    if (!lightbox.classList.contains('is-open')) return;\n    if (e.key === 'Escape') closeLightbox();\n    if (e.key === 'ArrowRight') goNext();\n    if (e.key === 'ArrowLeft') goPrev();\n  });\n\n  /* Touch swipe support for lightbox */\n  var touchStartX = 0;\n  lightbox.addEventListener('touchstart', function(e) {\n    touchStartX = e.changedTouches[0].clientX;\n  }, { passive: true });\n  lightbox.addEventListener('touchend', function(e) {\n    var dx = e.changedTouches[0].clientX - touchStartX;\n    if (Math.abs(dx) > 50) { dx < 0 ? goNext() : goPrev(); }\n  }, { passive: true });\n\n})();\n</script>",
