" class=\"hi-btn hi-btn-orange\">Conhecer todos os cursos</a>\n        <a href=\"https://www.hyperisland.com.br/pages/cursos-para-empresas\" class=\"hi-btn hi-btn-outline\" style=\"border-color:rgba(255,255,255,0.4);color:#fff;\">Cursos in-company</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ============================================================\n       6. RECURSOS GRATUITOS\n       ============================================================ -->\n  <section class=\"hi-resources\" aria-label=\"Ferramentas e recursos gratuitos\">\n    <div class=\"hi-container\">\n      <div class=\"hi-resources__header hi-reveal\">\n        <div>\n          <span class=\"hi-eyebrow\">Ferramentas gratuitas</span>\n          <h2 class=\"hi-resources__title\">Comece com uma ferramenta prática.</h2>\n        </div>\n        <p class=\"hi-resources__intro\">\n          Explore assessments, ferramentas e conteúdos gratuitos para refletir\n          sobre liderança, facilitar conversas e aplicar novas práticas com\n          seu time.\n        </p>\n      </div>\n      <div class=\"hi-resources__grid\">\n\n        <article class=\"hi-resource-card hi-reveal hi-reveal-delay-1\">\n          <div class=\"hi-resource-card__icon\" aria-hidden=\"true\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/HI_Icon_InPerson.png?v=1779995159\" alt=\"\" class=\"hi-resource-card__icon-img\">\n          </div>\n          <h3 class=\"hi-resource-card__title\">Leadership Balance Assessment</h3>\n          <p class=\"hi-resource-card__text\">\n            Descubra como você equilibra liderança operacional, empreendedora\n            e habilitadora.\n          </p>\n          <a href=\"https://leadership-assessment.hyperislandamericas.com/\" class=\"hi-resource-card__link\" target=\"_blank\" rel=\"noopener\">Fazer assessment</a>\n        </article>\n\n        <article class=\"hi-resource-card hi-reveal hi-reveal-delay-2\">\n          <div class=\"hi-resource-card