      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<!-- ============================================================\n     HYPER ISLAND — BANNER ANIVERSÁRIO DE 30 ANOS\n     Seção isolada e autocontida. Cole dentro de uma seção HTML\n     do Shopify. Não interfere em menu, footer ou outros elementos.\n     Fontes: propositalmente NÃO definidas — o tema do Shopify\n     (ABC Gravity Variable) assume automaticamente.\n============================================================= -->\n<section id=\"hi30-banner\" aria-label=\"Promoção de aniversário de 30 anos da Hyper Island\">\n\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@300&amp;display=swap\" rel=\"stylesheet\">\n\n  <style>\n    #hi30-banner{\n      --hi30-orange:#FF7300;\n      --hi30-orange-light:#ffb066;\n      --hi30-black:#0b0b0c;\n      --hi30-black-2:#161618;\n      --hi30-cream:#F3F0ED;\n      position:relative;\n      width:100%;\n      overflow:hidden;\n      background:#000;\n      padding:64px 20px 56px;\n      box-sizing:border-box;\n      isolation:isolate;\n    }\n\n    #hi30-banner *{ box-sizing:border-box; }\n\n    /* ---------- conteúdo central ---------- */\n    #hi30-banner .hi30-inner{\n      position:relative;\n      z-index:2;\n      max-width:740px;\n      margin:0 auto;\n      text-align:center;\n    }\n\n    /* halo pulsante atrás da logo */\n    #hi30-banner .hi30-logo-wrap{\n      position:relative;\n      display:flex;\n      justify-content:center;\n      align-items:center;\n      width:100%;\n      margin-bottom:28px;\n    }\n    #hi30-banner .hi30-logo-wrap svg{\n      position:relative;\n      width:100%;\n      max-width:230px;\n      height:auto;\n      display:block;\n      margin:0 auto;\n      filter:drop-shadow(0 0 18px rgba(255,115,0,.35));\n    }\n\n    /* eyebrow */\n    #hi30-banner .hi30-eyebrow{\n      display:inline-block;\n      color:var(--hi30-orange);\n      font-size:13px;\n      font-weight:700;\n      letter-spacing:.22em;\n      text-transform:uppercase;\n      margin:0 0 10px;\n      opacity:0;\n      animation:hi30-rise .7s ease-out .1s forwards;\n    }\n\n    /* headline */\n    #hi30-banner h2.hi30-title{\n      margin:0 0 14px;\n      color:var(--hi30-cream);\n      font-weight:700;\n      font-size:clamp(28px, 5vw, 44px);\n      line-height:1.08;\n      letter-spacing:-.01em;\n      opacity:0;\n      animation:hi30-rise .7s ease-out .22s forwards;\n    }\n    #hi30-banner h2.hi30-title span{\n      background:linear-gradient(90deg, var(--hi30-orange-light), var(--hi30-orange), var(--hi30-orange-light));\n      background-size:220% auto;\n      -webkit-background-clip:text;\n      background-clip:text;\n      -webkit-text-fill-color:transparent;\n      animation:hi30-shimmer 3.2s linear infinite;\n    }\n    @keyframes hi30-shimmer{\n      to{ background-position:-220% center; }\n    }\n\n    /* subtítulo */\n    #hi30-banner .hi30-sub{\n      color:rgba(243,240,237,.78);\n      font-size:clamp(15px,2.2vw,18px);\n      line-height:1.5;\n      margin:0 0 34px;\n      opacity:0;\n      animation:hi30-rise .7s ease-out .34s forwards;\n    }\n    #hi30-banner .hi30-sub strong{\n      color:var(--hi30-orange);\n      font-weight:700;\n    }\n\n    /* cupom + botão */\n    #hi30-banner .hi30-coupon-block{\n      display:flex;\n      flex-wrap:wrap;\n      gap:14px;\n      justify-content:center;\n      align-items:center;\n      opacity:0;\n      animation:hi30-rise .7s ease-out .46s forwards;\n    }\n\n    #hi30-banner .hi30-code-chip{\n      display:flex;\n      align-items:center;\n      gap:10px;\n      border:1.5px dashed rgba(255,115,0,.55);\n      border-radius:999px;\n      padding:12px 22px;\n      background:rgba(255,115,0,.06);\n    }\n    #hi30-banner .hi30-code-chip .hi30-code-label{\n      font-size:11px;\n      letter-spacing:.16em;\n      text-transform:uppercase;\n      color:rgba(243,240,237,.55);\n      font-weight:600;\n    }\n    #hi30-banner .hi30-code-chip .hi30-code-value{\n      font-weight:800;\n      font-size:18px;\n      letter-spacing:.06em;\n      color:var(--hi30-cream);\n    }\n\n    #hi30-banner .hi30-btn{\n      position:relative;\n      display:inline-flex;\n      align-items:center;\n      gap:10px;\n      background:var(--hi30-orange);\n      color:#0b0b0c;\n      font-weight:700;\n      font-size:16px;\n      letter-spacing:.01em;\n      border:none;\n      border-radius:999px;\n      padding:15px 30px;\n      cursor:pointer;\n      overflow:hidden;\n      box-shadow:0 0 0 0 rgba(255,115,0,.55);\n      animation:hi30-btn-pulse 2.2s ease-in-out infinite;\n      transition:transform .18s ease, background .18s ease;\n    }\n    #hi30-banner .hi30-btn:hover{\n      transform:translateY(-2px) scale(1.03);\n      background:var(--hi30-orange-light);\n    }\n    #hi30-banner .hi30-btn:active{\n      transform:translateY(0) scale(.98);\n    }\n    #hi30-banner .hi30-btn.hi30-copied{\n      background:#1e9e5a;\n      color:#fff;\n      animation:none;\n      box-shadow:0 0 0 0 rgba(30,158,90,0);\n    }\n    #hi30-banner .hi30-btn .hi30-icon-copy,\n    #hi30-banner .hi30-btn .hi30-icon-check{\n      display:block;\n    }\n    #hi30-banner .hi30-btn .hi30-icon-check{\n      display:none;\n    }\n    #hi30-banner .hi30-btn.hi30-copied .hi30-icon-copy{\n      display:none;\n    }\n    #hi30-banner .hi30-btn.hi30-copied .hi30-icon-check{\n      display:block;\n    }\n    @keyframes hi30-btn-pulse{\n      0%{ box-shadow:0 0 0 0 rgba(255,115,0,.55); }\n      70%{ box-shadow:0 0 0 14px rgba(255,115,0,0); }\n      100%{ box-shadow:0 0 0 0 rgba(255,115,0,0); }\n    }\n    #hi30-banner .hi30-btn svg{\n      width:16px;\n      height:16px;\n      flex:none;\n    }\n    #hi30-banner .hi30-btn .hi30-btn-label{\n      transition:opacity .15s ease;\n    }\n\n    #hi30-banner .hi30-toast{\n      position:absolute;\n      left:50%;\n      bottom:calc(100% + 10px);\n      transform:translateX(-50%) translateY(6px);\n      background:var(--hi30-cream);\n      color:#0b0b0c;\n      font-size:12px;\n      font-weight:700;\n      letter-spacing:.02em;\n      padding:7px 14px;\n      border-radius:8px;\n      white-space:nowrap;\n      opacity:0;\n      pointer-events:none;\n      transition:opacity .2s ease, transform .2s ease;\n    }\n    #hi30-banner .hi30-toast::after{\n      content:\"\";\n      position:absolute;\n      top:100%;\n      left:50%;\n      transform:translateX(-50%);\n      border:5px solid transparent;\n      border-top-color:var(--hi30-cream);\n    }\n    #hi30-banner .hi30-btn.hi30-copied .hi30-toast{\n      opacity:1;\n      transform:translateX(-50%) translateY(0);\n    }\n\n    #hi30-banner .hi30-fineprint{\n      margin:22px 0 0;\n      color:rgba(243,240,237,.4);\n      font-size:12px;\n      opacity:0;\n      animation:hi30-rise .7s ease-out .56s forwards;\n    }\n\n    @keyframes hi30-rise{\n      from{ opacity:0; transform:translateY(14px); }\n      to{ opacity:1; transform:translateY(0); }\n    }\n\n    @media (max-width:480px){\n      #hi30-banner{ padding:48px 16px 44px; }\n      #hi30-banner .hi30-coupon-block{ flex-direction:column; }\n    }\n\n    @media (prefers-reduced-motion: reduce){\n      #hi30-banner h2.hi30-title span,\n      #hi30-banner .hi30-btn{\n        animation:none !important;\n      }\n      #hi30-banner .hi30-eyebrow,\n      #hi30-banner h2.hi30-title,\n      #hi30-banner .hi30-sub,\n      #hi30-banner .hi30-coupon-block,\n      #hi30-banner .hi30-fineprint{\n        opacity:1 !important;\n        transform:none !important;\n        animation:none !important;\n      }\n    }\n  </style>\n\n  <div class=\"hi30-inner\">\n\n    <div class=\"hi30-logo-wrap\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 793.27 256.96\" role=\"img\" aria-label=\"Hyper Island 30 anos\">\n        <defs>\n          <style>\n            .hi30-cls-1, .hi30-cls-2 { fill:#ff7300; }\n            .hi30-cls-2 { font-family:'Montserrat', sans-serif; font-weight:300; font-size:258.92px; }\n            .hi30-cls-3 { fill:#fff; }\n          </style>\n        </defs>\n        <text class=\"hi30-cls-2\" transform=\"translate(.61 197.26)\"><tspan x=\"0\" y=\"0\">3</tspan></text>\n        <path class=\"hi30-cls-1\" d=\"M278.57,46.36h-15.4c-10.43-17.18-29.31-28.68-50.84-28.68-32.77,0-59.43,26.66-59.43,59.43,0,17.88,8.02,34.66,21.69,45.91v16.63c-1.05-.63-2.08-1.3-3.1-1.98-20.16-13.62-32.2-36.26-32.2-60.56,0-40.27,32.76-73.04,73.04-73.04,29.29,0,54.61,17.33,66.24,42.28\"></path>\n        <g>\n          <path class=\"hi30-cls-3\" d=\"M214.84,86.02h40.79v25.84h25.52v-25.84h40.79v75h-40.79v-27.2h-25.52v27.2h-40.79v-75Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M365.04,141.51l-38.81-55.49h46.76l12.92,22.59,12.92-22.59h46.34l-38.81,55.33v19.66h-41.32v-19.51Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M449.4,86.02h54.97c27.93,0,45.97,7.27,45.97,26.31s-17.26,27.72-45.81,27.72h-14.33v20.97h-40.79v-75ZM496.26,122.26c9.15,0,13.81-2.88,13.81-9.52s-4.71-9.2-13.6-9.2h-6.28v18.72h6.07Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M555.66,86.02h93.93v18.57h-53.14v8.63h43.72v19.25h-43.72v9.47h53.14v19.09h-93.93v-75Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M655.17,86.02h66.26c25.78,0,37.97,7.37,37.97,21.13,0,12.19-9.21,17.99-20.92,20.08,13.6,1.67,22.12,5.91,22.12,19.61v14.17h-40.79v-13.86c0-8.79-5.18-11.19-16.47-11.19h-7.37v25.05h-40.79v-75ZM706.79,118.81c7.27,0,12.29-2.14,12.29-8.16s-4.92-7.48-12.29-7.48h-10.83v15.64h10.83Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M186.9,174.56h40.79v75h-40.79v-75Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M232.35,227.27h44.4c.21,5.6,4.6,9,11.51,9,4.34,0,8.52-1.46,8.52-5.33,0-3.66-3.56-5.18-10.41-6.48l-18.46-3.45c-15.85-2.98-34.15-8-34.15-23.06,0-18.93,25-25.99,51.36-25.99,24.95,0,50.52,6.96,52.67,23.95h-42.68c-.63-6.07-5.02-8.05-10.09-8.05s-8.73,2.09-8.73,5.65c0,3.35,3.4,4.24,7.17,4.97l26.67,5.23c16.11,3.14,29.44,8.73,29.44,22.96,0,18.36-24.27,25.52-53.97,25.52s-52.4-8.68-53.24-24.9Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M344.44,174.56h40.79v52.25h45.92v22.75h-86.71v-75Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M465.26,174.56h58.42l31.64,75h-44.09l-3.66-10.88h-27.09l-3.66,10.88h-43.04l31.48-75ZM501.24,218.49l-7.27-22.23-7.22,22.23h14.49Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M558.43,174.56h46.91l30.12,41.16v-41.16h36.4v75h-45.81l-31.17-42.78v42.78h-36.45v-75Z\"></path>\n          <path class=\"hi30-cls-3\" d=\"M678.2,174.56h54.97c35.51,0,55.39,11.72,55.39,36.98s-19.3,38.02-55.59,38.02h-54.76v-75ZM724.69,230.2c12.66,0,20.45-5.39,20.45-18.67s-7.48-17.73-19.35-17.73h-6.85v36.4h5.75Z\"></path>\n        </g>\n      </svg>\n    </div>\n\n    <p class=\"hi30-eyebrow\">Aniversário Hyper Island</p>\n    <h2 class=\"hi30-title\">30 anos formando quem <span>transforma o futuro</span>\n</h2>\n    <p class=\"hi30-sub\">Para celebrar, <strong>30% de desconto</strong> em todos os cursos online com o cupom abaixo.</p>\n\n    <div class=\"hi30-coupon-block\">\n      <div class=\"hi30-code-chip\">\n        <span class=\"hi30-code-label\">cupom</span>\n        <span class=\"hi30-code-value\" id=\"hi30-code-text\">HI30ANOS</span>\n      </div>\n\n      <button type=\"button\" class=\"hi30-btn\" id=\"hi30-copy-btn\" aria-label=\"Copiar cupom HI30ANOS\">\n        <span class=\"hi30-toast\" id=\"hi30-toast\">Cupom copiado!</span>\n        <svg class=\"hi30-icon-copy\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path></svg>\n        <svg class=\"hi30-icon-check\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n        <span class=\"hi30-btn-label\" id=\"hi30-btn-label\">Resgatar cupom</span>\n      </button>\n    </div>\n\n    <p class=\"hi30-fineprint\">Válido para cursos online até dia 31/07. Aplique o cupom na etapa de pagamento.</p>\n\n  </div>\n\n  <script>\n    (function(){\n      var root = document.getElementById('hi30-banner');\n      if(!root) return;\n\n      /* ---- copiar cupom ---- */\n      var btn = root.querySelector('#hi30-copy-btn');\n      var codeText = root.querySelector('#hi30-code-text').textContent.trim();\n\n      function fallbackCopy(text){\n        var ta = document.createElement('textarea');\n        ta.value = text;\n        ta.style.position = 'fixed';\n        ta.style.opacity = '0';\n        document.body.appendChild(ta);\n        ta.focus();\n        ta.select();\n        try { document.execCommand('copy'); } catch(e) {}\n        document.body.removeChild(ta);\n      }\n\n      var label = root.querySelector('#hi30-btn-label');\n      var originalLabel = label.textContent;\n      var copiedTimeout;\n\n      btn.addEventListener('click', function(){\n        var done = function(){\n          clearTimeout(copiedTimeout);\n          btn.classList.add('hi30-copied');\n          label.textContent = 'Cupom copiado!';\n          copiedTimeout = setTimeout(function(){\n            btn.classList.remove('hi30-copied');\n            label.textContent = originalLabel;\n          }, 2200);\n        };\n\n        if (navigator.clipboard && navigator.clipboard.writeText) {\n          navigator.clipboard.writeText(codeText).then(done).catch(function(){\n            fallbackCopy(codeText);\n            done();\n          });\n        } else {\n          fallbackCopy(codeText);\n          done();\n        }\n      });\n    })();\n  </script>\n\n</section>",
