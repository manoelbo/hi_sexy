        "html": "<!-- =============================================\n     SEÇÃO: DEPOIMENTOS EM VÍDEO\n     Hyper Island Brasil — Shopify Ready\n     - Sem wrappers html/head/body\n     - CSS escopado em .hi-testimonials\n     - 5 vídeos verticais lado a lado\n     - Compatível com mobile (scroll horizontal)\n============================================= -->\n\n<style>\n  .hi-testimonials {\n    background-color: #000000;\n    padding: 72px 40px;\n    font-family: 'Montserrat', sans-serif;\n  }\n\n  .hi-testimonials__header {\n    text-align: center;\n    margin-bottom: 48px;\n  }\n\n  .hi-testimonials__eyebrow {\n    display: inline-block;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #FF7300;\n    margin-bottom: 12px;\n  }\n\n  .hi-testimonials__title {\n    font-size: clamp(24px, 3vw, 38px);\n    font-weight: 800;\n    color: #f3f0ed;\n    line-height: 1.15;\n    margin: 0;\n    letter-spacing: -0.02em;\n  }\n\n  .hi-testimonials__title span {\n    color: #FF7300;\n  }\n\n  /* Track com scroll horizontal em mobile */\n  .hi-testimonials__track-wrap {\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none; /* Firefox */\n    padding-bottom: 8px;\n  }\n\n  .hi-testimonials__track-wrap::-webkit-scrollbar {\n    display: none;\n  }\n\n  .hi-testimonials__track {\n    display: flex;\n    gap: 16px;\n    min-width: max-content;\n  }\n\n  /* Card individual */\n  .hi-testimonials__card {\n    position: relative;\n    width: 220px;\n    flex-shrink: 0;\n    border-radius: 12px;\n    overflow: hidden;\n    background: #1a1a1a;\n    cursor: pointer;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n\n  .hi-testimonials__card:hover {\n    transform: translateY(-6px) scale(1.02);\n    box-shadow: 0 24px 48px rgba(255, 115, 0, 0.2);\n  }\n\n  /* Wrapper de aspecto 9:16 para vídeos verticais */\n  .hi-testimonials__video-wrap {\n    position: relative;\n    width: 100%;\n    padding-top: 177.78%; /* 16:9 invertido = 9:16 */\n  }\n\n  .hi-testimonials__video {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    border-radius: 12px;\n  }\n\n  /* Thumbnail — esconde quando vídeo está tocando */\n  .hi-testimonials__thumb {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    border-radius: 12px;\n    transition: opacity 0.3s ease;\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .hi-testimonials__card.is-playing .hi-testimonials__thumb {\n    opacity: 0;\n  }\n\n  /* Overlay e play ficam acima da thumb */\n  .hi-testimonials__overlay {\n    z-index: 2;\n  }\n\n  .hi-testimonials__play {\n    z-index: 3;\n  }\n\n  /* Overlay escuro com gradiente na base */\n  .hi-testimonials__overlay {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 50%;\n    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 100%);\n    border-radius: 0 0 12px 12px;\n    pointer-events: none;\n    transition: opacity 0.3s ease;\n  }\n\n  /* Botão play centralizado */\n  .hi-testimonials__play {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 52px;\n    height: 52px;\n    background: rgba(255, 115, 0, 0.92);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: opacity 0.25s ease, transform 0.25s ease, background 0.25s ease;\n    pointer-events: none;\n  }\n\n  .hi-testimonials__play svg {\n    width: 20px;\n    height: 20px;\n    fill: #fff;\n    margin-left: 3px; /* compensa posição visual do triângulo */\n  }\n\n  /* Quando o vídeo está tocando: esconde botão play e overlay */\n  .hi-testimonials__card.is-playing .hi-testimonials__play {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0.8);\n  }\n\n  .hi-testimonials__card.is-playing .hi-testimonials__overlay {\n    opacity: 0;\n  }\n\n  .hi-testimonials__card:hover .hi-testimonials__play {\n    background: #FF7300;\n    transform: translate(-50%, -50%) scale(1.1);\n  }\n\n  /* Responsivo: em telas maiores os cards crescem proporcionalmente */\n  @media (min-width: 1280px) {\n    .hi-testimonials__card {\n      width: calc((100vw - 80px - 64px) / 5);\n      max-width: 260px;\n    }\n\n    .hi-testimonials__track {\n      min-width: unset;\n      justify-content: center;\n    }\n  }\n\n  /* Botão CTA */\n  .hi-testimonials__cta-wrap {\n    text-align: center;\n    margin-top: 48px;\n  }\n\n  .hi-testimonials__cta {\n    display: inline-block;\n    background-color: #FF7300;\n    color: #fff;\n    font-family: 'Montserrat', sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    text-decoration: none;\n    padding: 18px 48px;\n    border-radius: 999px;\n    transition: background-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;\n  }\n\n  .hi-testimonials__cta:hover {\n    background-color: #e56600;\n    transform: translateY(-2px);\n    box-shadow: 0 12px 32px rgba(255, 115, 0, 0.35);\n    color: #fff;\n    text-decoration: none;\n  }\n\n  .hi-testimonials__cta:active {\n    transform: translateY(0);\n    box-shadow: none;\n  }\n\n  @media (max-width: 768px) {\n    .hi-testimonials {\n      padding: 48px 24px;\n    }\n\n    .hi-testimonials__card {\n      width: 68vw;\n      max-width: 240px;\n    }\n\n    .hi-testimonials__cta {\n      width: 100%;\n      text-align: center;\n      padding: 18px 24px;\n      box-sizing: border-box;\n    }\n  }\n</style>\n\n<!-- GOOGLE FONTS — Montserrat -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n\n<section class=\"hi-testimonials\">\n\n  <div class=\"hi-testimonials__header\">\n    <p class=\"hi-testimonials__eyebrow\">Não precisa ficar só na nossa palavra…</p>\n    <h2 class=\"hi-testimonials__title\">O que os <span>participantes dizem</span>\n</h2>\n  </div>\n\n  <div class=\"hi-testimonials__track-wrap\">\n    <div class=\"hi-testimonials__track\" id=\"hiTestimonialsTrack\">\n\n      <!-- Vídeo 1 -->\n      <div class=\"hi-testimonials__card\" data-index=\"0\">\n        <div class=\"hi-testimonials__video-wrap\">\n          <video class=\"hi-testimonials__video\" src=\"https://cdn.shopify.com/videos/c/o/v/4a05b111f14244968ea7ea404cd69c24.mp4\" playsinline muted loop preload=\"none\"></video>\n          <img class=\"hi-testimonials__thumb\" src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/FS_SP_Erica_-_LEGENDADO.00_00_03_28.Quadro003.png?v=1781201471\" alt=\"Depoimento 1\" loading=\"lazy\">\n          <div class=\"hi-testimonials__overlay\"></div>\n          <div class=\"hi-testimonials__play\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <polygon points=\"5,3 19,12 5,21\"></polygon>\n            </svg>\n          </div>\n        </div>\n      </div>\n\n      <!-- Vídeo 2 -->\n      <div class=\"hi-testimonials__card\" data-index=\"1\">\n        <div class=\"hi-testimonials__video-wrap\">\n          <video class=\"hi-testimonials__video\" src=\"https://cdn.shopify.com/videos/c/o/v/547b4ed72db04db6a7b8459c62fb997a.mp4\" playsinline muted loop preload=\"none\"></video>\n          <img class=\"hi-testimonials__thumb\" src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/FS_SP_Erica_-_LEGENDADO.00_00_04_09.Quadro001.png?v=1781201471\" alt=\"Depoimento 2\" loading=\"lazy\">\n          <div class=\"hi-testimonials__overlay\"></div>\n          <div class=\"hi-testimonials__play\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <polygon points=\"5,3 19,12 5,21\"></polygon>\n            </svg>\n          </div>\n        </div>\n      </div>\n\n      <!-- Vídeo 3 -->\n      <div class=\"hi-testimonials__card\" data-index=\"2\">\n        <div class=\"hi-testimonials__video-wrap\">\n          <video class=\"hi-testimonials__video\" src=\"https://cdn.shopify.com/videos/c/o/v/d6a74b3c1e824f14881113178487a954.mp4\" playsinline muted loop preload=\"none\"></video>\n          <img class=\"hi-testimonials__thumb\" src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/FS_SP_Erica_-_LEGENDADO.00_00_03_28.Quadro002.png?v=1781201471\" alt=\"Depoimento 3\" loading=\"lazy\">\n          <div class=\"hi-testimonials__overlay\"></div>\n          <div class=\"hi-testimonials__play\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <polygon points=\"5,3 19,12 5,21\"></polygon>\n            </svg>\n          </div>\n        </div>\n      </div>\n\n      <!-- Vídeo 4 -->\n      <div class=\"hi-testimonials__card\" data-index=\"3\">\n        <div class=\"hi-testimonials__video-wrap\">\n          <video class=\"hi-testimonials__video\" src=\"https://cdn.shopify.com/videos/c/o/v/e08506e62117494298da7e1624505e6f.mp4\" playsinline muted loop preload=\"none\"></video>\n          <img class=\"hi-testimonials__thumb\" src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/FS_SP_Erica_-_LEGENDADO.00_00_04_04.Quadro004.png?v=1781201471\" alt=\"Depoimento 4\" loading=\"lazy\">\n          <div class=\"hi-testimonials__overlay\"></div>\n          <div class=\"hi-testimonials__play\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <polygon points=\"5,3 19,12 5,21\"></polygon>\n            </svg>\n          </div>\n        </div>\n      </div>\n\n      <!-- Vídeo 5 -->\n      <div class=\"hi-testimonials__card\" data-index=\"4\">\n        <div class=\"hi-testimonials__video-wrap\">\n          <video class=\"hi-testimonials__video\" src=\"https://cdn.shopify.com/videos/c/o/v/d5b94635ac4a4569a68a5001738e8c90.mp4\" playsinline muted loop preload=\"none\"></video>\n          <img class=\"hi-testimonials__thumb\" src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/FS_SP_Erica_-_LEGENDADO.00_00_04_03.Quadro005.png?v=1781201471\" alt=\"Depoimento 5\" loading=\"lazy\">\n          <div class=\"hi-testimonials__overlay\"></div>\n          <div class=\"hi-testimonials__play\">\n            <svg viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n              <polygon points=\"5,3 19,12 5,21\"></polygon>\n            </svg>\n          </div>\n        </div>\n      </div>\n\n    </div>\n<!-- /.hi-testimonials__track -->\n  </div>\n<!-- /.hi-testimonials__track-wrap -->\n\n  <div class=\"hi-testimonials__cta-wrap\">\n    <a class=\"hi-testimonials__cta\" href=\"https://www.hyperisland.com.br/products/future-skills-masterclass-full-pass\" target=\"_blank\" rel=\"noopener\">\n      Garanta seu ingresso\n    </a>\n  </div>\n\n</section>\n\n<script>\n  (function () {\n    var cards = document.querySelectorAll('.hi-testimonials__card');\n    var currentPlaying = null;\n\n    cards.forEach(function (card) {\n      var video = card.querySelector('video');\n\n      card.addEventListener('click', function () {\n        if (currentPlaying && currentPlaying !== video) {\n          // Pausa o vídeo anterior\n          currentPlaying.pause();\n          currentPlaying.parentElement.closest('.hi-testimonials__card').classList.remove('is-playing');\n        }\n\n        if (video.paused) {\n          video.muted = false; // tira o mute ao clicar\n          video.play();\n          card.classList.add('is-playing');\n          currentPlaying = video;\n        } else {\n          video.pause();\n          card.classList.remove('is-playing');\n          currentPlaying = null;\n        }\n      });\n\n      // Ao terminar, volta ao estado inicial\n      video.addEventListener('ended', function () {\n        card.classList.remove('is-playing');\n        currentPlaying = null;\n      });\n    });\n  })();\n</script>",
