    "html_nTmKtA": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&amp;family=Barlow:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\n  .hi-section {\n    --hi-orange: #FF6200;\n    --hi-black: #111111;\n    --hi-beige: #EAE6DF;\n    --hi-beige-dark: #D8D2C7;\n    --hi-white: #FAFAF8;\n    --hi-text: #1A1A1A;\n    --hi-muted: #5A5A5A;\n    --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);\n\n    font-family: 'Barlow', sans-serif;\n    background-color: var(--hi-white);\n    padding: 80px 24px;\n    overflow: hidden;\n  }\n\n  .hi-section *,\n  .hi-section *::before,\n  .hi-section *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  .hi-container {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  /* ── HEADLINE ── */\n  .hi-headline-wrap {\n    margin-bottom: 56px;\n    max-width: 780px;\n    opacity: 0;\n    transform: translateY(28px);\n    transition: opacity 0.6s ease, transform 0.6s ease;\n  }\n\n  .hi-headline-wrap.hi-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hi-eyebrow {\n    display: inline-block;\n    font-family: 'Barlow', sans-serif;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: var(--hi-orange);\n    margin-bottom: 20px;\n    position: relative;\n    padding-left: 20px;\n  }\n\n  .hi-eyebrow::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 12px;\n    height: 2px;\n    background: var(--hi-orange);\n  }\n\n  .hi-headline {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(36px, 5.5vw, 68px);\n    line-height: 1.0;\n    text-transform: uppercase;\n    color: var(--hi-black);\n    letter-spacing: -0.01em;\n  }\n\n  /* ── TOP GRID: 3 cards ── */\n  .hi-grid-top {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    margin-bottom: 16px;\n  }\n\n  /* ── BOTTOM: wide card ── */\n  .hi-grid-bottom {\n    display: grid;\n    grid-template-columns: 1fr;\n  }\n\n  /* ── CARD BASE ── */\n  .hi-card {\n    background: var(--hi-beige);\n    padding: 36px 32px 40px;\n    position: relative;\n    overflow: hidden;\n    cursor: default;\n    opacity: 0;\n    transform: translateY(32px);\n    transition:\n      opacity 0.55s ease,\n      transform 0.55s ease,\n      background var(--transition),\n      box-shadow var(--transition);\n  }\n\n  .hi-card.hi-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hi-card::after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 0;\n    height: 3px;\n    background: var(--hi-orange);\n    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .hi-card:hover::after {\n    width: 100%;\n  }\n\n  .hi-card:hover {\n    background: #E0DAD1;\n    box-shadow: 0 8px 32px rgba(0,0,0,0.08);\n  }\n\n  /* ── CARD: number accent ── */\n  .hi-card-num {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    color: var(--hi-orange);\n    text-transform: uppercase;\n    margin-bottom: 28px;\n    display: block;\n  }\n\n  .hi-card-title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 22px;\n    font-weight: 800;\n    text-transform: uppercase;\n    color: var(--hi-black);\n    line-height: 1.15;\n    margin-bottom: 16px;\n    letter-spacing: 0.01em;\n  }\n\n  .hi-card-text {\n    font-family: 'Barlow', sans-serif;\n    font-size: 14.5px;\n    font-weight: 400;\n    line-height: 1.65;\n    color: var(--hi-muted);\n  }\n\n  /* ── BOTTOM CARD (Liderança) ── */\n  .hi-card-wide {\n    background: var(--hi-beige-dark);\n    display: grid;\n    grid-template-columns: auto 1fr;\n    align-items: start;\n    gap: 24px;\n    padding: 36px 32px 40px;\n  }\n\n  .hi-card-wide:hover {\n    background: #CEC8BC;\n  }\n\n  .hi-wide-title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 22px;\n    font-weight: 800;\n    text-transform: uppercase;\n    color: var(--hi-black);\n    line-height: 1.15;\n    letter-spacing: 0.01em;\n    white-space: nowrap;\n  }\n\n  .hi-wide-right {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .hi-wide-text {\n    font-family: 'Barlow', sans-serif;\n    font-size: 14.5px;\n    font-weight: 400;\n    line-height: 1.65;\n    color: var(--hi-muted);\n  }\n\n  /* ── STAGGER DELAYS ── */\n  .hi-card:nth-child(1) { transition-delay: 0.05s; }\n  .hi-card:nth-child(2) { transition-delay: 0.15s; }\n  .hi-card:nth-child(3) { transition-delay: 0.25s; }\n  .hi-card-wide        { transition-delay: 0.35s; }\n\n  /* ── RESPONSIVE ── */\n  @media (max-width: 900px) {\n    .hi-grid-top {\n      grid-template-columns: 1fr 1fr;\n    }\n    .hi-card-wide {\n      grid-template-columns: 1fr;\n      padding: 32px;\n      gap: 16px;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .hi-section { padding: 56px 20px; }\n    .hi-grid-top { grid-template-columns: 1fr; }\n    .hi-card { padding: 28px 24px 32px; }\n    .hi-card-wide { padding: 28px 24px; }\n    .hi-headline-wrap { margin-bottom: 40px; }\n  }\n</style>\n\n<section class=\"hi-section\" id=\"hi-resilience-section\">\n  <div class=\"hi-container\">\n\n    <!-- Headline -->\n    <div class=\"hi-headline-wrap\" id=\"hi-headline\">\n      <span class=\"hi-eyebrow\">Business Transformation</span>\n      <h2 class=\"hi-headline\">Ajudamos a construir<br>organizações resilientes<br>e preparadas para o futuro</h2>\n    </div>\n\n    <!-- Top 3 cards -->\n    <div class=\"hi-grid-top\">\n\n      <div class=\"hi-card\">\n        <h3 class=\"hi-card-title\">Visão de Futuro<br>&amp; Estratégia</h3>\n        <p class=\"hi-card-text\">Antecipe o que está por vir e prospere na incerteza. Ajudamos organizações a usar o pensamento de futuros para compreender sinais, explorar cenários e tomar decisões estratégicas mais acertadas num mundo incerto.</p>\n      </div>\n\n      <div class=\"hi-card\">\n        <h3 class=\"hi-card-title\">Inovação<br>&amp; Criatividade</h3>\n        <p class=\"hi-card-text\">Crie o que vem a seguir, não mais do mesmo. Treinamos times para resolver problemas de forma criativa, testar ideias rapidamente e criar soluções baseadas no comportamento humano real.</p>\n      </div>\n\n      <div class=\"hi-card\">\n        <h3 class=\"hi-card-title\">Tecnologia Emergente<br>&amp; Transformação</h3>\n        <p class=\"hi-card-text\">Use a tecnologia de forma a fortalecer as pessoas. Ajudamos organizações a compreender novas tecnologias, tomar decisões inteligentes e desenvolver capacidades digitais de forma responsável.</p>\n      </div>\n\n    </div>\n\n    <!-- Bottom wide card -->\n    <div class=\"hi-grid-bottom\">\n      <div class=\"hi-card hi-card-wide\">\n\n        <div>\n          <h3 class=\"hi-wide-title\">Liderança<br>&amp; Cultura</h3>\n        </div>\n\n        <div class=\"hi-wide-right\" style=\"padding-top: 4px;\">\n          <p class=\"hi-wide-text\">Desenvolvemos líderes capazes de navegar na complexidade, construir formas de trabalho sólidas e promover culturas onde as pessoas colaboram, assumem responsabilidade e agem com agilidade.</p>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function() {\n  var section = document.getElementById('hi-resilience-section');\n  if (!section) return;\n\n  var headline = document.getElementById('hi-headline');\n  var cards = section.querySelectorAll('.hi-card');\n\n  var observer = new IntersectionObserver(function(entries) {\n    entries.forEach(function(entry) {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('hi-visible');\n        observer.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.12 });\n\n  if (headline) observer.observe(headline);\n  cards.forEach(function(card) { observer.observe(card); });\n})();\n</script>",
