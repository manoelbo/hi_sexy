        "html": "<!-- ===== Section: Para quem é ===== -->\n<section class=\"wrapup-audience\" aria-labelledby=\"aud-title\">\n  <div class=\"wrapup-audience__container\">\n    <h2 id=\"aud-title\" class=\"aud-title\">Para quem é</h2>\n    <span class=\"aud-underline\" aria-hidden=\"true\"></span>\n\n    <div class=\"aud-pills\" role=\"list\">\n      <!-- Pill 1 -->\n      <a class=\"aud-pill\" role=\"listitem\" href=\"#\">\n        <span class=\"aud-icon\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M8 12a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3ZM8 14c-3.314 0-6 1.79-6 4v1h6.5a5.5 5.5 0 0 1 .5-2 6.3 6.3 0 0 1 1.07-1.54A7.2 7.2 0 0 0 8 14Zm8 0a5 5 0 0 0-5 5v0h10v-1c0-2.21-2.686-4-5-4Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span>CEO e C-level</span>\n      </a>\n\n      <!-- Pill 2 -->\n      <a class=\"aud-pill\" role=\"listitem\" href=\"#\">\n        <span class=\"aud-icon\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M8 12a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3ZM8 14c-3.314 0-6 1.79-6 4v1h6.5a5.5 5.5 0 0 1 .5-2 6.3 6.3 0 0 1 1.07-1.54A7.2 7.2 0 0 0 8 14Zm8 0a5 5 0 0 0-5 5v0h10v-1c0-2.21-2.686-4-5-4Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span>VPs e Heads</span>\n      </a>\n\n      <!-- Pill 3 (ativa) -->\n      <a class=\"aud-pill\" role=\"listitem\" href=\"#\">\n        <span class=\"aud-icon\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M8 12a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3ZM8 14c-3.314 0-6 1.79-6 4v1h6.5a5.5 5.5 0 0 1 .5-2 6.3 6.3 0 0 1 1.07-1.54A7.2 7.2 0 0 0 8 14Zm8 0a5 5 0 0 0-5 5v0h10v-1c0-2.21-2.686-4-5-4Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span>Times multifuncionais</span>\n      </a>\n\n      <!-- Pill 4 -->\n      <a class=\"aud-pill\" role=\"listitem\" href=\"#\">\n        <span class=\"aud-icon\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M8 12a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3ZM8 14c-3.314 0-6 1.79-6 4v1h6.5a5.5 5.5 0 0 1 .5-2 6.3 6.3 0 0 1 1.07-1.54A7.2 7.2 0 0 0 8 14Zm8 0a5 5 0 0 0-5 5v0h10v-1c0-2.21-2.686-4-5-4Z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n        <span>PMOs e Enablers</span>\n      </a>\n    </div>\n  </div>\n</section>\n\n<style>\n  :root{\n    --hi-orange:#FF7700;\n    --title:#0f172a;      /* slate-900 */\n    --muted:#64748b;      /* slate-500 */\n    --pill:#ffffff;\n    --pill-border:#e2e8f0; /* slate-200 */\n    --shadow:0 10px 24px rgba(15,23,42,.08);\n    --radius:14px;\n  }\n\n  .wrapup-audience{\n    background:#fff1e9;\n    padding: clamp(36px, 6vw, 72px) 16px 36px;\n  }\n  .wrapup-audience__container{\n    max-width: 980px;\n    margin: 0 auto;\n    text-align: center;\n  }\n  .wrapup-audience, .wrapup-audience *{\n    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, \"Helvetica Neue\", Arial;\n  }\n\n  /* Título + sublinhado */\n  .aud-title{\n    margin: 0;\n    color: var(--title);\n    font-weight: 900;\n    letter-spacing: -.01em;\n    line-height: 1.05;\n    font-size: clamp(1.8rem, 4.2vw, 2.4rem);\n  }\n  .aud-underline{\n    display:block;\n    width: 64px;\n    height: 6px;\n    background: var(--hi-orange);\n    border-radius: 6px;\n    margin: 14px auto 22px;\n  }\n\n  /* Pills */\n  .aud-pills{\n    display:flex;\n    gap: clamp(10px, 2vw, 22px);\n    justify-content:center;\n    align-items:center;\n    flex-wrap: wrap;\n  }\n  .aud-pill{\n    display:inline-flex;\n    align-items:center;\n    gap: 10px;\n    padding: 14px 22px;\n    background: var(--pill);\n    color: #1f2937; /* slate-800 */\n    border: 2px solid var(--pill-border);\n    border-radius: var(--radius);\n    text-decoration:none;\n    font-weight: 600;\n    transition: border-color .2s ease, box-shadow .2s ease, color .2s ease, transform .05s ease;\n  }\n  .aud-pill:hover{ border-color:#d1d5db; }\n  .aud-pill:active{ transform: translateY(1px); }\n\n  .aud-icon{\n    width: 22px; height: 22px;\n    color: var(--muted);\n    display:inline-flex; align-items:center; justify-content:center;\n  }\n  .aud-icon svg{ width: 22px; height: 22px; display:block; }\n\n  /* Estado ativo */\n  .aud-pill.is-active{\n    border-color: var(--hi-orange);\n    box-shadow: var(--shadow);\n  }\n  .aud-pill.is-active .aud-icon{ color: var(--hi-orange); }\n\n  @media (max-width: 640px){\n    .aud-pill{ width: 100%; justify-content: center; }\n  }\n</style>\n<!-- ===== /Section ===== -->",
