    "html_NkqGht": {
      "type": "html",
      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<!-- ===== Wrap-Up 2025 • Hero Section ===== -->\n<section class=\"hero-wrapup\" aria-labelledby=\"wrapup-hero-title\">\n  <div class=\"hero-wrapup__container\">\n    <!-- Badge / breadcrumb -->\n    <a class=\"hero-wrapup__badge\" href=\"#\" aria-label=\"Wrap-Up 2025, Estratégia 2026\">\n      <span>Wrap-Up 2025</span>\n      <span class=\"dot\">•</span>\n      <span>Estratégia 2026</span>\n    </a>\n\n    <!-- Title -->\n    <h3 id=\"wrapup-hero-title\" class=\"hero-wrapup__title\">\n      Celebre o que deu certo<br>\n      e entre em 2026 com<br>\n      prioridades claras e um<br>\n      plano de 90 dias\n    </h3>\n\n    <!-- Subheadline -->\n    <p class=\"hero-wrapup__subtitle\">\n      Workshop estratégico facilitado pela Hyper Island para transformar fim de\n      ano em foco prático.\n    </p>\n\n    <!-- CTAs -->\n    <div class=\"hero-wrapup__ctas\">\n      <a class=\"btn btn--primary\" href=\"https://www.hyperisland.com.br/pages/wrap-up-2025#form\" id=\"cta-onepager\">\n        Baixar One-Pager\n        <span class=\"arrow\" aria-hidden=\"true\">➜</span>\n      </a>\n\n      <a class=\"btn btn--ghost\" href=\"mailto:carlos.zuccolo@hyperisland.com\" id=\"cta-especialista\">\n        <svg class=\"icon\" viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M12 3c4.97 0 9 3.582 9 8 0 2.11-.96 4.03-2.54 5.49.06.54.28 1.53.86 2.51.11.19.09.43-.06.59-.13.12-.3.18-.47.14-1.41-.32-2.49-.82-3.19-1.22-.69.13-1.41.19-2.16.19-4.97 0-9-3.58-9-8s4.03-8 9-8Z\" fill=\"currentColor\"></path>\n        </svg>\n        Fale com um especialista\n      </a>\n    </div>\n\n    <!-- Chips -->\n    <ul class=\"hero-wrapup__chips\" aria-label=\"Formatos disponíveis\">\n      <li>Intensivo</li>\n      <li class=\"sep\">•</li>\n      <li>Sprint</li>\n      <li class=\"sep\">•</li>\n      <li>Leadership Offsite</li>\n      <li class=\"sep\">•</li>\n      <li>PT/EN/ES</li>\n    </ul>\n  </div>\n</section>\n\n<style>\n  :root{\n    --hi-orange:#FF7700;\n    --text:#0f172a;      /* slate-900 */\n    --muted:#475569;     /* slate-600 */\n    --bg:#ffffff;\n    --badge-bg:#fdece0;  /* light orange tint */\n    --ghost-border:#cbd5e1; /* slate-300 */\n    --radius:14px;\n    --shadow:0 10px 30px rgba(17,24,39,.08);\n  }\n\n  .hero-wrapup{\n    background: var(--bg);\n    padding: clamp(48px, 6vw, 96px) 16px 56px;\n  }\n  .hero-wrapup__container{\n    max-width: 1080px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  /* Badge */\n  .hero-wrapup__badge{\n    display:inline-flex;\n    align-items:center;\n    gap:.5rem;\n    padding: 10px 14px;\n    border-radius: 999px;\n    font-size: .95rem;\n    font-weight: 600;\n    text-decoration: none;\n    color: var(--hi-orange);\n    background: var(--badge-bg);\n    box-shadow: var(--shadow);\n    margin-bottom: 20px;\n  }\n  .hero-wrapup__badge .dot{ color: var(--muted); }\n\n  /* Title */\n  .hero-wrapup__title{\n    margin: 8px 0 12px;\n    font-weight: 900;\n    line-height: 1.05;\n    letter-spacing: -.02em;\n    color: var(--text);\n    font-size: clamp(2rem, 6vw, 4.2rem);\n  }\n\n  /* Subtitle */\n  .hero-wrapup__subtitle{\n    max-width: 850px;\n    margin: 0 auto;\n    color: var(--muted);\n    font-size: clamp(1rem, 2.2vw, 1.25rem);\n  }\n\n  /* CTAs */\n  .hero-wrapup__ctas{\n    margin-top: 28px;\n    display:flex;\n    justify-content:center;\n    gap:14px;\n    flex-wrap:wrap;\n  }\n  .btn{\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    padding: 16px 22px;\n    border-radius: var(--radius);\n    font-weight: 700;\n    text-decoration: none;\n    transition: transform .05s ease, box-shadow .2s ease, background .2s ease;\n    will-change: transform;\n    border:1px solid transparent;\n  }\n  .btn:active{ transform: translateY(1px); }\n\n  .btn--primary{\n    background: var(--hi-orange);\n    color: #fff;\n    box-shadow: var(--shadow);\n  }\n  .btn--primary:hover{ filter: brightness(1.05); }\n  .btn--primary .arrow{ font-size: 1.2em; line-height: 0; }\n\n  .btn--ghost{\n    background: #fff;\n    color: var(--text);\n    border-color: var(--ghost-border);\n  }\n  .btn--ghost:hover{ background:#f8fafc; }\n  .btn--ghost .icon{\n    width: 20px; height: 20px; flex: 0 0 20px;\n  }\n\n  /* Chips */\n  .hero-wrapup__chips{\n    margin: 18px auto 0;\n    padding: 0;\n    list-style: none;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    gap: 10px;\n    color: var(--muted);\n    font-size: .95rem;\n  }\n  .hero-wrapup__chips .sep{ opacity:.6; }\n\n  /* Nice font stack (troque no seu projeto se quiser) */\n  .hero-wrapup, .hero-wrapup *{\n    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, \"Helvetica Neue\", Arial, \"Noto Sans\", \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\";\n  }\n\n  /* Spacing tweaks for very small screens */\n  @media (max-width: 420px){\n    .hero-wrapup__badge{ font-size: .88rem; padding:8px 12px; }\n    .btn{ width:100%; justify-content:center; }\n    .hero-wrapup{ padding-bottom: 40px; }\n  }\n</style>\n<!-- ===== /Hero Section ===== -->",
