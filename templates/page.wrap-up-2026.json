    "html_AdG8mC": {
      "type": "html",
      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<!-- ===== Section: Formatos Flexíveis ===== -->\n<section class=\"wrapup-formats\" aria-labelledby=\"formats-title\">\n  <div class=\"wrapup-formats__container\">\n    <h2 id=\"formats-title\" class=\"formats-title\">Formatos Flexíveis para o seu time</h2>\n    <p class=\"formats-sub\">Escolha o formato que melhor se adapta à sua equipe</p>\n\n    <div class=\"formats-grid\">\n      <!-- Card 1 -->\n      <article class=\"format-card\">\n        <div class=\"format-card__icon\">\n          <!-- Bolt -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M13 2 4 14h6l-1 8 9-12h-6l1-8Z\"></path>\n          </svg>\n        </div>\n\n        <h3 class=\"format-card__title\">Intensivo</h3>\n        <p class=\"format-card__meta\">1 dia completo</p>\n\n        <p class=\"format-card__text\">\n          Formato imersivo ideal para times que precisam de resultados rápidos.\n          Um dia intenso que cobre todas as 4 etapas com foco e energia.\n        </p>\n\n        <hr class=\"format-card__rule\">\n\n        <p class=\"format-card__label\">Ideal para:</p>\n        <p class=\"format-card__foot\">Times executivos, departamentos com agenda apertada</p>\n      </article>\n\n      <!-- Card 2 -->\n      <article class=\"format-card\">\n        <div class=\"format-card__icon\">\n          <!-- Clock -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm1 11h4v-2h-3V7h-2v6Z\"></path>\n          </svg>\n        </div>\n\n        <h3 class=\"format-card__title\">Sprint</h3>\n        <p class=\"format-card__meta\">2 sessões de 4h</p>\n\n        <p class=\"format-card__text\">\n          Dois encontros de meio período que permitem reflexão entre sessões. \n<br>\n          Ideal para times que preferem processar informações em etapas.\n        </p>\n\n        <hr class=\"format-card__rule\">\n\n        <p class=\"format-card__label\">Ideal para:</p>\n        <p class=\"format-card__foot\">Times multifuncionais, projetos complexos</p>\n      </article>\n\n      <!-- Card 3 -->\n      <article class=\"format-card\">\n        <div class=\"format-card__icon\">\n          <!-- Mountain -->\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#fff\" d=\"M3 19h18L13 5l-3 6-2-2-5 10Z\"></path>\n          </svg>\n        </div>\n\n        <h3 class=\"format-card__title\">Leadership Offsite</h3>\n        <p class=\"format-card__meta\">1–2 dias</p>\n\n        <p class=\"format-card__text\">\n          Experiência completa com tempo para aprofundamento, networking e\n          construção de relacionamentos. Inclui momentos de integração.\n        </p>\n\n        <hr class=\"format-card__rule\">\n\n        <p class=\"format-card__label\">Ideal para:</p>\n        <p class=\"format-card__foot\">Liderança executiva, boards, comitês estratégicos</p>\n      </article>\n    </div>\n\n    <!-- Selo idiomas -->\n    <div class=\"formats-langs\">\n      Disponível em Português, Inglês e Espanhol\n    </div>\n  </div>\n</section>\n\n<style>\n  :root{\n    --hi-orange:#FF7700;\n    --bg:#f6f8fa;          /* fundo da seção */\n    --title:#0f172a;       /* slate-900 */\n    --muted:#475569;       /* slate-600 */\n    --card:#fff;\n    --border:#e5e7eb;      /* slate-200 */\n    --shadow:0 12px 30px rgba(15,23,42,.08);\n    --radius-lg:14px;\n    --radius-md:10px;\n  }\n\n  .wrapup-formats{\n    background: var(--bg);\n    padding: clamp(52px, 7vw, 96px) 16px;\n  }\n  .wrapup-formats__container{\n    max-width: 1160px;\n    margin: 0 auto;\n    text-align: center;\n  }\n  .wrapup-formats, .wrapup-formats *{\n    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, \"Helvetica Neue\", Arial;\n  }\n\n  .formats-title{\n    margin: 0 0 10px;\n    font-weight: 900;\n    color: var(--title);\n    letter-spacing: -.01em;\n    line-height: 1.05;\n    font-size: clamp(1.9rem, 4.5vw, 3rem);\n  }\n  .formats-sub{\n    margin: 0 auto clamp(28px, 5vw, 44px);\n    max-width: 760px;\n    color: var(--muted);\n    font-size: clamp(1rem, 2vw, 1.125rem);\n    line-height: 1.8;\n  }\n\n  .formats-grid{\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0,1fr));\n    gap: clamp(16px, 2.4vw, 26px);\n    padding: 0 clamp(0px, .6vw, 6px);\n    text-align: left;\n  }\n\n  .format-card{\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    box-shadow: var(--shadow);\n    padding: 22px;\n  }\n\n  .format-card__icon{\n    width: 44px; height: 44px;\n    border-radius: 12px;\n    background: var(--hi-orange);\n    display:inline-flex; align-items:center; justify-content:center;\n    box-shadow: 0 6px 16px rgba(255,119,0,.25);\n    margin-bottom: 16px;\n  }\n  .format-card__icon svg{ width: 24px; height: 24px; display:block; }\n\n  .format-card__title{\n    margin: 0 0 2px;\n    font-weight: 800;\n    color: var(--title);\n    font-size: clamp(1.05rem, 2.2vw, 1.125rem);\n  }\n  .format-card__meta{\n    margin: 0 0 14px;\n    color: #6b7280; /* slate-500 */\n    font-size: .98rem;\n  }\n  .format-card__text{\n    margin: 0;\n    color: var(--muted);\n    line-height: 1.85;\n    font-size: 1.02rem;\n  }\n  .format-card__rule{\n    border: 0;\n    border-top: 1px solid var(--border);\n    margin: 18px 0 12px;\n  }\n  .format-card__label{\n    margin: 0 0 6px;\n    font-weight: 700;\n    color: var(--title);\n  }\n  .format-card__foot{\n    margin: 0;\n    color: var(--muted);\n    line-height: 1.8;\n  }\n\n  /* Selo idiomas */\n  .formats-langs{\n    display:inline-block;\n    margin: clamp(22px, 4vw, 36px) auto 0;\n    padding: 14px 22px;\n    border: 2px solid var(--hi-orange);\n    color: var(--hi-orange);\n    border-radius: 999px;\n    font-weight: 700;\n    box-shadow: 0 1px 0 rgba(0,0,0,.02);\n  }\n\n  /* Responsivo */\n  @media (max-width: 1024px){\n    .formats-grid{ grid-template-columns: 1fr; }\n    .format-card{ max-width: 720px; margin: 0 auto; }\n  }\n</style>\n<!-- ===== /Section ===== -->",
