      "settings": {
        "html": "<!-- =========================================================\n     HYPER ISLAND · WRAP-UP 2026\n     Seção HTML para Shopify (sem menu e sem footer)\n     Todo o CSS está escopado em .hi-wu26 para não conflitar com o tema.\n     Fontes herdadas do tema (font-family: inherit).\n\n     OPCIONAL: para usar a imagem de gradiente original no hero e no\n     bloco final, suba o arquivo em Conteúdo > Arquivos no Shopify e cole\n     a URL na variável --hi-wu26-bg-img abaixo, ex.:\n     --hi-wu26-bg-img: url('https://cdn.shopify.com/s/files/.../gradiente.png');\n     Sem a imagem, o gradiente é recriado em CSS.\n     ========================================================= -->\n\n<style>\n  .hi-wu26 {\n    --hi-wu26-orange: #ff7300;\n    --hi-wu26-orange-mid: #ffa45c;\n    --hi-wu26-orange-soft: #ffd9bd;\n    --hi-wu26-cream: #fff6f0;\n    --hi-wu26-ink: #0a0a0a;\n    --hi-wu26-ink-soft: #3a3a3a;\n    --hi-wu26-white: #ffffff;\n    --hi-wu26-dark: #141110;\n    --hi-wu26-gutter: clamp(20px, 6vw, 96px);\n    --hi-wu26-max: 1240px;\n    --hi-wu26-bg-img: none;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    color: var(--hi-wu26-ink);\n    background: var(--hi-wu26-white);\n    -webkit-font-smoothing: antialiased;\n  }\n  .hi-wu26 *, .hi-wu26 *::before, .hi-wu26 *::after { box-sizing: border-box; }\n\n  /* Neutraliza estilos globais de títulos e parágrafos do tema */\n  .hi-wu26 h1, .hi-wu26 h2, .hi-wu26 h3, .hi-wu26 p, .hi-wu26 ul, .hi-wu26 li {\n    margin: 0;\n    padding: 0;\n    color: inherit;\n    letter-spacing: normal;\n  }\n  .hi-wu26 ul { list-style: none; }\n\n  .hi-wu26__inner {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    max-width: var(--hi-wu26-max);\n    margin: 0 auto;\n    padding-left: var(--hi-wu26-gutter);\n    padding-right: var(--hi-wu26-gutter);\n  }\n\n  .hi-wu26__sr {\n    position: absolute !important;\n    width: 1px; height: 1px;\n    padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0,0,0,0);\n    white-space: nowrap; border: 0;\n  }\n\n  /* ---------- Fundo em gradiente (recriação das artes) ---------- */\n  .hi-wu26__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    background:\n      var(--hi-wu26-bg-img) center top / cover no-repeat,\n      linear-gradient(180deg,\n        var(--hi-wu26-orange) 0%,\n        var(--hi-wu26-orange-mid) 22%,\n        var(--hi-wu26-orange-soft) 45%,\n        var(--hi-wu26-cream) 68%,\n        var(--hi-wu26-white) 100%);\n  }\n  .hi-wu26__bg::before {\n    /* listras verticais desfocadas */\n    content: \"\";\n    position: absolute;\n    inset: -40px 0 35% 0;\n    background: repeating-linear-gradient(90deg,\n      rgba(255,255,255,0) 0px,\n      rgba(255,255,255,.28) 18px,\n      rgba(255,255,255,0) 44px,\n      rgba(255,115,0,.18) 70px,\n      rgba(255,255,255,0) 96px);\n    filter: blur(10px);\n    opacity: .9;\n  }\n  .hi-wu26__bg::after {\n    /* brilho claro no topo, como nas artes */\n    content: \"\";\n    position: absolute;\n    top: -18%;\n    left: 40%;\n    width: 55%;\n    height: 45%;\n    background: radial-gradient(closest-side, rgba(255,255,255,.75), rgba(255,255,255,0));\n    filter: blur(20px);\n  }\n  .hi-wu26__bg--flip {\n    background:\n      var(--hi-wu26-bg-img) center bottom / cover no-repeat,\n      linear-gradient(0deg,\n        var(--hi-wu26-orange) 0%,\n        var(--hi-wu26-orange-mid) 24%,\n        var(--hi-wu26-orange-soft) 48%,\n        var(--hi-wu26-cream) 72%,\n        var(--hi-wu26-white) 100%);\n  }\n  .hi-wu26__bg--flip::before { inset: 35% 0 -40px 0; }\n  .hi-wu26__bg--flip::after { top: auto; bottom: -20%; left: -10%; }\n\n  /* ---------- HERO ---------- */\n  .hi-wu26-hero {\n    position: relative;\n    min-height: clamp(620px, 92vh, 960px);\n    display: flex;\n    align-items: flex-end;\n    padding: clamp(120px, 18vh, 200px) 0 clamp(64px, 10vh, 112px);\n  }\n  .hi-wu26-hero__year {\n    position: absolute;\n    z-index: 1;\n    left: 50%;\n    top: clamp(70px, 14vh, 150px);\n    transform: translateX(-50%);\n    width: 110%;\n    text-align: center;\n    font-weight: 900;\n    font-size: clamp(9rem, 40vw, 42rem);\n    line-height: .8;\n    letter-spacing: -0.06em;\n    white-space: nowrap;\n    user-select: none;\n    pointer-events: none;\n    /* número branco que se dissolve no fundo branco */\n    background: linear-gradient(180deg, #fff 0%, #fff 55%, rgba(255,255,255,0) 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: #fff;\n  }\n  .hi-wu26-hero__content { max-width: 100%; }\n  .hi-wu26-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 20px;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--hi-wu26-ink);\n  }\n  .hi-wu26-eyebrow::before {\n    content: \"\";\n    width: 28px;\n    height: 2px;\n    background: var(--hi-wu26-orange);\n  }\n  .hi-wu26 .hi-wu26-hero__title {\n    font-size: clamp(4.25rem, 15vw, 11rem);\n    font-weight: 900;\n    line-height: .86;\n    letter-spacing: -0.04em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    color: var(--hi-wu26-ink);\n  }\n  .hi-wu26 .hi-wu26-hero__lead {\n    margin-top: clamp(20px, 3vw, 32px);\n    max-width: 560px;\n    font-size: clamp(1.25rem, 2.4vw, 1.75rem);\n    line-height: 1.35;\n    font-weight: 400;\n    color: var(--hi-wu26-ink);\n  }\n\n  /* ---------- Botão ---------- */\n  .hi-wu26-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 14px;\n    margin-top: clamp(28px, 4vw, 40px);\n    padding: 16px 28px;\n    border-radius: 999px;\n    background: var(--hi-wu26-ink);\n    color: var(--hi-wu26-white) !important;\n    font-size: 15px;\n    font-weight: 700;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    text-decoration: none !important;\n    border: 2px solid var(--hi-wu26-ink);\n    transition: background .25s ease, color .25s ease, transform .25s ease;\n  }\n  .hi-wu26-btn svg { width: 28px; height: 14px; transition: transform .25s ease; }\n  .hi-wu26-btn:hover,\n  .hi-wu26-btn:focus-visible {\n    background: var(--hi-wu26-orange);\n    border-color: var(--hi-wu26-orange);\n    color: var(--hi-wu26-ink) !important;\n  }\n  .hi-wu26-btn:hover svg { transform: translateX(5px); }\n  .hi-wu26-btn:focus-visible { outline: 3px solid var(--hi-wu26-ink); outline-offset: 3px; }\n\n  /* ---------- CONTEXTO ---------- */\n  .hi-wu26-context {\n    position: relative;\n    padding: clamp(72px, 11vw, 140px) 0;\n    background: var(--hi-wu26-white);\n  }\n  .hi-wu26-context__grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: clamp(28px, 5vw, 72px);\n    align-items: start;\n  }\n  .hi-wu26 .hi-wu26-context__title {\n    font-size: clamp(1.9rem, 4.2vw, 3.25rem);\n    font-weight: 800;\n    line-height: 1.12;\n    letter-spacing: -0.02em;\n  }\n  .hi-wu26 .hi-wu26-context__questions {\n    font-size: clamp(1.2rem, 2.2vw, 1.6rem);\n    font-style: italic;\n    line-height: 1.4;\n    color: var(--hi-wu26-ink-soft);\n  }\n  .hi-wu26 .hi-wu26-context__text {\n    margin-top: 24px;\n    font-size: clamp(1rem, 1.4vw, 1.125rem);\n    line-height: 1.65;\n    color: var(--hi-wu26-ink-soft);\n  }\n  .hi-wu26 .hi-wu26-context__text strong { color: var(--hi-wu26-ink); font-weight: 700; }\n\n  /* ---------- OBJETIVOS ---------- */\n  .hi-wu26-goals {\n    position: relative;\n    padding: clamp(72px, 11vw, 140px) 0;\n    background: var(--hi-wu26-dark);\n    color: var(--hi-wu26-white);\n    overflow: hidden;\n  }\n  .hi-wu26-goals::before {\n    content: \"\";\n    position: absolute;\n    right: -15%;\n    bottom: -35%;\n    width: 70%;\n    aspect-ratio: 1;\n    background: radial-gradient(closest-side, rgba(255,115,0,.55), rgba(255,115,0,0));\n    filter: blur(30px);\n    pointer-events: none;\n  }\n  .hi-wu26 .hi-wu26-goals__title {\n    max-width: 620px;\n    font-size: clamp(1.75rem, 3.8vw, 2.9rem);\n    font-weight: 300;\n    line-height: 1.18;\n    color: var(--hi-wu26-white);\n  }\n  .hi-wu26 .hi-wu26-goals__title strong { font-weight: 800; }\n  .hi-wu26-goals__list {\n    margin-top: clamp(40px, 6vw, 72px) !important;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 1px;\n    background: rgba(255,255,255,.14);\n    border-top: 1px solid rgba(255,255,255,.14);\n    border-bottom: 1px solid rgba(255,255,255,.14);\n  }\n  .hi-wu26 .hi-wu26-goals__item {\n    display: flex;\n    gap: 18px;\n    align-items: flex-start;\n    padding: 28px 0;\n    background: var(--hi-wu26-dark);\n  }\n  .hi-wu26-goals__star {\n    flex: 0 0 auto;\n    font-size: 34px;\n    line-height: .9;\n    font-weight: 700;\n    color: var(--hi-wu26-orange);\n  }\n  .hi-wu26 .hi-wu26-goals__text {\n    font-size: clamp(1.15rem, 1.9vw, 1.4rem);\n    font-weight: 700;\n    line-height: 1.3;\n    color: var(--hi-wu26-white);\n  }\n\n  .hi-wu26-chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin-top: clamp(36px, 5vw, 56px) !important;\n  }\n  .hi-wu26 .hi-wu26-chips li {\n    padding: 9px 16px;\n    border: 1px solid rgba(255,255,255,.28);\n    border-radius: 999px;\n    font-size: 14px;\n    color: rgba(255,255,255,.86);\n  }\n\n  /* ---------- FORMULÁRIO ---------- */\n  .hi-wu26-form-section {\n    position: relative;\n    padding: clamp(72px, 11vw, 140px) 0;\n    scroll-margin-top: 80px;\n  }\n  .hi-wu26-form__grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: clamp(36px, 5vw, 72px);\n    align-items: center;\n  }\n  .hi-wu26 .hi-wu26-form__title {\n    font-size: clamp(1.9rem, 4vw, 3rem);\n    font-weight: 800;\n    line-height: 1.12;\n    letter-spacing: -0.02em;\n  }\n  .hi-wu26 .hi-wu26-form__brand {\n    margin-top: 24px;\n    font-size: clamp(3.25rem, 9vw, 6.5rem);\n    font-weight: 900;\n    line-height: .86;\n    letter-spacing: -0.04em;\n    text-transform: uppercase;\n  }\n  .hi-wu26 .hi-wu26-form__cta {\n    margin-top: 20px;\n    font-size: clamp(1rem, 1.6vw, 1.25rem);\n    font-weight: 500;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: var(--hi-wu26-orange);\n  }\n  .hi-wu26 .hi-wu26-form__note {\n    margin-top: 20px;\n    max-width: 440px;\n    font-size: 1rem;\n    line-height: 1.6;\n    color: var(--hi-wu26-ink-soft);\n  }\n\n  .hi-wu26-form__card {\n    position: relative;\n    background: var(--hi-wu26-white);\n    border-radius: 20px;\n    padding: clamp(24px, 4vw, 44px);\n    box-shadow: 0 30px 80px -30px rgba(120, 45, 0, .35);\n  }\n  .hi-wu26 .hi-wu26-form__card-title {\n    font-size: 1.25rem;\n    font-weight: 800;\n    line-height: 1.3;\n    margin-bottom: 6px;\n  }\n  .hi-wu26 .hi-wu26-form__card-sub {\n    font-size: .95rem;\n    line-height: 1.5;\n    color: var(--hi-wu26-ink-soft);\n    margin-bottom: 24px;\n  }\n  .hi-wu26-form__loading {\n    font-size: .95rem;\n    color: var(--hi-wu26-ink-soft);\n  }\n\n  /* Estilo do formulário HubSpot (aplica quando o form renderiza em HTML, sem iframe) */\n  .hi-wu26 .hs-form { font-family: inherit; }\n  .hi-wu26 .hs-form fieldset { max-width: 100% !important; }\n  .hi-wu26 .hs-form .hs-form-field { margin-bottom: 16px; }\n  .hi-wu26 .hs-form fieldset.form-columns-2 .hs-form-field { width: 50%; }\n  .hi-wu26 .hs-form fieldset.form-columns-2 .hs-form-field:first-child { padding-right: 8px; }\n  .hi-wu26 .hs-form fieldset.form-columns-2 .hs-form-field:last-child { padding-left: 8px; }\n  .hi-wu26 .hs-form fieldset .input { margin-right: 0 !important; }\n  .hi-wu26 .hs-form label:not(.hs-form-booleancheckbox-display):not(.hs-form-radio-display) {\n    display: block;\n    margin-bottom: 6px;\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--hi-wu26-ink);\n  }\n  .hi-wu26 .hs-form .hs-input:not([type=\"checkbox\"]):not([type=\"radio\"]) {\n    width: 100% !important;\n    min-height: 48px;\n    padding: 12px 14px;\n    border: 1px solid #d9d4d0;\n    border-radius: 10px;\n    background: #fff;\n    font-size: 16px; /* evita zoom no iOS */\n    color: var(--hi-wu26-ink);\n    transition: border-color .2s ease, box-shadow .2s ease;\n  }\n  .hi-wu26 .hs-form textarea.hs-input { min-height: 110px; resize: vertical; }\n  .hi-wu26 .hs-form select.hs-input { appearance: auto; }\n  .hi-wu26 .hs-form .hs-input:focus {\n    outline: none;\n    border-color: var(--hi-wu26-orange);\n    box-shadow: 0 0 0 3px rgba(255,115,0,.2);\n  }\n  .hi-wu26 .hs-form .hs-error-msgs { margin: 6px 0 0; padding: 0; list-style: none; }\n  .hi-wu26 .hs-form .hs-error-msg,\n  .hi-wu26 .hs-form .hs-error-msgs label { font-size: 13px !important; font-weight: 500 !important; color: #c0392b !important; }\n  .hi-wu26 .hs-form .legal-consent-container,\n  .hi-wu26 .hs-form .hs-richtext { font-size: 12px; line-height: 1.5; color: var(--hi-wu26-ink-soft); }\n  .hi-wu26 .hs-form .hs-button {\n    width: 100%;\n    margin-top: 8px;\n    padding: 16px 24px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--hi-wu26-ink);\n    color: #fff;\n    font-size: 15px;\n    font-weight: 700;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    cursor: pointer;\n    -webkit-appearance: none;\n    transition: background .25s ease, color .25s ease;\n  }\n  .hi-wu26 .hs-form .hs-button:hover { background: var(--hi-wu26-orange); color: var(--hi-wu26-ink); }\n  .hi-wu26 .submitted-message { font-size: 1.1rem; line-height: 1.5; font-weight: 600; }\n\n  /* ---------- Animação de entrada ---------- */\n  .hi-wu26 [data-wu26-reveal] {\n    opacity: 0;\n    transform: translateY(24px);\n    transition: opacity .8s ease, transform .8s ease;\n  }\n  .hi-wu26 [data-wu26-reveal].is-visible { opacity: 1; transform: none; }\n  @media (prefers-reduced-motion: reduce) {\n    .hi-wu26 [data-wu26-reveal] { opacity: 1; transform: none; transition: none; }\n    .hi-wu26-btn, .hi-wu26-btn svg { transition: none; }\n  }\n\n  /* ---------- Responsivo ---------- */\n  @media (min-width: 768px) {\n    .hi-wu26-context__grid { grid-template-columns: 1.1fr 1fr; }\n    .hi-wu26-goals__list { grid-template-columns: 1fr 1fr; }\n    .hi-wu26 .hi-wu26-goals__item { padding: 36px 32px 36px 0; }\n    .hi-wu26 .hi-wu26-goals__item:nth-child(even) { padding-left: 32px; }\n  }\n  @media (min-width: 1024px) {\n    .hi-wu26-form__grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 767px) {\n    .hi-wu26-hero { min-height: 560px; padding-top: 140px; }\n    .hi-wu26-hero__year { top: 70px; font-size: 46vw; }\n    .hi-wu26-btn { width: 100%; justify-content: center; }\n    .hi-wu26 .hs-form fieldset.form-columns-2 .hs-form-field { width: 100% !important; padding: 0 !important; float: none !important; }\n  }\n</style>\n\n<div class=\"hi-wu26\">\n\n  <!-- HERO -->\n  <section class=\"hi-wu26-hero\" aria-labelledby=\"hi-wu26-title\">\n    <div class=\"hi-wu26__bg\" aria-hidden=\"true\"></div>\n    <div class=\"hi-wu26-hero__year\" aria-hidden=\"true\">2026</div>\n\n    <div class=\"hi-wu26__inner\">\n      <div class=\"hi-wu26-hero__content\" data-wu26-reveal=\"\">\n        <span class=\"hi-wu26-eyebrow\">Experiência corporativa · Hyper Island</span>\n        <h1 class=\"hi-wu26-hero__title\" id=\"hi-wu26-title\">Wrap Up<span class=\"hi-wu26__sr\"> 2026</span>\n</h1>\n        <p class=\"hi-wu26-hero__lead\">O que precisamos desaprender antes de entrar em 2027?</p>\n        <a class=\"hi-wu26-btn\" href=\"#hi-wu26-form-section\">\n          Agende uma conversa\n          <svg viewbox=\"0 0 28 14\" fill=\"none\" aria-hidden=\"true\"><path d=\"M0 7h26M20 1l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.6\"></path></svg>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- CONTEXTO -->\n  <section class=\"hi-wu26-context\" aria-labelledby=\"hi-wu26-context-title\">\n    <div class=\"hi-wu26__inner\">\n      <div class=\"hi-wu26-context__grid\">\n        <h2 class=\"hi-wu26-context__title\" id=\"hi-wu26-context-title\" data-wu26-reveal=\"\">\n          Um ano inteiro de decisões, conquistas, mudanças e aprendizados.\n        </h2>\n        <div data-wu26-reveal=\"\">\n          <p class=\"hi-wu26-context__questions\">\n            Quais experiências devem orientar o próximo ciclo? Quais práticas precisam ser revistas?\n          </p>\n          <p class=\"hi-wu26-context__text\">\n            O fim do ano costuma chegar em ritmo de corrida, e muitos times atravessam para o próximo ciclo carregando os mesmos hábitos, crenças e atalhos. O <strong>Wrap-Up 2026</strong> cria uma pausa intencional para olhar o que este ano ensinou, abrir espaço para desaprender o que já não serve e decidir, juntos, o que vai sustentar 2027.\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- OBJETIVOS -->\n  <section class=\"hi-wu26-goals\" aria-labelledby=\"hi-wu26-goals-title\">\n    <div class=\"hi-wu26__inner\">\n      <h2 class=\"hi-wu26-goals__title\" id=\"hi-wu26-goals-title\" data-wu26-reveal=\"\">\n        Uma experiência corporativa <strong>facilitada pela Hyper Island</strong> para:\n      </h2>\n\n      <ul class=\"hi-wu26-goals__list\">\n        <li class=\"hi-wu26-goals__item\" data-wu26-reveal=\"\">\n          <span class=\"hi-wu26-goals__star\" aria-hidden=\"true\">*</span>\n          <p class=\"hi-wu26-goals__text\">Reconhecer conquistas e aprendizados de 2026.</p>\n        </li>\n        <li class=\"hi-wu26-goals__item\" data-wu26-reveal=\"\">\n          <span class=\"hi-wu26-goals__star\" aria-hidden=\"true\">*</span>\n          <p class=\"hi-wu26-goals__text\">Questionar crenças e formas de trabalhar.</p>\n        </li>\n        <li class=\"hi-wu26-goals__item\" data-wu26-reveal=\"\">\n          <span class=\"hi-wu26-goals__star\" aria-hidden=\"true\">*</span>\n          <p class=\"hi-wu26-goals__text\">Identificar prioridades para 2027.</p>\n        </li>\n        <li class=\"hi-wu26-goals__item\" data-wu26-reveal=\"\">\n          <span class=\"hi-wu26-goals__star\" aria-hidden=\"true\">*</span>\n          <p class=\"hi-wu26-goals__text\">Construir compromissos e próximos passos.</p>\n        </li>\n      </ul>\n\n      <ul class=\"hi-wu26-chips\" aria-label=\"Formato\" data-wu26-reveal=\"\">\n        <li>Desenhado para o contexto do seu time</li>\n        <li>Presencial ou online</li>\n        <li>Português, Inglês e Espanhol</li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- FORMULÁRIO -->\n  <section class=\"hi-wu26-form-section\" id=\"hi-wu26-form-section\" aria-labelledby=\"hi-wu26-form-title\">\n    <div class=\"hi-wu26__bg hi-wu26__bg--flip\" aria-hidden=\"true\"></div>\n    <div class=\"hi-wu26__inner\">\n      <div class=\"hi-wu26-form__grid\">\n        <div data-wu26-reveal=\"\">\n          <h2 class=\"hi-wu26-form__title\" id=\"hi-wu26-form-title\">\n            Antes de começar 2027, reúna sua equipe para construir o próximo capítulo.\n          </h2>\n          <h2 class=\"hi-wu26-form__brand\" aria-hidden=\"true\">Wrap Up</h2>\n          <p class=\"hi-wu26-form__cta\">Agende uma conversa.</p>\n          <p class=\"hi-wu26-form__note\">\n            Preencha o formulário e nosso time entra em contato para desenhar a experiência com você.\n          </p>\n        </div>\n\n        <div class=\"hi-wu26-form__card\" data-wu26-reveal=\"\">\n          <p class=\"hi-wu26-form__card-title\">Quero levar o Wrap-Up 2026 para o meu time</p>\n          <p class=\"hi-wu26-form__card-sub\"></p>\n          <div id=\"hi-wu26-hubspot-form\">\n            <p class=\"hi-wu26-form__loading\">Carregando formulário...</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</div>\n\n<script>\n  (function () {\n    /* ---------- HubSpot ---------- */\n    var TARGET = '#hi-wu26-hubspot-form';\n\n    function createForm() {\n      if (!window.hbspt || !window.hbspt.forms) return;\n      var el = document.querySelector(TARGET);\n      if (!el || el.getAttribute('data-loaded')) return;\n      el.setAttribute('data-loaded', 'true');\n      el.innerHTML = '';\n      window.hbspt.forms.create({\n        portalId: '1588780',\n        formId: '6a157401-47c3-4d92-9918-4d2637635771',\n        region: 'na1',\n        target: TARGET\n      });\n    }\n\n    if (window.hbspt && window.hbspt.forms) {\n      createForm();\n    } else {\n      var existing = document.querySelector('script[src*=\"js.hsforms.net/forms/embed/v2.js\"]');\n      if (existing) {\n        existing.addEventListener('load', createForm);\n        var tries = 0;\n        var poll = setInterval(function () {\n          tries++;\n          if (window.hbspt && window.hbspt.forms) { clearInterval(poll); createForm(); }\n          if (tries > 50) clearInterval(poll);\n        }, 200);\n      } else {\n        var s = document.createElement('script');\n        s.src = 'https://js.hsforms.net/forms/embed/v2.js';\n        s.charset = 'utf-8';\n        s.async = true;\n        s.onload = createForm;\n        document.head.appendChild(s);\n      }\n    }\n\n    /* ---------- Rolagem suave para o formulário ---------- */\n    document.querySelectorAll('.hi-wu26 a[href=\"#hi-wu26-form-section\"]').forEach(function (a) {\n      a.addEventListener('click', function (e) {\n        var target = document.getElementById('hi-wu26-form-section');\n        if (!target) return;\n        e.preventDefault();\n        target.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      });\n    });\n\n    /* ---------- Animação de entrada ---------- */\n    var items = document.querySelectorAll('.hi-wu26 [data-wu26-reveal]');\n    if (!('IntersectionObserver' in window)) {\n      items.forEach(function (el) { el.classList.add('is-visible'); });\n      return;\n    }\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('is-visible');\n          io.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });\n    items.forEach(function (el) { io.observe(el); });\n  })();\n</script>",
