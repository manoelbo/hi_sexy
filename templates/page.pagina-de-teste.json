gradient(circle, rgba(255,90,0,0.14) 0%, transparent 65%);\n      pointer-events: none;\n      animation: pulse 7s ease-in-out infinite;\n    }\n    @keyframes pulse {\n      0%,100% { opacity:1; transform:scale(1); }\n      50%      { opacity:.65; transform:scale(1.06); }\n    }\n\n    .hero-label {\n      position: relative;\n      z-index: 2;\n      font-family: var(--font-mono);\n      font-size: 10px;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      color: var(--orange);\n      margin-bottom: 24px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .hero-label::before {\n      content: '';\n      display: block;\n      width: 28px;\n      height: 1px;\n      background: var(--orange);\n    }\n\n    .hero-title {\n      position: relative;\n      z-index: 2;\n      font-family: var(--font-display);\n      font-weight: 900;\n      font-size: clamp(3.6rem, 10vw, 8.5rem);\n      line-height: 0.92;\n      text-transform: uppercase;\n      letter-spacing: -0.02em;\n      color: #f5f0eb;\n      max-width: 820px;\n      animation: fadeUp 0.85s ease both;\n    }\n    .hero-title span { color: var(--orange); }\n\n    @keyframes fadeUp {\n      from { opacity:0; transform:translateY(36px); }\n      to   { opacity:1; transform:translateY(0); }\n    }\n\n    .hero-sub {\n      position: relative;\n      z-index: 2;\n      margin-top: 28px;\n      font-size: 17px;\n      color: #999;\n      max-width: 480px;\n      line-height: 1.65;\n      animation: fadeUp 0.85s 0.18s ease both;\n    }\n\n    /* ─── WRAPPER ─── */\n    .wrap {\n      max-width: 1120px;\n      margin: 0 auto;\n      padding: 0 6vw;\n    }\n\n    /* ─── SECTION ─── */\n    .section {\n      padding: 88px 0;\n    }\n\n    .section-tag {\n      font-family: var(--font-mono);\n      font-size: 10px;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: var(--orange);\n      margin-bottom: 14px;\n    }\n\n    .section-title {\n      font-family: var(--font-display);\n      font-weight: 900;\n      font-size: clamp(2.2rem, 4.5vw, 3.4rem);\n      text-transform: uppercase;\n      line-height: 1;\n      letter-spacing: -0.01em;\n      margin-bottom: 48px;\n      color: var(--black);\n    }\n\n    /* ─── JOB CARD ─── */\n    .job-card {\n      border: 1px solid var(--border);\n      border-top: 4px solid var(--orange);\n      background: var(--white);\n      margin-bottom: 3px;\n    }\n\n    .job-card-header {\n      padding: 48px 52px;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 40px;\n      align-items: flex-start;\n      border-bottom: 1px solid var(--light);\n      position: relative;\n    }\n\n    .job-status {\n      position: absolute;\n      top: 22px;\n      right: 28px;\n      font-family: var(--font-mono);\n      font-size: 9px;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      color: var(--orange);\n      border: 1px solid var(--orange);\n      padding: 3px 9px;\n    }\n\n    .job-title-block { flex: 1; min-width: 240px; }\n\n    .job-role {\n      font-family: var(--font-display);\n      font-weight: 900;\n      font-size: clamp(2rem, 4.5vw, 3.2rem);\n      text-transform: uppercase;\n      line-height: 1;\n      color: var(--black);\n    }\n    .job-role em {\n      color: var(--orange);\n      font-style: normal;\n      display: block;\n    }\n\n    .job-meta {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      margin-top: 20px;\n    }\n    .chip {\n      font-family: var(--font-mono);\n      font-size: 10px;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      border: 1px solid var(--border);\n      padding: 5px 13px;\n      color: var(--muted);\n      background: var(--off);\n    }\n    .chip.hi { border-color: var(--orange); color: var(--orange); background: #fff5f0; }\n\n    .job-pdf-block {\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      gap: 10px;\n    }\n\n    .btn-pdf {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      padding: 15px 26px;\n      font-family: var(--font-display);\n      font-weight: 700;\n      font-size: 13px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      text-decoration: none;\n      color: var(--white);\n      background: var(--orange);\n      border: 2px solid var(--orange);\n      transition: background 0.2s, color 0.2s;\n      white-space: nowrap;\n    }\n    .btn-pdf:hover {\n      background: transparent;\n      color: var(--orange);\n    }\n\n    .btn-pdf-note {\n      font-family: var(--font-mono);\n      font-size: 9px;\n      letter-spacing: 0.12em;\n      color: var(--muted);\n      text-transform: uppercase;\n      text-align: center;\n    }\n\n    /* ─── DETAILS GRID ─── */\n    .details-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n      gap: 3px;\n      background: var(--light);\n      margin-bottom: 3px;\n    }\n\n    .detail-block {\n      background: var(--white);\n      padding: 36px 40px;\n      transition: background 0.2s;\n    }\n    .detail-block:hover { background: var(--off); }\n\n    .detail-block-title {\n      font-family: var(--font-display);\n      font-weight: 700;\n      font-size: 12px;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      color: var(--orange);\n      margin-bottom: 18px;\n      padding-bottom: 14px;\n      border-bottom: 1px solid var(--light);\n    }\n\n    .detail-list {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 9px;\n    }\n    .detail-list li {\n      font-size: 14.5px;\n      color: var(--text);\n      line-height: 1.5;\n      padding-left: 16px;\n      position: relative;\n    }\n    .detail-list li::before {\n      content: '–';\n      position: absolute;\n      left: 0;\n      color: var(--orange);\n    }\n\n    /* ─── OFFER STRIP ─── */\n    .offer-strip {\n      background: var(--black);\n      padding: 36px 52px;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 20px;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .offer-strip-title {\n      font-family: var(--font-display);\n      font-weight: 700;\n      font-size: 1.1rem;\n      text-transform: uppercase;\n      color: var(--orange);\n      letter-spacing: 0.08em;\n    }\n\n    .offer-items {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n    .offer-item {\n      background: rgba(255,255,255,0.06);\n      color: #ccc;\n      font-family: var(--font-mono);\n      font-size: 10px;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      padding: 7px 15px;\n      border: 1px solid rgba(255,255,255,0.1);\n    }\n\n    /* ─── DIVIDER ─── */\n    hr.divider {\n      border: none;\n      border-top: 1px solid var(--light);\n    }\n\n    /* ─── ABOUT ─── */\n    .about-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 80px;\n      align-items: center;\n    }\n\n    .about-text h2 {\n      font-family: var(--font-display);\n      font-weight: 900;\n      font-size: clamp(2rem, 4vw, 2.8rem);\n      text-transform: uppercase;\n      line-height: 1.05;\n      margin-bottom: 22px;\n      color: var(--black);\n    }\n    .about-text h2 span { color: var(--orange); }\n\n    .about-text p {\n      font-size: 15.5px;\n      color: #666;\n      line-height: 1.75;\n    }\n    .about-text p + p { margin-top: 14px; }\n\n    .stats-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 3px;\n      background: var(--light);\n    }\n\n    .stat-card {\n      background: var(--white);\n      padding: 32px 28px;\n      transition: background 0.2s;\n    }\n    .stat-card:hover { background: var(--off); }\n\n    .stat-number {\n      font-family: var(--font-display);\n      font-weight: 900;\n      font-size: 2.8rem;\n      color: var(--orange);\n      line-height: 1;\n    }\n    .stat-label {\n      font-size: 12.5px;\n      color: var(--muted);\n      margin-top: 6px;\n      line-height: 1.4;\n    }\n\n    /* ─── FORM ─── */\n    .form-intro p {\n      font-size: 16px;\n      color: #666;\n      line-height: 1.7;\n      margin-top: 16px;\n      max-width: 520px;\n    }\n\n    .form-wrapper {\n      margin-top: 48px;\n      background: var(--off);\n      border: 1px solid var(--border);\n      border-top: 4px solid var(--orange);\n      padding: 52px;\n      min-height: 420px;\n    }\n\n    /* ─── RESPONSIVE ─── */\n    @media (max-width: 768px) {\n      .hero { padding: 0 5vw 8vh; }\n      .wrap { padding: 0 5vw; }\n      .job-card-header { padding: 28px 28px 36px; }\n      .detail-block { padding: 24px 28px; }\n      .offer-strip { padding: 28px 28px; }\n      .about-grid { grid-template-columns: 1fr; gap: 44px; }\n      .form-wrapper { padding: 28px; }\n      .section { padding: 60px 0; }\n    }\n  </style>\n\n\n\n  <!-- ── HERO ── -->\n  <section class=\"hero\">\n    <div class=\"hero-grid\"></div>\n    <div class=\"hero-glow\"></div>\n    <p class=\"hero-label\">Hyper Island Americas · Trabalhe Conosco</p>\n    <h1 class=\"hero-title\">\n      Faça parte<br>\n      do <span>futuro</span><br>\n      do trabalho.\n    </h1>\n    <p class=\"hero-sub\">\n      Buscamos pessoas criativas, estratégicas e inquietas — prontas para transformar a educação com a gente.\n    </p>\n  </section>\n\n  <!-- ── VAGA ── -->\n  <div class=\"wrap\">\n    <section class=\"section\">\n      <p class=\"section-tag\">— Vaga em aberto</p>\n      <h2 class=\"section-title\">Oportunidade disponível</h2>\n\n      <div class=\"job-card\">\n\n        <!-- Cabeçalho -->\n        <div class=\"job-card-header\">\n          <span class=\"job-status\">Aberta agora</span>\n\n          <div class=\"job-title-block\">\n            <h3 class=\"job-role\">\n              Social Media\n              <em>Content Creator</em>\n            </h3>\n            <div class=\"job-meta\">\n              <span class=\"chip hi\">Aberta agora</span>\n              <span class=\"chip\">🌎 Remoto</span>\n              <span class=\"chip\">📄 PJ</span>\n              <span class=\"chip\">💰 R$5.000</span>\n            </div>\n          </div>\n\n          <div class=\"job-pdf-block\">\n            <a href=\"https://hyperisland.com/hubfs/Job%20Description%20-%20Social%20Media%20-%20Hyper%20Island.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-pdf\">\n              <svg width=\"16\" height=\"16\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path>\n                <polyline points=\"14 2 14 8 20 8\"></polyline>\n                <line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line>\n                <line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line>\n              </svg>\n              Ver Job Description\n            </a>\n            <span class=\"btn-pdf-note\">PDF completo da vaga →</span>\n          </div>\n        </div>\n\n        <!-- Detalhes -->\n        <div class=\"details-grid\">\n          <div class=\"detail-block\">\n            <p class=\"detail-block-title\">Responsabilidades</p>\n            <ul class=\"detail-list\">\n              <li>Criar e executar estratégias para Instagram, LinkedIn e outras plataformas</li>\n              <li>Desenvolver conteúdos originais com copywriting persuasivo</li>\n              <li>Gerenciar o calendário editorial com consistência de tom de voz</li>\n              <li>Monitorar tendências e interagir com a comunidade</li>\n              <li>Analisar métricas e otimizar campanhas orgânicas</li>\n              <li>Colaborar com o time de marketing na estratégia geral</li>\n            </ul>\n          </div>\n\n          <div class=\"detail-block\">\n            <p class=\"detail-block-title\">Requisitos</p>\n            <ul class=\"detail-list\">\n              <li>Conhecimento avançado em copywriting e storytelling</li>\n              <li>Inglês avançado — essencial para comunicação interna e conteúdo</li>\n              <li>Habilidade analítica para interpretar dados e ajustar estratégias</li>\n              <li>Criatividade e capacidade de inovar nas abordagens de conteúdo</li>\n            </ul>\n          </div>\n\n          <div class=\"detail-block\">\n            <p class=\"detail-block-title\">Diferenciais</p>\n            <ul class=\"detail-list\">\n              <li>Experiência prévia como Social Media ou função similar</li>\n              <li>Conhecimento básico de design (Canva ou Photoshop)</li>\n              <li>Espanhol avançado</li>\n            </ul>\n          </div>\n\n          <div class=\"detail-block\">\n            <p class=\"detail-block-title\">Sobre a Hyper Island</p>\n            <ul class=\"detail-list\">\n              <li>Instituição global de consultoria e educação para o futuro do trabalho</li>\n              <li>Presente em 6 hubs: Américas, Europa e Ásia</li>\n              <li>+280 facilitadores e consultores em rede global</li>\n              <li>+1.870 organizações já transformadas pela metodologia</li>\n            </ul>\n          </div>\n        </div>\n\n        <!-- Offer strip -->\n        <div class=\"offer-strip\">\n          <p class=\"offer-strip-title\">O que oferecemos</p>\n          <div class=\"offer-items\">\n            <span class=\"offer-item\">R$5.000 / mês</span>\n            <span class=\"offer-item\">100% remoto</span>\n            <span class=\"offer-item\">Horário flexível</span>\n            <span class=\"offer-item\">Ambiente internacional</span>\n            <span class=\"offer-item\">Crescimento contínuo</span>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  </div>\n\n  <hr class=\"divider\">\n\n  <!-- ── SOBRE ── -->\n  <div class=\"wrap\">\n    <section class=\"section\">\n      <div class=\"about-grid\">\n        <div class=\"about-text\">\n          <h2>Por que <span>Hyper Island</span>?</h2>\n          <p>\n            Na Hyper Island, cada projeto é uma experiência de aprendizagem real. Você terá autonomia para criar, acesso a uma rede global de pensadores e a chance de impactar diretamente como pessoas e organizações se preparam para o futuro.\n          </p>\n          <p>\n            Não buscamos apenas executores — queremos parceiros estratégicos com vontade de experimentar, aprender e cocriar.\n          </p>\n        </div>\n        <div class=\"stats-grid\">\n          <div class=\"stat-card\">\n            <div class=\"stat-number\">30</div>\n            <div class=\"stat-label\">anos de Hyper Island no mundo</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"stat-number\">6</div>\n            <div class=\"stat-label\">hubs globais</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"stat-number\">+280</div>\n            <div class=\"stat-label\">pessoas na rede global</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"stat-number\">+1870</div>\n            <div class=\"stat-label\">organizações transformadas</div>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <hr class=\"divider\">\n\n  <!-- ── FORMULÁRIO ── -->\n  <div class=\"wrap\">\n    <section class=\"section\">\n      <div class=\"form-intro\">\n        <p class=\"section-tag\">— Candidatura</p>\n        <h2 class=\"section-title\">Inscreva-se agora</h2>\n        <p>\n          Tem paixão por redes sociais e quer impactar a educação do futuro? Preencha o formulário abaixo e nossa equipe entrará em contato.\n        </p>\n      </div>\n      <div class=\"form-wrapper\">\n        <div data-tf-live=\"01KNJKTPEYQVK2BQ5XN17AA7HN\"></div>\n        <script src=\"//embed.typeform.com/next/embed.js\"></script>\n      </div>\n    </section>\n  </div>",
