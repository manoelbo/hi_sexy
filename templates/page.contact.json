    "html_CcR9cY": {
      "type": "html",
      "disabled": true,
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Que tipo de Líder Você é?</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #f4f4f4;\n            color: #333;\n            margin: 0;\n            padding: 20px;\n        }\n        .quiz-container {\n            background-color: #fff;\n            padding: 20px;\n            border-radius: 8px;\n            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n            width: 100%;\n            max-width: 600px;\n            margin: 0 auto;\n            text-align: center;\n        }\n        .quiz-container h1 {\n            color: #FF6F00;\n        }\n        .question {\n            margin-bottom: 20px;\n        }\n        .question h2 {\n            font-size: 22px;\n            color: #FF6F00;\n        }\n        .answers label {\n            display: block;\n            margin: 10px 0;\n        }\n        .next-button, .submit-button, .restart-button {\n            background-color: #FF6F00;\n            color: white;\n            border: none;\n            padding: 10px 20px;\n            cursor: pointer;\n            border-radius: 4px;\n            margin-top: 20px;\n        }\n        .result-container {\n            display: none;\n        }\n        .result-container h2 {\n            color: #FF6F00;\n        }\n    </style>\n\n\n    <div class=\"quiz-container\" id=\"quizContainer\">\n        <h1>Que tipo de Líder Você é?</h1>\n        <form id=\"quizForm\">\n            <div class=\"question\" id=\"question1\">\n                <h2>Pergunta 1: Como você lida com mudanças?</h2>\n                <div class=\"answers\">\n                    <label><input type=\"radio\" name=\"q1\" value=\"visionary\"> Abraço as mudanças e vejo oportunidades.</label>\n                    <label><input type=\"radio\" name=\"q1\" value=\"coach\">  Uso as mudanças para motivar e desenvolver minha equipe.</label>\n                    <label><input type=\"radio\" name=\"q1\" value=\"democratic\"> Consulto minha equipe para encontrar a melhor abordagem.</label>\n                </div>\n                <button type=\"button\" class=\"next-button\" onclick=\"showNextQuestion(1)\">Próxima</button>\n            </div>\n            <div class=\"question\" id=\"question2\" style=\"display: none;\">\n                <h2>Pergunta 2: Como você define o sucesso?</h2>\n                <div class=\"answers\">\n                    <label><input type=\"radio\" name=\"q2\" value=\"visionary\"> Alcançar grandes metas e inovar constantemente.</label>\n                    <label><input type=\"radio\" name=\"q2\" value=\"coach\"> Ver minha equipe crescer e se desenvolver.</label>\n                    <label><input type=\"radio\" name=\"q2\" value=\"democratic\"> Ter um ambiente de trabalho harmonioso e colaborativo.</label>\n                </div>\n                <button type=\"button\" class=\"next-button\" onclick=\"showNextQuestion(2)\">Próxima</button>\n            </div>\n            <div class=\"question\" id=\"question3\" style=\"display: none;\">\n                <h2>Pergunta 3: Como você resolve conflitos na equipe?</h2>\n                <div class=\"answers\">\n                    <label><input type=\"radio\" name=\"q3\" value=\"visionary\"> Foco nos objetivos comuns e na visão a longo prazo.</label>\n                    <label><input type=\"radio\" name=\"q3\" value=\"coach\"> Facilito diálogos e ajudo as pessoas a se entenderem.</label>\n                    <label><input type=\"radio\" name=\"q3\" value=\"democratic\"> Encorajo a equipe a encontrar soluções juntos.</label>\n                </div>\n                <button type=\"button\" class=\"next-button\" onclick=\"showNextQuestion(3)\">Próxima</button>\n            </div>\n            <div class=\"question\" id=\"question4\" style=\"display: none;\">\n                <h2>Pergunta 4: Qual é o seu estilo de comunicação?</h2>\n                <div class=\"answers\">\n                    <label><input type=\"radio\" name=\"q4\" value=\"visionary\">  Inspirador e motivacional.</label>\n                    <label><input type=\"radio\" name=\"q4\" value=\"coach\"> Feedback contínuo e construtivo.</label>\n                    <label><input type=\"radio\" name=\"q4\" value=\"democratic\"> Aberto e inclusivo.</label>\n                </div>\n                <button type=\"button\" class=\"next-button\" onclick=\"showNextQuestion(4)\">Próxima</button>\n            </div>\n            <div class=\"question\" id=\"question5\" style=\"display: none;\">\n                <h2>Pergunta 5: Como você toma decisões importantes?</h2>\n                <div class=\"answers\">\n                    <label><input type=\"radio\" name=\"q5\" value=\"visionary\"> Baseado na minha visão e intuição.</label>\n                    <label><input type=\"radio\" name=\"q5\" value=\"coach\"> Considerando o impacto no desenvolvimento da equipe.</label>\n                    <label><input type=\"radio\" name=\"q5\" value=\"democratic\"> Consultando a equipe e buscando consenso.</label>\n                </div>\n                <button type=\"button\" class=\"submit-button\" onclick=\"submitQuiz()\">Enviar</button>\n            </div>\n        </form>\n        <div class=\"result-container\" id=\"result\">\n            <h2>Seu tipo de líder é:</h2>\n            <p id=\"resultText\"></p>\n            <button type=\"button\" class=\"restart-button\" onclick=\"restartQuiz()\">Refazer o Quiz</button>\n        </div>\n    </div>\n    <script>\n        function showNextQuestion(currentQuestion) {\n            const currentQuestionDiv = document.getElementById(`question${currentQuestion}`);\n            const nextQuestionDiv = document.getElementById(`question${currentQuestion + 1}`);\n            const answers = currentQuestionDiv.querySelectorAll('input[type=\"radio\"]');\n\n            let answered = false;\n            answers.forEach(answer => {\n                if (answer.checked) {\n                    answered = true;\n                }\n            });\n\n            if (answered) {\n                currentQuestionDiv.style.display = 'none';\n                nextQuestionDiv.style.display = 'block';\n            } else {\n                alert('Por favor, responda a pergunta.');\n            }\n        }\n\n        function submitQuiz() {\n            const form = document.getElementById('quizForm');\n            const resultDiv = document.getElementById('result');\n            const resultText = document.getElementById('resultText');\n\n            const answers = Array.from(form.elements)\n                .filter(element => element.checked)\n                .map(element => element.value);\n\n            const resultCounts = {\n                visionary: 0,\n                coach: 0,\n                democratic: 0\n            };\n\n            answers.forEach(answer => resultCounts[answer]++);\n\n            const maxCount = Math.max(resultCounts.visionary, resultCounts.coach, resultCounts.democratic);\n            let resultType = '';\n            let resultDescription = '';\n\n            if (resultCounts.visionary === maxCount) {\n                resultType = 'Visionário';\n                resultDescription = 'Você é um líder visionário, sempre enxergando oportunidades nas mudanças e inspirando sua equipe a alcançar grandes metas.';\n            } else if (resultCounts.coach === maxCount) {\n                resultType = 'Coach';\n                resultDescription = 'Você é um líder coach, focado no desenvolvimento contínuo de sua equipe e utilizando as mudanças como ferramenta de crescimento.';\n            } else if (resultCounts.democratic === maxCount) {\n                resultType = 'Democrático';\n                resultDescription = 'Você é um líder democrático, valorizando a opinião de todos e buscando consenso para tomar decisões importantes.';\n            }\n\n            resultText.innerHTML = `<strong>${resultType}</strong>: ${resultDescription}`;\n            resultDiv.style.display = 'block';\n\n            const quizContainer = document.getElementById('quizContainer');\n            quizContainer.querySelector('form').style.display = 'none';\n        }\n\n        function restartQuiz() {\n            const form = document.getElementById('quizForm');\n            form.reset();\n\n            const questions = form.querySelectorAll('.question');\n            questions.forEach(question => {\n                question.style.display = 'none';\n            });\n\n            const quizContainer = document.getElementById('quizContainer');\n            quizContainer.querySelector('form').style.display = 'block';\n            document.getElementById('result').style.display = 'none';\n\n            document.getElementById('question1').style.display = 'block';\n        }\n    </script>",
