        callbacks: {\n                            label: function(tooltipItem) {\n                                return tooltipItem.dataset.label + ': Maturidade (' + tooltipItem.raw.x + '), Prioridade (' + tooltipItem.raw.y + ')';\n                            }\n                        }\n                    }\n                }\n            }\n        };\n\n        const matrizChart = new Chart(ctx, config);\n    </script>",
