        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Matriz Prioridade x Maturidade</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <style>\n        body {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n            margin: 0;\n            text-align: center;\n            flex-direction: column;\n        }\n\n        canvas {\n            max-width: 600px;\n            max-height: 400px;\n        }\n    </style>\n\n\n    <h2>Matriz de Prioridade x Maturidade</h2>\n    <br>\n    <canvas id=\"matrizChart\"></canvas>\n\n    <script>\n        const ctx = document.getElementById('matrizChart').getContext('2d');\n        const data = {\n            datasets: [{\n                label: 'Protagonismo em solução',\n                data: [{ x: 3.00, y: 4.72 }],\n                backgroundColor: 'rgba(255, 99, 132, 0.7)',\n                borderColor: 'rgba(255, 99, 132, 1)',\n                borderWidth: 1,\n                pointRadius: 8\n            }, {\n                label: 'Visão Sistêmica',\n                data: [{ x: 3.12, y: 4.70 }],\n                backgroundColor: 'rgba(54, 162, 235, 0.7)',\n                borderColor: 'rgba(54, 162, 235, 1)',\n                borderWidth: 1,\n                pointRadius: 8\n            }, {\n                label: 'Comunicação Influente',\n                data: [{ x: 3.08, y: 4.68 }],\n                backgroundColor: 'rgba(75, 192, 192, 0.7)',\n                borderColor: 'rgba(75, 192, 192, 1)',\n                borderWidth: 1,\n                pointRadius: 8\n            }, {\n                label: 'Inteligência Preditiva',\n                data: [{ x: 2.95, y: 4.68 }],\n                backgroundColor: 'rgba(153, 102, 255, 0.7)',\n                borderColor: 'rgba(153, 102, 255, 1)',\n                borderWidth: 1,\n          