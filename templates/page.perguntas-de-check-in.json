    "html_Qdz8ff": {
      "type": "html",
      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Hackeie Sua Criatividade</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Poppins', sans-serif;\n            transition: all 0.3s ease;\n        }\n        .challenge-transition {\n            animation: fadeIn 0.5s ease-in-out;\n        }\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .bg-orange-hi {\n            background-color: #ff7700;\n        }\n        .text-orange-hi {\n            color: #ff7700;\n        }\n        .border-orange-hi {\n            border-color: #ff7700;\n        }\n    </style>\n\n\n    <div class=\"container mx-auto px-4 py-8 flex-grow flex flex-col\">\n        <!-- Initial Screen -->\n        <div id=\"initial-screen\" class=\"flex flex-col items-center justify-center flex-grow text-center\">\n            <h1 class=\"text-4xl md:text-5xl font-bold mb-4 text-orange-hi\">Hackeie Sua Criatividade</h1>\n            <p class=\"text-xl md:text-2xl text-gray-700 mb-8 max-w-2xl mx-auto\">Experimente desafios rápidos para desbloquear novas formas de pensar.</p>\n            <button id=\"start-btn\" class=\"bg-orange-hi hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-full text-lg transition-all transform hover:scale-105\">\n                Iniciar Experimento\n            </button>\n        </div>\n\n        <!-- Challenges Container -->\n        <div id=\"challenges-container\" class=\"hidden flex-grow flex flex-col\">\n            <!-- Challenge progress indicator -->\n            <div class=\"mb-6 flex justify-center space-x-2\">\n                <div id=\"progress-1\" class=\"w-8 h-2 rounded-full bg-gray-300\"></div>\n                <div id=\"progress-2\" class=\"w-8 h-2 rounded-full bg-gray-300\"></div>\n                <div id=\"progress-3\" class=\"w-8 h-2 rounded-full bg-gray-300\"></div>\n            </div>\n\n            <!-- Challenge content will be injected here -->\n            <div id=\"challenge-content\" class=\"flex-grow flex flex-col items-center justify-center text-center challenge-transition\">\n                <!-- Content will be dynamically loaded -->\n            </div>\n\n            <!-- Navigation buttons -->\n            <div class=\"mt-8 flex justify-center\">\n                <button id=\"next-btn\" class=\"bg-orange-hi hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-full text-lg transition-all transform hover:scale-105 hidden\">\n                    Próximo\n                </button>\n            </div>\n        </div>\n\n        <!-- Results Screen -->\n        <div id=\"results-screen\" class=\"hidden flex-grow flex flex-col items-center justify-center text-center\">\n            <div class=\"max-w-2xl mx-auto px-4\">\n                <h2 class=\"text-3xl md:text-4xl font-bold mb-6 text-orange-hi\">Seu Perfil de Pensamento Criativo</h2>\n                <div id=\"result-text\" class=\"text-xl md:text-2xl text-gray-700 mb-8\">\n                    <!-- Result will be inserted here -->\n                </div>\n                <p class=\"text-lg text-gray-600 mb-8\">Experimente usar esse estilo em sua próxima reunião ou projeto. Criatividade é prática.</p>\n                <div class=\"flex flex-col sm:flex-row justify-center gap-4\">\n                    <button id=\"more-challenges-btn\" class=\"bg-orange-hi hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-full transition-all transform hover:scale-105\">\n                        Quero mais desafios\n                    </button>\n                    <a href=\"https://www.hyperisland.com\" target=\"_blank\" class=\"border-2 border-orange-hi text-orange-hi hover:bg-orange-50 font-bold py-3 px-6 rounded-full transition-all transform hover:scale-105\">\n                        Explorar cursos da Hyper Island\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <footer class=\"bg-gray-100 py-4 text-center text-gray-600 text-sm\">\n        <p>© 2023 Hackeie Sua Criatividade - Inspirado pela metodologia Hyper Island</p>\n    </footer>\n\n    <script>\n        // Challenge types\n        const challengeTypes = [\n            {\n                type: \"association\",\n                title: \"Associação Improvável\",\n                description: \"Crie uma conexão entre estas duas coisas:\",\n                content: `<div class=\"text-4xl font-bold mb-8\">\n                    <span class=\"text-orange-hi\">Abacaxi</span> + <span class=\"text-orange-hi\">Banco de Dados</span>\n                </div>\n                <textarea id=\"response\" class=\"w-full max-w-md h-32 p-4 border-2 border-gray-300 rounded-lg focus:border-orange-hi focus:outline-none\" placeholder=\"Digite sua conexão criativa aqui...\"></textarea>`\n            },\n            {\n                type: \"certainty\",\n                title: \"Destruição de Certezas\",\n                description: \"Subverta este pensamento comum:\",\n                content: `<div class=\"text-3xl font-bold mb-8 italic text-gray-700\">\"Tempo é dinheiro\"</div>\n                <textarea id=\"response\" class=\"w-full max-w-md h-32 p-4 border-2 border-gray-300 rounded-lg focus:border-orange-hi focus:outline-none\" placeholder=\"Como você subverteria esta ideia?\"></textarea>`\n            },\n            {\n                type: \"completion\",\n                title: \"Completar o Caos\",\n                description: \"Complete esta frase absurda:\",\n                content: `<div class=\"text-3xl font-bold mb-8 italic text-gray-700\">\"O futuro será governado por ___ e ___\"</div>\n                <textarea id=\"response\" class=\"w-full max-w-md h-32 p-4 border-2 border-gray-300 rounded-lg focus:border-orange-hi focus:outline-none\" placeholder=\"Preencha os espaços com ideias inesperadas...\"></textarea>`\n            },\n            {\n                type: \"description\",\n                title: \"Desenhe com Palavras\",\n                description: \"Descreva este objeto de uma forma que ninguém faria:\",\n                content: `<div class=\"text-4xl mb-8\">✏️</div>\n                <div class=\"text-xl mb-4\">Um lápis comum...</div>\n                <textarea id=\"response\" class=\"w-full max-w-md h-32 p-4 border-2 border-gray-300 rounded-lg focus:border-orange-hi focus:outline-none\" placeholder=\"Descreva de forma totalmente inovadora\"></textarea>`\n            },\n            {\n                type: \"reversal\",\n                title: \"Ideia por Reversão\",\n                description: \"Pense no PIOR jeito possível de resolver este problema:\",\n                content: `<div class=\"text-2xl font-bold mb-8\">\"Como melhorar a produtividade?\"</div>\n                <textarea id=\"response\" class=\"w-full max-w-md h-32 p-4 border-2 border-gray-300 rounded-lg focus:border-orange-hi focus:outline-none\" placeholder=\"A pior solução possível...\"></textarea>`\n            }\n        ];\n\n        // Creative profiles\n        const creativeProfiles = [\n            {\n                title: \"Você pensa por contraste\",\n                description: \"Vê o mundo de trás pra frente e encontra soluções invertendo o problema. Sua mente questiona automaticamente o status quo.\"\n            },\n            {\n                title: \"Sua criatividade é metafórica e caótica\",\n                description: \"E isso é ótimo! Você conecta ideias aparentemente desconexas e cria novas perspectivas a partir de associações inesperadas.\"\n            },\n            {\n                title: \"Você é um hacker de ideias\",\n                description: \"Conecta coisas improváveis com facilidade e encontra padrões onde outros veem apenas ruído. Sua mente funciona como um algoritmo de criatividade.\"\n            },\n            {\n                title: \"Seu superpoder é a destruição criativa\",\n                description: \"Você brilha ao desmontar conceitos estabelecidos e reconstruí-los de formas novas. Nada escapa do seu olhar questionador.\"\n            },\n            {\n                title: \"Você é um arquiteto de absurdos\",\n                description: \"Transforma o nonsense em insights valiosos. Sua mente vê potencial criativo mesmo nas ideias mais malucas.\"\n            }\n        ];\n\n        // App state\n        let currentChallenge = 0;\n        let selectedChallenges = [];\n        let userResponses = [];\n\n        // DOM elements\n        const initialScreen = document.getElementById('initial-screen');\n        const challengesContainer = document.getElementById('challenges-container');\n        const challengeContent = document.getElementById('challenge-content');\n        const nextBtn = document.getElementById('next-btn');\n        const resultsScreen = document.getElementById('results-screen');\n        const resultText = document.getElementById('result-text');\n        const startBtn = document.getElementById('start-btn');\n        const moreChallengesBtn = document.getElementById('more-challenges-btn');\n\n        // Start the experiment\n        startBtn.addEventListener('click', startExperiment);\n        moreChallengesBtn.addEventListener('click', startExperiment);\n        nextBtn.addEventListener('click', nextChallenge);\n\n        function startExperiment() {\n            // Reset state\n            currentChallenge = 0;\n            userResponses = [];\n            \n            // Select 3 random challenges\n            selectedChallenges = [...challengeTypes]\n                .sort(() => 0.5 - Math.random())\n                .slice(0, 3);\n            \n            // Update UI\n            initialScreen.classList.add('hidden');\n            resultsScreen.classList.add('hidden');\n            challengesContainer.classList.remove('hidden');\n            \n            // Reset progress indicators\n            document.querySelectorAll('[id^=\"progress-\"]').forEach(el => {\n                el.classList.remove('bg-orange-hi');\n                el.classList.add('bg-gray-300');\n            });\n            \n            // Show first challenge\n            showChallenge();\n        }\n\n        function showChallenge() {\n            // Update progress indicator\n            document.getElementById(`progress-${currentChallenge + 1}`).classList.remove('bg-gray-300');\n            document.getElementById(`progress-${currentChallenge + 1}`).classList.add('bg-orange-hi');\n            \n            // Get current challenge\n            const challenge = selectedChallenges[currentChallenge];\n            \n            // Update challenge content\n            challengeContent.innerHTML = `\n                <h2 class=\"text-2xl md:text-3xl font-bold mb-4 text-orange-hi\">${challenge.title}</h2>\n                <p class=\"text-lg md:text-xl text-gray-700 mb-8\">${challenge.description}</p>\n                ${challenge.content}\n            `;\n            \n            // Show next button\n            nextBtn.classList.remove('hidden');\n            \n            // Add transition effect\n            challengeContent.classList.add('challenge-transition');\n            setTimeout(() => {\n                challengeContent.classList.remove('challenge-transition');\n            }, 500);\n        }\n\n        function nextChallenge() {\n            // Save user response\n            const responseTextarea = document.getElementById('response');\n            if (responseTextarea) {\n                userResponses.push(responseTextarea.value.trim());\n            }\n            \n            // Move to next challenge or show results\n            currentChallenge++;\n            if (currentChallenge < selectedChallenges.length) {\n                showChallenge();\n            } else {\n                showResults();\n            }\n        }\n\n        function showResults() {\n            // Hide challenges\n            challengesContainer.classList.add('hidden');\n            \n            // Show results\n            resultsScreen.classList.remove('hidden');\n            \n            // Select a random creative profile\n            const randomProfile = creativeProfiles[Math.floor(Math.random() * creativeProfiles.length)];\n            \n            // Update result text\n            resultText.innerHTML = `\n                <h3 class=\"text-2xl font-bold mb-4\">${randomProfile.title}</h3>\n                <p class=\"text-gray-700\">${randomProfile.description}</p>\n            `;\n        }\n    </script>",
