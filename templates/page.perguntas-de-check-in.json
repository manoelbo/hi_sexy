        "html": "<!-- ╔══════════════════════════════════════════════════════════════╗\n     ║  Hyper Island — Check-in / Check-out Generator              ║\n     ║  Shopify-safe embed: cole este bloco num Custom HTML section ║\n     ╚══════════════════════════════════════════════════════════════╝ -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Barlow+Condensed:wght@300;400;600;700&amp;family=Barlow:wght@300;400;500&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\n/* ═══════════════════════════════════════════════════════════\n   SCOPED RESET — tudo dentro de #hicq-root para não vazar\n═══════════════════════════════════════════════════════════ */\n#hicq-root *,\n#hicq-root *::before,\n#hicq-root *::after {\n  box-sizing: border-box !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ── DARK token set ── */\n#hicq-root {\n  --hi-orange:      #FF6B00;\n  --bg:             #0A0A0A;\n  --fg:             #F5F2EE;\n  --sub-fg:         #888;\n  --logo-fg:        #888;\n  --card-bg:        #1A1A1A;\n  --card-border:    rgba(255,255,255,0.09);\n  --card-shadow:    0 30px 80px rgba(0,0,0,0.45),0 0 0 1px rgba(255,107,0,.10);\n  --card-glow:      rgba(255,107,0,0.06);\n  --stk1-bg:        rgba(255,107,0,0.06);\n  --stk1-bd:        rgba(255,107,0,0.14);\n  --stk2-bg:        rgba(255,107,0,0.03);\n  --stk2-bd:        rgba(255,107,0,0.07);\n  --tab-bg:         #1A1A1A;\n  --tab-bd:         rgba(255,255,255,0.07);\n  --tab-fg:         #888;\n  --tab-a-bg:       rgba(255,107,0,0.08);\n  --tab-a-fg:       #F5F2EE;\n  --btn-bd:         rgba(255,255,255,0.12);\n  --btn-fg:         #888;\n  --btn-h-bg:       rgba(255,107,0,0.06);\n  --chip-bg:        rgba(255,255,255,0.04);\n  --chip-bd:        rgba(255,255,255,0.06);\n  --chip-fg:        rgba(255,255,255,0.30);\n  --cnt-fg:         rgba(255,255,255,0.15);\n  --cat-bg:         rgba(255,255,255,0.04);\n  --cat-fg:         rgba(255,255,255,0.25);\n  --kbd-fg:         rgba(255,255,255,0.18);\n  --kbd-bg:         rgba(255,255,255,0.06);\n  --kbd-bd:         rgba(255,255,255,0.10);\n  --hist-fg:        rgba(255,255,255,0.20);\n  --dot-off:        rgba(255,255,255,0.10);\n  --orb1:           rgba(255,107,0,0.12);\n  --orb2:           rgba(255,107,0,0.07);\n  --trk-bg:         #2E2E2E;\n  --trk-bd:         rgba(255,255,255,0.10);\n  --thm-bg:         #F5F2EE;\n  --noise-op:       0.55;\n  --t:              0.4s ease;\n  --card-w:         min(680px, 92vw);\n}\n\n/* ── LIGHT token set ── */\n#hicq-root[data-theme=\"light\"] {\n  --bg:             #EDE9E3;\n  --fg:             #0A0A0A;\n  --sub-fg:         #777;\n  --logo-fg:        #999;\n  --card-bg:        #FFFFFF;\n  --card-border:    rgba(0,0,0,0.07);\n  --card-shadow:    0 24px 64px rgba(0,0,0,0.13),0 0 0 1px rgba(255,107,0,.12);\n  --card-glow:      rgba(255,107,0,0.04);\n  --stk1-bg:        rgba(255,107,0,0.05);\n  --stk1-bd:        rgba(255,107,0,0.18);\n  --stk2-bg:        rgba(255,107,0,0.02);\n  --stk2-bd:        rgba(255,107,0,0.09);\n  --tab-bg:         #DDD9D2;\n  --tab-bd:         rgba(0,0,0,0.08);\n  --tab-fg:         #999;\n  --tab-a-bg:       rgba(255,107,0,0.10);\n  --tab-a-fg:       #0A0A0A;\n  --btn-bd:         rgba(0,0,0,0.12);\n  --btn-fg:         #777;\n  --btn-h-bg:       rgba(255,107,0,0.07);\n  --chip-bg:        rgba(0,0,0,0.04);\n  --chip-bd:        rgba(0,0,0,0.07);\n  --chip-fg:        rgba(0,0,0,0.40);\n  --cnt-fg:         rgba(0,0,0,0.18);\n  --cat-bg:         rgba(0,0,0,0.05);\n  --cat-fg:         rgba(0,0,0,0.35);\n  --kbd-fg:         rgba(0,0,0,0.30);\n  --kbd-bg:         rgba(0,0,0,0.05);\n  --kbd-bd:         rgba(0,0,0,0.12);\n  --hist-fg:        rgba(0,0,0,0.28);\n  --dot-off:        rgba(0,0,0,0.10);\n  --orb1:           rgba(255,107,0,0.09);\n  --orb2:           rgba(255,107,0,0.05);\n  --trk-bg:         #C8C3BC;\n  --trk-bd:         rgba(0,0,0,0.10);\n  --thm-bg:         #0A0A0A;\n  --noise-op:       0.18;\n}\n\n/* ── ROOT WRAPPER ── */\n#hicq-root {\n  display: block !important;\n  position: relative !important;\n  width: 100% !important;\n  overflow: hidden !important;\n  background: var(--bg) !important;\n  color: var(--fg) !important;\n  font-family: 'Barlow', sans-serif !important;\n  transition: background var(--t), color var(--t);\n  /* pull to full bleed if inside a narrow Shopify container */\n  margin-left: calc(50% - 50vw) !important;\n  margin-right: calc(50% - 50vw) !important;\n  width: 100vw !important;\n}\n\n/* Noise texture */\n#hicq-root::before {\n  content: '' !important;\n  position: absolute !important;\n  inset: 0 !important;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E\") !important;\n  pointer-events: none !important;\n  z-index: 0 !important;\n  opacity: var(--noise-op) !important;\n  transition: opacity var(--t) !important;\n}\n\n/* Background orbs */\n#hicq-root .hiq-orb {\n  position: absolute !important;\n  border-radius: 50% !important;\n  filter: blur(110px) !important;\n  pointer-events: none !important;\n  z-index: 0 !important;\n  animation: hiq-drift 18s ease-in-out infinite alternate !important;\n}\n#hicq-root .hiq-orb-1 {\n  width: 480px !important; height: 480px !important;\n  background: radial-gradient(circle, var(--orb1) 0%, transparent 70%) !important;\n  top: -80px !important; left: -80px !important;\n}\n#hicq-root .hiq-orb-2 {\n  width: 380px !important; height: 380px !important;\n  background: radial-gradient(circle, var(--orb2) 0%, transparent 70%) !important;\n  bottom: -40px !important; right: -40px !important;\n  animation-delay: -9s !important;\n  animation-duration: 22s !important;\n}\n@keyframes hiq-drift {\n  from { transform: translate(0,0) scale(1); }\n  to   { transform: translate(40px,30px) scale(1.1); }\n}\n\n/* ── PAGE INNER ── */\n#hicq-root .hiq-wrap {\n  position: relative !important;\n  z-index: 1 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  padding: 64px 24px 84px !important;\n  max-width: 100% !important;\n}\n\n/* ── HEADER ── */\n#hicq-root .hiq-header {\n  width: 100% !important;\n  max-width: 780px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: flex-start !important;\n  gap: 12px !important;\n  margin-bottom: 52px !important;\n  animation: hiq-fadeup 0.8s cubic-bezier(.22,.68,0,1.2) both !important;\n}\n\n#hicq-root .hiq-logo {\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n  margin-bottom: 8px !important;\n}\n#hicq-root .hiq-diamond {\n  width: 36px !important; height: 36px !important;\n  background: var(--hi-orange) !important;\n  clip-path: polygon(50% 0%,100% 50%,50% 100%,0% 50%) !important;\n  flex-shrink: 0 !important;\n  animation: hiq-spin 12s linear infinite !important;\n}\n@keyframes hiq-spin { to { transform: rotate(360deg); } }\n\n#hicq-root .hiq-logo-txt {\n  font-family: 'Bebas Neue', sans-serif !important;\n  font-size: 1.1rem !important;\n  letter-spacing: 0.18em !important;\n  color: var(--logo-fg) !important;\n  text-transform: uppercase !important;\n  line-height: 1 !important;\n  transition: color var(--t) !important;\n}\n\n#hicq-root .hiq-headline {\n  font-family: 'Bebas Neue', sans-serif !important;\n  font-size: clamp(3.2rem, 9vw, 6.4rem) !important;\n  line-height: 0.92 !important;\n  letter-spacing: 0.02em !important;\n  color: var(--fg) !important;\n  text-transform: uppercase !important;\n  font-weight: 400 !important;\n  transition: color var(--t) !important;\n}\n#hicq-root .hiq-headline span {\n  color: var(--hi-orange) !important;\n  display: inline-block !important;\n}\n#hicq-root .hiq-sub {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 1.05rem !important;\n  font-weight: 300 !important;\n  letter-spacing: 0.06em !important;\n  color: var(--sub-fg) !important;\n  text-transform: uppercase !important;\n  max-width: 500px !important;\n  line-height: 1.4 !important;\n  transition: color var(--t) !important;\n}\n\n/* ── CONTROLS ── */\n#hicq-root .hiq-controls {\n  width: 100% !important;\n  max-width: 780px !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 12px !important;\n  margin-bottom: 36px !important;\n  flex-wrap: wrap !important;\n  animation: hiq-fadeup 0.9s cubic-bezier(.22,.68,0,1.2) 0.1s both !important;\n}\n\n#hicq-root .hiq-tabs {\n  display: flex !important;\n  background: var(--tab-bg) !important;\n  border: 1px solid var(--tab-bd) !important;\n  border-radius: 2px !important;\n  overflow: hidden !important;\n  transition: background var(--t), border-color var(--t) !important;\n}\n#hicq-root .hiq-tab {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.85rem !important;\n  font-weight: 600 !important;\n  letter-spacing: 0.12em !important;\n  text-transform: uppercase !important;\n  padding: 10px 22px !important;\n  border: none !important;\n  background: transparent !important;\n  color: var(--tab-fg) !important;\n  cursor: pointer !important;\n  transition: all 0.25s ease !important;\n  position: relative !important;\n  line-height: 1 !important;\n}\n#hicq-root .hiq-tab::after {\n  content: '' !important;\n  position: absolute !important;\n  bottom: 0 !important; left: 0 !important; right: 0 !important;\n  height: 2px !important;\n  background: var(--hi-orange) !important;\n  transform: scaleX(0) !important;\n  transition: transform 0.25s ease !important;\n}\n#hicq-root .hiq-tab.active {\n  color: var(--tab-a-fg) !important;\n  background: var(--tab-a-bg) !important;\n}\n#hicq-root .hiq-tab.active::after { transform: scaleX(1) !important; }\n#hicq-root .hiq-tab:hover:not(.active) { color: var(--tab-a-fg) !important; }\n\n/* Right controls cluster */\n#hicq-root .hiq-right {\n  margin-left: auto !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n}\n\n#hicq-root .hiq-lang {\n  display: flex !important;\n  background: var(--tab-bg) !important;\n  border: 1px solid var(--tab-bd) !important;\n  border-radius: 2px !important;\n  overflow: hidden !important;\n  transition: background var(--t), border-color var(--t) !important;\n}\n#hicq-root .hiq-lang-btn {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.78rem !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.16em !important;\n  text-transform: uppercase !important;\n  padding: 10px 16px !important;\n  border: none !important;\n  background: transparent !important;\n  color: var(--tab-fg) !important;\n  cursor: pointer !important;\n  transition: all 0.2s ease !important;\n  line-height: 1 !important;\n}\n#hicq-root .hiq-lang-btn.active {\n  background: var(--hi-orange) !important;\n  color: #000 !important;\n}\n\n/* Theme switch */\n#hicq-root .hiq-switch {\n  position: relative !important;\n  width: 56px !important; height: 28px !important;\n  background: var(--trk-bg) !important;\n  border: 1px solid var(--trk-bd) !important;\n  border-radius: 14px !important;\n  cursor: pointer !important;\n  padding: 0 !important;\n  flex-shrink: 0 !important;\n  outline: none !important;\n  overflow: hidden !important;\n  display: flex !important;\n  align-items: center !important;\n  transition: background 0.35s ease, border-color 0.35s ease !important;\n}\n#hicq-root .hiq-switch:focus-visible {\n  outline: 2px solid var(--hi-orange) !important;\n  outline-offset: 2px !important;\n}\n#hicq-root .hiq-thumb {\n  position: absolute !important;\n  left: 3px !important;\n  width: 20px !important; height: 20px !important;\n  border-radius: 50% !important;\n  background: var(--thm-bg) !important;\n  box-shadow: 0 1px 4px rgba(0,0,0,0.3) !important;\n  z-index: 2 !important;\n  transition: transform 0.35s cubic-bezier(.22,.68,0,1.2), background 0.35s ease !important;\n  margin: 0 !important; padding: 0 !important;\n}\n#hicq-root[data-theme=\"light\"] .hiq-thumb { transform: translateX(28px) !important; }\n#hicq-root .hiq-sw-icon {\n  position: absolute !important;\n  font-size: 0.68rem !important;\n  line-height: 1 !important;\n  user-select: none !important;\n  pointer-events: none !important;\n  transition: opacity 0.3s ease !important;\n}\n#hicq-root .hiq-sw-icon.moon { right: 7px !important; opacity: 1 !important; }\n#hicq-root .hiq-sw-icon.sun  { left:  7px !important; opacity: 0 !important; }\n#hicq-root[data-theme=\"light\"] .hiq-sw-icon.moon { opacity: 0 !important; }\n#hicq-root[data-theme=\"light\"] .hiq-sw-icon.sun  { opacity: 1 !important; }\n\n/* ── CARD STAGE ── */\n#hicq-root .hiq-stage {\n  width: var(--card-w) !important;\n  position: relative !important;\n  perspective: 1200px !important;\n  margin-bottom: 44px !important;\n  animation: hiq-fadeup 1s cubic-bezier(.22,.68,0,1.2) 0.2s both !important;\n}\n\n#hicq-root .hiq-shadow {\n  position: absolute !important;\n  inset: 0 !important;\n  border-radius: 4px !important;\n  transition: transform 0.5s cubic-bezier(.22,.68,0,1.2), background var(--t), border-color var(--t) !important;\n}\n#hicq-root .hiq-shadow-1 {\n  background: var(--stk1-bg) !important;\n  border: 1px solid var(--stk1-bd) !important;\n  transform: translateY(10px) scale(0.97) !important;\n  z-index: 1 !important;\n}\n#hicq-root .hiq-shadow-2 {\n  background: var(--stk2-bg) !important;\n  border: 1px solid var(--stk2-bd) !important;\n  transform: translateY(20px) scale(0.94) !important;\n  z-index: 0 !important;\n}\n#hicq-root .hiq-stage:hover .hiq-shadow-1 { transform: translateY(14px) scale(0.97) !important; }\n#hicq-root .hiq-stage:hover .hiq-shadow-2 { transform: translateY(26px) scale(0.94) !important; }\n\n#hicq-root .hiq-card {\n  position: relative !important;\n  z-index: 2 !important;\n  background: var(--card-bg) !important;\n  border: 1px solid var(--card-border) !important;\n  border-radius: 4px !important;\n  padding: 52px 52px 44px !important;\n  min-height: 320px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 28px !important;\n  overflow: hidden !important;\n  transition: box-shadow 0.3s ease, background var(--t), border-color var(--t) !important;\n}\n#hicq-root .hiq-card:hover { box-shadow: var(--card-shadow) !important; }\n\n/* Orange bar top */\n#hicq-root .hiq-card::before {\n  content: '' !important;\n  position: absolute !important;\n  top: 0 !important; left: 0 !important;\n  width: 80px !important; height: 4px !important;\n  background: var(--hi-orange) !important;\n}\n/* Inner glow */\n#hicq-root .hiq-card::after {\n  content: '' !important;\n  position: absolute !important;\n  inset: 0 !important;\n  background: radial-gradient(ellipse at top left, var(--card-glow) 0%, transparent 60%) !important;\n  opacity: 0 !important;\n  transition: opacity 0.4s ease !important;\n  pointer-events: none !important;\n}\n#hicq-root .hiq-card:hover::after { opacity: 1 !important; }\n\n#hicq-root .hiq-tag {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.72rem !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.22em !important;\n  text-transform: uppercase !important;\n  color: var(--hi-orange) !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n  line-height: 1 !important;\n}\n#hicq-root .hiq-tag::after {\n  content: '' !important;\n  flex: 1 !important;\n  height: 1px !important;\n  background: rgba(255,107,0,0.2) !important;\n}\n\n#hicq-root .hiq-question {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: clamp(1.55rem, 4vw, 2.2rem) !important;\n  font-weight: 600 !important;\n  line-height: 1.22 !important;\n  letter-spacing: 0.01em !important;\n  color: var(--fg) !important;\n  flex: 1 !important;\n  transition: color var(--t) !important;\n}\n\n#hicq-root .hiq-meta {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n}\n#hicq-root .hiq-counter {\n  font-family: 'Bebas Neue', sans-serif !important;\n  font-size: 1rem !important;\n  letter-spacing: 0.15em !important;\n  color: var(--cnt-fg) !important;\n  font-weight: 400 !important;\n  line-height: 1 !important;\n  transition: color var(--t) !important;\n}\n#hicq-root .hiq-cat {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.72rem !important;\n  letter-spacing: 0.14em !important;\n  text-transform: uppercase !important;\n  color: var(--cat-fg) !important;\n  background: var(--cat-bg) !important;\n  padding: 5px 12px !important;\n  border-radius: 2px !important;\n  transition: color var(--t), background var(--t) !important;\n  line-height: 1.4 !important;\n}\n\n/* Card animations */\n@keyframes hiq-card-right {\n  from { opacity: 0; transform: translateX(60px) rotateY(-8deg) scale(0.95); }\n  to   { opacity: 1; transform: none; }\n}\n@keyframes hiq-card-left {\n  from { opacity: 0; transform: translateX(-60px) rotateY(8deg) scale(0.95); }\n  to   { opacity: 1; transform: none; }\n}\n#hicq-root .hiq-card.anim-right { animation: hiq-card-right 0.5s cubic-bezier(.22,.68,0,1.2) both !important; }\n#hicq-root .hiq-card.anim-left  { animation: hiq-card-left  0.5s cubic-bezier(.22,.68,0,1.2) both !important; }\n\n/* ── ACTION BAR ── */\n#hicq-root .hiq-actions {\n  display: flex !important;\n  align-items: center !important;\n  gap: 16px !important;\n  animation: hiq-fadeup 1.1s cubic-bezier(.22,.68,0,1.2) 0.3s both !important;\n}\n\n#hicq-root .hiq-btn-main {\n  font-family: 'Bebas Neue', sans-serif !important;\n  font-size: 1.15rem !important;\n  letter-spacing: 0.18em !important;\n  text-transform: uppercase !important;\n  padding: 18px 48px !important;\n  background: var(--hi-orange) !important;\n  color: #000 !important;\n  border: none !important;\n  border-radius: 2px !important;\n  cursor: pointer !important;\n  position: relative !important;\n  overflow: hidden !important;\n  transition: transform 0.2s ease, box-shadow 0.2s ease !important;\n  line-height: 1 !important;\n}\n#hicq-root .hiq-btn-main::before {\n  content: '' !important;\n  position: absolute !important;\n  inset: 0 !important;\n  background: rgba(255,255,255,0.15) !important;\n  transform: translateX(-110%) skewX(-15deg) !important;\n  transition: transform 0.5s cubic-bezier(.22,.68,0,1.2) !important;\n}\n#hicq-root .hiq-btn-main:hover::before { transform: translateX(110%) skewX(-15deg) !important; }\n#hicq-root .hiq-btn-main:hover { transform: translateY(-2px) !important; box-shadow: 0 12px 40px rgba(255,107,0,0.35) !important; }\n#hicq-root .hiq-btn-main:active { transform: translateY(0) !important; }\n\n#hicq-root .hiq-btn-icon {\n  width: 52px !important; height: 52px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  background: transparent !important;\n  border: 1px solid var(--btn-bd) !important;\n  border-radius: 2px !important;\n  color: var(--btn-fg) !important;\n  cursor: pointer !important;\n  font-size: 1.2rem !important;\n  transition: all 0.2s ease !important;\n  line-height: 1 !important;\n}\n#hicq-root .hiq-btn-icon:hover {\n  border-color: var(--hi-orange) !important;\n  color: var(--hi-orange) !important;\n  background: var(--btn-h-bg) !important;\n}\n#hicq-root .hiq-btn-icon:active { transform: scale(0.93) !important; }\n#hicq-root .hiq-btn-icon.copied {\n  border-color: var(--hi-orange) !important;\n  color: var(--hi-orange) !important;\n}\n\n/* Progress dots */\n#hicq-root .hiq-dots {\n  display: flex !important;\n  gap: 6px !important;\n  align-items: center !important;\n  margin-top: 20px !important;\n}\n#hicq-root .hiq-dot {\n  width: 6px !important; height: 6px !important;\n  border-radius: 50% !important;\n  background: var(--dot-off) !important;\n  transition: all 0.3s ease !important;\n  padding: 0 !important;\n}\n#hicq-root .hiq-dot.active {\n  background: var(--hi-orange) !important;\n  transform: scale(1.4) !important;\n}\n\n/* History */\n#hicq-root .hiq-history {\n  width: 100% !important;\n  max-width: 780px !important;\n  margin-top: 36px !important;\n  animation: hiq-fadeup 1.2s cubic-bezier(.22,.68,0,1.2) 0.4s both !important;\n}\n#hicq-root .hiq-hist-label {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.72rem !important;\n  letter-spacing: 0.2em !important;\n  text-transform: uppercase !important;\n  color: var(--hist-fg) !important;\n  margin-bottom: 12px !important;\n  line-height: 1 !important;\n  display: block !important;\n  transition: color var(--t) !important;\n}\n#hicq-root .hiq-chips {\n  display: flex !important;\n  gap: 8px !important;\n  flex-wrap: wrap !important;\n}\n#hicq-root .hiq-chip {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.78rem !important;\n  letter-spacing: 0.04em !important;\n  color: var(--chip-fg) !important;\n  background: var(--chip-bg) !important;\n  border: 1px solid var(--chip-bd) !important;\n  border-radius: 2px !important;\n  padding: 5px 12px !important;\n  max-width: 220px !important;\n  overflow: hidden !important;\n  text-overflow: ellipsis !important;\n  white-space: nowrap !important;\n  animation: hiq-chip-in 0.3s ease both !important;\n  transition: color var(--t), background var(--t), border-color var(--t) !important;\n  line-height: 1.4 !important;\n  display: inline-block !important;\n}\n@keyframes hiq-chip-in {\n  from { opacity: 0; transform: scale(0.85) translateY(4px); }\n  to   { opacity: 1; transform: none; }\n}\n\n/* Keyboard hint */\n#hicq-root .hiq-kbd-hint {\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.72rem !important;\n  letter-spacing: 0.1em !important;\n  text-transform: uppercase !important;\n  color: var(--kbd-fg) !important;\n  margin-top: 28px !important;\n  text-align: center !important;\n  animation: hiq-fadeup 1.3s cubic-bezier(.22,.68,0,1.2) 0.5s both !important;\n  transition: color var(--t) !important;\n  display: block !important;\n}\n#hicq-root .hiq-kbd-hint kbd {\n  background: var(--kbd-bg) !important;\n  border: 1px solid var(--kbd-bd) !important;\n  border-radius: 3px !important;\n  padding: 2px 7px !important;\n  font-family: 'Barlow Condensed', sans-serif !important;\n  font-size: 0.72rem !important;\n  transition: background var(--t), border-color var(--t) !important;\n}\n\n/* Shared fade-up */\n@keyframes hiq-fadeup {\n  from { opacity: 0; transform: translateY(28px); }\n  to   { opacity: 1; transform: none; }\n}\n\n/* Responsive */\n@media (max-width: 600px) {\n  #hicq-root .hiq-card        { padding: 36px 28px 30px !important; min-height: 260px !important; }\n  #hicq-root .hiq-actions     { flex-wrap: wrap !important; }\n  #hicq-root .hiq-btn-main    { flex: 1 !important; text-align: center !important; }\n  #hicq-root .hiq-right       { margin-left: 0 !important; }\n  #hicq-root .hiq-controls    { flex-wrap: wrap !important; }\n}\n</style>\n\n<!-- ╔═══════════════ HTML ═══════════════╗ -->\n<div id=\"hicq-root\" data-theme=\"dark\">\n  <div class=\"hiq-orb hiq-orb-1\"></div>\n  <div class=\"hiq-orb hiq-orb-2\"></div>\n\n  <div class=\"hiq-wrap\">\n\n    <!-- Header -->\n    <header class=\"hiq-header\">\n      <div class=\"hiq-logo\">\n        <div class=\"hiq-diamond\"></div>\n        <span class=\"hiq-logo-txt\">Hyper Island</span>\n      </div>\n      <h2 class=\"hiq-headline\" id=\"hiq-headline\">CHECK-IN &amp;<br><span>CHECK-OUT</span>\n</h2>\n      <p class=\"hiq-sub\" id=\"hiq-sub\">Perguntas que abrem e fecham conversas que importam</p>\n    </header>\n\n    <!-- Controls -->\n    <div class=\"hiq-controls\">\n      <div class=\"hiq-tabs\" role=\"tablist\">\n        <button class=\"hiq-tab active\" id=\"hiq-tab-all\" onclick=\"hiqSetMode('all')\" role=\"tab\"><span id=\"hiq-tab-all-lbl\">Todas</span></button>\n        <button class=\"hiq-tab\" id=\"hiq-tab-checkin\" onclick=\"hiqSetMode('checkin')\" role=\"tab\">Check-in</button>\n        <button class=\"hiq-tab\" id=\"hiq-tab-checkout\" onclick=\"hiqSetMode('checkout')\" role=\"tab\">Check-out</button>\n      </div>\n      <div class=\"hiq-right\">\n        <div class=\"hiq-lang\" role=\"group\" aria-label=\"Idioma\">\n          <button class=\"hiq-lang-btn active\" id=\"hiq-btn-pt\" onclick=\"hiqSetLang('pt')\" aria-label=\"Português\">PT</button>\n          <button class=\"hiq-lang-btn\" id=\"hiq-btn-en\" onclick=\"hiqSetLang('en')\" aria-label=\"English\">EN</button>\n        </div>\n        <button class=\"hiq-switch\" onclick=\"hiqToggleTheme()\" aria-label=\"Alternar tema\">\n          <span class=\"hiq-thumb\"></span>\n          <span class=\"hiq-sw-icon moon\">☾</span>\n          <span class=\"hiq-sw-icon sun\">☀</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Card stage -->\n    <div class=\"hiq-stage\" id=\"hiq-stage\">\n      <div class=\"hiq-shadow hiq-shadow-2\"></div>\n      <div class=\"hiq-shadow hiq-shadow-1\"></div>\n      <div class=\"hiq-card\" id=\"hiq-card\">\n        <div class=\"hiq-tag\" id=\"hiq-tag\">Check-in</div>\n        <div class=\"hiq-question\" id=\"hiq-question\">Carregando sua pergunta…</div>\n        <div class=\"hiq-meta\">\n          <span class=\"hiq-counter\" id=\"hiq-counter\">001 / 99</span>\n          <span class=\"hiq-cat\" id=\"hiq-cat\">Reflexão</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Actions -->\n    <div class=\"hiq-actions\">\n      <button class=\"hiq-btn-icon\" id=\"hiq-shuffle\" onclick=\"hiqShuffle()\" title=\"Embaralhar\" aria-label=\"Embaralhar\">⇅</button>\n      <button class=\"hiq-btn-main\" onclick=\"hiqNext()\"><span id=\"hiq-btn-lbl\">Próxima Pergunta</span></button>\n      <button class=\"hiq-btn-icon\" id=\"hiq-copy\" onclick=\"hiqCopy()\" title=\"Copiar pergunta\" aria-label=\"Copiar\">❐</button>\n    </div>\n\n    <!-- Dots -->\n    <div class=\"hiq-dots\" id=\"hiq-dots\"></div>\n\n    <!-- History -->\n    <div class=\"hiq-history\">\n      <span class=\"hiq-hist-label\" id=\"hiq-hist-lbl\">Últimas perguntas</span>\n      <div class=\"hiq-chips\" id=\"hiq-chips\"></div>\n    </div>\n\n    <!-- Keyboard hint -->\n    <span class=\"hiq-kbd-hint\" id=\"hiq-kbd\">\n      Pressione <kbd>→</kbd> para avançar  ·  <kbd>Space</kbd> para aleatória\n    </span>\n\n  </div>\n<!-- /hiq-wrap -->\n</div><!-- /hicq-root -->\n\n<script>\n(function(){\n// ── questions ──\nvar Q=[\n  {t:'checkin',  c:{pt:'Clima',en:'Weather'},      pt:'Se o seu estado mental agora fosse uma condição climática, qual seria?',                              en:'If your current mental state were a weather condition, what would it be?'},\n  {t:'checkin',  c:{pt:'Energia',en:'Energy'},      pt:'Em uma escala de 0 a 10, onde está a sua energia agora — e o que explica esse número?',               en:'On a scale of 0 to 10, where is your energy right now — and what explains that number?'},\n  {t:'checkin',  c:{pt:'Palavra',en:'Word'},         pt:'Escolha uma única palavra que represente como você chegou hoje nessa sala.',                           en:'Choose a single word that represents how you arrived in this room today.'},\n  {t:'checkin',  c:{pt:'Cor',en:'Color'},            pt:'Se a sua semana fosse uma cor, qual seria — e por quê essa e não outra?',                              en:'If your week were a color, which would it be — and why that one and not another?'},\n  {t:'checkin',  c:{pt:'Presença',en:'Presence'},    pt:'O que você precisa deixar do lado de fora dessa sala para estar 100% presente agora?',                en:'What do you need to leave outside this room to be 100% present right now?'},\n  {t:'checkin',  c:{pt:'Animal',en:'Animal'},        pt:'Que animal representa o seu ritmo nesse momento — e por quê?',                                        en:'What animal represents your current pace — and why?'},\n  {t:'checkin',  c:{pt:'Intenção',en:'Intention'},   pt:'Qual é a única coisa que tornaria esse encontro genuinamente valioso para você?',                     en:'What is the one thing that would make this meeting truly valuable for you?'},\n  {t:'checkin',  c:{pt:'Superpoder',en:'Superpower'},pt:'Se você pudesse trazer um superpoder para esse encontro, qual seria?',                                 en:'If you could bring one superpower to this meeting, what would it be?'},\n  {t:'checkin',  c:{pt:'Curiosidade',en:'Curiosity'},pt:'Qual pergunta você não conseguiu tirar da cabeça esta semana?',                                        en:'What question have you not been able to get out of your head this week?'},\n  {t:'checkin',  c:{pt:'Música',en:'Music'},         pt:'Qual seria a trilha sonora perfeita para o seu estado de espírito agora?',                             en:'What would be the perfect soundtrack for your mood right now?'},\n  {t:'checkin',  c:{pt:'Metáfora',en:'Metaphor'},    pt:'Você está mais como um rio correndo rápido, um lago tranquilo ou um oceano agitado?',                 en:'Are you more like a fast-flowing river, a calm lake, or a choppy ocean right now?'},\n  {t:'checkin',  c:{pt:'Presença',en:'Presence'},    pt:'O que você está trazendo de energia para esse grupo hoje?',                                            en:'What energy are you bringing to this group today?'},\n  {t:'checkin',  c:{pt:'Descoberta',en:'Discovery'}, pt:'O que você descobriu sobre si mesmo(a) nas últimas 48 horas?',                                        en:'What did you discover about yourself in the last 48 hours?'},\n  {t:'checkin',  c:{pt:'Corpo',en:'Body'},            pt:'Onde no seu corpo você sente mais tensão agora — e o que ela está tentando te dizer?',                en:'Where in your body are you feeling the most tension right now — and what is it trying to tell you?'},\n  {t:'checkin',  c:{pt:'Conexão',en:'Connection'},   pt:'O que faz você se sentir mais conectado(a) com as pessoas ao seu redor?',                             en:'What makes you feel most connected to the people around you?'},\n  {t:'checkin',  c:{pt:'Foco',en:'Focus'},            pt:'Se você jogasse fora 80% das suas preocupações de hoje, qual seria o 20% que ficaria?',               en:'If you threw away 80% of today\\'s worries, what would be the 20% you keep?'},\n  {t:'checkin',  c:{pt:'Bateria',en:'Battery'},       pt:'Que tipo de bateria está te alimentando hoje — solar, elétrica ou pilha AA quase no fim?',            en:'What kind of battery is powering you today — solar, electric, or an almost-dead AA?'},\n  {t:'checkin',  c:{pt:'Intenção',en:'Intention'},   pt:'Que versão de você quer aparecer nessa conversa hoje?',                                                en:'Which version of yourself do you want to show up as in this conversation today?'},\n  {t:'checkin',  c:{pt:'Abertura',en:'Openness'},     pt:'Qual é a crença que você está disposto(a) a questionar hoje?',                                        en:'What is a belief you are willing to challenge today?'},\n  {t:'checkin',  c:{pt:'Surpresa',en:'Surprise'},     pt:'O que te surpreendeu positivamente nos últimos dias?',                                                en:'What surprised you positively in the last few days?'},\n  {t:'checkin',  c:{pt:'Fome',en:'Hunger'},           pt:'O que você está com \"fome\" de aprender, fazer ou experimentar neste momento da vida?',                en:'What are you \"hungry\" to learn, do, or experience at this point in your life?'},\n  {t:'checkin',  c:{pt:'Símbolo',en:'Symbol'},        pt:'Que objeto na sua casa representa como você está se sentindo agora — e por quê?',                     en:'What object in your home represents how you are feeling right now — and why?'},\n  {t:'checkin',  c:{pt:'Embalagem',en:'Package'},     pt:'Se você fosse um pacote chegando pelo correio, qual seria o conteúdo e como estaria embalado?',       en:'If you were a package arriving in the mail, what would be inside and how would it be wrapped?'},\n  {t:'checkin',  c:{pt:'Velocidade',en:'Speed'},      pt:'Você está em modo \"sprint\", \"caminhada\" ou \"pausa\" — e está satisfeito(a) com isso?',                 en:'Are you in \"sprint\", \"walk\", or \"pause\" mode right now — and are you okay with that?'},\n  {t:'checkin',  c:{pt:'Gratidão',en:'Gratitude'},    pt:'O que é uma coisa pequena pela qual você é genuinamente grato(a) hoje?',                              en:'What is one small thing you are genuinely grateful for today?'},\n  {t:'checkin',  c:{pt:'Personagem',en:'Character'},  pt:'Que personagem fictício melhor descreve onde você está mentalmente agora?',                           en:'What fictional character best describes where you are mentally right now?'},\n  {t:'checkin',  c:{pt:'Zona',en:'Zone'},             pt:'Você está na zona de conforto, de aprendizado ou de pânico agora?',                                   en:'Are you in your comfort zone, learning zone, or panic zone right now?'},\n  {t:'checkin',  c:{pt:'Título',en:'Title'},          pt:'Se a sua semana fosse um episódio de série, qual seria o título desse episódio?',                     en:'If your week were a TV episode, what would the episode title be?'},\n  {t:'checkin',  c:{pt:'Temperatura',en:'Temp'},      pt:'Em graus, qual é a temperatura da sua motivação hoje — e o que faria ela subir um grau?',             en:'In degrees, what is the temperature of your motivation today — and what would raise it one degree?'},\n  {t:'checkin',  c:{pt:'Cardápio',en:'Menu'},         pt:'Se o seu estado de espírito hoje fosse um prato, o que seria e como estaria servido?',                en:'If your mood today were a dish of food, what would it be and how would it be served?'},\n  {t:'checkin',  c:{pt:'Silêncio',en:'Silence'},      pt:'Qual parte de você está quieta hoje que normalmente fala alto?',                                      en:'What part of you is quiet today that usually speaks loudly?'},\n  {t:'checkin',  c:{pt:'Clareza',en:'Clarity'},       pt:'O que está claro para você hoje que estava nebuloso na semana passada?',                              en:'What is clear to you today that was foggy last week?'},\n  {t:'checkin',  c:{pt:'Risco',en:'Risk'},            pt:'Qual risco você está disposto(a) a correr nessa conversa?',                                           en:'What risk are you willing to take in this conversation?'},\n  {t:'checkin',  c:{pt:'Limite',en:'Boundary'},       pt:'Qual limite você quer expandir nessa reunião?',                                                       en:'What boundary do you want to expand in this meeting?'},\n  {t:'checkin',  c:{pt:'Mapa',en:'Map'},              pt:'Você sabe onde está no mapa agora — ou está navegando sem GPS?',                                      en:'Do you know where you are on the map right now — or are you navigating without GPS?'},\n  {t:'checkin',  c:{pt:'Luz',en:'Light'},             pt:'O que está iluminando o seu caminho essa semana?',                                                    en:'What is lighting your path this week?'},\n  {t:'checkin',  c:{pt:'Versão',en:'Version'},        pt:'Em qual \"versão\" de você mesmo(a) você está operando hoje?',                                          en:'Which \"version\" of yourself are you operating as today?'},\n  {t:'checkin',  c:{pt:'Peso',en:'Weight'},           pt:'O que está pesando em você agora — e você consegue soltar por um momento?',                           en:'What is weighing on you right now — and can you set it down for a moment?'},\n  {t:'checkin',  c:{pt:'Horizonte',en:'Horizon'},     pt:'O que você está vendo no horizonte que os outros talvez ainda não vejam?',                            en:'What are you seeing on the horizon that others might not yet see?'},\n  {t:'checkin',  c:{pt:'Estação',en:'Season'},        pt:'Em qual estação do ano a sua vida está agora — e o que essa estação pede de você?',                   en:'What season of the year is your life in right now — and what does that season ask of you?'},\n  {t:'checkin',  c:{pt:'Volume',en:'Volume'},         pt:'Se você colocasse um volume na sua mente neste momento, seria 1 ou 10?',                              en:'If you put a volume level on your mind right now, would it be 1 or 10?'},\n  {t:'checkin',  c:{pt:'Âncora',en:'Anchor'},         pt:'O que te ancora quando tudo parece incerto?',                                                         en:'What anchors you when everything feels uncertain?'},\n  {t:'checkin',  c:{pt:'Ritmo',en:'Pace'},            pt:'Você precisaria desacelerar ou acelerar para estar totalmente presente agora?',                       en:'Would you need to slow down or speed up to be fully present right now?'},\n  {t:'checkin',  c:{pt:'Pergunta',en:'Question'},     pt:'Qual pergunta você traria para esse grupo se soubesse que seria bem recebida?',                       en:'What question would you bring to this group if you knew it would be well received?'},\n  {t:'checkin',  c:{pt:'Ousadia',en:'Boldness'},      pt:'Qual é a coisa mais ousada que você poderia contribuir aqui hoje?',                                   en:'What is the boldest contribution you could make here today?'},\n  {t:'checkin',  c:{pt:'Escolha',en:'Choice'},        pt:'Qual pequena escolha você faria diferente para começar essa reunião do jeito certo?',                 en:'What small choice would you make differently to start this meeting on the right note?'},\n  {t:'checkin',  c:{pt:'Não-dito',en:'Unsaid'},       pt:'O que não foi dito ainda — mas precisa entrar no espaço dessa conversa?',                            en:'What has not been said yet — but needs to enter the space of this conversation?'},\n  {t:'checkin',  c:{pt:'Radar',en:'Radar'},           pt:'O que está no seu radar hoje que não estava ontem?',                                                  en:'What is on your radar today that was not there yesterday?'},\n  {t:'checkin',  c:{pt:'Combustível',en:'Fuel'},      pt:'Que combustível você precisa para atravessar esse encontro com energia?',                             en:'What fuel do you need to get through this meeting with energy?'},\n  {t:'checkin',  c:{pt:'Jornada',en:'Journey'},       pt:'Se você fosse um herói épico agora, em qual fase da jornada estaria?',                                en:'If you were an epic hero right now, at which stage of the journey would you be?'},\n  {t:'checkout', c:{pt:'Aprendizado',en:'Learning'},  pt:'O que você vai levar dessa conversa que não sabia antes de entrar aqui?',                             en:'What will you take from this conversation that you did not know before you walked in?'},\n  {t:'checkout', c:{pt:'Palavra',en:'Word'},          pt:'Em uma palavra: como você sai daqui em relação a como entrou?',                                       en:'In one word: how are you leaving compared to how you arrived?'},\n  {t:'checkout', c:{pt:'Ação',en:'Action'},           pt:'Qual é a primeira coisa que você vai fazer com o que foi discutido aqui?',                            en:'What is the first thing you will do with what was discussed here?'},\n  {t:'checkout', c:{pt:'Insight',en:'Insight'},       pt:'Qual foi o momento dessa reunião que você nunca vai esquecer — e por quê?',                           en:'What was the moment from this meeting you will never forget — and why?'},\n  {t:'checkout', c:{pt:'Presente',en:'Gift'},         pt:'Que presente inesperado essa conversa te deu?',                                                       en:'What unexpected gift did this conversation give you?'},\n  {t:'checkout', c:{pt:'Incompleto',en:'Incomplete'}, pt:'O que ficou por dizer — e precisa ser dito?',                                                         en:'What went unsaid — and needs to be said?'},\n  {t:'checkout', c:{pt:'Sabor',en:'Flavor'},          pt:'Se essa reunião fosse um prato de comida, como você avaliaria o sabor?',                              en:'If this meeting were a dish of food, how would you rate the flavor?'},\n  {t:'checkout', c:{pt:'Mudança',en:'Change'},        pt:'O que mudou no seu ponto de vista entre o início e o fim dessa conversa?',                            en:'What shifted in your perspective between the start and end of this conversation?'},\n  {t:'checkout', c:{pt:'Compromisso',en:'Commit'},    pt:'Que compromisso você faz — com você ou com o grupo — antes de sair daqui?',                           en:'What commitment do you make — to yourself or to the group — before leaving?'},\n  {t:'checkout', c:{pt:'Próximo Passo',en:'Next Step'},pt:'Qual é o primeiro passo, mesmo que pequeno, que você vai dar nas próximas 24h?',                     en:'What is the first step, however small, you will take in the next 24 hours?'},\n  {t:'checkout', c:{pt:'Energia',en:'Energy'},        pt:'Sua energia aumentou ou diminuiu nessa reunião — e o que contribuiu para isso?',                      en:'Did your energy increase or decrease during this meeting — and what contributed to that?'},\n  {t:'checkout', c:{pt:'Desconforto',en:'Discomfort'},pt:'O que te desconfortou de um jeito produtivo nessa conversa?',                                         en:'What made you uncomfortably productive in this conversation?'},\n  {t:'checkout', c:{pt:'Essência',en:'Essence'},      pt:'Se você tivesse que resumir tudo em uma única frase, qual seria?',                                    en:'If you had to summarize everything in a single sentence, what would it be?'},\n  {t:'checkout', c:{pt:'Gratidão',en:'Gratitude'},    pt:'Pelo que ou por quem você é grato(a) nesse grupo hoje?',                                              en:'What or who are you grateful for in this group today?'},\n  {t:'checkout', c:{pt:'Conexão',en:'Connection'},    pt:'O que essa conversa revelou sobre como você trabalha junto com outras pessoas?',                      en:'What did this conversation reveal about how you work alongside others?'},\n  {t:'checkout', c:{pt:'Semente',en:'Seed'},          pt:'Que ideia foi plantada hoje que você quer regar nos próximos dias?',                                  en:'What idea was planted today that you want to nurture in the coming days?'},\n  {t:'checkout', c:{pt:'Surpresa',en:'Surprise'},     pt:'O que te surpreendeu mais nessa conversa — positiva ou negativamente?',                               en:'What surprised you most in this conversation — positively or negatively?'},\n  {t:'checkout', c:{pt:'Relação',en:'Relationship'},  pt:'O que você aprendeu sobre alguém nessa sala que não sabia antes?',                                    en:'What did you learn about someone in this room that you did not know before?'},\n  {t:'checkout', c:{pt:'Manchete',en:'Headline'},     pt:'Se essa reunião virasse manchete de jornal, qual seria o título?',                                    en:'If this meeting became a newspaper headline, what would the title be?'},\n  {t:'checkout', c:{pt:'Desafio',en:'Challenge'},     pt:'O que você vai fazer diferente na próxima vez?',                                                      en:'What will you do differently next time?'},\n  {t:'checkout', c:{pt:'Temperatura',en:'Temp'},      pt:'Como está a temperatura do grupo agora vs. o início — mais quente, igual ou mais fria?',              en:'What is the group temperature now vs. the start — warmer, the same, or cooler?'},\n  {t:'checkout', c:{pt:'Aberto',en:'Open Thread'},    pt:'Existe alguma conversa que esse encontro deixou em aberto e que precisa acontecer?',                  en:'Is there a conversation this meeting left open that still needs to happen?'},\n  {t:'checkout', c:{pt:'Espelho',en:'Mirror'},        pt:'O que você viu em alguém do grupo hoje que também existe em você?',                                   en:'What did you see in someone in the group today that also exists in you?'},\n  {t:'checkout', c:{pt:'Momento',en:'Moment'},        pt:'Qual foi o momento exato em que algo clicou para você nessa reunião?',                                en:'What was the exact moment when something clicked for you in this meeting?'},\n  {t:'checkout', c:{pt:'Futuro',en:'Future'},         pt:'Daqui a um mês, o que você vai lembrar dessa conversa?',                                              en:'One month from now, what will you remember from this conversation?'},\n  {t:'checkout', c:{pt:'Pergunta Central',en:'Key Q'},pt:'Qual foi a pergunta mais importante que surgiu — mesmo sem ter sido respondida?',                     en:'What was the most important question that emerged — even if it was not answered?'},\n  {t:'checkout', c:{pt:'Avaliação',en:'Score'},       pt:'De 0 a 10, qual foi o valor gerado nessa reunião — e o que faria subir para 10?',                     en:'From 0 to 10, what value did this meeting generate — and what would push it to 10?'},\n  {t:'checkout', c:{pt:'Eco',en:'Echo'},              pt:'O que vai continuar ecoando na sua cabeça depois daqui?',                                             en:'What will keep echoing in your head after leaving here?'},\n  {t:'checkout', c:{pt:'Lacuna',en:'Gap'},            pt:'O que você esperava que essa reunião respondesse, mas não respondeu?',                                en:'What did you hope this meeting would answer, but did not?'},\n  {t:'checkout', c:{pt:'Transformação',en:'Shift'},   pt:'Existe alguma crença que você chegou segurando e saiu disposto(a) a questionar?',                     en:'Is there a belief you arrived holding and are now willing to question?'},\n  {t:'checkout', c:{pt:'Conselho',en:'Advice'},       pt:'Se você pudesse dar um conselho para o seu \"eu do início da reunião\", qual seria?',                   en:'If you could give advice to your \"self from the start of this meeting\", what would it be?'},\n  {t:'checkout', c:{pt:'Dança',en:'Dance'},           pt:'Se essa reunião fosse uma dança, qual ritmo ela teve e quem liderou?',                                en:'If this meeting were a dance, what rhythm did it have and who led?'},\n  {t:'checkout', c:{pt:'Obra',en:'Artwork'},          pt:'Se o resultado dessa reunião fosse uma obra de arte, como você a descreveria?',                       en:'If the outcome of this meeting were a work of art, how would you describe it?'},\n  {t:'checkout', c:{pt:'Receita',en:'Recipe'},        pt:'Que ingredientes essa conversa misturou — e o que saiu do forno?',                                    en:'What ingredients did this conversation mix — and what came out of the oven?'},\n  {t:'checkout', c:{pt:'Bússola',en:'Compass'},       pt:'Sua bússola interna está apontando para onde ao sair daqui?',                                        en:'Where is your internal compass pointing as you leave here?'},\n  {t:'checkout', c:{pt:'Ciclo',en:'Cycle'},           pt:'Algum ciclo foi aberto ou fechado nessa conversa?',                                                   en:'Was any cycle opened or closed in this conversation?'},\n  {t:'checkout', c:{pt:'Escuta',en:'Listening'},      pt:'O que essa conversa te ensinou sobre como você escuta os outros?',                                    en:'What did this conversation teach you about how you listen to others?'},\n  {t:'checkout', c:{pt:'Coletivo',en:'Collective'},   pt:'Se o grupo aprendeu uma coisa coletivamente hoje, qual foi?',                                         en:'If the group learned one thing collectively today, what was it?'},\n  {t:'checkout', c:{pt:'Ferramenta',en:'Tool'},       pt:'Que ferramenta mental ou relacional você sai daqui segurando diferente?',                             en:'What mental or relational tool are you leaving here holding differently?'},\n  {t:'checkout', c:{pt:'Pedido',en:'Request'},        pt:'O que você pede para o grupo continuar fazendo — e o que pede para parar?',                           en:'What do you ask the group to keep doing — and what to stop?'},\n  {t:'checkout', c:{pt:'Invisível',en:'Invisible'},   pt:'O que foi invisível nessa conversa, mas estava presente o tempo todo?',                              en:'What was invisible in this conversation, but present the whole time?'},\n  {t:'checkout', c:{pt:'Reframing',en:'Reframe'},     pt:'O que você via como problema antes dessa conversa que agora enxerga diferente?',                     en:'What did you see as a problem before this conversation that you now see differently?'},\n  {t:'checkout', c:{pt:'Confiança',en:'Trust'},       pt:'Essa conversa aumentou, manteve ou diminuiu sua confiança no grupo?',                                en:'Did this conversation increase, maintain, or decrease your trust in the group?'},\n  {t:'checkout', c:{pt:'Janela',en:'Window'},         pt:'Qual janela essa conversa abriu — e você vai ter coragem de passar por ela?',                        en:'What window did this conversation open — and will you have the courage to pass through it?'},\n  {t:'checkout', c:{pt:'Promessa',en:'Promise'},      pt:'Que promessa você faz a si mesmo(a) ao sair daqui?',                                                 en:'What promise do you make to yourself as you leave here?'},\n  {t:'checkout', c:{pt:'Diálogo',en:'Dialogue'},      pt:'Qual conversa ainda não aconteceu — e precisa acontecer depois daqui?',                              en:'What conversation has not happened yet — and needs to happen after this?'},\n  {t:'checkout', c:{pt:'Carta',en:'Letter'},          pt:'Se você escrevesse uma carta para o grupo sobre essa reunião, qual seria a primeira frase?',          en:'If you wrote a letter to the group about this meeting, what would the opening sentence be?'}\n];\n\n// ── state ──\nvar lang='pt', mode='all', pool=[], hist=[], idx=0, curQ=null;\n\nvar COPY={\n  pt:{hl:'CHECK-IN &<br><span>CHECK-OUT</span>',sub:'Perguntas que abrem e fecham conversas que importam',all:'Todas',ci:'Check-in',co:'Check-out',btn:'Próxima Pergunta',hl2:'Últimas perguntas',kbd:'Pressione <kbd>→</kbd> para avançar &nbsp;·&nbsp; <kbd>Space</kbd> para aleatória'},\n  en:{hl:'CHECK-IN &<br><span>CHECK-OUT</span>',sub:'Questions that open and close conversations that matter',all:'All',ci:'Check-in',co:'Check-out',btn:'Next Question',hl2:'Recent questions',kbd:'Press <kbd>→</kbd> to advance &nbsp;·&nbsp; <kbd>Space</kbd> to randomize'}\n};\n\nfunction $id(id){return document.getElementById(id);}\n\nfunction hiqShuffle(arr){\n  var a=arr.slice();\n  for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var tmp=a[i];a[i]=a[j];a[j]=tmp;}\n  return a;\n}\nfunction hiqBuild(){\n  var f=mode==='all'?Q:Q.filter(function(q){return q.t===mode;});\n  pool=hiqShuffle(f);idx=0;\n}\nfunction hiqRender(q,dir){\n  var card=$id('hiq-card');\n  card.classList.remove('anim-right','anim-left');\n  void card.offsetWidth;\n  $id('hiq-tag').textContent=q.t==='checkin'?'Check-in':'Check-out';\n  $id('hiq-question').textContent=q[lang];\n  $id('hiq-counter').textContent=String(idx+1).padStart(3,'0')+' / '+pool.length;\n  $id('hiq-cat').textContent=q.c[lang];\n  card.classList.add(dir==='left'?'anim-left':'anim-right');\n  curQ=q;hiqDots();\n}\nfunction hiqPushHist(q){hist.unshift(q);if(hist.length>5)hist.pop();hiqRenderHist();}\nfunction hiqRenderHist(){\n  var el=$id('hiq-chips');el.innerHTML='';\n  hist.forEach(function(q,i){\n    var c=document.createElement('span');\n    c.className='hiq-chip';c.title=q[lang];c.textContent=q[lang];\n    c.style.animationDelay=(i*0.04)+'s';\n    el.appendChild(c);\n  });\n}\nfunction hiqDots(){\n  var el=$id('hiq-dots'),total=Math.min(pool.length,10);el.innerHTML='';\n  for(var i=0;i<total;i++){\n    var d=document.createElement('div');\n    d.className='hiq-dot'+(i===idx%10?' active':'');\n    el.appendChild(d);\n  }\n}\nfunction hiqUpdateCopy(){\n  var c=COPY[lang];\n  $id('hiq-headline').innerHTML=c.hl;\n  $id('hiq-sub').textContent=c.sub;\n  $id('hiq-tab-all-lbl').textContent=c.all;\n  $id('hiq-tab-checkin').textContent=c.ci;\n  $id('hiq-tab-checkout').textContent=c.co;\n  $id('hiq-btn-lbl').textContent=c.btn;\n  $id('hiq-hist-lbl').textContent=c.hl2;\n  $id('hiq-kbd').innerHTML=c.kbd;\n  hiqRenderHist();\n}\n\n// ── public actions (called from onclick) ──\nwindow.hiqNext=function(){if(curQ)hiqPushHist(curQ);idx=(idx+1)%pool.length;hiqRender(pool[idx],'right');};\nwindow.hiqShuffle=function(){\n  if(curQ)hiqPushHist(curQ);hiqBuild();hiqRender(pool[0],'right');\n  var b=$id('hiq-shuffle');\n  b.style.transition='none';b.style.transform='rotate(180deg)';\n  requestAnimationFrame(function(){requestAnimationFrame(function(){\n    b.style.transition='transform 0.45s cubic-bezier(.22,.68,0,1.2)';\n    b.style.transform='rotate(0deg)';\n  });});\n};\nwindow.hiqSetMode=function(m){\n  mode=m;\n  document.querySelectorAll('.hiq-tab').forEach(function(t){t.classList.remove('active');});\n  $id('hiq-tab-'+m).classList.add('active');\n  if(curQ)hiqPushHist(curQ);hiqBuild();hiqRender(pool[0],'right');\n};\nwindow.hiqSetLang=function(l){\n  lang=l;\n  $id('hiq-btn-pt').classList.toggle('active',l==='pt');\n  $id('hiq-btn-en').classList.toggle('active',l==='en');\n  hiqUpdateCopy();\n  if(curQ)hiqRender(curQ,'right');\n};\nwindow.hiqToggleTheme=function(){\n  var r=document.getElementById('hicq-root');\n  r.setAttribute('data-theme',r.getAttribute('data-theme')==='dark'?'light':'dark');\n};\nwindow.hiqCopy=function(){\n  if(!curQ)return;\n  var text=curQ[lang];\n  var btn=$id('hiq-copy');\n  function ok(){\n    var orig=btn.innerHTML;btn.innerHTML='✓';btn.classList.add('copied');\n    setTimeout(function(){btn.innerHTML=orig;btn.classList.remove('copied');},1800);\n  }\n  function fallback(){\n    var ta=document.createElement('textarea');\n    ta.value=text;ta.setAttribute('readonly','');\n    ta.style.cssText='position:fixed;left:-9999px;top:-9999px;opacity:0;pointer-events:none;';\n    document.body.appendChild(ta);ta.focus();ta.select();\n    try{if(document.execCommand('copy'))ok();}catch(e){}\n    document.body.removeChild(ta);\n  }\n  if(navigator.clipboard&&window.isSecureContext){\n    navigator.clipboard.writeText(text).then(ok).catch(fallback);\n  }else{fallback();}\n};\n\n// keyboard\ndocument.addEventListener('keydown',function(e){\n  if(e.key==='ArrowRight'||e.key==='Enter') window.hiqNext();\n  if(e.key===' '){e.preventDefault();window.hiqShuffle();}\n  if(e.key==='ArrowLeft'&&hist.length>0){\n    var p=hist.shift();pool.splice(idx,0,p);idx=Math.max(0,idx-1);\n    hiqRender(pool[idx],'left');hiqRenderHist();\n  }\n});\n\n// swipe\nvar tx=0;\nvar mc=document.getElementById('hiq-card');\nmc.addEventListener('touchstart',function(e){tx=e.touches[0].clientX;},{passive:true});\nmc.addEventListener('touchend',function(e){\n  var dx=e.changedTouches[0].clientX-tx;\n  if(Math.abs(dx)>50){\n    if(dx<0)window.hiqNext();\n    else if(hist.length>0){var p=hist.shift();pool.splice(0,0,p);idx=0;hiqRender(pool[0],'left');hiqRenderHist();}\n  }\n},{passive:true});\n\n// init\nhiqBuild();hiqRender(pool[0],'right');\n})();\n</script>",
