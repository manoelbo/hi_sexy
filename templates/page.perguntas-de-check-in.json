    "html_hKNRNW": {
      "type": "html",
      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bússola de Decisão Rápida</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Poppins', sans-serif;\n            transition: background-color 0.5s ease;\n        }\n        \n        .fade-in {\n            animation: fadeIn 0.5s;\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n        \n        .slide-in-right {\n            animation: slideInRight 0.5s forwards;\n        }\n        \n        @keyframes slideInRight {\n            from { transform: translateX(100%); opacity: 0; }\n            to { transform: translateX(0); opacity: 1; }\n        }\n        \n        .slide-out-left {\n            animation: slideOutLeft 0.5s forwards;\n        }\n        \n        @keyframes slideOutLeft {\n            from { transform: translateX(0); opacity: 1; }\n            to { transform: translateX(-100%); opacity: 0; }\n        }\n        \n        .progress-bar {\n            height: 6px;\n            transition: width 0.3s ease;\n        }\n        \n        .option-btn {\n            transition: all 0.3s ease;\n        }\n        \n        .option-btn:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n        }\n        \n        .result-chart {\n            height: 8px;\n            transition: width 0.8s ease;\n        }\n    </style>\n\n\n    <!-- Initial Screen -->\n    <div id=\"initial-screen\" class=\"flex-1 flex flex-col items-center justify-center p-6 fade-in\">\n        <div class=\"max-w-2xl text-center\">\n            <h1 class=\"text-4xl md:text-5xl font-bold text-gray-800 mb-4\">Bússola de Decisão Rápida</h1>\n            <h2 class=\"text-xl md:text-2xl text-gray-600 mb-10\">Você decide sob pressão ou por convicção? Descubra seu estilo de liderança agora.</h2>\n            <button id=\"start-btn\" class=\"bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 px-8 rounded-full text-lg transition-all duration-300 transform hover:scale-105 shadow-lg\">\n                Iniciar Simulação\n            </button>\n        </div>\n    </div>\n\n    <!-- Dilemma Screen -->\n    <div id=\"dilemma-screen\" class=\"hidden flex-1 flex flex-col p-6\">\n        <div class=\"mb-6\">\n            <div class=\"w-full bg-gray-200 rounded-full h-2\">\n                <div id=\"progress-bar\" class=\"progress-bar bg-orange-500 rounded-full\" style=\"width: 0%\"></div>\n            </div>\n        </div>\n        \n        <div class=\"flex-1 flex flex-col items-center justify-center\">\n            <div id=\"dilemma-container\" class=\"max-w-2xl w-full\">\n                <h2 id=\"dilemma-title\" class=\"text-2xl md:text-3xl font-bold text-gray-800 mb-8 text-center\"></h2>\n                <div id=\"dilemma-text\" class=\"text-lg md:text-xl text-gray-700 mb-12 text-center\"></div>\n                \n                <div class=\"flex flex-col md:flex-row gap-4 justify-center\">\n                    <button class=\"option-btn bg-white border-2 border-orange-500 text-orange-500 hover:bg-orange-50 font-bold py-4 px-6 rounded-lg flex-1 max-w-md transition-all duration-300\" data-option=\"A\">\n                        <span class=\"font-bold mr-2\">A)</span> <span id=\"option-a-text\"></span>\n                    </button>\n                    <button class=\"option-btn bg-white border-2 border-orange-500 text-orange-500 hover:bg-orange-50 font-bold py-4 px-6 rounded-lg flex-1 max-w-md transition-all duration-300\" data-option=\"B\">\n                        <span class=\"font-bold mr-2\">B)</span> <span id=\"option-b-text\"></span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Results Screen -->\n    <div id=\"results-screen\" class=\"hidden flex-1 flex flex-col items-center justify-center p-6\">\n        <div class=\"max-w-2xl w-full\">\n            <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800 mb-8 text-center\">Seu Perfil Decisório</h2>\n            \n            <div id=\"profile-result\" class=\"bg-white p-8 rounded-xl shadow-lg mb-10 fade-in\">\n                <h3 id=\"profile-title\" class=\"text-2xl font-bold text-orange-500 mb-4\"></h3>\n                <p id=\"profile-description\" class=\"text-gray-700 mb-6\"></p>\n                <p class=\"text-gray-600 italic\">\"Seu estilo é funcional… até que não seja. Como você se adapta em tempos de incerteza?\"</p>\n            </div>\n            \n            <div class=\"mb-10\">\n                <h3 class=\"text-xl font-bold text-gray-800 mb-4\">Seus Eixos Decisórios</h3>\n                \n                <div class=\"space-y-6\">\n                    <div>\n                        <div class=\"flex justify-between mb-1\">\n                            <span class=\"font-medium\">Lógica</span>\n                            <span class=\"font-medium\">Intuição</span>\n                        </div>\n                        <div class=\"w-full bg-gray-200 rounded-full h-2\">\n                            <div id=\"logic-intuition-bar\" class=\"result-chart bg-orange-500 rounded-full\" style=\"width: 50%\"></div>\n                        </div>\n                    </div>\n                    \n                    <div>\n                        <div class=\"flex justify-between mb-1\">\n                            <span class=\"font-medium\">Pessoas</span>\n                            <span class=\"font-medium\">Resultado</span>\n                        </div>\n                        <div class=\"w-full bg-gray-200 rounded-full h-2\">\n                            <div id=\"people-result-bar\" class=\"result-chart bg-orange-500 rounded-full\" style=\"width: 50%\"></div>\n                        </div>\n                    </div>\n                    \n                    <div>\n                        <div class=\"flex justify-between mb-1\">\n                            <span class=\"font-medium\">Coragem</span>\n                            <span class=\"font-medium\">Cautela</span>\n                        </div>\n                        <div class=\"w-full bg-gray-200 rounded-full h-2\">\n                            <div id=\"courage-caution-bar\" class=\"result-chart bg-orange-500 rounded-full\" style=\"width: 50%\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"flex flex-col md:flex-row gap-4 justify-center\">\n                <button id=\"retry-btn\" class=\"bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-3 px-6 rounded-lg transition-all duration-300\">\n                    Refazer simulação\n                </button>\n                <a href=\"https://www.hyperisland.com\" target=\"_blank\" class=\"bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg text-center transition-all duration-300\">\n                    Aprenda a decidir melhor → Conheça os cursos da Hyper Island\n                </a>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // Dilemmas data\n        const dilemmas = [\n            {\n                title: \"DILEMA #1\",\n                text: \"Um membro da sua equipe cometeu um erro grave, mas é o mais criativo do time. O que você faz?\",\n                optionA: \"Aplica uma sanção formal, em nome da justiça.\",\n                optionB: \"Protege a pessoa, em nome do futuro da equipe.\",\n                scores: {\n                    A: { logic: 2, result: 2, courage: 1 },\n                    B: { intuition: 2, people: 2, caution: 1 }\n                }\n            },\n            {\n                title: \"DILEMA #2\",\n                text: \"Seu projeto está atrasado. Você pode cortar testes de qualidade para cumprir o prazo ou atrasar a entrega. O que escolhe?\",\n                optionA: \"Corta testes, entrega no prazo e lida com problemas depois.\",\n                optionB: \"Atrasa a entrega para garantir qualidade.\",\n                scores: {\n                    A: { result: 2, courage: 2, logic: 1 },\n                    B: { people: 2, caution: 2, intuition: 1 }\n                }\n            },\n            {\n                title: \"DILEMA #3\",\n                text: \"Um colega propõe uma ideia arriscada que pode revolucionar o projeto ou causar seu fracasso. Como você reage?\",\n                optionA: \"Aprova imediatamente, pois inovação requer coragem.\",\n                optionB: \"Pede mais análise e dados antes de decidir.\",\n                scores: {\n                    A: { courage: 3, intuition: 2 },\n                    B: { caution: 3, logic: 2 }\n                }\n            },\n            {\n                title: \"DILEMA #4\",\n                text: \"Você descobre que um subordinado direto mentiu em um relatório para proteger a equipe. O que faz?\",\n                optionA: \"Confronta a pessoa e aplica medidas disciplinares.\",\n                optionB: \"Conversa em particular e busca entender os motivos.\",\n                scores: {\n                    A: { logic: 2, result: 2 },\n                    B: { intuition: 2, people: 2 }\n                }\n            },\n            {\n                title: \"DILEMA #5\",\n                text: \"Precisa demitir alguém para salvar o time. Escolhe o menos produtivo ou o que não se entrosou com o grupo?\",\n                optionA: \"Demite o menos produtivo - resultados vêm primeiro.\",\n                optionB: \"Demite o que não se entrosou - cultura é fundamental.\",\n                scores: {\n                    A: { result: 3, logic: 1 },\n                    B: { people: 3, intuition: 1 }\n                }\n            }\n        ];\n\n        // Profile results based on scores\n        const profiles = [\n            {\n                name: \"O Diplomata Intuitivo\",\n                description: \"Você evita o confronto, aposta em conexões humanas e segue seus instintos. Tende a priorizar harmonia e relações pessoais sobre resultados imediatos. Excelente para times criativos, mas pode ter dificuldade em decisões duras.\",\n                conditions: { intuition: 8, people: 8 }\n            },\n            {\n                name: \"O Estrategista Racional\",\n                description: \"Você pensa em sistemas, lógica e impacto de longo prazo. Toma decisões baseadas em dados e análise cuidadosa. Fundamental para projetos complexos, mas pode subestimar o fator humano.\",\n                conditions: { logic: 8, result: 8 }\n            },\n            {\n                name: \"O Executor Impulsivo\",\n                description: \"Rápido, direto e corajoso — às vezes demais. Age com convicção e não tem medo de riscos. Ideal para crises e momentos que exigem ação imediata, mas pode cometer erros por falta de análise.\",\n                conditions: { courage: 8, result: 6 }\n            },\n            {\n                name: \"O Protetor Cauteloso\",\n                description: \"Você prioriza segurança e estabilidade, protegendo sua equipe de riscos desnecessários. Excelente para manter processos estáveis, mas pode resistir a mudanças necessárias.\",\n                conditions: { caution: 8, people: 6 }\n            },\n            {\n                name: \"O Líder Equilibrado\",\n                description: \"Você adapta seu estilo conforme a situação, misturando análise e intuição conforme necessário. Não tem um padrão fixo, mostrando flexibilidade que pode ser uma força ou falta de posicionamento claro.\",\n                conditions: { balanced: true }\n            }\n        ];\n\n        // State management\n        let currentDilemma = 0;\n        let scores = {\n            logic: 0,\n            intuition: 0,\n            people: 0,\n            result: 0,\n            courage: 0,\n            caution: 0\n        };\n\n        // DOM elements\n        const initialScreen = document.getElementById('initial-screen');\n        const dilemmaScreen = document.getElementById('dilemma-screen');\n        const resultsScreen = document.getElementById('results-screen');\n        const startBtn = document.getElementById('start-btn');\n        const retryBtn = document.getElementById('retry-btn');\n        const progressBar = document.getElementById('progress-bar');\n        const dilemmaTitle = document.getElementById('dilemma-title');\n        const dilemmaText = document.getElementById('dilemma-text');\n        const optionAText = document.getElementById('option-a-text');\n        const optionBText = document.getElementById('option-b-text');\n        const profileTitle = document.getElementById('profile-title');\n        const profileDescription = document.getElementById('profile-description');\n        const logicIntuitionBar = document.getElementById('logic-intuition-bar');\n        const peopleResultBar = document.getElementById('people-result-bar');\n        const courageCautionBar = document.getElementById('courage-caution-bar');\n\n        // Event listeners\n        startBtn.addEventListener('click', startSimulation);\n        retryBtn.addEventListener('click', resetSimulation);\n\n        // Option buttons\n        document.querySelectorAll('.option-btn').forEach(btn => {\n            btn.addEventListener('click', function() {\n                const option = this.getAttribute('data-option');\n                handleOptionSelect(option);\n            });\n        });\n\n        // Functions\n        function startSimulation() {\n            initialScreen.classList.add('hidden');\n            dilemmaScreen.classList.remove('hidden');\n            showDilemma(0);\n        }\n\n        function showDilemma(index) {\n            if (index >= dilemmas.length) {\n                showResults();\n                return;\n            }\n\n            currentDilemma = index;\n            const dilemma = dilemmas[index];\n            \n            // Update progress bar\n            const progress = ((index) / dilemmas.length) * 100;\n            progressBar.style.width = `${progress}%`;\n            \n            // Set dilemma content\n            dilemmaTitle.textContent = dilemma.title;\n            dilemmaText.textContent = dilemma.text;\n            optionAText.textContent = dilemma.optionA;\n            optionBText.textContent = dilemma.optionB;\n            \n            // Animation\n            const container = document.getElementById('dilemma-container');\n            container.classList.remove('slide-in-right', 'slide-out-left');\n            setTimeout(() => {\n                container.classList.add('slide-in-right');\n            }, 10);\n        }\n\n        function handleOptionSelect(option) {\n            const currentScores = dilemmas[currentDilemma].scores[option];\n            \n            // Add scores\n            for (const key in currentScores) {\n                scores[key] += currentScores[key];\n            }\n            \n            // Next dilemma or show results\n            if (currentDilemma < dilemmas.length - 1) {\n                const container = document.getElementById('dilemma-container');\n                container.classList.remove('slide-in-right');\n                container.classList.add('slide-out-left');\n                \n                setTimeout(() => {\n                    showDilemma(currentDilemma + 1);\n                }, 400);\n            } else {\n                showResults();\n            }\n        }\n\n        function showResults() {\n            dilemmaScreen.classList.add('hidden');\n            resultsScreen.classList.remove('hidden');\n            \n            // Calculate profile\n            const profile = determineProfile();\n            profileTitle.textContent = profile.name;\n            profileDescription.textContent = profile.description;\n            \n            // Update charts\n            setTimeout(() => {\n                const logicScore = scores.logic;\n                const intuitionScore = scores.intuition;\n                const peopleScore = scores.people;\n                const resultScore = scores.result;\n                const courageScore = scores.courage;\n                const cautionScore = scores.caution;\n                \n                // Logic vs Intuition\n                const totalLI = logicScore + intuitionScore;\n                const logicPercent = totalLI > 0 ? (logicScore / totalLI) * 100 : 50;\n                logicIntuitionBar.style.width = `${logicPercent}%`;\n                \n                // People vs Result\n                const totalPR = peopleScore + resultScore;\n                const peoplePercent = totalPR > 0 ? (peopleScore / totalPR) * 100 : 50;\n                peopleResultBar.style.width = `${peoplePercent}%`;\n                \n                // Courage vs Caution\n                const totalCC = courageScore + cautionScore;\n                const couragePercent = totalCC > 0 ? (courageScore / totalCC) * 100 : 50;\n                courageCautionBar.style.width = `${couragePercent}%`;\n            }, 100);\n        }\n\n        function determineProfile() {\n            // Check for balanced profile first\n            const isBalanced = \n                Math.abs(scores.logic - scores.intuition) < 3 &&\n                Math.abs(scores.people - scores.result) < 3 &&\n                Math.abs(scores.courage - scores.caution) < 3;\n            \n            if (isBalanced) {\n                return profiles.find(p => p.conditions.balanced);\n            }\n            \n            // Check other profiles\n            for (const profile of profiles) {\n                if (profile.conditions.balanced) continue;\n                \n                let matches = true;\n                for (const key in profile.conditions) {\n                    if (scores[key] < profile.conditions[key]) {\n                        matches = false;\n                        break;\n                    }\n                }\n                \n                if (matches) return profile;\n            }\n            \n            // Default balanced if no specific profile matches\n            return profiles.find(p => p.conditions.balanced);\n        }\n\n        function resetSimulation() {\n            // Reset state\n            currentDilemma = 0;\n            scores = {\n                logic: 0,\n                intuition: 0,\n                people: 0,\n                result: 0,\n                courage: 0,\n                caution: 0\n            };\n            \n            // Reset UI\n            resultsScreen.classList.add('hidden');\n            initialScreen.classList.remove('hidden');\n            progressBar.style.width = '0%';\n            \n            // Reset charts\n            logicIntuitionBar.style.width = '50%';\n            peopleResultBar.style.width = '50%';\n            courageCautionBar.style.width = '50%';\n        }\n    </script>",
