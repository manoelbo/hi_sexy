    "html_ajgtdm": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Gerador de Check-in | Hyper Island</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        \n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8f9fa;\n        }\n        \n        .card-transition {\n            transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);\n            perspective: 1000px;\n        }\n        \n        .hi-orange {\n            color: #ff7700;\n        }\n        \n        .bg-hi-orange {\n            background-color: #ff7700;\n            background-image: linear-gradient(to right, #ff7700, #ff9500);\n        }\n        \n        .border-hi-orange {\n            border-color: #ff7700;\n        }\n        \n        .btn-hover {\n            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);\n        }\n        \n        .btn-hover:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 10px 20px -5px rgba(255, 119, 0, 0.4);\n        }\n        \n        .question-mark {\n            transition: all 0.5s ease;\n            box-shadow: 0 4px 10px rgba(255, 119, 0, 0.3);\n        }\n        \n        .card-shadow {\n            box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.1);\n        }\n        \n        @keyframes flipIn {\n            0% {\n                transform: rotateX(90deg);\n                opacity: 0;\n            }\n            100% {\n                transform: rotateX(0deg);\n                opacity: 1;\n            }\n        }\n        \n        .flip-in {\n            animation: flipIn 0.6s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;\n        }\n    </style>\n\n       \n    \n\n    <main class=\"flex-grow container mx-auto px-4 py-8 flex flex-col items-center justify-center\">\n        <div class=\"w-full max-w-2xl\">\n            <div class=\"bg-white rounded-2xl overflow-hidden mb-8 card-transition card-shadow\">\n                <div class=\"p-8\">\n                    <div class=\"flex justify-between items-start mb-8\">\n                        <div class=\"w-14 h-14 rounded-full bg-hi-orange flex items-center justify-center text-white font-bold text-2xl question-mark\">?</div>\n                        <span class=\"text-sm text-gray-400 font-medium\">Pergunta #<span id=\"question-number\">1</span></span>\n                    </div>\n                    <h2 id=\"question-text\" class=\"text-3xl font-medium text-gray-800 mb-8 leading-tight\">Clique no botão abaixo para gerar uma pergunta de check-in</h2>\n                    <div class=\"flex justify-end\">\n                        <button id=\"refresh-btn\" class=\"group bg-hi-orange text-white px-8 py-4 rounded-xl font-semibold btn-hover focus:outline-none focus:ring-4 focus:ring-orange-300 focus:ring-opacity-50 hover:shadow-lg\">\n                            <span class=\"inline-block transform transition-transform duration-300 group-hover:scale-110\">Nova Pergunta</span>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 inline ml-1\" viewbox=\"0 0 20 20\" fill=\"currentColor\">\n                                <path fill-rule=\"evenodd\" d=\"M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z\" clip-rule=\"evenodd\"></path>\n                            </svg>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"bg-gray-50 rounded-lg p-6\">\n                <h3 class=\"text-1g font-medium text-gray-800 mb-3\">Sobre este gerador</h3>\n                <p class=\"text-gray-600\">Este gerador cria perguntas para check-in que ajudam a quebrar o gelo no início de reuniões, workshops ou sessões de trabalho. Use essas perguntas para criar conexões entre os participantes e estabelecer um clima positivo antes de começar.</p>\n            </div>\n        </div>\n    </main>\n\n    \n    \n\n    <script>\n        const questions = [\n            \"Se você fosse um super-herói, qual seria seu poder e por quê?\",\n            \"Qual foi a coisa mais interessante que você aprendeu esta semana?\",\n            \"Se você pudesse viajar para qualquer lugar agora, onde seria e por quê?\",\n            \"Qual é o seu ritual matinal que te ajuda a começar bem o dia?\",\n            \"Qual foi o último livro, filme ou série que te marcou e por quê?\",\n            \"Se você pudesse jantar com qualquer pessoa (viva ou não), quem seria e por quê?\",\n            \"Qual é a habilidade que você gostaria de desenvolver este ano?\",\n            \"Qual foi o momento mais engraçado que você viveu esta semana?\",\n            \"Se sua vida fosse uma música, qual seria o título?\",\n            \"Qual é o lugar que te traz mais paz e tranquilidade?\",\n            \"Qual foi o melhor conselho que você já recebeu?\",\n            \"Se você pudesse ter um animal de estimação exótico, qual seria?\",\n            \"Qual é a coisa mais inesperada que já aconteceu com você?\",\n            \"Se você pudesse criar um novo feriado, qual seria e como seria comemorado?\",\n            \"Qual é o cheiro que traz boas memórias para você?\",\n            \"Se você pudesse ter uma habilidade sobrenatural, qual seria?\",\n            \"Qual foi a primeira coisa que você fez hoje que te deixou feliz?\",\n            \"Se você fosse um elemento da natureza (água, fogo, terra, ar), qual seria?\",\n            \"Qual é a sua dica para lidar com dias estressantes?\",\n            \"Se você pudesse aprender instantaneamente uma nova língua, qual seria?\",\n            \"Qual é a sua memória favorita da infância?\",\n            \"Se você pudesse ter uma conversa com você mesmo de 10 anos atrás, o que diria?\",\n            \"Qual é a coisa mais corajosa que você já fez?\",\n            \"Se você pudesse viver em qualquer década do século passado, qual seria?\",\n            \"Qual é a sua comida de conforto favorita?\",\n            \"Se você fosse um personagem de filme, quem seria e por quê?\",\n            \"Qual é o melhor presente que você já deu ou recebeu?\",\n            \"Se você pudesse resolver um problema mundial, qual seria?\",\n            \"Qual é a sua estação do ano favorita e por quê?\",\n            \"Se você pudesse ter uma conversa com qualquer figura histórica, quem seria?\"\n        ];\n\n        const questionText = document.getElementById('question-text');\n        const questionNumber = document.getElementById('question-number');\n        const refreshBtn = document.getElementById('refresh-btn');\n        let currentQuestionIndex = 0;\n        let previousQuestionIndex = 0;\n\n        function getRandomQuestion() {\n            let newIndex;\n            do {\n                newIndex = Math.floor(Math.random() * questions.length);\n            } while (newIndex === currentQuestionIndex && questions.length > 1);\n            \n            previousQuestionIndex = currentQuestionIndex;\n            currentQuestionIndex = newIndex;\n            return questions[currentQuestionIndex];\n        }\n\n        function updateQuestion() {\n            const card = document.querySelector('.card-transition');\n            const questionMark = document.querySelector('.question-mark');\n            \n            // Animate out\n            card.style.transform = 'rotateX(90deg)';\n            card.style.opacity = '0';\n            questionMark.style.transform = 'rotate(180deg) scale(0.8)';\n            \n            setTimeout(() => {\n                // Update content\n                questionText.textContent = getRandomQuestion();\n                questionNumber.textContent = currentQuestionIndex + 1;\n                \n                // Animate in\n                card.style.transform = 'rotateX(0deg)';\n                card.style.opacity = '1';\n                questionMark.style.transform = 'rotate(0deg) scale(1)';\n                \n                // Add pulse effect to question mark\n                questionMark.classList.add('animate__animated', 'animate__pulse');\n                setTimeout(() => {\n                    questionMark.classList.remove('animate__animated', 'animate__pulse');\n                }, 1000);\n            }, 300);\n        }\n\n        refreshBtn.addEventListener('click', updateQuestion);\n\n        // Generate first question on load\n        window.addEventListener('DOMContentLoaded', () => {\n            questionText.textContent = getRandomQuestion();\n            questionNumber.textContent = currentQuestionIndex + 1;\n        });\n    </script>",
