\"M19 9l-7 7-7-7\"></path>\n                            </svg>\n                        </button>\n                        <div class=\"module-content hidden px-4 pb-4\">\n                            <div class=\"space-y-3\">\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z\"></path>\n                                    </svg>\n                                    Slides - Design Thinking.pdf\n                                </a>\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z\"></path>\n                                    </svg>\n                                    Casos de Estudo - Módulo 2.pdf\n                                </a>\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1\"></path>\n                                    </svg>\n                                    Ferramentas Online\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Module 3 -->\n                    <div class=\"course-module bg-white rounded-lg custom-shadow overflow-hidden\">\n                        <button class=\"module-toggle w-full flex justify-between items-center p-4 text-left focus:outline-none\">\n                            <h3 class=\"font-medium\">Módulo 3: Liderança e Trabalho em Equipe</h3>\n                            <svg class=\"w-5 h-5 text-[#ff7700] transform transition-transform duration-200\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n                            </svg>\n                        </button>\n                        <div class=\"module-content hidden px-4 pb-4\">\n                            <div class=\"space-y-3\">\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z\"></path>\n                                    </svg>\n                                    Slides - Liderança.pdf\n                                </a>\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z\"></path>\n                                    </svg>\n                                    Atividades Práticas\n                                </a>\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1\"></path>\n                                    </svg>\n                                    Vídeos Complementares\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Class Recordings -->\n            <section class=\"mb-12\">\n                <h2 class=\"text-xl font-bold mb-6 text-gray-800 border-b pb-2\">🎥 Gravações das Aulas</h2>\n                \n                <!-- Video Player -->\n                <div class=\"mb-8\">\n                    <div class=\"video-placeholder rounded-lg overflow-hidden mb-4 h-64 md:h-96 flex items-center justify-center text-white\">\n                        <div class=\"text-center p-4\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-16 w-16 mx-auto mb-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\"></path>\n                            </svg>\n                            <p>Player de vídeo</p>\n                        </div>\n                    </div>\n                    <h3 class=\"font-medium text-lg mb-2\">Aula 1: Introdução à Metodologia Hyper Island</h3>\n                    <p class=\"text-gray-600 text-sm\">15/03/2023 - Duração: 1h 25min</p>\n                </div>\n                \n                <!-- Recordings List -->\n                <div class=\"bg-white rounded-lg custom-shadow overflow-hidden\">\n                    <div class=\"divide-y divide-gray-200\">\n                        <div class=\"p-4 hover:bg-gray-50 cursor-pointer\">\n                            <h4 class=\"font-medium\">Aula 2: Fundamentos do Design Thinking</h4>\n                            <p class=\"text-gray-600 text-sm\">22/03/2023 - Duração: 1h 42min</p>\n                        </div>\n                        <div class=\"p-4 hover:bg-gray-50 cursor-pointer\">\n                            <h4 class=\"font-medium\">Aula 3: Workshop de Prototipagem</h4>\n                            <p class=\"text-gray-600 text-sm\">29/03/2023 - Duração: 2h 15min</p>\n                        </div>\n                        <div class=\"p-4 hover:bg-gray-50 cursor-pointer\">\n                            <h4 class=\"font-medium\">Aula 4: Dinâmicas de Grupo</h4>\n                            <p class=\"text-gray-600 text-sm\">05/04/2023 - Duração: 1h 38min</p>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Certificate Section -->\n            <section class=\"mb-12\">\n                <h2 class=\"text-xl font-bold mb-6 text-gray-800 border-b pb-2\">📜 Certificado de Conclusão</h2>\n                <div id=\"certificate-section\" class=\"bg-white rounded-lg custom-shadow p-6 text-center hidden\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-16 w-16 text-[#ff7700] mx-auto mb-4\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                    </svg>\n                    <h3 class=\"text-xl font-bold mb-2\">Parabéns!</h3>\n                    <p class=\"mb-6\">Você completou todos os módulos do curso e está apto a receber seu certificado.</p>\n                    <button id=\"download-certificate\" class=\"bg-[#ff7700] hover:bg-[#e56d00] text-white font-medium py-2 px-6 rounded-lg transition-colors\">\n                        Baixar Certificado\n                    </button>\n                </div>\n                <div id=\"incomplete-course\" class=\"bg-white rounded-lg custom-shadow p-6 text-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-16 w-16 text-gray-400 mx-auto mb-4\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"></path>\n                    </svg>\n                    <h3 class=\"text-xl font-bold mb-2\">Curso em Andamento</h3>\n                    <p>Complete todos os módulos para liberar seu certificado.</p>\n                </div>\n            </section>\n\n            <!-- Discussion Forum -->\n            <section class=\"mb-12\">\n                <h2 class=\"text-xl font-bold mb-6 text-gray-800 border-b pb-2\">💬 Fórum de Discussão</h2>\n                \n                <!-- New Post Form -->\n                <div class=\"bg-white rounded-lg custom-shadow p-6 mb-6\">\n                    <h3 class=\"font-medium mb-4\">Nova Mensagem</h3>\n                    <form id=\"new-post-form\">\n                        <textarea id=\"post-content\" rows=\"3\" class=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#ff7700] focus:border-[#ff7700]\" placeholder=\"Compartilhe suas ideias, dúvidas ou reflexões...\"></textarea>\n                        <div class=\"mt-4 flex justify-end\">\n                            <button type=\"submit\" class=\"bg-[#ff7700] hover:bg-[#e56d00] text-white font-medium py-2 px-6 rounded-lg transition-colors\">\n                                Postar\n                            </button>\n                        </div>\n                    </form>\n                </div>\n                \n                <!-- Posts List -->\n                <div id=\"posts-container\" class=\"space-y-4\">\n                    <!-- Posts will be added here dynamically -->\n                </div>\n            </section>\n        </main>\n\n        <!-- Footer -->\n        <footer class=\"bg-gray-100 py-6\">\n            <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-gray-600 text-sm\">\n                <p>Portal exclusivo para alunos Hyper Island Brasil. Dúvidas? <a href=\"#\" class=\"text-[#ff7700] hover:underline\">Fale conosco</a>.</p>\n            </div>\n        </footer>\n    </div>\n\n    <script>\n        // Sample user data\n        const currentUser = { fullname: \"Aluno Hyper Island\", progress: 75 };\n\n        // DOM Elements\n        const logoutBtn = document.getElementById('logout-btn');\n        const studentName = document.getElementById('student-name');\n        const welcomeName = document.getElementById('welcome-name');\n        const progressBar = document.getElementById('progress-bar');\n        const progressPercentage = document.getElementById('progress-percentage');\n        const certificateSection = document.getElementById('certificate-section');\n        const incompleteCourse = document.getElementById('incomplete-course');\n        const newPostForm = document.getElementById('new-post-form');\n        const postsContainer = document.getElementById('posts-container');\n        const downloadCertificate = document.getElementById('download-certificate');\n\n        // Sample forum posts\n        let forumPosts = [\n            { \n                author: \"Ana Silva\", \n                content: \"Alguém pode me ajudar com a atividade do módulo 2? Estou com dúvidas na etapa de prototipagem.\", \n                date: \"10/04/2023 14:30\" \n            },\n            { \n                author: \"Carlos Oliveira\", \n                content: \"Ótima aula hoje sobre liderança! Alguém quer formar um grupo de estudo para discutir os casos?\", \n                date: \"08/04/2023 19:15\" \n            },\n            { \n                author: \"Professor João\", \n                content: \"Lembrando que os trabalhos do módulo 1 devem ser entregues até sexta-feira no portal.\", \n                date: \"05/04/2023 10:45\" \n            }\n        ];\n\n        // Toggle module content\n        function setupModuleToggles() {\n            const toggles = document.querySelectorAll('.module-toggle');\n            toggles.forEach(toggle => {\n                toggle.addEventListener('click', (e) => {\n                    e.preventDefault();\n                    const module = toggle.parentElement;\n                    const content = module.querySelector('.module-content');\n                    const icon = toggle.querySelector('svg');\n                    \n                    content.classList.toggle('hidden');\n                    icon.classList.toggle('rotate-180');\n                });\n            });\n        }\n\n        // Render forum posts\n        function renderForumPosts() {\n            postsContainer.innerHTML = '';\n            \n            forumPosts.forEach(post => {\n                const postElement = document.createElement('div');\n                postElement.className = 'forum-post bg-white rounded-lg custom-shadow p-6';\n                postElement.innerHTML = `\n                    <div class=\"flex justify-between items-start mb-3\">\n                        <h4 class=\"font-medium text-[#ff7700]\">${post.author}</h4>\n                        <span class=\"text-gray-500 text-sm\">${post.date}</span>\n                    </div>\n                    <p class=\"text-gray-700\">${post.content}</p>\n                `;\n                postsContainer.appendChild(postElement);\n            });\n        }\n\n        // Update UI with sample user data\n        studentName.textContent = currentUser.fullname;\n        welcomeName.textContent = currentUser.fullname.split(' ')[0];\n        progressBar.style.width = `${currentUser.progress}%`;\n        progressPercentage.textContent = `${currentUser.progress}%`;\n        \n        // Show certificate section if course is complete\n        if (currentUser.progress === 100) {\n            certificateSection.classList.remove('hidden');\n            incompleteCourse.classList.add('hidden');\n        }\n        \n        // Setup UI components\n        setupModuleToggles();\n        renderForumPosts();\n\n        // Logout function\n        logoutBtn.addEventListener('click', () => {\n            alert('Você saiu do portal');\n            window.location.reload();\n        });\n\n        // New post form\n        newPostForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n            const content = document.getElementById('post-content').value.trim();\n            \n            if (content) {\n                const currentUser = JSON.parse(localStorage.getItem('currentUser'));\n                const now = new Date();\n                const dateStr = `${now.getDate()}/${now.getMonth() + 1}/${now.getFullYear()} ${now.getHours()}:${now.getMinutes().toString().padStart(2, '0')}`;\n                \n                // Add new post\n                forumPosts.unshift({\n                    author: currentUser.fullname,\n                    content: content,\n                    date: dateStr\n                });\n                \n                // Reset form and re-render posts\n                document.getElementById('post-content').value = '';\n                renderForumPosts();\n            }\n        });\n\n        // Download certificate\n        downloadCertificate.addEventListener('click', () => {\n            alert('Simulação: Certificado está sendo baixado em formato PDF.');\n        });\n\n        // Initialize UI\n        document.addEventListener('DOMContentLoaded', () => {\n            setupModuleToggles();\n            renderForumPosts();\n        });\n    </script>",
