    "html_y3Ccdf": {
      "type": "html",
      "disabled": true,
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Gerador de Missões Criativas</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <style>\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .fade-in {\n            animation: fadeIn 0.5s ease-out forwards;\n        }\n        \n        .mission-card {\n            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n        }\n        \n        .btn-primary {\n            transition: all 0.3s ease;\n            background: linear-gradient(135deg, #ff7700 0%, #ff9933 100%);\n        }\n        \n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 20px -5px rgba(255, 119, 0, 0.4);\n        }\n        \n        .btn-primary:active {\n            transform: translateY(0);\n        }\n        \n        .btn-secondary {\n            transition: all 0.3s ease;\n        }\n        \n        .btn-secondary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px -5px rgba(0, 0, 0, 0.1);\n        }\n        \n        .emoji {\n            font-size: 1.5rem;\n            margin: 0 2px;\n        }\n    </style>\n\n\n    <div class=\"max-w-2xl w-full text-center\">\n        <h1 class=\"text-4xl md:text-5xl font-bold text-orange-900 mb-4\">Missão Criativa do Dia</h1>\n        <p class=\"text-lg md:text-xl text-orange-700 mb-10 max-w-lg mx-auto\">Aperte o botão e receba um desafio criativo único para estimular sua imaginação e sair do óbvio.</p>\n        \n        <div class=\"flex justify-center mb-10\">\n            <button id=\"generateBtn\" class=\"btn-primary text-white font-bold py-4 px-8 rounded-full text-lg md:text-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-opacity-50\">\n                Gerar Missão\n            </button>\n        </div>\n        \n        <div id=\"missionContainer\" class=\"hidden mb-8\">\n            <div class=\"mission-card bg-white p-6 md:p-8 rounded-xl max-w-md mx-auto\">\n                <h2 class=\"text-2xl font-bold text-orange-800 mb-4\">Sua Missão:</h2>\n                <div id=\"missionText\" class=\"text-lg md:text-xl text-gray-700\"></div>\n            </div>\n        </div>\n        \n        <div id=\"anotherBtn\" class=\"hidden\">\n            <button class=\"btn-secondary bg-white text-orange-700 font-semibold py-3 px-6 rounded-full border border-orange-200 hover:border-orange-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-opacity-50\">\n                Gerar outro!\n            </button>\n        </div>\n    </div>\n    \n    <footer class=\"mt-auto pt-10 text-center text-orange-600 text-sm\">\n        <p>Uma provocação da Hyper Island Brasil. Descubra como transformar criatividade em ação.</p>\n    </footer>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const generateBtn = document.getElementById('generateBtn');\n            const missionContainer = document.getElementById('missionContainer');\n            const missionText = document.getElementById('missionText');\n            const anotherBtn = document.getElementById('anotherBtn');\n            \n            const objectives = [\n                \"Melhore a comunicação entre departamentos\",\n                \"Crie uma apresentação mais impactante\",\n                \"Transforme uma reunião chata em produtiva\",\n                \"Resolva um conflito entre colegas\",\n                \"Aumente o engajamento da equipe\",\n                \"Otimize um processo burocrático\",\n                \"Facilite o onboarding de novos funcionários\",\n                \"Melhore a experiência do cliente\",\n                \"Crie uma solução para procrastinação\",\n                \"Implemente uma nova forma de feedback\",\n                \"Reduza o estresse no ambiente de trabalho\",\n                \"Aumente a colaboração entre equipes\",\n                \"Melhore a organização do escritório\",\n                \"Crie um ritual matinal produtivo\",\n                \"Implemente uma cultura de aprendizado\",\n                \"Reduza o número de e-mails desnecessários\",\n                \"Melhore as reuniões de brainstorming\",\n                \"Crie um sistema de reconhecimento entre pares\",\n                \"Facilite a tomada de decisões em grupo\",\n                \"Implemente uma política de home office eficaz\",\n                \"Melhore a comunicação com clientes difíceis\",\n                \"Crie um sistema de priorização de tarefas\",\n                \"Reduza o tempo em reuniões improdutivas\",\n                \"Implemente uma cultura de feedback contínuo\",\n                \"Melhore a integração entre equipes remotas\",\n                \"Crie um ambiente mais inclusivo\",\n                \"Reduza o turnover na equipe\",\n                \"Implemente uma política de bem-estar\",\n                \"Melhore a comunicação em projetos complexos\",\n                \"Crie um sistema de mentoria eficaz\"\n            ];\n            \n            const resources = [\n                \"apenas post-its e canetas\",\n                \"um quadro branco\",\n                \"três emojis\",\n                \"uma planilha simples\",\n                \"um e-mail bem escrito\",\n                \"cinco objetos do escritório\",\n                \"sua playlist favorita\",\n                \"um aplicativo de mensagens\",\n                \"uma reunião rápida de 5 minutos\",\n                \"um café com um colega\",\n                \"um formulário online\",\n                \"um sistema de votação simples\",\n                \"um mural de ideias\",\n                \"um grupo de WhatsApp\",\n                \"um documento compartilhado\",\n                \"uma chamada de vídeo\",\n                \"um quadro Kanban\",\n                \"um sistema de pontos\",\n                \"um mural de reconhecimento\",\n                \"um livro sobre gestão\",\n                \"um podcast inspirador\",\n                \"um template de apresentação\",\n                \"um sistema de pareamento aleatório\",\n                \"um calendário compartilhado\",\n                \"um jogo rápido de equipe\",\n                \"um sistema de recompensas simples\",\n                \"um mural de feedback\",\n                \"um café da manhã em equipe\",\n                \"um sistema de mentoria reversa\",\n                \"um happy hour virtual\"\n            ];\n            \n            const constraints = [\n                \"em menos de 15 minutos\",\n                \"sem gastar recursos extras\",\n                \"usando apenas ferramentas existentes\",\n                \"sem aprovação da diretoria\",\n                \"envolvendo toda a equipe\",\n                \"com orçamento zero\",\n                \"em uma semana\",\n                \"usando apenas comunicação escrita\",\n                \"sem interromper o fluxo de trabalho\",\n                \"com métricas mensuráveis\",\n                \"sem criar mais burocracia\",\n                \"usando apenas uma reunião\",\n                \"sem contratações adicionais\",\n                \"com foco na experiência do funcionário\",\n                \"mantendo a privacidade de dados\",\n                \"sem aumentar a carga horária\",\n                \"considerando equipes remotas\",\n                \"com feedback em tempo real\",\n                \"sem prejudicar a produtividade\",\n                \"com foco na diversidade\",\n                \"usando apenas recursos internos\",\n                \"sem criar mais reuniões\",\n                \"com foco na saúde mental\",\n                \"sem mudar os processos principais\",\n                \"considerando diferentes níveis hierárquicos\",\n                \"sem aumentar o estresse\",\n                \"com foco na sustentabilidade\",\n                \"sem criar dependência de uma pessoa\",\n                \"considerando diferentes gerações\",\n                \"sem burocracia adicional\"\n            ];\n            \n            function getRandomElement(array) {\n                return array[Math.floor(Math.random() * array.length)];\n            }\n            \n            function generateMission() {\n                const objective = getRandomElement(objectives);\n                const resource = getRandomElement(resources);\n                const constraint = getRandomElement(constraints);\n                \n                return `${objective} <span class=\"text-orange-600 font-semibold\">usando ${resource}</span> <span class=\"text-amber-600 font-semibold\">${constraint}</span>.`;\n            }\n            \n            function showMission() {\n                missionText.innerHTML = generateMission();\n                \n                missionContainer.classList.remove('hidden');\n                missionContainer.classList.add('fade-in');\n                \n                anotherBtn.classList.remove('hidden');\n                anotherBtn.classList.add('fade-in');\n                \n                // Scroll to mission if on mobile\n                if (window.innerWidth < 768) {\n                    missionContainer.scrollIntoView({ behavior: 'smooth' });\n                }\n            }\n            \n            generateBtn.addEventListener('click', showMission);\n            \n            anotherBtn.addEventListener('click', function() {\n                // Reset animation\n                missionContainer.classList.remove('fade-in');\n                void missionContainer.offsetWidth; // Trigger reflow\n                missionContainer.classList.add('fade-in');\n                \n                showMission();\n            });\n        });\n    </script>",
