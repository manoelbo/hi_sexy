    "html_Xi9dwn": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Radar da Adaptabilidade</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Poppins', sans-serif;\n            background-color: #f8f9fa;\n        }\n        \n        .radar-chart {\n            width: 100%;\n            max-width: 400px;\n            margin: 0 auto;\n        }\n        \n        .question-transition {\n            animation: fadeIn 0.5s ease-in-out;\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .result-transition {\n            animation: slideUp 0.7s ease-out;\n        }\n        \n        @keyframes slideUp {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .radar-polygon {\n            fill: rgba(255, 119, 0, 0.2);\n            stroke: #ff7700;\n            stroke-width: 2;\n        }\n        \n        .radar-axis {\n            stroke: #ccc;\n            stroke-width: 1;\n        }\n        \n        .radar-label {\n            font-size: 12px;\n            fill: #333;\n            font-weight: 500;\n        }\n        \n        .radar-point {\n            fill: #ff7700;\n        }\n    </style>\n\n\n    <div class=\"container mx-auto px-4 py-8 flex-grow\">\n        <!-- Initial Screen -->\n        <div id=\"initial-screen\" class=\"text-center max-w-2xl mx-auto\">\n            <h1 class=\"text-4xl md:text-5xl font-bold text-gray-800 mb-2\">Radar da Adaptabilidade</h1>\n            <h2 class=\"text-x1 md:text-3xl text-gray-600 mb-8\">Três dimensões. Uma provocação para o futuro.</h2>\n            \n            <div class=\"bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8\">\n                <p class=\"text-gray-700 mb-6 text-lg\">\n                    Descubra seu nível de adaptabilidade com base em três dimensões comportamentais fundamentais para navegar em ambientes complexos.\n                </p>\n                <button id=\"start-btn\" class=\"bg-[#ff7700] hover:bg-[#e56a00] text-white font-bold py-3 px-8 rounded-full text-lg transition-all transform hover:scale-105\">\n                    Iniciar Avaliação\n                </button>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mt-12\">\n                <div class=\"bg-white p-6 rounded-xl shadow-md\">\n                    <h2 class=\"font-bold text-[#ff7700] text-2xl mb-2\">Contribuição</h2>\n                    <p class=\"text-gray-600\">vs. autopreservação</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-md\">\n                    <h3 class=\"font-bold text-[#ff7700] text-2xl mb-2\">Flexibilidade Emocional</h3>\n                    <p class=\"text-gray-600\">vs. rigidez</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-md\">\n                    <h3 class=\"font-bold text-[#ff7700] text-2xl mb-2\">Abertura ao Novo</h3>\n                    <p class=\"text-gray-600\">vs. resistência</p>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Quiz Container -->\n        <div id=\"quiz-container\" class=\"hidden max-w-3xl mx-auto\">\n            <div class=\"bg-white rounded-xl shadow-lg p-6 md:p-8\">\n                <div class=\"flex justify-between items-start mb-6\">\n                    <div class=\"text-sm text-gray-500\">\n                        Pergunta <span id=\"current-question\">1</span>/9\n                    </div>\n                    <div class=\"w-full bg-gray-200 rounded-full h-2.5 max-w-xs\">\n                        <div id=\"progress-bar\" class=\"bg-[#ff7700] h-2.5 rounded-full\" style=\"width: 11.11%\"></div>\n                    </div>\n                </div>\n                \n                <div id=\"questions\" class=\"question-transition\">\n                    <!-- Questions will be inserted here by JavaScript -->\n                </div>\n                \n                <div class=\"mt-8 flex justify-between\">\n                    <button id=\"prev-btn\" class=\"text-[#ff7700] font-medium py-2 px-4 rounded-lg border border-[#ff7700] hidden\">\n                        Voltar\n                    </button>\n                    <button id=\"next-btn\" class=\"bg-[#ff7700] hover:bg-[#e56a00] text-white font-bold py-2 px-6 rounded-lg ml-auto\">\n                        Próxima\n                    </button>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Results Screen -->\n        <div id=\"results-screen\" class=\"hidden max-w-4xl mx-auto\">\n            <div class=\"text-center mb-8\">\n                <h1 class=\"text-3xl md:text-4xl font-bold text-gray-800 mb-2\">Seu Radar da Adaptabilidade</h1>\n                <p class=\"text-xl text-gray-600\">Veja como você se posiciona nas três dimensões</p>\n            </div>\n            \n            <div class=\"bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8 result-transition\">\n                <div class=\"flex flex-col md:flex-row items-center\">\n                    <div class=\"w-full md:w-1/2 mb-8 md:mb-0\">\n                        <svg id=\"radar-chart\" class=\"radar-chart\" viewbox=\"0 0 400 400\"></svg>\n                    </div>\n                    <div class=\"w-full md:w-1/2 md:pl-8\">\n                        <h2 id=\"profile-title\" class=\"text-2xl font-bold text-[#ff7700] mb-4\"></h2>\n                        <p id=\"profile-description\" class=\"text-gray-700 mb-6\"></p>\n                        \n                        <div id=\"suggestions\" class=\"bg-gray-50 p-4 rounded-lg\">\n                            <h3 class=\"font-bold text-gray-800 mb-2\">Sugestões para evolução:</h3>\n                            <ul id=\"suggestion-list\" class=\"list-disc pl-5 space-y-2 text-gray-700\"></ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"flex flex-col sm:flex-row justify-center gap-4 mt-8\">\n                <button id=\"restart-btn\" class=\"bg-white hover:bg-gray-100 text-[#ff7700] font-bold py-3 px-6 rounded-full border border-[#ff7700] transition-all\">\n                    Refazer Avaliação\n                </button>\n                <a href=\"https://www.hyperisland.com\" target=\"_blank\" class=\"bg-[#ff7700] hover:bg-[#e56a00] text-white font-bold py-3 px-6 rounded-full text-center transition-all transform hover:scale-105\">\n                    Quero desenvolver minha adaptabilidade →\n                </a>\n                <a href=\"#\" class=\"bg-white hover:bg-gray-100 text-gray-800 font-bold py-3 px-6 rounded-full border border-gray-300 transition-all\">\n                    Ler o artigo A Primeira Lei da Adaptabilidade\n                </a>\n            </div>\n        </div>\n    </div>\n    \n    <footer class=\"bg-gray-800 text-white py-6 mt-12\">\n        <div class=\"container mx-auto px-4 text-center\">\n            <p>Inspirado na Primeira Lei da Adaptabilidade de Benito Berretta</p>\n            <p class=\"mt-2 text-gray-400 text-sm\">“Se você contribui, você pode ficar.”</p>\n        </div>\n    </footer>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            // Questions data\n            const questions = [\n                {\n                    dimension: 'Contribuição',\n                    text: 'Quando enfrento desafios no trabalho, meu primeiro pensamento é como posso ajudar a resolver.'\n                },\n                {\n                    dimension: 'Flexibilidade Emocional',\n                    text: 'Consigo manter a calma e pensar com clareza mesmo quando as coisas não saem como planejado.'\n                },\n                {\n                    dimension: 'Abertura ao Novo',\n                    text: 'Fico animado(a) quando surge a oportunidade de experimentar novas formas de fazer meu trabalho.'\n                },\n                {\n                    dimension: 'Contribuição',\n                    text: 'Costumo compartilhar ideias e sugestões para melhorar processos, mesmo sem ser solicitado.'\n                },\n                {\n                    dimension: 'Flexibilidade Emocional',\n                    text: 'Quando recebo feedback crítico, consigo refletir sobre ele sem ficar na defensiva.'\n                },\n                {\n                    dimension: 'Abertura ao Novo',\n                    text: 'Adoto novas tecnologias e ferramentas com facilidade, mesmo que exijam aprender algo diferente.'\n                },\n                {\n                    dimension: 'Contribuição',\n                    text: 'Me sinto responsável pelo sucesso do time, não apenas pelas minhas tarefas individuais.'\n                },\n                {\n                    dimension: 'Flexibilidade Emocional',\n                    text: 'Consigo adaptar meu humor e comportamento conforme a situação exige.'\n                },\n                {\n                    dimension: 'Abertura ao Novo',\n                    text: 'Gosto de desafios que me tiram da zona de conforto e me fazem aprender coisas novas.'\n                }\n            ];\n            \n            // Variables\n            let currentQuestion = 0;\n            let answers = [];\n            const quizContainer = document.getElementById('quiz-container');\n            const initialScreen = document.getElementById('initial-screen');\n            const resultsScreen = document.getElementById('results-screen');\n            const questionsContainer = document.getElementById('questions');\n            const currentQuestionDisplay = document.getElementById('current-question');\n            const progressBar = document.getElementById('progress-bar');\n            const prevBtn = document.getElementById('prev-btn');\n            const nextBtn = document.getElementById('next-btn');\n            const startBtn = document.getElementById('start-btn');\n            const restartBtn = document.getElementById('restart-btn');\n            \n            // Initialize\n            function init() {\n                currentQuestion = 0;\n                answers = [];\n                renderQuestion();\n                updateProgress();\n            }\n            \n            // Render question\n            function renderQuestion() {\n                const question = questions[currentQuestion];\n                \n                let html = `\n                    <h3 class=\"text-xl font-bold text-gray-800 mb-2\">${question.dimension}</h3>\n                    <p class=\"text-lg text-gray-700 mb-6\">${question.text}</p>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex items-center\">\n                            <input type=\"radio\" id=\"option1\" name=\"answer\" value=\"3\" class=\"h-5 w-5 text-[#ff7700] focus:ring-[#ff7700]\">\n                            <label for=\"option1\" class=\"ml-3 text-gray-700\">Concordo plenamente</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"radio\" id=\"option2\" name=\"answer\" value=\"2\" class=\"h-5 w-5 text-[#ff7700] focus:ring-[#ff7700]\">\n                            <label for=\"option2\" class=\"ml-3 text-gray-700\">Concordo em parte</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"radio\" id=\"option3\" name=\"answer\" value=\"1\" class=\"h-5 w-5 text-[#ff7700] focus:ring-[#ff7700]\">\n                            <label for=\"option3\" class=\"ml-3 text-gray-700\">Discordo</label>\n                        </div>\n                    </div>\n                `;\n                \n                questionsContainer.innerHTML = html;\n                currentQuestionDisplay.textContent = currentQuestion + 1;\n                \n                // Check if there's a saved answer for this question\n                if (answers[currentQuestion] !== undefined) {\n                    document.querySelector(`input[value=\"${answers[currentQuestion]}\"]`).checked = true;\n                }\n                \n                // Update button states\n                prevBtn.classList.toggle('hidden', currentQuestion === 0);\n                nextBtn.textContent = currentQuestion === questions.length - 1 ? 'Ver Resultados' : 'Próxima';\n            }\n            \n            // Update progress bar\n            function updateProgress() {\n                const progress = ((currentQuestion + 1) / questions.length) * 100;\n                progressBar.style.width = `${progress}%`;\n            }\n            \n            // Save answer\n            function saveAnswer() {\n                const selectedOption = document.querySelector('input[name=\"answer\"]:checked');\n                if (selectedOption) {\n                    answers[currentQuestion] = parseInt(selectedOption.value);\n                }\n            }\n            \n            // Calculate results\n            function calculateResults() {\n                const dimensions = {\n                    'Contribuição': 0,\n                    'Flexibilidade Emocional': 0,\n                    'Abertura ao Novo': 0\n                };\n                \n                questions.forEach((question, index) => {\n                    dimensions[question.dimension] += answers[index] || 0;\n                });\n                \n                return dimensions;\n            }\n            \n            // Determine profile\n            function determineProfile(scores) {\n                const values = Object.values(scores);\n                \n                if (values.every(score => score >= 7)) {\n                    return {\n                        title: \"Conector de Possibilidades\",\n                        description: \"Você colabora, se adapta com leveza e abraça o novo. Está pronto para ambientes complexos.\"\n                    };\n                } else if (values.filter(score => score >= 7).length === 2 && values.some(score => score <= 5)) {\n                    return {\n                        title: \"Explorador em Construção\",\n                        description: \"Você já demonstra grande adaptabilidade, mas ainda tem uma barreira para derrubar.\"\n                    };\n                } else if (values.filter(score => score >= 7).length === 1 && values.filter(score => score <= 6).length === 2) {\n                    return {\n                        title: \"Tático Reativo\",\n                        description: \"Você se adapta em situações específicas, mas tende a reagir mais do que liderar a mudança.\"\n                    };\n                } else {\n                    return {\n                        title: \"Guardião do Status Quo\",\n                        description: \"Você busca estabilidade e segurança, mas pode estar limitando seu crescimento.\"\n                    };\n                }\n            }\n            \n            // Get suggestions based on lowest scores\n            function getSuggestions(scores) {\n                const suggestions = [];\n                const minScore = Math.min(...Object.values(scores));\n                \n                for (const [dimension, score] of Object.entries(scores)) {\n                    if (score === minScore) {\n                        if (dimension === 'Contribuição') {\n                            suggestions.push(\"Assuma microiniciativas. Contribuir é o primeiro passo para influenciar.\");\n                        } else if (dimension === 'Flexibilidade Emocional') {\n                            suggestions.push(\"Observe como você reage diante de mudanças pequenas. Pratique tolerância ao incômodo.\");\n                        } else if (dimension === 'Abertura ao Novo') {\n                            suggestions.push(\"Adote o hábito de testar algo novo toda semana. Comece pequeno, mas comece.\");\n                        }\n                    }\n                }\n                \n                return suggestions;\n            }\n            \n            // Draw radar chart\n            function drawRadarChart(scores) {\n                const radarChart = document.getElementById('radar-chart');\n                radarChart.innerHTML = '';\n                \n                const centerX = 200;\n                const centerY = 200;\n                const radius = 150;\n                const dimensions = Object.keys(scores);\n                const numDimensions = dimensions.length;\n                const angleSlice = (Math.PI * 2) / numDimensions;\n                \n                // Draw grid circles\n                for (let level = 1; level <= 3; level++) {\n                    const levelRadius = (radius / 3) * level;\n                    const circle = document.createElementNS(\"http://www.w3.org/2000/svg\", \"circle\");\n                    circle.setAttribute(\"cx\", centerX);\n                    circle.setAttribute(\"cy\", centerY);\n                    circle.setAttribute(\"r\", levelRadius);\n                    circle.setAttribute(\"class\", \"radar-axis\");\n                    circle.setAttribute(\"fill\", \"none\");\n                    radarChart.appendChild(circle);\n                    \n                    // Add level labels\n                    if (level === 3) {\n                        const text = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n                        text.setAttribute(\"x\", centerX + levelRadius + 5);\n                        text.setAttribute(\"y\", centerY);\n                        text.setAttribute(\"class\", \"radar-label\");\n                        text.textContent = \"9\";\n                        radarChart.appendChild(text);\n                    } else if (level === 2) {\n                        const text = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n                        text.setAttribute(\"x\", centerX + levelRadius + 5);\n                        text.setAttribute(\"y\", centerY);\n                        text.setAttribute(\"class\", \"radar-label\");\n                        text.textContent = \"6\";\n                        radarChart.appendChild(text);\n                    } else if (level === 1) {\n                        const text = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n                        text.setAttribute(\"x\", centerX + levelRadius + 5);\n                        text.setAttribute(\"y\", centerY);\n                        text.setAttribute(\"class\", \"radar-label\");\n                        text.textContent = \"3\";\n                        radarChart.appendChild(text);\n                    }\n                }\n                \n                // Draw axes\n                for (let i = 0; i < numDimensions; i++) {\n                    const angle = angleSlice * i - Math.PI / 2;\n                    const x = centerX + Math.cos(angle) * radius;\n                    const y = centerY + Math.sin(angle) * radius;\n                    \n                    const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n                    line.setAttribute(\"x1\", centerX);\n                    line.setAttribute(\"y1\", centerY);\n                    line.setAttribute(\"x2\", x);\n                    line.setAttribute(\"y2\", y);\n                    line.setAttribute(\"class\", \"radar-axis\");\n                    radarChart.appendChild(line);\n                    \n                    // Add dimension labels\n                    const labelAngle = angleSlice * i - Math.PI / 2;\n                    const labelRadius = radius + 25;\n                    const labelX = centerX + Math.cos(labelAngle) * labelRadius;\n                    const labelY = centerY + Math.sin(labelAngle) * labelRadius;\n                    \n                    // Adjust text anchor based on angle for better alignment\n                    let textAnchor = \"middle\";\n                    if (Math.abs(Math.cos(labelAngle)) > 0.7) {\n                        textAnchor = Math.cos(labelAngle) > 0 ? \"start\" : \"end\";\n                    }\n                    \n                    const text = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n                    text.setAttribute(\"x\", labelX);\n                    text.setAttribute(\"y\", labelY);\n                    text.setAttribute(\"class\", \"radar-label\");\n                    text.setAttribute(\"text-anchor\", \"middle\");\n                    text.textContent = dimensions[i];\n                    radarChart.appendChild(text);\n                }\n                \n                // Draw data polygon\n                const points = [];\n                for (let i = 0; i < numDimensions; i++) {\n                    const angle = angleSlice * i - Math.PI / 2;\n                    const value = scores[dimensions[i]];\n                    const scaledRadius = (value / 9) * radius;\n                    const x = centerX + Math.cos(angle) * scaledRadius;\n                    const y = centerY + Math.sin(angle) * scaledRadius;\n                    points.push(`${x},${y}`);\n                    \n                    // Add data points\n                    const point = document.createElementNS(\"http://www.w3.org/2000/svg\", \"circle\");\n                    point.setAttribute(\"cx\", x);\n                    point.setAttribute(\"cy\", y);\n                    point.setAttribute(\"r\", 5);\n                    point.setAttribute(\"class\", \"radar-point\");\n                    radarChart.appendChild(point);\n                }\n                \n                const polygon = document.createElementNS(\"http://www.w3.org/2000/svg\", \"polygon\");\n                polygon.setAttribute(\"points\", points.join(' '));\n                polygon.setAttribute(\"class\", \"radar-polygon\");\n                radarChart.appendChild(polygon);\n            }\n            \n            // Show results\n            function showResults() {\n                const scores = calculateResults();\n                const profile = determineProfile(scores);\n                const suggestions = getSuggestions(scores);\n                \n                document.getElementById('profile-title').textContent = profile.title;\n                document.getElementById('profile-description').textContent = profile.description;\n                \n                const suggestionList = document.getElementById('suggestion-list');\n                suggestionList.innerHTML = '';\n                suggestions.forEach(suggestion => {\n                    const li = document.createElement('li');\n                    li.textContent = suggestion;\n                    suggestionList.appendChild(li);\n                });\n                \n                drawRadarChart(scores);\n                \n                initialScreen.classList.add('hidden');\n                quizContainer.classList.add('hidden');\n                resultsScreen.classList.remove('hidden');\n            }\n            \n            // Event listeners\n            startBtn.addEventListener('click', () => {\n                initialScreen.classList.add('hidden');\n                quizContainer.classList.remove('hidden');\n                init();\n            });\n            \n            restartBtn.addEventListener('click', () => {\n                resultsScreen.classList.add('hidden');\n                initialScreen.classList.remove('hidden');\n            });\n            \n            nextBtn.addEventListener('click', () => {\n                saveAnswer();\n                \n                if (currentQuestion < questions.length - 1) {\n                    currentQuestion++;\n                    questionsContainer.classList.remove('question-transition');\n                    void questionsContainer.offsetWidth; // Trigger reflow\n                    questionsContainer.classList.add('question-transition');\n                    renderQuestion();\n                    updateProgress();\n                } else {\n                    showResults();\n                }\n            });\n            \n            prevBtn.addEventListener('click', () => {\n                saveAnswer();\n                \n                if (currentQuestion > 0) {\n                    currentQuestion--;\n                    questionsContainer.classList.remove('question-transition');\n                    void questionsContainer.offsetWidth; // Trigger reflow\n                    questionsContainer.classList.add('question-transition');\n                    renderQuestion();\n                    updateProgress();\n                }\n            });\n        });\n    </script>",
