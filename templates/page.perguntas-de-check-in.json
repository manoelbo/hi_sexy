      "name": "HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Portal do Aluno – Hyper Island</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Montserrat', sans-serif;\n        }\n        .custom-shadow {\n            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\n        }\n        .course-module {\n            transition: all 0.3s ease;\n        }\n        .course-module:hover {\n            transform: translateY(-2px);\n        }\n        .forum-post {\n            animation: fadeIn 0.5s ease;\n        }\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .video-placeholder {\n            background: linear-gradient(135deg, #ff7700, #ff9d42);\n        }\n    </style>\n\n\n    <!-- Student Portal -->\n    <div id=\"student-portal\">\n        <!-- Header -->\n        <header class=\"bg-white shadow-sm\">\n            <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center\">\n                <div class=\"flex items-center\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 24 24\" fill=\"#ff7700\" class=\"w-8 h-8 mr-2\">\n                        <path d=\"M11.7 2.805a.75.75 0 01.6 0A60.65 60.65 0 0122.83 8.72a.75.75 0 01-.231 1.337 49.949 49.949 0 00-9.902 3.912l-.003.002-.34.18a.75.75 0 01-.707 0A50.009 50.009 0 007.5 12.174v-.224c0-.131.067-.248.172-.311a54.614 54.614 0 014.653-2.52.75.75 0 00-.65-1.352 56.129 56.129 0 00-4.78 2.589 1.858 1.858 0 00-.859 1.228 49.803 49.803 0 00-4.634-1.527.75.75 0 01-.231-1.337A60.653 60.653 0 0111.7 2.805z\"></path>\n                        <path d=\"M13.06 15.473a48.45 48.45 0 017.666-3.282c.134 1.414.22 2.843.255 4.285a.75.75 0 01-.46.71 47.878 47.878 0 00-8.105 4.342.75.75 0 01-.832 0 47.877 47.877 0 00-8.104-4.342.75.75 0 01-.461-.71c.035-1.442.121-2.87.255-4.286A48.4 48.4 0 016 13.18v1.27a1.5 1.5 0 00-.14 2.508c-.09.38-.222.753-.397 1.11.452.213.901.434 1.346.661a6.729 6.729 0 00.551-1.608 1.5 1.5 0 00.14-2.67v-.645a48.549 48.549 0 013.44 1.668 2.25 2.25 0 002.12 0z\"></path>\n                        <path d=\"M4.462 19.462c.42-.419.753-.89 1-1.394.453.213.902.434 1.347.661a6.743 6.743 0 01-1.286 1.794.6.6 0 01-.061-.06z\"></path>\n                    </svg>\n                    <h1 class=\"text-xl font-bold text-gray-800\">Portal do Aluno</h1>\n                </div>\n                <div class=\"flex items-center space-x-4\">\n                    <span id=\"student-name\" class=\"text-sm font-medium text-gray-700\"></span>\n                    <button id=\"logout-btn\" class=\"text-sm text-[#ff7700] hover:underline\">Sair</button>\n                </div>\n            </div>\n        </header>\n\n        <!-- Main Content -->\n        <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n            <!-- Welcome Section -->\n            <section class=\"mb-12\">\n                <div class=\"bg-[#ff7700] rounded-lg p-6 text-white\">\n                    <h2 class=\"text-2xl font-bold mb-2\">Bem-vindo de volta, <span id=\"welcome-name\"></span>!</h2>\n                    <p class=\"mb-4\">Continue sua jornada de aprendizado na Hyper Island.</p>\n                    \n                    <!-- Progress Bar -->\n                    <div class=\"w-full bg-white bg-opacity-30 rounded-full h-4 mb-2\">\n                        <div id=\"progress-bar\" class=\"bg-white h-4 rounded-full\" style=\"width: 0%\"></div>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span>Progresso do curso</span>\n                        <span id=\"progress-percentage\">0%</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Course Materials -->\n            <section class=\"mb-12\">\n                <h2 class=\"text-xl font-bold mb-6 text-gray-800 border-b pb-2\">📚 Materiais do Curso</h2>\n                <div class=\"space-y-4\">\n                    <!-- Module 1 -->\n                    <div class=\"course-module bg-white rounded-lg custom-shadow overflow-hidden\">\n                        <button class=\"module-toggle w-full flex justify-between items-center p-4 text-left focus:outline-none\">\n                            <h3 class=\"font-medium\">Módulo 1: Introdução à Aprendizagem Experiencial</h3>\n                            <svg class=\"w-5 h-5 text-[#ff7700] transform transition-transform duration-200\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n                            </svg>\n                        </button>\n                        <div class=\"module-content hidden px-4 pb-4\">\n                            <div class=\"space-y-3\">\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-[#ff7700] mr-2\" fill=\"none\" viewbox=\"0 0 24 24\" stroke=\"currentColor\">\n                                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z\"></path>\n                                    </svg>\n                                    Slides - Introdução.pdf\n                                </a>\n                                <a href=\"#\" class=\"block p-3 hover:bg-gray-50 rounded flex items-center\">\n                           