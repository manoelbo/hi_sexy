{
  "sections": {
    "html_Yd3CN4": {
      "type": "html",
      "name": "HTML",
      "settings": {
        "html": "<body>\n\n\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cases — Hyper Island Brasil</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&amp;display=swap\" rel=\"stylesheet\">\n<style>\n/* =========================================\n   RESET & TOKENS\n   ========================================= */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n:root {\n  --cream:       #F2EAE0;\n  --cream-panel: #E8DFCF;\n  --ink:         #0C0A09;\n  --white:       #FEFCF8;\n  --orange:      #E64E0E;\n  --orange-soft: #F28050;\n  --gray:        #7A726A;\n  --gray-light:  #AFA89F;\n  --border:      rgba(12,10,9,0.10);\n  --border-mid:  rgba(12,10,9,0.18);\n  --f-disp:      'Bebas Neue', Impact, sans-serif;\n  --f-body:      'Plus Jakarta Sans', sans-serif;\n  --ease:        cubic-bezier(0.16,1,0.3,1);\n}\n\nhtml  { scroll-behavior: smooth; font-size: 16px; overflow-x: hidden; }\nbody  {\n  font-family: var(--f-body);\n  background: var(--cream);\n  color: var(--ink);\n  -webkit-font-smoothing: antialiased;\n}\n\n/* =========================================\n   HERO\n   ========================================= */\n.hero {\n  padding: 72px 48px 60px;\n  border-bottom: 1px solid var(--border-mid);\n  position: relative; overflow: hidden;\n}\n.hero-crumb {\n  font-size: 11px; font-weight: 600; letter-spacing: 0.12em;\n  text-transform: uppercase; color: var(--gray-light);\n  display: flex; align-items: center; gap: 10px;\n  margin-bottom: 22px;\n}\n.hero-crumb::after {\n  content: ''; display: block;\n  width: 36px; height: 1px; background: var(--gray-light);\n}\n.hero-title {\n  font-family: var(--f-disp);\n  font-size: clamp(68px, 9.5vw, 132px);\n  line-height: 0.9; letter-spacing: 0.025em;\n  margin-bottom: 28px; max-width: 820px;\n}\n.hero-title .t-orange { color: var(--orange); }\n.hero-desc {\n  font-size: 15px; font-weight: 300; line-height: 1.75;\n  color: var(--gray); max-width: 460px; margin-bottom: 52px;\n}\n.hero-stats {\n  display: flex; gap: 0;\n  border-top: 1px solid var(--border-mid);\n  padding-top: 32px;\n}\n.hero-stat {\n  padding-right: 40px; margin-right: 40px;\n  border-right: 1px solid var(--border-mid);\n}\n.hero-stat:last-child { border-right: none; }\n.hero-stat .s-num {\n  font-family: var(--f-disp);\n  font-size: 52px; letter-spacing: 0.03em; line-height: 1;\n  color: var(--ink); display: block;\n}\n.hero-stat .s-lbl {\n  font-size: 10px; font-weight: 600;\n  letter-spacing: 0.1em; text-transform: uppercase;\n  color: var(--gray-light); margin-top: 5px; display: block;\n}\n/* subtle background mark */\n.hero::after {\n  content: 'CASES';\n  font-family: var(--f-disp);\n  font-size: 280px; letter-spacing: 0.04em;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.05);\n  position: absolute; bottom: -60px; right: -20px;\n  pointer-events: none; user-select: none; line-height: 1;\n}\n\n/* =========================================\n   FILTER BAR\n   ========================================= */\n.filter-bar {\n  position: sticky; top: 0; z-index: 200;\n  background: rgba(242,234,224,0.98);\n  border-bottom: 1px solid var(--border-mid);\n  padding: 0 48px;\n  overflow: visible;\n}\n.filter-row {\n  display: flex; align-items: center;\n  gap: 8px; height: 50px;\n  border-bottom: 1px solid var(--border);\n  overflow: visible;\n}\n.f-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--gray-light); margin-right: 6px; flex-shrink: 0;\n}\n.f-sep { width: 1px; height: 22px; background: var(--border-mid); margin: 0 6px; }\n.f-group { position: relative; overflow: visible; }\n.f-trigger {\n  display: flex; align-items: center; gap: 5px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--ink); background: none;\n  border: 1px solid var(--border-mid);\n  padding: 6px 13px; border-radius: 2px;\n  cursor: pointer; white-space: nowrap;\n  transition: background .15s, border-color .15s, color .15s;\n}\n.f-trigger:hover { background: var(--cream-panel); }\n.f-trigger.is-active {\n  background: var(--ink); color: var(--cream); border-color: var(--ink);\n}\n.f-trigger .chev { font-size: 9px; transition: transform .2s; line-height: 1; }\n.f-trigger.is-open .chev { transform: rotate(180deg); }\n.f-badge {\n  width: 15px; height: 15px; border-radius: 50%;\n  background: var(--orange); color: #fff;\n  font-size: 8px; font-weight: 800;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.f-dropdown {\n  display: none; flex-direction: column;\n  position: absolute; top: calc(100% + 8px); left: 0;\n  background: var(--white);\n  border: 1px solid var(--border-mid);\n  border-radius: 3px; min-width: 240px;\n  box-shadow: 0 10px 36px rgba(12,10,9,0.18);\n  overflow: visible; z-index: 9999;\n}\n.f-dropdown.is-open { display: flex !important; }\n.f-opt {\n  padding: 10px 16px;\n  font-size: 12px; font-weight: 400;\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border); color: var(--ink);\n  transition: background .1s;\n}\n.f-opt:last-child { border-bottom: none; }\n.f-opt:hover { background: var(--cream); }\n.f-opt.is-sel { font-weight: 600; color: var(--orange); }\n.f-chk {\n  width: 14px; height: 14px; border-radius: 2px;\n  border: 1.5px solid var(--border-mid);\n  display: inline-flex; align-items: center; justify-content: center;\n  font-size: 9px; flex-shrink: 0;\n}\n.f-opt.is-sel .f-chk { background: var(--orange); border-color: var(--orange); color: #fff; }\n.f-clear {\n  margin-left: auto;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--gray-light); background: none; border: none;\n  cursor: pointer; padding: 6px 8px;\n  transition: color .15s; display: none;\n}\n.f-clear.is-vis { display: block; }\n.f-clear:hover { color: var(--orange); }\n.f-count {\n  margin-left: 12px;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--gray-light); flex-shrink: 0;\n}\n.f-chips {\n  display: flex; gap: 6px; flex-wrap: wrap;\n  padding: 8px 0;\n}\n.f-chips:empty { padding: 0; height: 0; overflow: hidden; border: none; }\n.f-chip {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-size: 10px; font-weight: 700; letter-spacing: 0.07em;\n  text-transform: uppercase;\n  background: var(--ink); color: var(--cream);\n  padding: 4px 10px; border-radius: 2px;\n}\n.f-chip-x {\n  font-size: 13px; cursor: pointer; line-height: 1;\n  opacity: 0.5; transition: opacity .15s;\n}\n.f-chip-x:hover { opacity: 1; }\n\n/* =========================================\n   CASES FEED\n   ========================================= */\n.cases-feed { }\n\n/* Force odd layout (visual left, content right) regardless of nth-child position */\n.case-item.case-flip .case-vis { order: 1 !important; background: var(--cream-panel) !important; }\n.case-item.case-flip .case-cnt { order: 2 !important; }\n\n.empty-state {\n  display: none; flex-direction: column; align-items: center;\n  padding: 80px 48px; text-align: center;\n}\n.empty-state.is-vis { display: flex; }\n.empty-state h3 {\n  font-family: var(--f-disp); font-size: 42px;\n  letter-spacing: 0.04em; margin-bottom: 10px;\n}\n.empty-state p { font-size: 14px; color: var(--gray); }\n\n/* Case item */\n.case-item {\n  display: grid; grid-template-columns: 1fr 1fr;\n  min-height: 600px;\n  border-bottom: 1px solid var(--border-mid);\n\n  transition: opacity .75s var(--ease), transform .75s var(--ease);\n}\n.case-item.is-vis { opacity: 1; transform: translateY(0); }\n.case-item.is-hidden { display: none; }\n\n/* Odd: visual LEFT, content RIGHT */\n.case-item:nth-child(odd)  .case-vis { order: 1; background: var(--cream-panel); }\n.case-item:nth-child(odd)  .case-cnt { order: 2; }\n/* Even: content LEFT, visual RIGHT */\n.case-item:nth-child(even) .case-vis { order: 2; background: var(--ink); }\n.case-item:nth-child(even) .case-cnt { order: 1; }\n\n/* Visual panel */\n.case-vis {\n  position: relative; overflow: hidden;\n}\n.case-vis img, .case-vis video {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%;\n  object-fit: cover;\n  transition: transform .7s var(--ease);\n}\n.case-vis:hover img, .case-vis:hover video { transform: scale(1.04); }\n\n/* Placeholder */\n.case-placeholder {\n  position: absolute; inset: 0;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center; gap: 8px;\n}\n.case-placeholder .ph-icon {\n  width: 48px; height: 48px; border-radius: 50%;\n  border: 1.5px solid currentColor;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 20px; opacity: 0.3;\n}\n.case-placeholder .ph-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.28;\n}\n.case-placeholder .ph-hint {\n  font-size: 10px; opacity: 0.2; font-family: var(--f-body);\n  letter-spacing: 0.04em;\n}\n\n/* Content panel */\n.case-cnt {\n  padding: 52px 52px 52px 52px;\n  display: flex; flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n}\n\n/* Ghost number */\n.case-ghost {\n  font-family: var(--f-disp);\n  font-size: 130px; letter-spacing: 0.02em; line-height: 1;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.07);\n  position: absolute; top: 24px; right: 36px;\n  pointer-events: none; user-select: none;\n}\n\n/* Tags */\n.case-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 18px; }\n.tag {\n  display: inline-block;\n  font-size: 9px; font-weight: 800; letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 3px 9px; border-radius: 2px; border: 1px solid;\n}\n.tag-fut  { color: #1A4FD4; border-color: #1A4FD4; }\n.tag-inn  { color: var(--orange); border-color: var(--orange); }\n.tag-tec  { color: #07786E; border-color: #07786E; }\n.tag-lid  { color: #7C2A08; border-color: #7C2A08; }\n.tag-sec  { color: var(--gray); border-color: var(--border-mid); }\n\n/* Client logo */\n.case-logo-wrap {\n  margin-bottom: 10px;\n}\n.case-logo {\n  height: 32px; width: auto;\n  max-width: 160px;\n  object-fit: contain;\n  display: block;\n}\n\n/* Client name */\n.case-client {\n  font-family: var(--f-disp);\n  font-size: 48px; letter-spacing: 0.04em; line-height: 1;\n  color: var(--ink); margin-bottom: 14px;\n}\n\n/* Title */\n.case-title {\n  font-size: 24px; font-weight: 500; line-height: 1.35;\n  color: var(--ink); margin-bottom: 18px; max-width: 600px;\n}\n\n/* Description */\n.case-desc {\n  font-size: 13px; font-weight: 300; line-height: 1.8;\n  color: var(--gray); max-width: 600px; margin-bottom: 0;\n}\n\n/* Stats */\n.case-stats {\n  display: flex; gap: 28px;\n  padding-top: 22px; margin-top: 22px;\n  border-top: 1px solid var(--border);\n}\n.c-stat .c-num {\n  font-family: var(--f-disp);\n  font-size: 38px; letter-spacing: 0.02em; line-height: 1;\n  color: var(--orange); display: block;\n}\n.c-stat .c-lbl {\n  font-size: 10px; font-weight: 600; letter-spacing: 0.09em;\n  text-transform: uppercase; color: var(--gray-light);\n  margin-top: 3px; display: block;\n}\n\n/* Quote */\n.case-quote {\n  padding-left: 16px;\n  border-left: 3px solid var(--orange);\n  margin-top: 22px;\n}\n.case-quote p {\n  font-size: 13px; font-style: italic;\n  font-weight: 300; line-height: 1.7;\n  color: var(--gray); margin-bottom: 7px;\n}\n.case-quote cite {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.08em; text-transform: uppercase;\n  color: var(--ink); font-style: normal;\n}\n\n/* Link */\n.case-link {\n  display: inline-flex; align-items: center; gap: 7px;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); text-decoration: none;\n  border-bottom: 1.5px solid var(--ink);\n  padding-bottom: 1px; margin-top: 22px; width: fit-content;\n  transition: color .2s, border-color .2s;\n}\n.case-link:hover { color: var(--orange); border-color: var(--orange); }\n.case-link .arr { transition: transform .2s; display: inline-block; }\n.case-link:hover .arr { transform: translateX(4px); }\n\n/* =========================================\n   CTA BLOCK\n   ========================================= */\n.cta-block {\n  background: var(--ink);\n  padding: 80px 48px;\n  display: grid; grid-template-columns: 1fr 1fr;\n  gap: 64px; align-items: center;\n}\n.cta-eyebrow {\n  font-size: 10px; font-weight: 700; letter-spacing: 0.14em;\n  text-transform: uppercase; color: rgba(255,255,255,0.3);\n  margin-bottom: 16px;\n}\n.cta-title {\n  font-family: var(--f-disp);\n  font-size: clamp(52px, 6.5vw, 96px);\n  line-height: 0.9; letter-spacing: 0.02em;\n  color: var(--cream); margin-bottom: 18px;\n}\n.cta-title .t-orange { color: var(--orange); }\n.cta-p {\n  font-size: 14px; font-weight: 300; line-height: 1.75;\n  color: rgba(255,255,255,0.45);\n}\n.cta-right { display: flex; flex-direction: column; gap: 14px; }\n.cta-person {\n  display: flex; align-items: center; gap: 14px; margin-bottom: 6px;\n}\n.cta-avatar {\n  width: 50px; height: 50px; border-radius: 50%;\n  background: var(--orange-soft);\n  display: flex; align-items: center; justify-content: center;\n  font-family: var(--f-disp); font-size: 19px; letter-spacing: 0.04em;\n  color: var(--white); flex-shrink: 0;\n}\n.cta-pname { font-size: 14px; font-weight: 600; color: var(--cream); margin-bottom: 2px; }\n.cta-prole { font-size: 11px; color: rgba(255,255,255,0.35); }\n.btn-primary {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); background: var(--cream); border: none;\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: background .2s, transform .15s;\n}\n.btn-primary:hover { background: #fff; transform: translateY(-1px); }\n.btn-sec {\n  display: inline-flex; align-items: center;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.45); background: none;\n  border: 1px solid rgba(255,255,255,0.18);\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: border-color .2s, color .2s;\n}\n.btn-sec:hover { border-color: rgba(255,255,255,0.45); color: var(--cream); }\n\n/* =========================================\n   FOOTER\n   ========================================= */\n.footer {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 22px 48px;\n  border-top: 1px solid var(--border-mid);\n}\n.footer-logo { font-family: var(--f-disp); font-size: 17px; letter-spacing: 0.06em; }\n.footer-copy { font-size: 11px; color: var(--gray-light); }\n\n/* =========================================\n   RESPONSIVE\n   ========================================= */\n@media (max-width: 900px) {\n  .nav-links { display: none; }\n  .hero { padding: 48px 24px 40px; }\n  .hero::after { display: none; }\n  .hero-stats { gap: 0; overflow-x: auto; }\n  .hero-stat { padding-right: 24px; margin-right: 24px; flex-shrink: 0; }\n  .filter-bar, .footer { padding: 0 24px; }\n  .filter-row { overflow-x: auto; }\n  .case-item { grid-template-columns: 1fr; min-height: auto; }\n  .case-item:nth-child(odd)  .case-vis,\n  .case-item:nth-child(even) .case-vis { order: 1; height: 280px; }\n  .case-item:nth-child(odd)  .case-cnt,\n  .case-item:nth-child(even) .case-cnt { order: 2; }\n  .case-cnt { padding: 36px 28px; }\n  .cta-block { grid-template-columns: 1fr; padding: 60px 24px; gap: 40px; }\n}\n</style>\n\n\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <p class=\"hero-crumb\">Para Empresas · Cases</p>\n  <h1 class=\"hero-title\">TRANSFORMAÇÃO<br>REAL. <span class=\"t-orange\">RESULTADOS</span><br>QUE FICAM.</h1>\n  <p class=\"hero-desc\">Como as maiores empresas do Brasil e do mundo desenvolvem seus times com a Hyper Island — e o que mudou depois.</p>\n  <div class=\"hero-stats\">\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">2.000+</span>\n      <span class=\"s-lbl\">Empresas Impactadas</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">30</span>\n      <span class=\"s-lbl\">Anos de Transformação</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">50.000+</span>\n      <span class=\"s-lbl\">Profissionais treinados</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">40+</span>\n      <span class=\"s-lbl\">Países alcançados</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FILTER BAR ============ -->\n<div class=\"filter-bar\" id=\"filterBar\">\n  <div class=\"filter-row\">\n    <span class=\"f-label\">Filtrar</span>\n\n    <!-- Setor -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-industry\">\n        Setor <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-industry\"></div>\n    </div>\n\n    <!-- Tipo -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-type\">\n        Tipo de Projeto <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-type\"></div>\n    </div>\n\n    <!-- Área de Treinamento -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-territory\">\n        Área de Treinamento <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-territory\"></div>\n    </div>\n\n    <div class=\"f-sep\"></div>\n    <button class=\"f-clear\" id=\"clearBtn\">✕ Limpar filtros</button>\n    <span class=\"f-count\" id=\"fCount\">5 cases</span>\n  </div>\n  <div class=\"f-chips\" id=\"fChips\"></div>\n</div>\n\n<!-- ============ CASES FEED ============ -->\n<main class=\"cases-feed\">\n\n  <div class=\"empty-state\" id=\"emptyState\">\n    <h3>NENHUM CASE ENCONTRADO</h3>\n    <p>Tente remover alguns filtros para ver mais resultados.</p>\n  </div>\n\n  <!-- ========== CASE 01 — DISNEY ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"midia\" data-type=\"jornada\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/ChatGPT_Image_5_de_mai._de_2026_17_24_35.png?v=1778012718\" alt=\"Case Disney\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">01</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-inn\">Inovação &amp; Criatividade</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Sprint de Inovação</span>\n          <span class=\"tag tag-sec\">Mídia &amp; Entretenimento</span>\n        </div>\n        <div class=\"case-logo-wrap\">\n          <img class=\"case-logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/8/8f/Disney_logo.png\" alt=\"Disney\">\n        </div>\n        <div class=\"case-client\">DISNEY</div>\n        <h2 class=\"case-title\">Desenvolver talentos na empresa que mais sabe criar experiências no mundo.</h2>\n        <p class=\"case-desc\">A Disney confiou à Hyper Island dois projetos complementares: um programa de trainees de quatro meses para jovens talentos do México, Argentina e Brasil, desenvolvendo criatividade, autonomia e influência através da metodologia 3U; e o Voices with Vision, um hackathon transregional onde equipes de diferentes países desenvolveram e apresentaram protótipos reais em um único dia, com os melhores avançando para colaboração crossregion. Dois formatos distintos, o mesmo compromisso com aprendizagem que gera impacto real.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">países simultaneamente</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"300\">+300</span><span class=\"c-lbl\">colaboradores treinados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"4\">4</span><span class=\"c-lbl\">meses de jornada híbrida</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Tenho orgulho do que construímos junto à Hyper Island. Criamos um espaço para aprender fazendo e desafiar o status quo, demonstrando que a inovação acontece quando damos lugar a todas as vozes e trabalhamos de forma diferente.\"</p>\n          <cite>Juliana Bianculli — People &amp; Culture Regional Business Partner, Disney</cite>\n        </blockquote>\n        <a href=\"https://www.hyperisland.com.br/pages/case-de-sucesso-disney\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 02 — GRUPO BOTICÁRIO ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"consumo\" data-type=\"jornada\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/IMG_6904.jpg?v=1778694423\" alt=\"Case Grupo Boticário\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">02</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Cocriação</span>\n          <span class=\"tag tag-sec\">Consumo &amp; Varejo</span>\n        </div>\n        <div class=\"case-logo-wrap\">\n          <img class=\"case-logo\" src=\"https://fundacaogrupoboticario.org.br/wp-content/uploads/2025/01/Logotipo.GrupoBoticario.RGB_.Preferencial.Policromatico.Horizontal.Positivo.png\" alt=\"GRUPO BOTICÁRIO\">\n        </div>\n        <div class=\"case-client\">GRUPO BOTICÁRIO</div>\n        <h2 class=\"case-title\">Uma parceria que atravessa diretorias, formatos e anos</h2>\n        <p class=\"case-desc\">Desde 2018, a Hyper Island e o Grupo Boticário constroem uma parceria que já atravessou sete diretorias diferentes, incluindo Supply Chain, Suprimentos, Franquias, B2C, QEC, Estratégia e o programa de Trainees. Cada projeto teve seu próprio formato: um diagnóstico profundo de habilidades com 300 profissionais no Supply Chain, um treinamento de liderança orientada por dados no Suprimentos, e um evento de team building de três dias com mais de 300 pessoas na rede de Franquias. O que une projetos tão distintos é a capacidade da Hyper Island de se adaptar ao contexto de cada área sem perder a consistência metodológica que faz a empresa continuar renovando a parceria há sete anos.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"500\">500+</span><span class=\"c-lbl\">colaboradores</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"7\">7</span><span class=\"c-lbl\">anos de parceria contínua</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">+5</span><span class=\"c-lbl\">diretorias</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A Hyper Island fez um trabalho incrível com a gente, desde o briefing inicial entendendo as nossas necessidades, entendendo o nosso momento e traduzindo isso em um encontro incrível com ativações bastante coerentes e energéticas. O time sai muito engajado e muito motivado!\"</p>\n          <cite>Fabiano Olivo — Diretor de Franquias, Grupo Boticário</cite>\n        </blockquote>\n        <a href=\"http://hyperisland.com.br/pages/case-de-sucesso-grupo-boticario\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 03 — MONDELĒZ ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"consumo\" data-type=\"jornada\" data-territory=\"tecnologias\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/ChatGPT_Image_27_de_abr._de_2026_10_09_00.png?v=1777295555\" alt=\"Case Mondelēz\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">03</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-tec\">Tecnologias Emergentes &amp; Transformação</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Consumo &amp; Varejo</span>\n        </div>\n        <div class=\"case-logo-wrap\">\n          <img class=\"case-logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c7/Mondelez_international_2012_logo.svg/3840px-Mondelez_international_2012_logo.svg.png\" alt=\"MONDELĒZ\">\n        </div>\n        <div class=\"case-client\">MONDELĒZ</div>\n        <h2 class=\"case-title\">Mais de uma década de parceria no centro da transformação humana e organizacional</h2>\n        <p class=\"case-desc\">A Mondelez é uma das parcerias mais longas e profundas da Hyper Island nas Américas. Desde 2014, mais de 20 projetos foram desenvolvidos em conjunto, cobrindo programas regionais de marketing, jornadas de liderança, alinhamentos estratégicos e workshops de transformação cultural em sete países. O capítulo mais recente dessa parceria envolveu a adoção global da plataforma de IA o9, onde a Hyper Island foi chamada para trabalhar o que a tecnologia não resolve sozinha: a resistência humana à mudança, a qualidade da colaboração entre áreas e a construção dos mindsets necessários para que uma inteligência artificial realmente funcione dentro de uma organização. Mais de 150 executivos em seis países participaram desse programa, conduzido em múltiplos idiomas e desenhado sessão a sessão para responder ao contexto específico de cada operação.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"10\">+10</span><span class=\"c-lbl\">anos de parceria</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"20\">20</span><span class=\"c-lbl\">projetos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"7\">7</span><span class=\"c-lbl\">países</span>\n</div>\n        </div>\n        <a href=\"https://www.hyperisland.com.br/pages/case-de-sucesso-mondelez\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 04 — STELLANTIS ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"industrial\" data-type=\"cocriacoes\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/stellantis_pic_6.png?v=1777221079\" alt=\"Case Stellantis\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">04</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-sec\">Cocriação</span>\n          <span class=\"tag tag-sec\">Industrial &amp; Manufatura</span>\n        </div>\n        <div class=\"case-logo-wrap\">\n          <img class=\"case-logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/d/dd/Stellantis.svg/1280px-Stellantis.svg.png\" alt=\"STELLANTIS\">\n        </div>\n        <div class=\"case-client\">STELLANTIS</div>\n        <h2 class=\"case-title\">Quando a pergunta certa vale mais do que a resposta pronta</h2>\n        <p class=\"case-desc\">Desde 2020, a Hyper Island atua como parceira estratégica da Stellantis em projetos que vão muito além de treinamentos pontuais. A relação começou durante a pandemia, com sessões de facilitação focadas em colaboração e segurança psicológica, e foi crescendo em escopo e profundidade ao longo dos anos. Hoje, com mais de 300 pessoas impactadas no Brasil, Argentina, Chile e South America, a parceria inclui workshops de governança, processos de mudança de estrutura organizacional, Brand Planning para múltiplas marcas e países, e um assessment completo de competências para 30 lideranças de marketing. Em cada projeto, o ponto de partida foi o mesmo: entender o problema real antes de propor qualquer solução.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"300\">+300</span><span class=\"c-lbl\">pessoas</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"4\">4</span><span class=\"c-lbl\">países</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">anos de parceria</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Com reflexões valiosas, vivemos uma jornada guiada pela Hyper Island, que nos trouxe perspectivas sobre como potencializar o impacto positivo das marcas.\"</p>\n          <cite>Alessandra Souza — Chief Marketing Officer, Stellantis</cite>\n        </blockquote>\n        <a href=\"https://www.hyperisland.com.br/pages/case-de-sucesso-stellantis\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 05 — JUNTOS SOMOS MAIS ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"industrial\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/PXL_20251209_141349146.PORTRAIT.jpg?v=1776298330\" alt=\"Case Juntos Somos Mais\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">05</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Industrial &amp; Manufatura</span>\n        </div>\n        <div class=\"case-logo-wrap\">\n          <img class=\"case-logo\" src=\"https://campanhas.juntossomosmais.com.br/profissional-mais/assets/logo-header.png\" alt=\"JUNTOS SOMOS MAIS\">\n        </div>\n        <div class=\"case-client\">JUNTOS SOMOS MAIS</div>\n        <h2 class=\"case-title\">Três anos, três momentos e uma parceria que cresceu junto com a liderança.</h2>\n        <p class=\"case-desc\">Parceria de três anos com a Juntos Somos Mais, joint venture formada por Tigre, Gerdau e Votorantim, que começou em 2023 com um programa de integração para 25 líderes, evoluiu em 2025 para um ciclo robusto de desenvolvimento em três níveis hierárquicos simultâneos com 40 pessoas e chegou em 2026 com foco na aplicação prática do que foi construído sob uma nova liderança executiva. Ao longo de cada fase, a Hyper Island redesenhou o programa para responder ao momento específico do negócio, demonstrando capacidade de acompanhar a maturidade da organização e não apenas resolver problemas pontuais.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">Anos de parceria</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"40\">+40</span><span class=\"c-lbl\">Líderes treinados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">Níveis de liderança</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O primeiro treinamento que fizemos em 2023 foi um divisor de águas aqui pra gente e para muitos dos nossos líderes.\"</p>\n          <cite>Yasmin Lopes — Coordenadora de HRBP, Juntos Somos Mais</cite>\n        </blockquote>\n        <a href=\"https://www.hyperisland.com.br/pages/case-de-sucesso-juntos-somos-mais\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n</main>\n\n<!-- ============ CTA ============ -->\n  <!-- ========== CASE 06 — EDENRED ========== -->\n  <article class=\"case-item is-vis case-flip\" data-industry=\"financeiro\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/ChatGPT_Image_21_de_mai._de_2026_10_48_26.png?v=1779373704\" alt=\"Case Edenred\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">06</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Financeiro &amp; Bancos</span>\n        </div>\n        <div class=\"case-logo-wrap\">\n          <img class=\"case-logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/c/c1/Edenred_Logo_%28depuis_2017%29.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=original\" alt=\"Edenred\">\n        </div>\n        <div class=\"case-client\">EDENRED</div>\n        <h2 class=\"case-title\">Cinco anos desenvolvendo lideranças na Edenred.</h2>\n        <p class=\"case-desc\">Desde 2022, a Hyper Island atua como parceira estratégica da Edenred em dois eixos complementares: o desenvolvimento de talentos emergentes e o fortalecimento da cultura organizacional. O Programa Acelera, já na quinta edição, formou 175 líderes em jornadas presenciais que combinam meta skills, desafios reais de negócio e pitches para a liderança sênior. Em paralelo, o Dream Team Bootcamp reuniu primeiro 120 top líderes e depois expandiu para 400, trabalhando valores, cultura e integração numa empresa que cresceu absorvendo diferentes histórias organizacionais. Ao longo de cinco anos e mais de 695 pessoas impactadas, a parceria se consolidou como um esforço contínuo de construir, camada por camada, uma cultura compartilhada e uma liderança preparada para o futuro.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">anos de parceria</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"600\">600+</span><span class=\"c-lbl\">colaboradores treinados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">Meta Skills desenvolvidas</span>\n</div>\n        </div>\n        <a href=\"https://www.hyperisland.com.br/pages/case-de-sucesso-edenred\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n<section class=\"cta-block\">\n  <div>\n    <p class=\"cta-eyebrow\">Próximo passo</p>\n    <h2 class=\"cta-title\">PRONTO PARA SER O PRÓXIMO <span class=\"t-orange\">CASE DE SUCESSO?</span>\n</h2>\n    <p class=\"cta-p\">Conte o desafio do seu time. A gente ouve, entende e constrói uma jornada que faz sentido para o seu momento — e para os próximos cinco anos.</p>\n  </div>\n  <div class=\"cta-right\">\n    <div class=\"cta-person\">\n      <img src=\"data:image/png;base64,\" alt=\"Sabryna Alsfasser\" style=\"width:50px;height:50px;border-radius:50%;object-fit:cover;flex-shrink:0;\">\n      <div>\n        <p class=\"cta-pname\">Sabryna Alsfasser</p>\n        <p class=\"cta-prole\">Business Development — Hyper Island Brasil</p>\n      </div>\n    </div>\n    <a href=\"https://meetings.hubspot.com/sabryna-alsfasser?uuid=fec930c1-02ad-4b9d-9aad-e03c0c6b5e93\" class=\"btn-primary\" target=\"_blank\">Agendar uma conversa →</a>\n    <a href=\"https://api.whatsapp.com/send?phone=593991223305&amp;text=Ol%C3%A1,%20gostaria%20de%20saber%20mais%20sobre%20a%20Hyper%20Island.\" class=\"btn-sec\" target=\"_blank\">Enviar mensagem</a>\n  </div>\n</section>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n\n/* PHOTO PLACEHOLDER HELPER */\ndocument.querySelectorAll(\".case-vis img, .case-vis video\").forEach(media => {\n  if (!media.src || media.src === window.location.href) return;\n  media.style.display = \"\";\n  const ph = media.closest(\".case-vis\").querySelector(\".case-placeholder\");\n  if (ph) ph.style.display = \"none\";\n  media.addEventListener(\"load\", () => {\n    media.style.display = \"\";\n    if (ph) ph.style.display = \"none\";\n  });\n});\n\n/* FILTER SYSTEM */\nconst state = { industry: null, type: null, territory: null };\nconst labels = {\n  industry:  { financeiro:\"Financeiro & Bancos\", tecnologia:\"Tecnologia & Software\", consumo:\"Consumo & Varejo\",\n               industrial:\"Industrial & Manufatura\", saude:\"Saúde & Farma\", energia:\"Energia & Utilities\",\n               midia:\"Mídia & Entretenimento\", telecom:\"Telecom\", agro:\"Agronegócio\",\n               educacao:\"Educação\", logistica:\"Logística & Transporte\", governo:\"Governo & Setor Público\" },\n  type:      { jornada:\"Jornada de Transformação\", workshop:\"Workshop\", sprint:\"Sprint de Inovação\",\n               palestra:\"Palestra\", curso:\"Curso In-Company\", cocriacoes:\"Cocriação\", assessment:\"Assessment de Skills\" },\n  territory: { futuro:\"Visão de Futuro & Estratégia\", inovacao:\"Inovação & Criatividade\",\n               tecnologias:\"Tecnologias Emergentes & Transformação\", lideranca:\"Liderança & Cultura\" }\n};\n\n// Build dropdowns dynamically from existing cases\nfunction buildFilters() {\n  const cats = { industry: new Set(), type: new Set(), territory: new Set() };\n  document.querySelectorAll(\".case-item\").forEach(item => {\n    if (item.dataset.industry)  cats.industry.add(item.dataset.industry);\n    if (item.dataset.type)      cats.type.add(item.dataset.type);\n    if (item.dataset.territory) cats.territory.add(item.dataset.territory);\n  });\n  // Preserve label order from labels map\n  Object.keys(cats).forEach(cat => {\n    const drop = document.getElementById(\"drop-\" + cat);\n    drop.innerHTML = \"\";\n    Object.keys(labels[cat]).forEach(val => {\n      if (!cats[cat].has(val)) return; // skip if no case uses this value\n      const el = document.createElement(\"div\");\n      el.className = \"f-opt\";\n      el.dataset.cat = cat;\n      el.dataset.val = val;\n      el.innerHTML = labels[cat][val] + ' <span class=\"f-chk\"></span>';\n      el.addEventListener(\"click\", () => selectF(el));\n      drop.appendChild(el);\n    });\n  });\n}\nbuildFilters();\n\nfunction toggleDrop(cat) {\n  const drop = document.getElementById(\"drop-\" + cat);\n  const trig = document.getElementById(\"trig-\" + cat);\n  const isOpen = drop.classList.contains(\"is-open\");\n  closeAllDrops();\n  if (!isOpen) { drop.classList.add(\"is-open\"); trig.classList.add(\"is-open\"); }\n}\nfunction closeAllDrops() {\n  document.querySelectorAll(\".f-dropdown\").forEach(d => d.classList.remove(\"is-open\"));\n  document.querySelectorAll(\".f-trigger\").forEach(t => t.classList.remove(\"is-open\"));\n}\nfunction selectF(el) {\n  const cat = el.dataset.cat, val = el.dataset.val;\n  if (state[cat] === val) {\n    state[cat] = null; el.classList.remove(\"is-sel\"); el.querySelector(\".f-chk\").textContent = \"\";\n  } else {\n    document.querySelectorAll(\"#drop-\" + cat + \" .f-opt\").forEach(o => { o.classList.remove(\"is-sel\"); o.querySelector(\".f-chk\").textContent = \"\"; });\n    state[cat] = val; el.classList.add(\"is-sel\"); el.querySelector(\".f-chk\").textContent = \"✓\";\n  }\n  applyFilters(); renderChips(); updateTriggers();\n  setTimeout(closeAllDrops, 160);\n}\nfunction applyFilters() {\n  let count = 0;\n  document.querySelectorAll(\".case-item\").forEach(item => {\n    const ok = (!state.industry || item.dataset.industry === state.industry) &&\n               (!state.type     || item.dataset.type     === state.type)     &&\n               (!state.territory|| item.dataset.territory=== state.territory);\n    if (ok) { item.classList.remove(\"is-hidden\"); item.classList.add(\"is-vis\"); count++; }\n    else      item.classList.add(\"is-hidden\");\n  });\n  document.getElementById(\"fCount\").textContent = count + (count === 1 ? \" case\" : \" cases\");\n  document.getElementById(\"emptyState\").classList.toggle(\"is-vis\", count === 0);\n}\nfunction renderChips() {\n  const container = document.getElementById(\"fChips\"); container.innerHTML = \"\";\n  let any = false;\n  Object.keys(state).forEach(cat => {\n    if (!state[cat]) return; any = true;\n    const chip = document.createElement(\"div\"); chip.className = \"f-chip\";\n    chip.innerHTML = (labels[cat][state[cat]] || state[cat]) + \" <span class=\\\"f-chip-x\\\" data-cat=\\\"\" + cat + \"\\\">×</span>\";\n    chip.querySelector(\".f-chip-x\").addEventListener(\"click\", e => removeFilter(e.target.dataset.cat));\n    container.appendChild(chip);\n  });\n  document.getElementById(\"clearBtn\").classList.toggle(\"is-vis\", any);\n}\nfunction updateTriggers() {\n  [\"industry\",\"type\",\"territory\"].forEach(cat => {\n    const trig = document.getElementById(\"trig-\" + cat);\n    const badge = trig.querySelector(\".f-badge\");\n    if (state[cat]) { if (!badge) { const b = document.createElement(\"span\"); b.className = \"f-badge\"; b.textContent = \"1\"; trig.appendChild(b); } trig.classList.add(\"is-active\"); }\n    else { if (badge) badge.remove(); trig.classList.remove(\"is-active\"); }\n  });\n}\nfunction removeFilter(cat) {\n  state[cat] = null;\n  document.querySelectorAll(\"#drop-\" + cat + \" .f-opt\").forEach(o => { o.classList.remove(\"is-sel\"); o.querySelector(\".f-chk\").textContent = \"\"; });\n  applyFilters(); renderChips(); updateTriggers();\n}\nfunction clearAll() {\n  Object.keys(state).forEach(k => { state[k] = null; document.querySelectorAll(\"#drop-\" + k + \" .f-opt\").forEach(o => { o.classList.remove(\"is-sel\"); o.querySelector(\".f-chk\").textContent = \"\"; }); });\n  applyFilters(); renderChips(); updateTriggers();\n}\n\n[\"industry\",\"type\",\"territory\"].forEach(cat => {\n  document.getElementById(\"trig-\" + cat).addEventListener(\"click\", e => { e.stopPropagation(); toggleDrop(cat); });\n});\ndocument.getElementById(\"clearBtn\").addEventListener(\"click\", clearAll);\ndocument.addEventListener(\"click\", e => { if (!e.target.closest(\".f-group\")) closeAllDrops(); });\n\n/* STAT COUNTER */\nfunction animCount(el) {\n  const orig = el.textContent, n = parseInt(el.dataset.n);\n  if (isNaN(n)) return;\n  const suffix = orig.replace(/[\\d.,]/g, \"\"), dur = 1100, t0 = performance.now();\n  function tick(now) {\n    const p = Math.min((now - t0) / dur, 1), ease = 1 - Math.pow(1 - p, 3);\n    el.textContent = Math.round(n * ease).toLocaleString(\"pt-BR\") + suffix;\n    if (p < 1) requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n}\nconst statObs = new IntersectionObserver(entries => {\n  entries.forEach(e => { if (e.isIntersecting) { e.target.querySelectorAll(\".c-num\").forEach(animCount); statObs.unobserve(e.target); } });\n}, { threshold: 0.25 });\ndocument.querySelectorAll(\".case-item\").forEach(item => statObs.observe(item));\n\n}); // end DOMContentLoaded\n</script>\n\n</body>",
