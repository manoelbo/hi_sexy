      "settings": {
        "html": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cases — Hyper Island Brasil</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&amp;display=swap\" rel=\"stylesheet\">\n<style>\n/* =========================================\n   RESET & TOKENS\n   ========================================= */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n:root {\n  --cream:       #F2EAE0;\n  --cream-panel: #E8DFCF;\n  --ink:         #0C0A09;\n  --white:       #FEFCF8;\n  --orange:      #E64E0E;\n  --orange-soft: #F28050;\n  --gray:        #7A726A;\n  --gray-light:  #AFA89F;\n  --border:      rgba(12,10,9,0.10);\n  --border-mid:  rgba(12,10,9,0.18);\n  --f-disp:      'Bebas Neue', Impact, sans-serif;\n  --f-body:      'Plus Jakarta Sans', sans-serif;\n  --ease:        cubic-bezier(0.16,1,0.3,1);\n}\n\nhtml  { scroll-behavior: smooth; font-size: 16px; }\nbody  {\n  font-family: var(--f-body);\n  background: var(--cream);\n  color: var(--ink);\n  overflow-x: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* =========================================\n   HERO\n   ========================================= */\n.hero {\n  padding: 72px 48px 60px;\n  border-bottom: 1px solid var(--border-mid);\n  position: relative; overflow: hidden;\n}\n.hero-crumb {\n  font-size: 11px; font-weight: 600; letter-spacing: 0.12em;\n  text-transform: uppercase; color: var(--gray-light);\n  display: flex; align-items: center; gap: 10px;\n  margin-bottom: 22px;\n}\n.hero-crumb::after {\n  content: ''; display: block;\n  width: 36px; height: 1px; background: var(--gray-light);\n}\n.hero-title {\n    font-size: clamp(68px, 9.5vw, 132px);\n  line-height: 0.9; letter-spacing: 0.025em;\n  margin-bottom: 28px; max-width: 820px;\n}\n.hero-title .t-orange { color: var(--orange); }\n.hero-desc {\n  font-size: 15px; font-weight: 300; line-height: 1.75;\n  color: var(--gray); max-width: 460px; margin-bottom: 52px;\n}\n.hero-stats {\n  display: flex; gap: 0;\n  border-top: 1px solid var(--border-mid);\n  padding-top: 32px;\n}\n.hero-stat {\n  padding-right: 40px; margin-right: 40px;\n  border-right: 1px solid var(--border-mid);\n}\n.hero-stat:last-child { border-right: none; }\n.hero-stat .s-num {\n  font-family: var(--f-disp);\n  font-size: 52px; letter-spacing: 0.03em; line-height: 1;\n  color: var(--ink); display: block;\n}\n.hero-stat .s-lbl {\n  font-size: 10px; font-weight: 600;\n  letter-spacing: 0.1em; text-transform: uppercase;\n  color: var(--gray-light); margin-top: 5px; display: block;\n}\n/* subtle background mark */\n.hero::after {\n  content: 'CASES';\n  font-family: var(--f-disp);\n  font-size: 280px; letter-spacing: 0.04em;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.05);\n  position: absolute; bottom: -60px; right: -20px;\n  pointer-events: none; user-select: none; line-height: 1;\n}\n\n/* =========================================\n   FILTER BAR\n   ========================================= */\n.filter-bar {\n  position: sticky; top: 0; z-index: 200;\n  background: rgba(242,234,224,0.96);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border-bottom: 1px solid var(--border-mid);\n  padding: 0 48px;\n}\n.filter-row {\n  display: flex; align-items: center;\n  gap: 8px; height: 50px;\n  border-bottom: 1px solid var(--border);\n}\n.f-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--gray-light); margin-right: 6px; flex-shrink: 0;\n}\n.f-sep { width: 1px; height: 22px; background: var(--border-mid); margin: 0 6px; }\n.f-group { position: relative; }\n.f-trigger {\n  display: flex; align-items: center; gap: 5px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--ink); background: none;\n  border: 1px solid var(--border-mid);\n  padding: 6px 13px; border-radius: 2px;\n  cursor: pointer; white-space: nowrap;\n  transition: background .15s, border-color .15s, color .15s;\n}\n.f-trigger:hover { background: var(--cream-panel); }\n.f-trigger.is-active {\n  background: var(--ink); color: var(--cream); border-color: var(--ink);\n}\n.f-trigger .chev { font-size: 9px; transition: transform .2s; line-height: 1; }\n.f-trigger.is-open .chev { transform: rotate(180deg); }\n.f-badge {\n  width: 15px; height: 15px; border-radius: 50%;\n  background: var(--orange); color: #fff;\n  font-size: 8px; font-weight: 800;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.f-dropdown {\n  display: none; flex-direction: column;\n  position: absolute; top: calc(100% + 6px); left: 0;\n  background: var(--white);\n  border: 1px solid var(--border-mid);\n  border-radius: 3px; min-width: 240px;\n  box-shadow: 0 10px 36px rgba(12,10,9,0.13);\n  overflow: hidden; z-index: 400;\n}\n.f-dropdown.is-open { display: flex; }\n.f-opt {\n  padding: 10px 16px;\n  font-size: 12px; font-weight: 400;\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border); color: var(--ink);\n  transition: background .1s;\n}\n.f-opt:last-child { border-bottom: none; }\n.f-opt:hover { background: var(--cream); }\n.f-opt.is-sel { font-weight: 600; color: var(--orange); }\n.f-chk {\n  width: 14px; height: 14px; border-radius: 2px;\n  border: 1.5px solid var(--border-mid);\n  display: inline-flex; align-items: center; justify-content: center;\n  font-size: 9px; flex-shrink: 0;\n}\n.f-opt.is-sel .f-chk { background: var(--orange); border-color: var(--orange); color: #fff; }\n.f-clear {\n  margin-left: auto;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--gray-light); background: none; border: none;\n  cursor: pointer; padding: 6px 8px;\n  transition: color .15s; display: none;\n}\n.f-clear.is-vis { display: block; }\n.f-clear:hover { color: var(--orange); }\n.f-count {\n  margin-left: 12px;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--gray-light); flex-shrink: 0;\n}\n.f-chips {\n  display: flex; gap: 6px; flex-wrap: wrap;\n  padding: 8px 0;\n}\n.f-chips:empty { padding: 0; height: 0; overflow: hidden; border: none; }\n.f-chip {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-size: 10px; font-weight: 700; letter-spacing: 0.07em;\n  text-transform: uppercase;\n  background: var(--ink); color: var(--cream);\n  padding: 4px 10px; border-radius: 2px;\n}\n.f-chip-x {\n  font-size: 13px; cursor: pointer; line-height: 1;\n  opacity: 0.5; transition: opacity .15s;\n}\n.f-chip-x:hover { opacity: 1; }\n\n/* =========================================\n   CASES FEED\n   ========================================= */\n.cases-feed { }\n\n.empty-state {\n  display: none; flex-direction: column; align-items: center;\n  padding: 80px 48px; text-align: center;\n}\n.empty-state.is-vis { display: flex; }\n.empty-state h3 {\n  font-family: var(--f-disp); font-size: 42px;\n  letter-spacing: 0.04em; margin-bottom: 10px;\n}\n.empty-state p { font-size: 14px; color: var(--gray); }\n\n/* Case item */\n.case-item {\n  display: grid; grid-template-columns: 1fr 1fr;\n  min-height: 600px;\n  border-bottom: 1px solid var(--border-mid);\n  opacity: 0; transform: translateY(28px);\n  transition: opacity .75s var(--ease), transform .75s var(--ease);\n}\n.case-item.is-vis { opacity: 1; transform: translateY(0); }\n.case-item.is-hidden { display: none; }\n\n/* Odd: visual LEFT, content RIGHT */\n.case-item:nth-child(odd)  .case-vis { order: 1; background: var(--cream-panel); }\n.case-item:nth-child(odd)  .case-cnt { order: 2; }\n/* Even: content LEFT, visual RIGHT */\n.case-item:nth-child(even) .case-vis { order: 2; background: var(--ink); }\n.case-item:nth-child(even) .case-cnt { order: 1; }\n\n/* Visual panel */\n.case-vis {\n  position: relative; overflow: hidden;\n}\n.case-vis img, .case-vis video {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%;\n  object-fit: cover;\n  transition: transform .7s var(--ease);\n}\n.case-vis:hover img, .case-vis:hover video { transform: scale(1.04); }\n\n/* Placeholder */\n.case-placeholder {\n  position: absolute; inset: 0;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center; gap: 8px;\n}\n.case-placeholder .ph-icon {\n  width: 48px; height: 48px; border-radius: 50%;\n  border: 1.5px solid currentColor;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 20px; opacity: 0.3;\n}\n.case-placeholder .ph-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.28;\n}\n.case-placeholder .ph-hint {\n  font-size: 10px; opacity: 0.2; font-family: var(--f-body);\n  letter-spacing: 0.04em;\n}\n\n/* Content panel */\n.case-cnt {\n  padding: 52px 52px 52px 52px;\n  display: flex; flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n}\n\n/* Ghost number */\n.case-ghost {\n  font-family: var(--f-disp);\n  font-size: 130px; letter-spacing: 0.02em; line-height: 1;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.07);\n  position: absolute; top: 24px; right: 36px;\n  pointer-events: none; user-select: none;\n}\n\n/* Tags */\n.case-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 18px; }\n.tag {\n  display: inline-block;\n  font-size: 9px; font-weight: 800; letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 3px 9px; border-radius: 2px; border: 1px solid;\n}\n.tag-fut  { color: #1A4FD4; border-color: #1A4FD4; }\n.tag-inn  { color: var(--orange); border-color: var(--orange); }\n.tag-tec  { color: #07786E; border-color: #07786E; }\n.tag-lid  { color: #7C2A08; border-color: #7C2A08; }\n.tag-sec  { color: var(--gray); border-color: var(--border-mid); }\n\n/* Client name */\n.case-client {\n  font-family: var(--f-disp);\n  font-size: 48px; letter-spacing: 0.04em; line-height: 1;\n  color: var(--ink); margin-bottom: 14px;\n}\n\n/* Title */\n.case-title {\n  font-size: 24px; font-weight: 500; line-height: 1.38;\n  color: var(--ink); margin-bottom: 18px; max-width: 400px;\n}\n\n/* Description */\n.case-desc {\n  font-size: 13px; font-weight: 300; line-height: 1.8;\n  color: var(--gray); max-width: 390px; margin-bottom: 0;\n}\n\n/* Stats */\n.case-stats {\n  display: flex; gap: 28px;\n  padding-top: 22px; margin-top: 22px;\n  border-top: 1px solid var(--border);\n}\n.c-stat .c-num {\n  font-family: var(--f-disp);\n  font-size: 38px; letter-spacing: 0.02em; line-height: 1;\n  color: var(--orange); display: block;\n}\n.c-stat .c-lbl {\n  font-size: 10px; font-weight: 600; letter-spacing: 0.09em;\n  text-transform: uppercase; color: var(--gray-light);\n  margin-top: 3px; display: block;\n}\n\n/* Quote */\n.case-quote {\n  padding-left: 16px;\n  border-left: 3px solid var(--orange);\n  margin-top: 22px;\n}\n.case-quote p {\n  font-size: 13px; font-style: italic;\n  font-weight: 300; line-height: 1.7;\n  color: var(--gray); margin-bottom: 7px;\n}\n.case-quote cite {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.08em; text-transform: uppercase;\n  color: var(--ink); font-style: normal;\n}\n\n/* Link */\n.case-link {\n  display: inline-flex; align-items: center; gap: 7px;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); text-decoration: none;\n  border-bottom: 1.5px solid var(--ink);\n  padding-bottom: 1px; margin-top: 22px; width: fit-content;\n  transition: color .2s, border-color .2s;\n}\n.case-link:hover { color: var(--orange); border-color: var(--orange); }\n.case-link .arr { transition: transform .2s; display: inline-block; }\n.case-link:hover .arr { transform: translateX(4px); }\n\n/* =========================================\n   CTA BLOCK\n   ========================================= */\n.cta-block {\n  background: var(--ink);\n  padding: 80px 48px;\n  display: grid; grid-template-columns: 1fr 1fr;\n  gap: 64px; align-items: center;\n}\n.cta-eyebrow {\n  font-size: 10px; font-weight: 700; letter-spacing: 0.14em;\n  text-transform: uppercase; color: rgba(255,255,255,0.3);\n  margin-bottom: 16px;\n}\n.cta-title {\n  font-family: var(--f-disp);\n  font-size: clamp(52px, 6.5vw, 96px);\n  line-height: 0.9; letter-spacing: 0.02em;\n  color: var(--cream); margin-bottom: 18px;\n}\n.cta-title .t-orange { color: var(--orange); }\n.cta-p {\n  font-size: 14px; font-weight: 300; line-height: 1.75;\n  color: rgba(255,255,255,0.45);\n}\n.cta-right { display: flex; flex-direction: column; gap: 14px; }\n.cta-person {\n  display: flex; align-items: center; gap: 14px; margin-bottom: 6px;\n}\n.cta-avatar {\n  width: 50px; height: 50px; border-radius: 50%;\n  background: var(--orange-soft);\n  display: flex; align-items: center; justify-content: center;\n  font-family: var(--f-disp); font-size: 19px; letter-spacing: 0.04em;\n  color: var(--white); flex-shrink: 0;\n}\n.cta-pname { font-size: 14px; font-weight: 600; color: var(--cream); margin-bottom: 2px; }\n.cta-prole { font-size: 11px; color: rgba(255,255,255,0.35); }\n.btn-primary {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); background: var(--cream); border: none;\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: background .2s, transform .15s;\n}\n.btn-primary:hover { background: #fff; transform: translateY(-1px); }\n.btn-sec {\n  display: inline-flex; align-items: center;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.45); background: none;\n  border: 1px solid rgba(255,255,255,0.18);\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: border-color .2s, color .2s;\n}\n.btn-sec:hover { border-color: rgba(255,255,255,0.45); color: var(--cream); }\n\n/* =========================================\n   FOOTER\n   ========================================= */\n.footer {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 22px 48px;\n  border-top: 1px solid var(--border-mid);\n}\n.footer-logo { font-family: var(--f-disp); font-size: 17px; letter-spacing: 0.06em; }\n.footer-copy { font-size: 11px; color: var(--gray-light); }\n\n/* =========================================\n   RESPONSIVE\n   ========================================= */\n@media (max-width: 900px) {\n  .nav-links { display: none; }\n  .hero { padding: 48px 24px 40px; }\n  .hero::after { display: none; }\n  .hero-stats { gap: 0; overflow-x: auto; }\n  .hero-stat { padding-right: 24px; margin-right: 24px; flex-shrink: 0; }\n  .filter-bar, .footer { padding: 0 24px; }\n  .filter-row { overflow-x: auto; }\n  .case-item { grid-template-columns: 1fr; min-height: auto; }\n  .case-item:nth-child(odd)  .case-vis,\n  .case-item:nth-child(even) .case-vis { order: 1; height: 280px; }\n  .case-item:nth-child(odd)  .case-cnt,\n  .case-item:nth-child(even) .case-cnt { order: 2; }\n  .case-cnt { padding: 36px 28px; }\n  .cta-block { grid-template-columns: 1fr; padding: 60px 24px; gap: 40px; }\n}\n</style>\n\n\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <p class=\"hero-crumb\">Para Empresas · Cases</p>\n  <h1 class=\"hero-title\">TRANSFORMAÇÃO REAL. <span class=\"t-orange\">RESULTADOS</span> QUE FICAM.</h1>\n  <p class=\"hero-desc\">Como as maiores empresas do Brasil desenvolvem seus times com a Hyper Island — e o que mudou depois.</p>\n  <div class=\"hero-stats\">\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">80+</span>\n      <span class=\"s-lbl\">Empresas atendidas</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">29</span>\n      <span class=\"s-lbl\">Anos de metodologia</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">5.000+</span>\n      <span class=\"s-lbl\">Profissionais treinados</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">14</span>\n      <span class=\"s-lbl\">Países alcançados</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FILTER BAR ============ -->\n<div class=\"filter-bar\" id=\"filterBar\">\n  <div class=\"filter-row\">\n    <span class=\"f-label\">Filtrar</span>\n\n    <!-- Setor -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-industry\" onclick=\"toggleDrop('industry')\">\n        Setor <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-industry\">\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"financeiro\" onclick=\"selectF(this)\">Financeiro &amp; Bancos <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"tecnologia\" onclick=\"selectF(this)\">Tecnologia &amp; Software <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"consumo\" onclick=\"selectF(this)\">Consumo &amp; Varejo <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"industrial\" onclick=\"selectF(this)\">Industrial &amp; Manufatura <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"saude\" onclick=\"selectF(this)\">Saúde &amp; Farma <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"energia\" onclick=\"selectF(this)\">Energia &amp; Utilities <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"midia\" onclick=\"selectF(this)\">Mídia &amp; Entretenimento <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"telecom\" onclick=\"selectF(this)\">Telecom <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"agro\" onclick=\"selectF(this)\">Agronegócio <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"educacao\" onclick=\"selectF(this)\">Educação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"logistica\" onclick=\"selectF(this)\">Logística &amp; Transporte <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"governo\" onclick=\"selectF(this)\">Governo &amp; Setor Público <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <!-- Tipo -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-type\" onclick=\"toggleDrop('type')\">\n        Tipo de Projeto <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-type\">\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"jornada\" onclick=\"selectF(this)\">Jornada de Transformação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"workshop\" onclick=\"selectF(this)\">Workshop <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"sprint\" onclick=\"selectF(this)\">Sprint de Inovação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"palestra\" onclick=\"selectF(this)\">Palestra <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"curso\" onclick=\"selectF(this)\">Curso In-Company <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"cocriacoes\" onclick=\"selectF(this)\">Cocriação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"assessment\" onclick=\"selectF(this)\">Assessment de Skills <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <!-- Área de Treinamento -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-territory\" onclick=\"toggleDrop('territory')\">\n        Área de Treinamento <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-territory\">\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"futuro\" onclick=\"selectF(this)\">Visão de Futuro &amp; Estratégia <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"inovacao\" onclick=\"selectF(this)\">Inovação &amp; Criatividade <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"tecnologias\" onclick=\"selectF(this)\">Tecnologias Emergentes &amp; Transformação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"lideranca\" onclick=\"selectF(this)\">Liderança &amp; Cultura <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <div class=\"f-sep\"></div>\n    <button class=\"f-clear\" id=\"clearBtn\" onclick=\"clearAll()\">✕ Limpar filtros</button>\n    <span class=\"f-count\" id=\"fCount\">8 cases</span>\n  </div>\n  <div class=\"f-chips\" id=\"fChips\"></div>\n</div>\n\n<!-- ============ CASES FEED ============ -->\n<main class=\"cases-feed\">\n\n  <div class=\"empty-state\" id=\"emptyState\">\n    <h3>NENHUM CASE ENCONTRADO</h3>\n    <p>Tente remover alguns filtros para ver mais resultados.</p>\n  </div>\n\n  <!-- ========== CASE 01 — ITAÚ ========== -->\n  <article class=\"case-item\" data-industry=\"financeiro\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 01: substitua o src abaixo pelo link da imagem ou vídeo do case Itaú -->\n      <img src=\"\" alt=\"Case Itaú Unibanco\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--ink);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-01-itau.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">01</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Financeiro</span>\n        </div>\n        <div class=\"case-client\">ITAÚ UNIBANCO</div>\n        <h1 class=\"case-title\">Construindo lideranças que conduzem a mudança em larga escala</h1>\n        <p class=\"case-desc\">Um programa de jornada estruturado em três fases — descoberta, experimentação e implementação — para desenvolver os líderes responsáveis pela transformação digital do maior banco privado da América Latina.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"400\">400+</span><span class=\"c-lbl\">líderes treinados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"6\">6</span><span class=\"c-lbl\">meses de programa</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"94\">94%</span><span class=\"c-lbl\">NPS do programa</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Mudou a forma como nossos líderes enxergam o papel deles na transformação. Não foi um treinamento — foi uma jornada real de mudança de mentalidade.\"</p>\n          <cite>Ana Lima — Diretora de Pessoas &amp; Cultura, Itaú</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 02 — MONDELĒZ ========== -->\n  <article class=\"case-item\" data-industry=\"consumo\" data-type=\"sprint\" data-territory=\"inovacao\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 02: substitua o src abaixo pelo link da imagem ou vídeo do case Mondelēz -->\n      <img src=\"\" alt=\"Case Mondelēz\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-02-mondelez.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">02</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-inn\">Inovação &amp; Criatividade</span>\n          <span class=\"tag tag-sec\">Sprint de Inovação</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">MONDELĒZ</div>\n        <h2 class=\"case-title\">Do problema real ao protótipo validado em 5 dias com times multidisciplinares</h2>\n        <p class=\"case-desc\">Sprints de inovação intensivos onde times de RH, Marketing, Supply Chain e Finanças trabalharam juntos para gerar soluções para desafios críticos do negócio, usando a metodologia 3U da Hyper Island.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"12\">12</span><span class=\"c-lbl\">times formados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"60\">60</span><span class=\"c-lbl\">protótipos gerados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">soluções implementadas</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A velocidade com que os times chegaram a soluções concretas foi surpreendente. Metodologia que respeita a inteligência coletiva das pessoas.\"</p>\n          <cite>Paulo Souza — Head of Innovation LATAM, Mondelēz</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 03 — BRADESCO ========== -->\n  <article class=\"case-item\" data-industry=\"financeiro\" data-type=\"curso\" data-territory=\"tecnologias\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 03: substitua o src abaixo pelo link da imagem ou vídeo do case Bradesco -->\n      <img src=\"\" alt=\"Case Bradesco\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--ink);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-03-bradesco.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">03</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-tec\">Tecnologias Emergentes</span>\n          <span class=\"tag tag-sec\">Curso In-Company</span>\n          <span class=\"tag tag-sec\">Financeiro</span>\n        </div>\n        <div class=\"case-client\">BRADESCO</div>\n        <h2 class=\"case-title\">Preparando 2.000 colaboradores para trabalhar com IA generativa no dia a dia</h2>\n        <p class=\"case-desc\">Programa de capacitação em 4 módulos — desde fundamentos de IA até aplicação prática em fluxos reais — desenvolvido para habilitar equipes de diferentes áreas a incorporarem inteligência artificial no cotidiano profissional.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"2000\">2.000</span><span class=\"c-lbl\">colaboradores</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"4\">4</span><span class=\"c-lbl\">módulos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"87\">87%</span><span class=\"c-lbl\">taxa de conclusão</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O grande diferencial foi equilibrar teoria com aplicação prática imediata. Os times saíram com ferramentas e confiança para usar IA no trabalho real.\"</p>\n          <cite>Carla Menezes — CHRO, Bradesco</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 04 — SCANIA ========== -->\n  <article class=\"case-item\" data-industry=\"industrial\" data-type=\"workshop\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 04: substitua o src abaixo pelo link da imagem ou vídeo do case Scania -->\n      <img src=\"\" alt=\"Case Scania\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-04-scania.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">04</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-sec\">Workshop</span>\n          <span class=\"tag tag-sec\">Industrial</span>\n        </div>\n        <div class=\"case-client\">SCANIA</div>\n        <h2 class=\"case-title\">Redesenhando a estratégia para 2030 com futures thinking e design de cenários</h2>\n        <p class=\"case-desc\">Três workshops intensivos com a alta liderança para explorar cenários de futuro, desafiar premissas estratégicas e construir uma visão compartilhada para o crescimento da Scania na América Latina até 2030.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">workshops</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"80\">80</span><span class=\"c-lbl\">executivos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">diretrizes estratégicas</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Conseguimos criar um alinhamento estratégico real entre lideranças de diferentes países. A abordagem de futures foi reveladora para toda a equipe.\"</p>\n          <cite>Martin Andersson — VP of Strategy LATAM, Scania</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 05 — GOOGLE ========== -->\n  <article class=\"case-item\" data-industry=\"tecnologia\" data-type=\"palestra\" data-territory=\"tecnologias\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 05: substitua o src abaixo pelo link da imagem ou vídeo do case Google -->\n      <img src=\"\" alt=\"Case Google\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--ink);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-05-google.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">05</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-tec\">Tecnologias Emergentes</span>\n          <span class=\"tag tag-sec\">Palestra + Workshop</span>\n          <span class=\"tag tag-sec\">Tecnologia</span>\n        </div>\n        <div class=\"case-client\">GOOGLE</div>\n        <h2 class=\"case-title\">IA generativa como copiloto criativo para times de marketing e produto em 9 países</h2>\n        <p class=\"case-desc\">Programa combinado de palestra inspiracional e workshops hands-on para capacitar times a integrar ferramentas de IA generativa nos fluxos criativos — sem perder a autenticidade e identidade da marca.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"500\">500</span><span class=\"c-lbl\">participantes</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"2\">2</span><span class=\"c-lbl\">dias intensivos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"9\">9</span><span class=\"c-lbl\">países envolvidos</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A Hyper Island conseguiu fazer algo difícil: tornar IA tangível e humana ao mesmo tempo. Os times saíram com clareza de como usar sem perder sua identidade.\"</p>\n          <cite>Renata Moreira — Head of L&amp;D LATAM, Google</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 06 — NESTLÉ ========== -->\n  <article class=\"case-item\" data-industry=\"consumo\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 06: substitua o src abaixo pelo link da imagem ou vídeo do case Nestlé -->\n      <img src=\"\" alt=\"Case Nestlé\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-06-nestle.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">06</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">NESTLÉ</div>\n        <h2 class=\"case-title\">Reconstruindo a cultura de times híbridos em 14 países simultaneamente</h2>\n        <p class=\"case-desc\">Jornada de transformação cultural desenhada para times que trabalham de forma distribuída, com foco em criar pertencimento, alinhamento de propósito e rituais de colaboração que funcionam além das fronteiras geográficas.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"14\">14</span><span class=\"c-lbl\">países</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"1200\">1.200</span><span class=\"c-lbl\">pessoas envolvidas</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"18\">18</span><span class=\"c-lbl\">meses de jornada</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Conseguimos criar uma cultura comum em times que nunca se encontram pessoalmente. Isso era algo que achávamos impossível antes desse programa.\"</p>\n          <cite>Isabela Santos — VP People &amp; Culture LATAM, Nestlé</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 07 — IBM ========== -->\n  <article class=\"case-item\" data-industry=\"tecnologia\" data-type=\"cocriacoes\" data-territory=\"inovacao\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 07: substitua o src abaixo pelo link da imagem ou vídeo do case IBM -->\n      <img src=\"\" alt=\"Case IBM\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--ink);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-07-ibm.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">07</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-inn\">Inovação &amp; Criatividade</span>\n          <span class=\"tag tag-sec\">Cocriação</span>\n          <span class=\"tag tag-sec\">Tecnologia</span>\n        </div>\n        <div class=\"case-client\">IBM</div>\n        <h2 class=\"case-title\">Cocriando o futuro do trabalho com líderes de 8 setores da economia brasileira</h2>\n        <p class=\"case-desc\">Laboratório de cocriação reunindo líderes de Finanças, Saúde, Varejo, Educação, Energia, Logística, Manufatura e Governo para desenvolver frameworks sobre o futuro do trabalho com IA e automação em escala nacional.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"8\">8</span><span class=\"c-lbl\">setores envolvidos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"45\">45</span><span class=\"c-lbl\">líderes</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">frameworks gerados</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A cocriação entre setores diferentes gerou insights que nenhum de nós teria individualmente. Foi um dos processos mais ricos que já vivenciei na carreira.\"</p>\n          <cite>Roberto Faria — Director of Innovation, IBM Brasil</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 08 — PEPSICO ========== -->\n  <article class=\"case-item\" data-industry=\"consumo\" data-type=\"assessment\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 08: substitua o src abaixo pelo link da imagem ou vídeo do case PepsiCo -->\n      <img src=\"\" alt=\"Case PepsiCo\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-08-pepsico.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">08</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-sec\">Assessment de Skills</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">PEPSICO</div>\n        <h2 class=\"case-title\">Mapeando competências críticas para construir a estratégia de talentos 2025–2030</h2>\n        <p class=\"case-desc\">Processo estruturado de assessment das competências críticas para o futuro — mapeando onde a organização está hoje e onde precisa chegar em 5 anos — para embasar o roadmap de desenvolvimento de talentos da PepsiCo LATAM.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"800\">800</span><span class=\"c-lbl\">profissionais mapeados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"12\">12</span><span class=\"c-lbl\">competências críticas</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">anos de roadmap</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O assessment foi além do diagnóstico. Chegamos com um plano claro, priorizado e com o buy-in das lideranças para os próximos cinco anos de desenvolvimento.\"</p>\n          <cite>Fernanda Costa — CHRO LATAM, PepsiCo</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n</main>\n\n<!-- ============ CTA ============ -->\n<section class=\"cta-block\">\n  <div>\n    <p class=\"cta-eyebrow\">Próximo passo</p>\n    <h2 class=\"cta-title\">PRONTO PARA<br>SER O PRÓXIMO<br><span class=\"t-orange\">CASE?</span>\n</h2>\n    <p class=\"cta-p\">Conte o desafio do seu time. A gente ouve, entende e constrói uma jornada que faz sentido para o seu momento — e para os próximos cinco anos.</p>\n  </div>\n  <div class=\"cta-right\">\n    <div class=\"cta-person\">\n      <div class=\"cta-avatar\">VI</div>\n      <div>\n        <p class=\"cta-pname\">Vivi Ishikawa</p>\n        <p class=\"cta-prole\">Business Development — Hyper Island Brasil</p>\n      </div>\n    </div>\n    <a href=\"mailto:learning.latam@hyperisland.com\" class=\"btn-primary\">Agendar uma conversa →</a>\n    <a href=\"https://wa.me/5511999999999\" class=\"btn-sec\">Enviar mensagem</a>\n  </div>\n</section>\n\n<!-- ============ FOOTER ============ -->\n<footer class=\"footer\">\n  <span class=\"footer-logo\">HYPER ISLAND</span>\n  <span class=\"footer-copy\">© 1996–2026 Hyper Island · learning.latam@hyperisland.com</span>\n</footer>\n\n<script>\n/* =========================================\n   PHOTO PLACEHOLDER HELPER\n   Show image/video and hide placeholder once src is set\n   ========================================= */\ndocument.querySelectorAll('.case-vis img, .case-vis video').forEach(media => {\n  if (!media.src || media.src === window.location.href) return;\n  media.style.display = '';\n  const ph = media.closest('.case-vis').querySelector('.case-placeholder');\n  if (ph) ph.style.display = 'none';\n  media.addEventListener('load', () => {\n    media.style.display = '';\n    if (ph) ph.style.display = 'none';\n  });\n});\n\n/* =========================================\n   FILTER SYSTEM\n   ========================================= */\nconst state = { industry: null, type: null, territory: null };\n\nconst labels = {\n  industry:  { financeiro:'Financeiro', tecnologia:'Tecnologia', consumo:'Consumo & Varejo', industrial:'Industrial' },\n  type:      { jornada:'Jornada de Transformação', workshop:'Workshop', sprint:'Sprint de Inovação',\n               palestra:'Palestra', curso:'Curso In-Company', cocriacoes:'Cocriação', assessment:'Assessment de Skills' },\n  territory: { futuro:'Visão de Futuro & Estratégia', inovacao:'Inovação & Criatividade',\n               tecnologias:'Tecnologias Emergentes', lideranca:'Liderança & Cultura' }\n};\n\nfunction toggleDrop(cat) {\n  const drop = document.getElementById('drop-' + cat);\n  const trig = document.getElementById('trig-' + cat);\n  const isOpen = drop.classList.contains('is-open');\n  // Close all\n  document.querySelectorAll('.f-dropdown').forEach(d => d.classList.remove('is-open'));\n  document.querySelectorAll('.f-trigger').forEach(t => t.classList.remove('is-open'));\n  if (!isOpen) {\n    drop.classList.add('is-open');\n    trig.classList.add('is-open');\n  }\n}\n\nfunction selectF(el) {\n  const cat = el.dataset.cat;\n  const val = el.dataset.val;\n  // Toggle (radio per category)\n  if (state[cat] === val) {\n    state[cat] = null;\n    el.classList.remove('is-sel');\n    el.querySelector('.f-chk').textContent = '';\n  } else {\n    // Clear previous selection in this category\n    document.querySelectorAll('#drop-' + cat + ' .f-opt').forEach(o => {\n      o.classList.remove('is-sel');\n      o.querySelector('.f-chk').textContent = '';\n    });\n    state[cat] = val;\n    el.classList.add('is-sel');\n    el.querySelector('.f-chk').textContent = '✓';\n  }\n  applyFilters();\n  renderChips();\n  updateTriggers();\n  // Close dropdown\n  setTimeout(() => {\n    document.getElementById('drop-' + cat).classList.remove('is-open');\n    document.getElementById('trig-' + cat).classList.remove('is-open');\n  }, 160);\n}\n\nfunction applyFilters() {\n  const items = document.querySelectorAll('.case-item');\n  let count = 0;\n  items.forEach(item => {\n    const ok =\n      (!state.industry  || item.dataset.industry  === state.industry)  &&\n      (!state.type      || item.dataset.type      === state.type)      &&\n      (!state.territory || item.dataset.territory === state.territory);\n    if (ok) {\n      item.classList.remove('is-hidden');\n      // Ensure visible animation\n      if (!item.classList.contains('is-vis')) item.classList.add('is-vis');\n      count++;\n    } else {\n      item.classList.add('is-hidden');\n    }\n  });\n  document.getElementById('fCount').textContent = count + (count === 1 ? ' case' : ' cases');\n  document.getElementById('emptyState').classList.toggle('is-vis', count === 0);\n}\n\nfunction renderChips() {\n  const container = document.getElementById('fChips');\n  container.innerHTML = '';\n  let any = false;\n  Object.keys(state).forEach(cat => {\n    const val = state[cat];\n    if (!val) return;\n    any = true;\n    const chip = document.createElement('div');\n    chip.className = 'f-chip';\n    chip.innerHTML = (labels[cat][val] || val) + ' <span class=\"f-chip-x\" data-cat=\"' + cat + '\">×</span>';\n    chip.querySelector('.f-chip-x').addEventListener('click', e => {\n      removeFilter(e.target.dataset.cat);\n    });\n    container.appendChild(chip);\n  });\n  document.getElementById('clearBtn').classList.toggle('is-vis', any);\n}\n\nfunction updateTriggers() {\n  ['industry','type','territory'].forEach(cat => {\n    const trig = document.getElementById('trig-' + cat);\n    const badge = trig.querySelector('.f-badge');\n    if (state[cat]) {\n      if (!badge) {\n        const b = document.createElement('span');\n        b.className = 'f-badge'; b.textContent = '1';\n        trig.appendChild(b);\n      }\n      trig.classList.add('is-active');\n    } else {\n      if (badge) badge.remove();\n      trig.classList.remove('is-active');\n    }\n  });\n}\n\nfunction removeFilter(cat) {\n  state[cat] = null;\n  document.querySelectorAll('#drop-' + cat + ' .f-opt').forEach(o => {\n    o.classList.remove('is-sel');\n    o.querySelector('.f-chk').textContent = '';\n  });\n  applyFilters();\n  renderChips();\n  updateTriggers();\n}\n\nfunction clearAll() {\n  Object.keys(state).forEach(k => {\n    state[k] = null;\n    document.querySelectorAll('#drop-' + k + ' .f-opt').forEach(o => {\n      o.classList.remove('is-sel');\n      o.querySelector('.f-chk').textContent = '';\n    });\n  });\n  applyFilters();\n  renderChips();\n  updateTriggers();\n}\n\n// Close dropdowns on outside click\ndocument.addEventListener('click', e => {\n  if (!e.target.closest('.f-group')) {\n    document.querySelectorAll('.f-dropdown').forEach(d => d.classList.remove('is-open'));\n    document.querySelectorAll('.f-trigger').forEach(t => t.classList.remove('is-open'));\n  }\n});\n\n/* =========================================\n   SCROLL REVEAL\n   ========================================= */\nconst revealObs = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      e.target.classList.add('is-vis');\n      revealObs.unobserve(e.target);\n    }\n  });\n}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });\n\ndocument.querySelectorAll('.case-item').forEach((item, i) => {\n  item.style.transitionDelay = (i < 2 ? i * 0.06 : 0) + 's';\n  revealObs.observe(item);\n});\n\n/* =========================================\n   STAT COUNTER ANIMATION\n   ========================================= */\nfunction animCount(el) {\n  const orig = el.textContent;\n  const n = parseInt(el.dataset.n);\n  if (isNaN(n)) return;\n  const suffix = orig.replace(/[\\d.,]/g, '');\n  const dur = 1100;\n  const t0 = performance.now();\n  function tick(now) {\n    const p = Math.min((now - t0) / dur, 1);\n    const ease = 1 - Math.pow(1 - p, 3);\n    const cur = Math.round(n * ease);\n    el.textContent = cur.toLocaleString('pt-BR') + suffix;\n    if (p < 1) requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n}\n\nconst statObs = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      e.target.querySelectorAll('.c-num').forEach(animCount);\n      statObs.unobserve(e.target);\n    }\n  });\n}, { threshold: 0.25 });\n\ndocument.querySelectorAll('.case-item').forEach(item => statObs.observe(item));\n</script>",
