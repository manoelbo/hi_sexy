      "settings": {
        "html": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cases — Hyper Island Brasil</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&amp;display=swap\" rel=\"stylesheet\">\n<style>\n/* =========================================\n   RESET & TOKENS\n   ========================================= */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n:root {\n  --cream:       #F2EAE0;\n  --cream-panel: #E8DFCF;\n  --ink:         #0C0A09;\n  --white:       #FEFCF8;\n  --orange:      #E64E0E;\n  --orange-soft: #F28050;\n  --gray:        #7A726A;\n  --gray-light:  #AFA89F;\n  --border:      rgba(12,10,9,0.10);\n  --border-mid:  rgba(12,10,9,0.18);\n  --f-disp:      'Bebas Neue', Impact, sans-serif;\n  --f-body:      'Plus Jakarta Sans', sans-serif;\n  --ease:        cubic-bezier(0.16,1,0.3,1);\n}\n\nhtml  { scroll-behavior: smooth; font-size: 16px; overflow-x: hidden; }\nbody  {\n  font-family: var(--f-body);\n  background: var(--cream);\n  color: var(--ink);\n  -webkit-font-smoothing: antialiased;\n}\n\n/* =========================================\n   HERO\n   ========================================= */\n.hero {\n  padding: 72px 48px 60px;\n  border-bottom: 1px solid var(--border-mid);\n  position: relative; overflow: hidden;\n}\n.hero-crumb {\n  font-size: 11px; font-weight: 600; letter-spacing: 0.12em;\n  text-transform: uppercase; color: var(--gray-light);\n  display: flex; align-items: center; gap: 10px;\n  margin-bottom: 22px;\n}\n.hero-crumb::after {\n  content: ''; display: block;\n  width: 36px; height: 1px; background: var(--gray-light);\n}\n.hero-title {\n  \n  font-size: clamp(68px, 9.5vw, 132px);\n  line-height: 0.9; letter-spacing: 0.025em;\n  margin-bottom: 28px; max-width: 820px;\n}\n.hero-title .t-orange { color: var(--orange); }\n.hero-desc {\n  font-size: 15px; font-weight: 300; line-height: 1.75;\n  color: var(--gray); max-width: 460px; margin-bottom: 52px;\n}\n.hero-stats {\n  display: flex; gap: 0;\n  border-top: 1px solid var(--border-mid);\n  padding-top: 32px;\n}\n.hero-stat {\n  padding-right: 40px; margin-right: 40px;\n  border-right: 1px solid var(--border-mid);\n}\n.hero-stat:last-child { border-right: none; }\n.hero-stat .s-num {\n  font-family: var(--f-disp);\n  font-size: 52px; letter-spacing: 0.03em; line-height: 1;\n  color: var(--ink); display: block;\n}\n.hero-stat .s-lbl {\n  font-size: 10px; font-weight: 600;\n  letter-spacing: 0.1em; text-transform: uppercase;\n  color: var(--gray-light); margin-top: 5px; display: block;\n}\n/* subtle background mark */\n.hero::after {\n  content: 'CASES';\n  font-family: var(--f-disp);\n  font-size: 280px; letter-spacing: 0.04em;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.05);\n  position: absolute; bottom: -60px; right: -20px;\n  pointer-events: none; user-select: none; line-height: 1;\n}\n\n/* =========================================\n   FILTER BAR\n   ========================================= */\n.filter-bar {\n  position: sticky; top: 0; z-index: 200;\n  background: rgba(242,234,224,0.98);\n  border-bottom: 1px solid var(--border-mid);\n  padding: 0 48px;\n  overflow: visible;\n}\n.filter-row {\n  display: flex; align-items: center;\n  gap: 8px; height: 50px;\n  border-bottom: 1px solid var(--border);\n  overflow: visible;\n}\n.f-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--gray-light); margin-right: 6px; flex-shrink: 0;\n}\n.f-sep { width: 1px; height: 22px; background: var(--border-mid); margin: 0 6px; }\n.f-group { position: relative; overflow: visible; }\n.f-trigger {\n  display: flex; align-items: center; gap: 5px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--ink); background: none;\n  border: 1px solid var(--border-mid);\n  padding: 6px 13px; border-radius: 2px;\n  cursor: pointer; white-space: nowrap;\n  transition: background .15s, border-color .15s, color .15s;\n}\n.f-trigger:hover { background: var(--cream-panel); }\n.f-trigger.is-active {\n  background: var(--ink); color: var(--cream); border-color: var(--ink);\n}\n.f-trigger .chev { font-size: 9px; transition: transform .2s; line-height: 1; }\n.f-trigger.is-open .chev { transform: rotate(180deg); }\n.f-badge {\n  width: 15px; height: 15px; border-radius: 50%;\n  background: var(--orange); color: #fff;\n  font-size: 8px; font-weight: 800;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.f-dropdown {\n  display: none; flex-direction: column;\n  position: absolute; top: calc(100% + 8px); left: 0;\n  background: var(--white);\n  border: 1px solid var(--border-mid);\n  border-radius: 3px; min-width: 240px;\n  box-shadow: 0 10px 36px rgba(12,10,9,0.18);\n  overflow: visible; z-index: 9999;\n}\n.f-dropdown.is-open { display: flex !important; }\n.f-opt {\n  padding: 10px 16px;\n  font-size: 12px; font-weight: 400;\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border); color: var(--ink);\n  transition: background .1s;\n}\n.f-opt:last-child { border-bottom: none; }\n.f-opt:hover { background: var(--cream); }\n.f-opt.is-sel { font-weight: 600; color: var(--orange); }\n.f-chk {\n  width: 14px; height: 14px; border-radius: 2px;\n  border: 1.5px solid var(--border-mid);\n  display: inline-flex; align-items: center; justify-content: center;\n  font-size: 9px; flex-shrink: 0;\n}\n.f-opt.is-sel .f-chk { background: var(--orange); border-color: var(--orange); color: #fff; }\n.f-clear {\n  margin-left: auto;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--gray-light); background: none; border: none;\n  cursor: pointer; padding: 6px 8px;\n  transition: color .15s; display: none;\n}\n.f-clear.is-vis { display: block; }\n.f-clear:hover { color: var(--orange); }\n.f-count {\n  margin-left: 12px;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--gray-light); flex-shrink: 0;\n}\n.f-chips {\n  display: flex; gap: 6px; flex-wrap: wrap;\n  padding: 8px 0;\n}\n.f-chips:empty { padding: 0; height: 0; overflow: hidden; border: none; }\n.f-chip {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-size: 10px; font-weight: 700; letter-spacing: 0.07em;\n  text-transform: uppercase;\n  background: var(--ink); color: var(--cream);\n  padding: 4px 10px; border-radius: 2px;\n}\n.f-chip-x {\n  font-size: 13px; cursor: pointer; line-height: 1;\n  opacity: 0.5; transition: opacity .15s;\n}\n.f-chip-x:hover { opacity: 1; }\n\n/* =========================================\n   CASES FEED\n   ========================================= */\n.cases-feed { }\n\n.empty-state {\n  display: none; flex-direction: column; align-items: center;\n  padding: 80px 48px; text-align: center;\n}\n.empty-state.is-vis { display: flex; }\n.empty-state h3 {\n  font-family: var(--f-disp); font-size: 42px;\n  letter-spacing: 0.04em; margin-bottom: 10px;\n}\n.empty-state p { font-size: 14px; color: var(--gray); }\n\n/* Case item */\n.case-item {\n  display: grid; grid-template-columns: 1fr 1fr;\n  min-height: 600px;\n  border-bottom: 1px solid var(--border-mid);\n\n  transition: opacity .75s var(--ease), transform .75s var(--ease);\n}\n.case-item.is-vis { opacity: 1; transform: translateY(0); }\n.case-item.is-hidden { display: none; }\n\n/* Odd: visual LEFT, content RIGHT */\n.case-item:nth-child(odd)  .case-vis { order: 1; background: var(--cream-panel); }\n.case-item:nth-child(odd)  .case-cnt { order: 2; }\n/* Even: content LEFT, visual RIGHT */\n.case-item:nth-child(even) .case-vis { order: 2; background: var(--ink); }\n.case-item:nth-child(even) .case-cnt { order: 1; }\n\n/* Visual panel */\n.case-vis {\n  position: relative; overflow: hidden;\n}\n.case-vis img, .case-vis video {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%;\n  object-fit: cover;\n  transition: transform .7s var(--ease);\n}\n.case-vis:hover img, .case-vis:hover video { transform: scale(1.04); }\n\n/* Placeholder */\n.case-placeholder {\n  position: absolute; inset: 0;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center; gap: 8px;\n}\n.case-placeholder .ph-icon {\n  width: 48px; height: 48px; border-radius: 50%;\n  border: 1.5px solid currentColor;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 20px; opacity: 0.3;\n}\n.case-placeholder .ph-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.28;\n}\n.case-placeholder .ph-hint {\n  font-size: 10px; opacity: 0.2; font-family: var(--f-body);\n  letter-spacing: 0.04em;\n}\n\n/* Content panel */\n.case-cnt {\n  padding: 52px 52px 52px 52px;\n  display: flex; flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n}\n\n/* Ghost number */\n.case-ghost {\n  font-family: var(--f-disp);\n  font-size: 130px; letter-spacing: 0.02em; line-height: 1;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.07);\n  position: absolute; top: 24px; right: 36px;\n  pointer-events: none; user-select: none;\n}\n\n/* Tags */\n.case-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 18px; }\n.tag {\n  display: inline-block;\n  font-size: 9px; font-weight: 800; letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 3px 9px; border-radius: 2px; border: 1px solid;\n}\n.tag-fut  { color: #1A4FD4; border-color: #1A4FD4; }\n.tag-inn  { color: var(--orange); border-color: var(--orange); }\n.tag-tec  { color: #07786E; border-color: #07786E; }\n.tag-lid  { color: #7C2A08; border-color: #7C2A08; }\n.tag-sec  { color: var(--gray); border-color: var(--border-mid); }\n\n/* Client name */\n.case-client {\n  font-family: var(--f-disp);\n  font-size: 48px; letter-spacing: 0.04em; line-height: 1;\n  color: var(--ink); margin-bottom: 14px;\n}\n\n/* Title */\n.case-title {\n  font-size: 24px; font-weight: 500; line-height: 1.35;\n  color: var(--ink); margin-bottom: 18px; max-width: 600px;\n}\n\n/* Description */\n.case-desc {\n  font-size: 13px; font-weight: 300; line-height: 1.8;\n  color: var(--gray); max-width: 500px; margin-bottom: 0;\n}\n\n/* Stats */\n.case-stats {\n  display: flex; gap: 28px;\n  padding-top: 22px; margin-top: 22px;\n  border-top: 1px solid var(--border);\n}\n.c-stat .c-num {\n  font-family: var(--f-disp);\n  font-size: 38px; letter-spacing: 0.02em; line-height: 1;\n  color: var(--orange); display: block;\n}\n.c-stat .c-lbl {\n  font-size: 10px; font-weight: 600; letter-spacing: 0.09em;\n  text-transform: uppercase; color: var(--gray-light);\n  margin-top: 3px; display: block;\n}\n\n/* Quote */\n.case-quote {\n  padding-left: 16px;\n  border-left: 3px solid var(--orange);\n  margin-top: 22px;\n}\n.case-quote p {\n  font-size: 13px; font-style: italic;\n  font-weight: 300; line-height: 1.7;\n  color: var(--gray); margin-bottom: 7px;\n}\n.case-quote cite {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.08em; text-transform: uppercase;\n  color: var(--ink); font-style: normal;\n}\n\n/* Link */\n.case-link {\n  display: inline-flex; align-items: center; gap: 7px;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); text-decoration: none;\n  border-bottom: 1.5px solid var(--ink);\n  padding-bottom: 1px; margin-top: 22px; width: fit-content;\n  transition: color .2s, border-color .2s;\n}\n.case-link:hover { color: var(--orange); border-color: var(--orange); }\n.case-link .arr { transition: transform .2s; display: inline-block; }\n.case-link:hover .arr { transform: translateX(4px); }\n\n/* =========================================\n   CTA BLOCK\n   ========================================= */\n.cta-block {\n  background: var(--ink);\n  padding: 80px 48px;\n  display: grid; grid-template-columns: 1fr 1fr;\n  gap: 64px; align-items: center;\n}\n.cta-eyebrow {\n  font-size: 10px; font-weight: 700; letter-spacing: 0.14em;\n  text-transform: uppercase; color: rgba(255,255,255,0.3);\n  margin-bottom: 16px;\n}\n.cta-title {\n  font-family: var(--f-disp);\n  font-size: clamp(52px, 6.5vw, 96px);\n  line-height: 0.9; letter-spacing: 0.02em;\n  color: var(--cream); margin-bottom: 18px;\n}\n.cta-title .t-orange { color: var(--orange); }\n.cta-p {\n  font-size: 14px; font-weight: 300; line-height: 1.75;\n  color: rgba(255,255,255,0.45);\n}\n.cta-right { display: flex; flex-direction: column; gap: 14px; }\n.cta-person {\n  display: flex; align-items: center; gap: 14px; margin-bottom: 6px;\n}\n.cta-avatar {\n  width: 50px; height: 50px; border-radius: 50%;\n  background: var(--orange-soft);\n  display: flex; align-items: center; justify-content: center;\n  font-family: var(--f-disp); font-size: 19px; letter-spacing: 0.04em;\n  color: var(--white); flex-shrink: 0;\n}\n.cta-pname { font-size: 14px; font-weight: 600; color: var(--cream); margin-bottom: 2px; }\n.cta-prole { font-size: 11px; color: rgba(255,255,255,0.35); }\n.btn-primary {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); background: var(--cream); border: none;\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: background .2s, transform .15s;\n}\n.btn-primary:hover { background: #fff; transform: translateY(-1px); }\n.btn-sec {\n  display: inline-flex; align-items: center;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.45); background: none;\n  border: 1px solid rgba(255,255,255,0.18);\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: border-color .2s, color .2s;\n}\n.btn-sec:hover { border-color: rgba(255,255,255,0.45); color: var(--cream); }\n\n/* =========================================\n   FOOTER\n   ========================================= */\n.footer {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 22px 48px;\n  border-top: 1px solid var(--border-mid);\n}\n.footer-logo { font-family: var(--f-disp); font-size: 17px; letter-spacing: 0.06em; }\n.footer-copy { font-size: 11px; color: var(--gray-light); }\n\n/* =========================================\n   RESPONSIVE\n   ========================================= */\n@media (max-width: 900px) {\n  .nav-links { display: none; }\n  .hero { padding: 48px 24px 40px; }\n  .hero::after { display: none; }\n  .hero-stats { gap: 0; overflow-x: auto; }\n  .hero-stat { padding-right: 24px; margin-right: 24px; flex-shrink: 0; }\n  .filter-bar, .footer { padding: 0 24px; }\n  .filter-row { overflow-x: auto; }\n  .case-item { grid-template-columns: 1fr; min-height: auto; }\n  .case-item:nth-child(odd)  .case-vis,\n  .case-item:nth-child(even) .case-vis { order: 1; height: 280px; }\n  .case-item:nth-child(odd)  .case-cnt,\n  .case-item:nth-child(even) .case-cnt { order: 2; }\n  .case-cnt { padding: 36px 28px; }\n  .cta-block { grid-template-columns: 1fr; padding: 60px 24px; gap: 40px; }\n}\n</style>\n\n\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <p class=\"hero-crumb\">Para Empresas · Cases</p>\n  <h1 class=\"hero-title\">TRANSFORMAÇÃO<br>REAL. <span class=\"t-orange\">RESULTADOS</span><br>QUE FICAM.</h1>\n  <p class=\"hero-desc\">Como as maiores empresas do Brasil e do mundo desenvolvem seus times com a Hyper Island — e o que mudou depois.</p>\n  <div class=\"hero-stats\">\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">2.000+</span>\n      <span class=\"s-lbl\">Empresas atendidas</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">30</span>\n      <span class=\"s-lbl\">Anos de metodologia</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">50.000+</span>\n      <span class=\"s-lbl\">Profissionais treinados</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">40+</span>\n      <span class=\"s-lbl\">Países alcançados</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FILTER BAR ============ -->\n<div class=\"filter-bar\" id=\"filterBar\">\n  <div class=\"filter-row\">\n    <span class=\"f-label\">Filtrar</span>\n\n    <!-- Setor -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-industry\">\n        Setor <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-industry\">\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"financeiro\">Financeiro &amp; Bancos <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"tecnologia\">Tecnologia &amp; Software <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"consumo\">Consumo &amp; Varejo <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"industrial\">Industrial &amp; Manufatura <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"saude\">Saúde &amp; Farma <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"energia\">Energia &amp; Utilities <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"midia\">Mídia &amp; Entretenimento <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"telecom\">Telecom <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"agro\">Agronegócio <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"educacao\">Educação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"logistica\">Logística &amp; Transporte <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"governo\">Governo &amp; Setor Público <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <!-- Tipo -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-type\">\n        Tipo de Projeto <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-type\">\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"jornada\">Jornada de Transformação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"workshop\">Workshop <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"sprint\">Sprint de Inovação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"palestra\">Palestra <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"curso\">Curso In-Company <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"cocriacoes\">Cocriação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"assessment\">Assessment de Skills <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <!-- Área de Treinamento -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-territory\">\n        Área de Treinamento <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-territory\">\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"futuro\">Visão de Futuro &amp; Estratégia <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"inovacao\">Inovação &amp; Criatividade <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"tecnologias\">Tecnologias Emergentes &amp; Transformação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"lideranca\">Liderança &amp; Cultura <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <div class=\"f-sep\"></div>\n    <button class=\"f-clear\" id=\"clearBtn\">✕ Limpar filtros</button>\n    <span class=\"f-count\" id=\"fCount\">8 cases</span>\n  </div>\n  <div class=\"f-chips\" id=\"fChips\"></div>\n</div>\n\n<!-- ============ CASES FEED ============ -->\n<main class=\"cases-feed\">\n\n  <div class=\"empty-state\" id=\"emptyState\">\n    <h3>NENHUM CASE ENCONTRADO</h3>\n    <p>Tente remover alguns filtros para ver mais resultados.</p>\n  </div>\n\n  <!-- ========== CASE 01 — JUNTOS SOMOS MAIS ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"industrial\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/PXL_20251209_141349146.PORTRAIT.jpg?v=1776298330\" alt=\"Case Juntos Somos Mais\">\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">01</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Industrial &amp; Manufatura</span>\n        </div>\n        <div class=\"case-client\">JUNTOS SOMOS MAIS</div>\n        <h2 class=\"case-title\">Três anos, três momentos e uma parceria que cresceu junto com a liderança.</h2>\n        <p class=\"case-desc\">Parceria de três anos com a Juntos Somos Mais que começou em 2023 com um programa de integração para 25 líderes, evoluiu em 2025 para um ciclo robusto de desenvolvimento em três níveis hierárquicos simultâneos com 40 pessoas e chegou em 2026 com foco na aplicação prática do que foi construído sob uma nova liderança executiva.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">Anos de parceria</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"40\">+40</span><span class=\"c-lbl\">Líderes treinados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">Níveis de liderança</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O primeiro treinamento que fizemos em 2023 foi um divisor de águas aqui pra gente e para muitos dos nossos líderes.\"</p>\n          <cite>Yasmin Lopes — Coordenadora de HRBP, Juntos Somos Mais</cite>\n        </blockquote>\n        <a href=\"https://www.hyperisland.com.br/pages/case-study/juntos-somos-mais\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 02 — STELLANTIS ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"industrial\" data-type=\"cocriacoes\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 02: substitua o src abaixo pelo link da imagem ou vídeo do case Stellantis -->\n      <img src=\"https://cdn.shopify.com/s/files/1/0634/7023/9966/files/stellantis_pic_6.png?v=1777221079\" alt=\"Case Stellantis\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-02-stellantis.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">02</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-sec\">Cocriação</span>\n          <span class=\"tag tag-sec\">Industrial &amp; Manufatura</span>\n        </div>\n        <div class=\"case-client\">STELLANTIS</div>\n        <h2 class=\"case-title\">Quando a pergunta certa vale mais do que a resposta pronta</h2>\n        <p class=\"case-desc\">A Stellantis chegou à Hyper Island sem um briefing fechado. A partir dessa abertura, a Hyper Island construiu um processo completo de mapeamento e desenvolvimento de competências para 30 líderes, combinando desk research, workshop estratégico com VP e Diretoria, self-assessment, entrevistas e um comitê de calibração que gerou relatórios individuais e coletivos de desenvolvimento. Em paralelo, conduziu sessões de facilitação e governança para mais de 300 pessoas no Brasil, Argentina, Chile e South America, ajudando o time de marketing a melhorar a forma como trabalha junto, toma decisões e atravessa conflitos. Uma parceria que existe desde 2020 e que se renova porque vai fundo onde os outros param na superfície.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"300\">+300</span><span class=\"c-lbl\">pessoas</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"4\">4</span><span class=\"c-lbl\">países</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">anos de parceria</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Com reflexões valiosas, vivemos uma jornada guiada pela Hyper Island, que nos trouxe perspectivas sobre como potencializar o impacto positivo das marcas.\"</p>\n          <cite>Alessandra Souza — Chief Marketing Officer, Stellantis</cite>\n        </blockquote>\n        <a href=\"https://www.hyperisland.com.br/pages/case-study/case-study-pyxcq4ub\" class=\"case-link\" target=\"_blank\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 03 — BRADESCO ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"financeiro\" data-type=\"curso\" data-territory=\"tecnologias\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 03: substitua o src abaixo pelo link da imagem ou vídeo do case Bradesco -->\n      <img src=\"\" alt=\"Case Bradesco\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--ink);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-03-bradesco.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">03</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-tec\">Tecnologias Emergentes</span>\n          <span class=\"tag tag-sec\">Curso In-Company</span>\n          <span class=\"tag tag-sec\">Financeiro</span>\n        </div>\n        <div class=\"case-client\">BRADESCO</div>\n        <h2 class=\"case-title\">Preparando 2.000 colaboradores para trabalhar com IA generativa no dia a dia</h2>\n        <p class=\"case-desc\">Programa de capacitação em 4 módulos — desde fundamentos de IA até aplicação prática em fluxos reais — desenvolvido para habilitar equipes de diferentes áreas a incorporarem inteligência artificial no cotidiano profissional.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"2000\">2.000</span><span class=\"c-lbl\">colaboradores</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"4\">4</span><span class=\"c-lbl\">módulos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"87\">87%</span><span class=\"c-lbl\">taxa de conclusão</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O grande diferencial foi equilibrar teoria com aplicação prática imediata. Os times saíram com ferramentas e confiança para usar IA no trabalho real.\"</p>\n          <cite>Carla Menezes — CHRO, Bradesco</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 04 — SCANIA ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"industrial\" data-type=\"workshop\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 04: substitua o src abaixo pelo link da imagem ou vídeo do case Scania -->\n      <img src=\"\" alt=\"Case Scania\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-04-scania.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">04</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-sec\">Workshop</span>\n          <span class=\"tag tag-sec\">Industrial</span>\n        </div>\n        <div class=\"case-client\">SCANIA</div>\n        <h2 class=\"case-title\">Redesenhando a estratégia para 2030 com futures thinking e design de cenários</h2>\n        <p class=\"case-desc\">Três workshops intensivos com a alta liderança para explorar cenários de futuro, desafiar premissas estratégicas e construir uma visão compartilhada para o crescimento da Scania na América Latina até 2030.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">workshops</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"80\">80</span><span class=\"c-lbl\">executivos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">diretrizes estratégicas</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Conseguimos criar um alinhamento estratégico real entre lideranças de diferentes países. A abordagem de futures foi reveladora para toda a equipe.\"</p>\n          <cite>Martin Andersson — VP of Strategy LATAM, Scania</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 05 — GOOGLE ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"tecnologia\" data-type=\"palestra\" data-territory=\"tecnologias\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 05: substitua o src abaixo pelo link da imagem ou vídeo do case Google -->\n      <img src=\"\" alt=\"Case Google\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--ink);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-05-google.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">05</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-tec\">Tecnologias Emergentes</span>\n          <span class=\"tag tag-sec\">Palestra + Workshop</span>\n          <span class=\"tag tag-sec\">Tecnologia</span>\n        </div>\n        <div class=\"case-client\">GOOGLE</div>\n        <h2 class=\"case-title\">IA generativa como copiloto criativo para times de marketing e produto em 9 países</h2>\n        <p class=\"case-desc\">Programa combinado de palestra inspiracional e workshops hands-on para capacitar times a integrar ferramentas de IA generativa nos fluxos criativos — sem perder a autenticidade e identidade da marca.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"500\">500</span><span class=\"c-lbl\">participantes</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"2\">2</span><span class=\"c-lbl\">dias intensivos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"9\">9</span><span class=\"c-lbl\">países envolvidos</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A Hyper Island conseguiu fazer algo difícil: tornar IA tangível e humana ao mesmo tempo. Os times saíram com clareza de como usar sem perder sua identidade.\"</p>\n          <cite>Renata Moreira — Head of L&amp;D LATAM, Google</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 06 — NESTLÉ ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"consumo\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 06: substitua o src abaixo pelo link da imagem ou vídeo do case Nestlé -->\n      <img src=\"\" alt=\"Case Nestlé\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-06-nestle.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">06</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">NESTLÉ</div>\n        <h2 class=\"case-title\">Reconstruindo a cultura de times híbridos em 14 países simultaneamente</h2>\n        <p class=\"case-desc\">Jornada de transformação cultural desenhada para times que trabalham de forma distribuída, com foco em criar pertencimento, alinhamento de propósito e rituais de colaboração que funcionam além das fronteiras geográficas.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"14\">14</span><span class=\"c-lbl\">países</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"1200\">1.200</span><span class=\"c-lbl\">pessoas envolvidas</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"18\">18</span><span class=\"c-lbl\">meses de jornada</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Conseguimos criar uma cultura comum em times que nunca se encontram pessoalmente. Isso era algo que achávamos impossível antes desse programa.\"</p>\n          <cite>Isabela Santos — VP People &amp; Culture LATAM, Nestlé</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 07 — JUNTOS SOMOS MAIS ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"consumo\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <video autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\">\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/b5d58dac538d47ff919e17065d6d54cd.mp4\" type=\"video/mp4\">\n      </source></video>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">07</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">JUNTOS SOMOS MAIS</div>\n        <h2 class=\"case-title\">Construindo uma cultura de alta performance em uma empresa de crescimento acelerado</h2>\n        <p class=\"case-desc\">Jornada de desenvolvimento cultural para times de liderança de uma das maiores plataformas de fidelidade do agronegócio brasileiro — criando rituais, comportamentos e uma identidade de time que sustentasse o crescimento acelerado da empresa.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"120\">120</span><span class=\"c-lbl\">líderes</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"8\">8</span><span class=\"c-lbl\">meses de jornada</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"96\">96%</span><span class=\"c-lbl\">NPS do programa</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A jornada nos ajudou a transformar velocidade de crescimento em cultura sólida. Hoje temos líderes que sabem conduzir times em ambientes de alta incerteza.\"</p>\n          <cite>Diretoria de Pessoas — Juntos Somos Mais</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 08 — PEPSICO ========== -->\n  <article class=\"case-item is-vis\" data-industry=\"consumo\" data-type=\"assessment\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <!-- FOTO/VÍDEO 08: substitua o src abaixo pelo link da imagem ou vídeo do case PepsiCo -->\n      <img src=\"\" alt=\"Case PepsiCo\" style=\"display:none\">\n      <div class=\"case-placeholder\" style=\"color: var(--cream);\">\n        <div class=\"ph-icon\">▶</div>\n        <span class=\"ph-label\">Foto / Vídeo</span>\n        <span class=\"ph-hint\">case-08-pepsico.jpg</span>\n      </div>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">08</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-fut\">Visão de Futuro &amp; Estratégia</span>\n          <span class=\"tag tag-sec\">Assessment de Skills</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">PEPSICO</div>\n        <h2 class=\"case-title\">Mapeando competências críticas para construir a estratégia de talentos 2025–2030</h2>\n        <p class=\"case-desc\">Processo estruturado de assessment das competências críticas para o futuro — mapeando onde a organização está hoje e onde precisa chegar em 5 anos — para embasar o roadmap de desenvolvimento de talentos da PepsiCo LATAM.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"800\">800</span><span class=\"c-lbl\">profissionais mapeados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"12\">12</span><span class=\"c-lbl\">competências críticas</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"5\">5</span><span class=\"c-lbl\">anos de roadmap</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O assessment foi além do diagnóstico. Chegamos com um plano claro, priorizado e com o buy-in das lideranças para os próximos cinco anos de desenvolvimento.\"</p>\n          <cite>Fernanda Costa — CHRO LATAM, PepsiCo</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n</main>\n\n<!-- ============ CTA ============ -->\n<section class=\"cta-block\">\n  <div>\n    <p class=\"cta-eyebrow\">Próximo passo</p>\n    <h2 class=\"cta-title\">PRONTO PARA<br>SER O PRÓXIMO<br><span class=\"t-orange\">CASE?</span>\n</h2>\n    <p class=\"cta-p\">Conte o desafio do seu time. A gente ouve, entende e constrói uma jornada que faz sentido para o seu momento — e para os próximos cinco anos.</p>\n  </div>\n  <div class=\"cta-right\">\n    <div class=\"cta-person\">\n      <div class=\"cta-avatar\">VI</div>\n      <div>\n        <p class=\"cta-pname\">Vivi Ishikawa</p>\n        <p class=\"cta-prole\">Business Development — Hyper Island Brasil</p>\n      </div>\n    </div>\n    <a href=\"/cdn-cgi/l/email-protection#a6cac3c7d4c8cfc8c188cac7d2c7cbe6cedfd6c3d4cfd5cac7c8c288c5c9cb\" class=\"btn-primary\">Agendar uma conversa →</a>\n    <a href=\"https://wa.me/5511999999999\" class=\"btn-sec\">Enviar mensagem</a>\n  </div>\n</section>\n\n<!-- ============ FOOTER ============ -->\n<footer class=\"footer\">\n  <span class=\"footer-logo\">HYPER ISLAND</span>\n  <span class=\"footer-copy\">© 1996–2026 Hyper Island · <a href=\"/cdn-cgi/l/email-protection\" class=\"__cf_email__\" data-cfemail=\"f5999094879b9c9b92db9994819498b59d8c8590879c8699949b91db969a98\">[email protected]</a></span>\n</footer>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n/* =========================================\n   PHOTO PLACEHOLDER HELPER\n   Show image/video and hide placeholder once src is set\n   ========================================= */\ndocument.querySelectorAll('.case-vis img, .case-vis video').forEach(media => {\n  if (!media.src || media.src === window.location.href) return;\n  media.style.display = '';\n  const ph = media.closest('.case-vis').querySelector('.case-placeholder');\n  if (ph) ph.style.display = 'none';\n  media.addEventListener('load', () => {\n    media.style.display = '';\n    if (ph) ph.style.display = 'none';\n  });\n});\n\n/* =========================================\n   FILTER SYSTEM\n   ========================================= */\nconst state = { industry: null, type: null, territory: null };\n\nconst labels = {\n  industry:  { financeiro:'Financeiro & Bancos', tecnologia:'Tecnologia & Software', consumo:'Consumo & Varejo',\n               industrial:'Industrial & Manufatura', saude:'Saúde & Farma', energia:'Energia & Utilities',\n               midia:'Mídia & Entretenimento', telecom:'Telecom', agro:'Agronegócio',\n               educacao:'Educação', logistica:'Logística & Transporte', governo:'Governo & Setor Público' },\n  type:      { jornada:'Jornada de Transformação', workshop:'Workshop', sprint:'Sprint de Inovação',\n               palestra:'Palestra', curso:'Curso In-Company', cocriacoes:'Cocriação', assessment:'Assessment de Skills' },\n  territory: { futuro:'Visão de Futuro & Estratégia', inovacao:'Inovação & Criatividade',\n               tecnologias:'Tecnologias Emergentes', lideranca:'Liderança & Cultura' }\n};\n\nfunction toggleDrop(cat) {\n  const drop = document.getElementById('drop-' + cat);\n  const trig = document.getElementById('trig-' + cat);\n  const isOpen = drop.classList.contains('is-open');\n  closeAllDrops();\n  if (!isOpen) {\n    drop.classList.add('is-open');\n    trig.classList.add('is-open');\n  }\n}\n\nfunction closeAllDrops() {\n  document.querySelectorAll('.f-dropdown').forEach(d => d.classList.remove('is-open'));\n  document.querySelectorAll('.f-trigger').forEach(t => t.classList.remove('is-open'));\n}\n\nfunction selectF(el) {\n  const cat = el.dataset.cat;\n  const val = el.dataset.val;\n  if (state[cat] === val) {\n    state[cat] = null;\n    el.classList.remove('is-sel');\n    el.querySelector('.f-chk').textContent = '';\n  } else {\n    document.querySelectorAll('#drop-' + cat + ' .f-opt').forEach(o => {\n      o.classList.remove('is-sel');\n      o.querySelector('.f-chk').textContent = '';\n    });\n    state[cat] = val;\n    el.classList.add('is-sel');\n    el.querySelector('.f-chk').textContent = '✓';\n  }\n  applyFilters();\n  renderChips();\n  updateTriggers();\n  setTimeout(closeAllDrops, 160);\n}\n\nfunction applyFilters() {\n  const items = document.querySelectorAll('.case-item');\n  let count = 0;\n  items.forEach(item => {\n    const ok =\n      (!state.industry  || item.dataset.industry  === state.industry)  &&\n      (!state.type      || item.dataset.type      === state.type)      &&\n      (!state.territory || item.dataset.territory === state.territory);\n    if (ok) {\n      item.classList.remove('is-hidden');\n      item.classList.add('is-vis');\n      count++;\n    } else {\n      item.classList.add('is-hidden');\n    }\n  });\n  document.getElementById('fCount').textContent = count + (count === 1 ? ' case' : ' cases');\n  document.getElementById('emptyState').classList.toggle('is-vis', count === 0);\n}\n\nfunction renderChips() {\n  const container = document.getElementById('fChips');\n  container.innerHTML = '';\n  let any = false;\n  Object.keys(state).forEach(cat => {\n    const val = state[cat];\n    if (!val) return;\n    any = true;\n    const chip = document.createElement('div');\n    chip.className = 'f-chip';\n    chip.innerHTML = (labels[cat][val] || val) + ' <span class=\"f-chip-x\" data-cat=\"' + cat + '\">×</span>';\n    chip.querySelector('.f-chip-x').addEventListener('click', e => removeFilter(e.target.dataset.cat));\n    container.appendChild(chip);\n  });\n  document.getElementById('clearBtn').classList.toggle('is-vis', any);\n}\n\nfunction updateTriggers() {\n  ['industry','type','territory'].forEach(cat => {\n    const trig = document.getElementById('trig-' + cat);\n    const badge = trig.querySelector('.f-badge');\n    if (state[cat]) {\n      if (!badge) { const b = document.createElement('span'); b.className = 'f-badge'; b.textContent = '1'; trig.appendChild(b); }\n      trig.classList.add('is-active');\n    } else {\n      if (badge) badge.remove();\n      trig.classList.remove('is-active');\n    }\n  });\n}\n\nfunction removeFilter(cat) {\n  state[cat] = null;\n  document.querySelectorAll('#drop-' + cat + ' .f-opt').forEach(o => {\n    o.classList.remove('is-sel');\n    o.querySelector('.f-chk').textContent = '';\n  });\n  applyFilters(); renderChips(); updateTriggers();\n}\n\nfunction clearAll() {\n  Object.keys(state).forEach(k => {\n    state[k] = null;\n    document.querySelectorAll('#drop-' + k + ' .f-opt').forEach(o => {\n      o.classList.remove('is-sel');\n      o.querySelector('.f-chk').textContent = '';\n    });\n  });\n  applyFilters(); renderChips(); updateTriggers();\n}\n\n// Wire up triggers via addEventListener\n['industry','type','territory'].forEach(cat => {\n  document.getElementById('trig-' + cat).addEventListener('click', e => {\n    e.stopPropagation();\n    toggleDrop(cat);\n  });\n  document.querySelectorAll('#drop-' + cat + ' .f-opt').forEach(opt => {\n    opt.addEventListener('click', () => selectF(opt));\n  });\n});\n\ndocument.getElementById('clearBtn').addEventListener('click', clearAll);\n\n// Close on outside click\ndocument.addEventListener('click', e => {\n  if (!e.target.closest('.f-group')) closeAllDrops();\n});\n\n/* =========================================\n   SCROLL REVEAL\n   ========================================= */\nfunction revealItem(item) {\n  item.classList.add('is-vis');\n}\n\n// Reveal all items immediately visible in viewport on load\nfunction revealVisible() {\n  document.querySelectorAll('.case-item:not(.is-hidden)').forEach(item => {\n    const rect = item.getBoundingClientRect();\n    if (rect.top < window.innerHeight + 100) revealItem(item);\n  });\n}\n\n// IntersectionObserver as progressive enhancement for items below fold\nconst revealObs = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      revealItem(e.target);\n      revealObs.unobserve(e.target);\n    }\n  });\n}, { threshold: 0, rootMargin: '0px 0px 0px 0px' });\n\ndocument.querySelectorAll('.case-item').forEach((item, i) => {\n  item.style.transitionDelay = (i < 3 ? i * 0.08 : 0) + 's';\n  revealObs.observe(item);\n});\n\n// Run immediately + after fonts/images settle\nrevealVisible();\nsetTimeout(revealVisible, 100);\nsetTimeout(revealVisible, 400);\n\n/* =========================================\n   STAT COUNTER ANIMATION\n   ========================================= */\nfunction animCount(el) {\n  const orig = el.textContent;\n  const n = parseInt(el.dataset.n);\n  if (isNaN(n)) return;\n  const suffix = orig.replace(/[\\d.,]/g, '');\n  const dur = 1100;\n  const t0 = performance.now();\n  function tick(now) {\n    const p = Math.min((now - t0) / dur, 1);\n    const ease = 1 - Math.pow(1 - p, 3);\n    const cur = Math.round(n * ease);\n    el.textContent = cur.toLocaleString('pt-BR') + suffix;\n    if (p < 1) requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n}\n\nconst statObs = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (e.isIntersecting) {\n      e.target.querySelectorAll('.c-num').forEach(animCount);\n      statObs.unobserve(e.target);\n    }\n  });\n}, { threshold: 0.25 });\n\ndocument.querySelectorAll('.case-item').forEach(item => statObs.observe(item));\n\n}); // end DOMContentLoaded\n</script>",
