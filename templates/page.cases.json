\" width=\"16\" height=\"16\" transform=\"rotate(-14,-147,93)\" fill=\"none\" stroke=\"#E64E0E\" stroke-width=\"0.8\" opacity=\"0.55\"></rect>\n          <polygon points=\"70,-90 84,-68 56,-68\" fill=\"#fff\" opacity=\"0.18\"></polygon>\n          <polygon points=\"-72,115 -58,93 -86,93\" fill=\"#E64E0E\" opacity=\"0.38\"></polygon>\n          <circle cx=\"185\" cy=\"-30\" r=\"3\" fill=\"#fff\" opacity=\"0.3\"></circle>\n          <circle cx=\"-180\" cy=\"20\" r=\"2\" fill=\"#E64E0E\" opacity=\"0.5\"></circle>\n          <circle cx=\"0\" cy=\"0\" r=\"7\" fill=\"#E64E0E\"></circle>\n          <circle cx=\"0\" cy=\"0\" r=\"18\" fill=\"none\" stroke=\"#E64E0E\" stroke-width=\"0.9\" opacity=\"0.38\"></circle>\n          <circle cx=\"0\" cy=\"0\" r=\"36\" fill=\"none\" stroke=\"#fff\" stroke-width=\"0.4\" opacity=\"0.18\"></circle>\n        </g>\n      </svg>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">02</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-inn\">Inovação &amp; Criatividade</span>\n          <span class=\"tag tag-sec\">Sprint de Inovação</span>\n          <span class=\"tag tag-sec\">Consumo</span>\n        </div>\n        <div class=\"case-client\">MONDELĒZ</div>\n        <h2 class=\"case-title\">Do problema real ao protótipo validado em 5 dias com times multidisciplinares</h2>\n        <p class=\"case-desc\">Sprints de inovação intensivos onde times de RH, Marketing, Supply Chain e Finanças trabalharam juntos para gerar soluções para desafios críticos do negócio, usando a metodologia 3U da Hyper Island.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"12\">12</span><span class=\"c-lbl\">times formados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"60\">60</span><span class=\"c-lbl\">protótipos gerados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"3\">3</span><span class=\"c-lbl\">soluções implementadas</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"A velocidade com que os times chegaram a soluções concretas foi surpreendente. Metodologia que respeita a inteligência coletiva das pessoas.\"</p>\n          <cite>Paulo Souza — Head of Innovation LATAM, Mondelēz</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 03 — BRADESCO ========== -->\n  <article class=\"case-item\" data-industry=\"financeiro\" data-type=\"curso\" data-territory=\"tecnologias\">\n    <div class=\"case-vis\">\n      <svg viewbox=\"0 0 600 600\" preserveaspectratio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Grid dissolving to dots — digital transformation (light) -->\n        <line x1=\"60\" y1=\"60\" x2=\"60\" y2=\"540\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.55\"></line>\n        <line x1=\"130\" y1=\"60\" x2=\"130\" y2=\"540\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.55\"></line>\n        <line x1=\"200\" y1=\"60\" x2=\"200\" y2=\"540\" stroke=\"#0C0A09\" stroke-width=\"0.4\" opacity=\"0.4\"></line>\n        <line x1=\"270\" y1=\"60\" x2=\"270\" y2=\"540\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.22\"></line>\n        <line x1=\"60\" y1=\"100\" x2=\"540\" y2=\"100\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.55\"></line>\n        <line x1=\"60\" y1=\"170\" x2=\"540\" y2=\"170\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.55\"></line>\n        <line x1=\"60\" y1=\"240\" x2=\"540\" y2=\"240\" stroke=\"#0C0A09\" stroke-width=\"0.4\" opacity=\"0.4\"></line>\n        <line x1=\"60\" y1=\"310\" x2=\"540\" y2=\"310\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.22\"></line>\n        <line x1=\"60\" y1=\"380\" x2=\"540\" y2=\"380\" stroke=\"#0C0A09\" stroke-width=\"0.2\" opacity=\"0.14\"></line>\n        <!-- Filled cells -->\n        <rect x=\"60\" y=\"100\" width=\"70\" height=\"70\" fill=\"#0C0A09\" opacity=\"0.05\"></rect>\n        <rect x=\"130\" y=\"170\" width=\"70\" height=\"70\" fill=\"#E64E0E\" opacity=\"0.07\"></rect>\n        <rect x=\"60\" y=\"240\" width=\"70\" height=\"70\" fill=\"#0C0A09\" opacity=\"0.05\"></rect>\n        <!-- Dissolving dots (right half) -->\n        <circle cx=\"310\" cy=\"115\" r=\"2.5\" fill=\"#0C0A09\" opacity=\"0.45\"></circle>\n        <circle cx=\"350\" cy=\"128\" r=\"2\" fill=\"#0C0A09\" opacity=\"0.35\"></circle>\n        <circle cx=\"390\" cy=\"108\" r=\"2\" fill=\"#E64E0E\" opacity=\"0.5\"></circle>\n        <circle cx=\"430\" cy=\"122\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.28\"></circle>\n        <circle cx=\"468\" cy=\"112\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.22\"></circle>\n        <circle cx=\"505\" cy=\"118\" r=\"1\" fill=\"#0C0A09\" opacity=\"0.15\"></circle>\n        <circle cx=\"315\" cy=\"185\" r=\"2.5\" fill=\"#E64E0E\" opacity=\"0.55\"></circle>\n        <circle cx=\"355\" cy=\"198\" r=\"2\" fill=\"#0C0A09\" opacity=\"0.35\"></circle>\n        <circle cx=\"395\" cy=\"178\" r=\"2\" fill=\"#0C0A09\" opacity=\"0.28\"></circle>\n        <circle cx=\"432\" cy=\"190\" r=\"1.5\" fill=\"#E64E0E\" opacity=\"0.38\"></circle>\n        <circle cx=\"470\" cy=\"183\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.2\"></circle>\n        <circle cx=\"506\" cy=\"176\" r=\"1\" fill=\"#0C0A09\" opacity=\"0.14\"></circle>\n        <circle cx=\"305\" cy=\"255\" r=\"2.5\" fill=\"#0C0A09\" opacity=\"0.4\"></circle>\n        <circle cx=\"342\" cy=\"265\" r=\"2\" fill=\"#0C0A09\" opacity=\"0.32\"></circle>\n        <circle cx=\"378\" cy=\"248\" r=\"2\" fill=\"#E64E0E\" opacity=\"0.45\"></circle>\n        <circle cx=\"415\" cy=\"258\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.24\"></circle>\n        <circle cx=\"452\" cy=\"252\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.18\"></circle>\n        <circle cx=\"295\" cy=\"325\" r=\"2\" fill=\"#0C0A09\" opacity=\"0.28\"></circle>\n        <circle cx=\"330\" cy=\"340\" r=\"2\" fill=\"#0C0A09\" opacity=\"0.22\"></circle>\n        <circle cx=\"368\" cy=\"318\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.18\"></circle>\n        <circle cx=\"404\" cy=\"333\" r=\"1.5\" fill=\"#0C0A09\" opacity=\"0.14\"></circle>\n        <circle cx=\"440\" cy=\"325\" r=\"1\" fill=\"#E64E0E\" opacity=\"0.3\"></circle>\n        <circle cx=\"476\" cy=\"318\" r=\"1\" fill=\"#0C0A09\" opacity=\"0.1\"></circle>\n        <circle cx=\"514\" cy=\"290\" r=\"1.5\" fill=\"#E64E0E\" opacity=\"0.35\"></circle>\n        <circle cx=\"540\" cy=\"220\" r=\"1\" fill=\"#0C0A09\" opacity=\"0.18\"></circle>\n        <circle cx=\"528\" cy=\"355\" r=\"1\" fill=\"#0C0A09\" opacity=\"0.12\"></circle>\n      </svg>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">03</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-tec\">Tecnologias Emergentes</span>\n          <span class=\"tag tag-sec\">Curso In-Company</span>\n          <span class=\"tag tag-sec\">Financeiro</span>\n        </div>\n        <div class=\"case-client\">BRADESCO</div>\n        <h2 class=\"case-title\">Preparando 2.000 colaboradores para trabalhar com IA generativa no dia a dia</h2>\n        <p class=\"case-desc\">Programa de capacitação em 4 módulos — desde fundamentos de IA até aplicação prática em fluxos reais — desenvolvido para habilitar equipes de diferentes áreas a incorporarem inteligência artificial no cotidiano profissional.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"2000\">2.000</span><span class=\"c-lbl\">colaboradores</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"4\">4</span><span class=\"c-lbl\">módulos</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"87\">87%</span><span class=\"c-lbl\">taxa de conclusão</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"O grande diferencial foi equilibrar teoria com aplicação prática imediata. Os times saíram com ferramentas e confiança para usar IA no trabalho real.\"</p>\n          <cite>Carla Menezes — CHRO, Bradesco</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 04 — SCANIA ========== -->\n  <article class=\"case-item\" data-industry=\"industrial\" data-type=\"workshop\" data-territory=\"futuro\">\n    <div class=\"case-vis\">\n      <svg viewbox=\"0 0 600 600\" preserveaspectratio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Perspective lines — Future Vision (dark) -->\n        <line x1=\"0\" y1=\"40\" x2=\"600\" y2=\"310\" stroke=\"#fff\" stroke-width=\"0.5\" opacity=\"0.11\"></line>\n        <line x1=\"0\" y1=\"100\" x2=\"600\" y2=\"330\" stroke=\"#fff\" stroke-width=\"0.5\" opacity=\"0.11\"></line>\n        <line x1=\"0\" y1=\"160\" x2=\"600\" y2=\"350\" stroke=\"#fff\" stroke-width=\"0.5\" opacity=\"0.11\"></line>\n        <line x1=\"0\" y1=\"220\" x2=\"600\" y2=\"370\" stroke=\"#fff\" stroke-width=\"0.5\" opacity=\"0.11\"></line>\n        <line x1=\"0\" y1=\"280\" x2=\"600\" y2=\"390\" stroke=\"#fff\" stroke-width=\"0.4\" opacity=\"0.09\"></line>\n        <line x1=\"0\" y1=\"340\" x2=\"600\" y2=\"410\" stroke=\"#fff\" stroke-width=\"0.3\" opacity=\"0.07\"></line>\n        <line x1=\"0\" y1=\"400\" x2=\"600\" y2=\"430\" stroke=\"#fff\" stroke-width=\"0.2\" opacity=\"0.05\"></line>\n        <!-- Vertical perspective converging right -->\n        <line x1=\"80\" y1=\"0\" x2=\"420\" y2=\"600\" stroke=\"#fff\" stroke-width=\"0.5\" opacity=\"0.11\"></line>\n        <line x1=\"180\" y1=\"0\" x2=\"440\" y2=\"600\" stroke=\"#fff\" stroke-width=\"0.5\" opacity=\"0.11\"></line>\n        <line x1=\"280\" y1=\"