rcle>\n        <!-- Connection lines from hub -->\n        <line x1=\"300\" y1=\"300\" x2=\"300\" y2=\"136\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.22\"></line>\n        <line x1=\"300\" y1=\"300\" x2=\"450\" y2=\"207\" stroke=\"#E64E0E\" stroke-width=\"0.7\" opacity=\"0.35\"></line>\n        <line x1=\"300\" y1=\"300\" x2=\"455\" y2=\"393\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.22\"></line>\n        <line x1=\"300\" y1=\"300\" x2=\"300\" y2=\"474\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.22\"></line>\n        <line x1=\"300\" y1=\"300\" x2=\"145\" y2=\"393\" stroke=\"#E64E0E\" stroke-width=\"0.7\" opacity=\"0.35\"></line>\n        <line x1=\"300\" y1=\"300\" x2=\"148\" y2=\"207\" stroke=\"#0C0A09\" stroke-width=\"0.5\" opacity=\"0.22\"></line>\n        <!-- Secondary connections -->\n        <line x1=\"300\" y1=\"136\" x2=\"450\" y2=\"207\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.12\"></line>\n        <line x1=\"450\" y1=\"207\" x2=\"455\" y2=\"393\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.12\"></line>\n        <line x1=\"455\" y1=\"393\" x2=\"300\" y2=\"474\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.12\"></line>\n        <line x1=\"300\" y1=\"474\" x2=\"145\" y2=\"393\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.12\"></line>\n        <line x1=\"145\" y1=\"393\" x2=\"148\" y2=\"207\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.12\"></line>\n        <line x1=\"148\" y1=\"207\" x2=\"300\" y2=\"136\" stroke=\"#0C0A09\" stroke-width=\"0.3\" opacity=\"0.12\"></line>\n      </svg>\n    </div>\n    <div class=\"case-cnt\">\n      <span class=\"case-ghost\">01</span>\n      <div>\n        <div class=\"case-tags\">\n          <span class=\"tag tag-lid\">Liderança &amp; Cultura</span>\n          <span class=\"tag tag-sec\">Jornada de Transformação</span>\n          <span class=\"tag tag-sec\">Financeiro</span>\n        </div>\n        <div class=\"case-client\">ITAÚ UNIBANCO</div>\n        <h2 class=\"case-title\">Construindo lideranças que conduzem a mudança em larga escala</h2>\n        <p class=\"case-desc\">Um programa de jornada estruturado em três fases — descoberta, experimentação e implementação — para desenvolver os líderes responsáveis pela transformação digital do maior banco privado da América Latina.</p>\n      </div>\n      <div>\n        <div class=\"case-stats\">\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"400\">400+</span><span class=\"c-lbl\">líderes treinados</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"6\">6</span><span class=\"c-lbl\">meses de programa</span>\n</div>\n          <div class=\"c-stat\">\n<span class=\"c-num\" data-n=\"94\">94%</span><span class=\"c-lbl\">NPS do programa</span>\n</div>\n        </div>\n        <blockquote class=\"case-quote\">\n          <p>\"Mudou a forma como nossos líderes enxergam o papel deles na transformação. Não foi um treinamento — foi uma jornada real de mudança de mentalidade.\"</p>\n          <cite>Ana Lima — Diretora de Pessoas &amp; Cultura, Itaú</cite>\n        </blockquote>\n        <a href=\"#\" class=\"case-link\">Ver case completo <span class=\"arr\">→</span></a>\n      </div>\n    </div>\n  </article>\n\n  <!-- ========== CASE 02 — MONDELĒZ ========== -->\n  <article class=\"case-item\" data-industry=\"consumo\" data-type=\"sprint\" data-territory=\"inovacao\">\n    <div class=\"case-vis\">\n      <svg viewbox=\"0 0 600 600\" preserveaspectratio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Innovation burst on dark -->\n        <g transform=\"translate(280,310)\">\n          <line x1=\"0\" y1=\"0\" x2=\"210\" y2=\"-50\" stroke=\"#fff\" stroke-width=\"0.55\" opacity=\"0.12\"></line>\n          <line x1=\"0\" y1=\"0\" x2=\"190\" y2=\"-120\" stroke=\"#fff\" stroke-width=\"0.55\" opacity=\"0.12\"></line>\n          <line x1=\"0\" y1=\"0\" x2=\"140\" y2=\"-180\" stroke=\"#fff\" stroke-width=\"0.55\" 