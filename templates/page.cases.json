      "settings": {
        "html": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cases — Hyper Island Brasil</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&amp;display=swap\" rel=\"stylesheet\">\n<style>\n/* =========================================\n   RESET & TOKENS\n   ========================================= */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n:root {\n  --cream:       #F2EAE0;\n  --cream-panel: #E8DFCF;\n  --ink:         #0C0A09;\n  --white:       #FEFCF8;\n  --orange:      #E64E0E;\n  --orange-soft: #F28050;\n  --gray:        #7A726A;\n  --gray-light:  #AFA89F;\n  --border:      rgba(12,10,9,0.10);\n  --border-mid:  rgba(12,10,9,0.18);\n  --f-disp:      'Bebas Neue', Impact, sans-serif;\n  --f-body:      'Plus Jakarta Sans', sans-serif;\n  --ease:        cubic-bezier(0.16,1,0.3,1);\n}\n\nhtml  { scroll-behavior: smooth; font-size: 16px; }\nbody  {\n  font-family: var(--f-body);\n  background: var(--cream);\n  color: var(--ink);\n  overflow-x: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* =========================================\n   HERO\n   ========================================= */\n.hero {\n  padding: 72px 48px 60px;\n  border-bottom: 1px solid var(--border-mid);\n  position: relative; overflow: hidden;\n}\n.hero-crumb {\n  font-size: 11px; font-weight: 600; letter-spacing: 0.12em;\n  text-transform: uppercase; color: var(--gray-light);\n  display: flex; align-items: center; gap: 10px;\n  margin-bottom: 22px;\n}\n.hero-crumb::after {\n  content: ''; display: block;\n  width: 36px; height: 1px; background: var(--gray-light);\n}\n.hero-title {\n  font-family: var(--f-disp);\n  font-size: clamp(68px, 9.5vw, 132px);\n  line-height: 0.9; letter-spacing: 0.025em;\n  margin-bottom: 28px; max-width: 820px;\n}\n.hero-title .t-orange { color: var(--orange); }\n.hero-desc {\n  font-size: 15px; font-weight: 300; line-height: 1.75;\n  color: var(--gray); max-width: 460px; margin-bottom: 52px;\n}\n.hero-stats {\n  display: flex; gap: 0;\n  border-top: 1px solid var(--border-mid);\n  padding-top: 32px;\n}\n.hero-stat {\n  padding-right: 40px; margin-right: 40px;\n  border-right: 1px solid var(--border-mid);\n}\n.hero-stat:last-child { border-right: none; }\n.hero-stat .s-num {\n  font-family: var(--f-disp);\n  font-size: 52px; letter-spacing: 0.03em; line-height: 1;\n  color: var(--ink); display: block;\n}\n.hero-stat .s-lbl {\n  font-size: 10px; font-weight: 600;\n  letter-spacing: 0.1em; text-transform: uppercase;\n  color: var(--gray-light); margin-top: 5px; display: block;\n}\n/* subtle background mark */\n.hero::after {\n  content: 'CASES';\n  font-family: var(--f-disp);\n  font-size: 280px; letter-spacing: 0.04em;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.05);\n  position: absolute; bottom: -60px; right: -20px;\n  pointer-events: none; user-select: none; line-height: 1;\n}\n\n/* =========================================\n   FILTER BAR\n   ========================================= */\n.filter-bar {\n  position: sticky; top: 0; z-index: 200;\n  background: rgba(242,234,224,0.96);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border-bottom: 1px solid var(--border-mid);\n  padding: 0 48px;\n}\n.filter-row {\n  display: flex; align-items: center;\n  gap: 8px; height: 50px;\n  border-bottom: 1px solid var(--border);\n}\n.f-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--gray-light); margin-right: 6px; flex-shrink: 0;\n}\n.f-sep { width: 1px; height: 22px; background: var(--border-mid); margin: 0 6px; }\n.f-group { position: relative; }\n.f-trigger {\n  display: flex; align-items: center; gap: 5px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--ink); background: none;\n  border: 1px solid var(--border-mid);\n  padding: 6px 13px; border-radius: 2px;\n  cursor: pointer; white-space: nowrap;\n  transition: background .15s, border-color .15s, color .15s;\n}\n.f-trigger:hover { background: var(--cream-panel); }\n.f-trigger.is-active {\n  background: var(--ink); color: var(--cream); border-color: var(--ink);\n}\n.f-trigger .chev { font-size: 9px; transition: transform .2s; line-height: 1; }\n.f-trigger.is-open .chev { transform: rotate(180deg); }\n.f-badge {\n  width: 15px; height: 15px; border-radius: 50%;\n  background: var(--orange); color: #fff;\n  font-size: 8px; font-weight: 800;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.f-dropdown {\n  display: none; flex-direction: column;\n  position: absolute; top: calc(100% + 6px); left: 0;\n  background: var(--white);\n  border: 1px solid var(--border-mid);\n  border-radius: 3px; min-width: 240px;\n  box-shadow: 0 10px 36px rgba(12,10,9,0.13);\n  overflow: hidden; z-index: 400;\n}\n.f-dropdown.is-open { display: flex; }\n.f-opt {\n  padding: 10px 16px;\n  font-size: 12px; font-weight: 400;\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border); color: var(--ink);\n  transition: background .1s;\n}\n.f-opt:last-child { border-bottom: none; }\n.f-opt:hover { background: var(--cream); }\n.f-opt.is-sel { font-weight: 600; color: var(--orange); }\n.f-chk {\n  width: 14px; height: 14px; border-radius: 2px;\n  border: 1.5px solid var(--border-mid);\n  display: inline-flex; align-items: center; justify-content: center;\n  font-size: 9px; flex-shrink: 0;\n}\n.f-opt.is-sel .f-chk { background: var(--orange); border-color: var(--orange); color: #fff; }\n.f-clear {\n  margin-left: auto;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.05em;\n  color: var(--gray-light); background: none; border: none;\n  cursor: pointer; padding: 6px 8px;\n  transition: color .15s; display: none;\n}\n.f-clear.is-vis { display: block; }\n.f-clear:hover { color: var(--orange); }\n.f-count {\n  margin-left: 12px;\n  font-size: 10px; font-weight: 600; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--gray-light); flex-shrink: 0;\n}\n.f-chips {\n  display: flex; gap: 6px; flex-wrap: wrap;\n  padding: 8px 0;\n}\n.f-chips:empty { padding: 0; height: 0; overflow: hidden; border: none; }\n.f-chip {\n  display: inline-flex; align-items: center; gap: 6px;\n  font-size: 10px; font-weight: 700; letter-spacing: 0.07em;\n  text-transform: uppercase;\n  background: var(--ink); color: var(--cream);\n  padding: 4px 10px; border-radius: 2px;\n}\n.f-chip-x {\n  font-size: 13px; cursor: pointer; line-height: 1;\n  opacity: 0.5; transition: opacity .15s;\n}\n.f-chip-x:hover { opacity: 1; }\n\n/* =========================================\n   CASES FEED\n   ========================================= */\n.cases-feed { }\n\n.empty-state {\n  display: none; flex-direction: column; align-items: center;\n  padding: 80px 48px; text-align: center;\n}\n.empty-state.is-vis { display: flex; }\n.empty-state h3 {\n  font-family: var(--f-disp); font-size: 42px;\n  letter-spacing: 0.04em; margin-bottom: 10px;\n}\n.empty-state p { font-size: 14px; color: var(--gray); }\n\n/* Case item */\n.case-item {\n  display: grid; grid-template-columns: 1fr 1fr;\n  min-height: 600px;\n  border-bottom: 1px solid var(--border-mid);\n  opacity: 0; transform: translateY(28px);\n  transition: opacity .75s var(--ease), transform .75s var(--ease);\n}\n.case-item.is-vis { opacity: 1; transform: translateY(0); }\n.case-item.is-hidden { display: none; }\n\n/* Odd: visual LEFT, content RIGHT */\n.case-item:nth-child(odd)  .case-vis { order: 1; background: var(--cream-panel); }\n.case-item:nth-child(odd)  .case-cnt { order: 2; }\n/* Even: content LEFT, visual RIGHT */\n.case-item:nth-child(even) .case-vis { order: 2; background: var(--ink); }\n.case-item:nth-child(even) .case-cnt { order: 1; }\n\n/* Visual panel */\n.case-vis {\n  position: relative; overflow: hidden;\n}\n.case-vis svg {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%;\n  transition: transform .7s var(--ease);\n}\n.case-vis:hover svg { transform: scale(1.04); }\n\n/* Content panel */\n.case-cnt {\n  padding: 52px 52px 52px 52px;\n  display: flex; flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n}\n\n/* Ghost number */\n.case-ghost {\n  font-family: var(--f-disp);\n  font-size: 130px; letter-spacing: 0.02em; line-height: 1;\n  color: transparent;\n  -webkit-text-stroke: 1px rgba(12,10,9,0.07);\n  position: absolute; top: 24px; right: 36px;\n  pointer-events: none; user-select: none;\n}\n\n/* Tags */\n.case-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 18px; }\n.tag {\n  display: inline-block;\n  font-size: 9px; font-weight: 800; letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 3px 9px; border-radius: 2px; border: 1px solid;\n}\n.tag-fut  { color: #1A4FD4; border-color: #1A4FD4; }\n.tag-inn  { color: var(--orange); border-color: var(--orange); }\n.tag-tec  { color: #07786E; border-color: #07786E; }\n.tag-lid  { color: #7C2A08; border-color: #7C2A08; }\n.tag-sec  { color: var(--gray); border-color: var(--border-mid); }\n\n/* Client name */\n.case-client {\n  font-family: var(--f-disp);\n  font-size: 48px; letter-spacing: 0.04em; line-height: 1;\n  color: var(--ink); margin-bottom: 14px;\n}\n\n/* Title */\n.case-title {\n  font-size: 19px; font-weight: 500; line-height: 1.38;\n  color: var(--ink); margin-bottom: 18px; max-width: 400px;\n}\n\n/* Description */\n.case-desc {\n  font-size: 13px; font-weight: 300; line-height: 1.8;\n  color: var(--gray); max-width: 390px; margin-bottom: 0;\n}\n\n/* Stats */\n.case-stats {\n  display: flex; gap: 28px;\n  padding-top: 22px; margin-top: 22px;\n  border-top: 1px solid var(--border);\n}\n.c-stat .c-num {\n  font-family: var(--f-disp);\n  font-size: 38px; letter-spacing: 0.02em; line-height: 1;\n  color: var(--orange); display: block;\n}\n.c-stat .c-lbl {\n  font-size: 10px; font-weight: 600; letter-spacing: 0.09em;\n  text-transform: uppercase; color: var(--gray-light);\n  margin-top: 3px; display: block;\n}\n\n/* Quote */\n.case-quote {\n  padding-left: 16px;\n  border-left: 3px solid var(--orange);\n  margin-top: 22px;\n}\n.case-quote p {\n  font-size: 13px; font-style: italic;\n  font-weight: 300; line-height: 1.7;\n  color: var(--gray); margin-bottom: 7px;\n}\n.case-quote cite {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.08em; text-transform: uppercase;\n  color: var(--ink); font-style: normal;\n}\n\n/* Link */\n.case-link {\n  display: inline-flex; align-items: center; gap: 7px;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); text-decoration: none;\n  border-bottom: 1.5px solid var(--ink);\n  padding-bottom: 1px; margin-top: 22px; width: fit-content;\n  transition: color .2s, border-color .2s;\n}\n.case-link:hover { color: var(--orange); border-color: var(--orange); }\n.case-link .arr { transition: transform .2s; display: inline-block; }\n.case-link:hover .arr { transform: translateX(4px); }\n\n/* =========================================\n   CTA BLOCK\n   ========================================= */\n.cta-block {\n  background: var(--ink);\n  padding: 80px 48px;\n  display: grid; grid-template-columns: 1fr 1fr;\n  gap: 64px; align-items: center;\n}\n.cta-eyebrow {\n  font-size: 10px; font-weight: 700; letter-spacing: 0.14em;\n  text-transform: uppercase; color: rgba(255,255,255,0.3);\n  margin-bottom: 16px;\n}\n.cta-title {\n  font-family: var(--f-disp);\n  font-size: clamp(52px, 6.5vw, 96px);\n  line-height: 0.9; letter-spacing: 0.02em;\n  color: var(--cream); margin-bottom: 18px;\n}\n.cta-title .t-orange { color: var(--orange); }\n.cta-p {\n  font-size: 14px; font-weight: 300; line-height: 1.75;\n  color: rgba(255,255,255,0.45);\n}\n.cta-right { display: flex; flex-direction: column; gap: 14px; }\n.cta-person {\n  display: flex; align-items: center; gap: 14px; margin-bottom: 6px;\n}\n.cta-avatar {\n  width: 50px; height: 50px; border-radius: 50%;\n  background: var(--orange-soft);\n  display: flex; align-items: center; justify-content: center;\n  font-family: var(--f-disp); font-size: 19px; letter-spacing: 0.04em;\n  color: var(--white); flex-shrink: 0;\n}\n.cta-pname { font-size: 14px; font-weight: 600; color: var(--cream); margin-bottom: 2px; }\n.cta-prole { font-size: 11px; color: rgba(255,255,255,0.35); }\n.btn-primary {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--f-body);\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--ink); background: var(--cream); border: none;\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: background .2s, transform .15s;\n}\n.btn-primary:hover { background: #fff; transform: translateY(-1px); }\n.btn-sec {\n  display: inline-flex; align-items: center;\n  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,0.45); background: none;\n  border: 1px solid rgba(255,255,255,0.18);\n  padding: 14px 28px; border-radius: 2px;\n  cursor: pointer; text-decoration: none;\n  transition: border-color .2s, color .2s;\n}\n.btn-sec:hover { border-color: rgba(255,255,255,0.45); color: var(--cream); }\n\n/* =========================================\n   FOOTER\n   ========================================= */\n.footer {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 22px 48px;\n  border-top: 1px solid var(--border-mid);\n}\n.footer-logo { font-family: var(--f-disp); font-size: 17px; letter-spacing: 0.06em; }\n.footer-copy { font-size: 11px; color: var(--gray-light); }\n\n/* =========================================\n   RESPONSIVE\n   ========================================= */\n@media (max-width: 900px) {\n  .nav-links { display: none; }\n  .hero { padding: 48px 24px 40px; }\n  .hero::after { display: none; }\n  .hero-stats { gap: 0; overflow-x: auto; }\n  .hero-stat { padding-right: 24px; margin-right: 24px; flex-shrink: 0; }\n  .filter-bar, .footer { padding: 0 24px; }\n  .filter-row { overflow-x: auto; }\n  .case-item { grid-template-columns: 1fr; min-height: auto; }\n  .case-item:nth-child(odd)  .case-vis,\n  .case-item:nth-child(even) .case-vis { order: 1; height: 280px; }\n  .case-item:nth-child(odd)  .case-cnt,\n  .case-item:nth-child(even) .case-cnt { order: 2; }\n  .case-cnt { padding: 36px 28px; }\n  .cta-block { grid-template-columns: 1fr; padding: 60px 24px; gap: 40px; }\n}\n</style>\n\n\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <p class=\"hero-crumb\">Para Empresas · Cases</p>\n  <h1 class=\"hero-title\">TRANSFORMAÇÃO<br>REAL. <span class=\"t-orange\">RESULTADOS</span><br>QUE FICAM.</h1>\n  <p class=\"hero-desc\">Como as maiores empresas do Brasil desenvolvem seus times com a Hyper Island — e o que mudou depois.</p>\n  <div class=\"hero-stats\">\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">80+</span>\n      <span class=\"s-lbl\">Empresas atendidas</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">29</span>\n      <span class=\"s-lbl\">Anos de metodologia</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">5.000+</span>\n      <span class=\"s-lbl\">Profissionais treinados</span>\n    </div>\n    <div class=\"hero-stat\">\n      <span class=\"s-num\">14</span>\n      <span class=\"s-lbl\">Países alcançados</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FILTER BAR ============ -->\n<div class=\"filter-bar\" id=\"filterBar\">\n  <div class=\"filter-row\">\n    <span class=\"f-label\">Filtrar</span>\n\n    <!-- Setor -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-industry\" onclick=\"toggleDrop('industry')\">\n        Setor <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-industry\">\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"financeiro\" onclick=\"selectF(this)\">Financeiro <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"tecnologia\" onclick=\"selectF(this)\">Tecnologia <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"consumo\" onclick=\"selectF(this)\">Consumo &amp; Varejo <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"industry\" data-val=\"industrial\" onclick=\"selectF(this)\">Industrial <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <!-- Tipo -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-type\" onclick=\"toggleDrop('type')\">\n        Tipo de Projeto <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-type\">\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"jornada\" onclick=\"selectF(this)\">Jornada de Transformação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"workshop\" onclick=\"selectF(this)\">Workshop <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"sprint\" onclick=\"selectF(this)\">Sprint de Inovação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"palestra\" onclick=\"selectF(this)\">Palestra <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"curso\" onclick=\"selectF(this)\">Curso In-Company <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"cocriacoes\" onclick=\"selectF(this)\">Cocriação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"type\" data-val=\"assessment\" onclick=\"selectF(this)\">Assessment de Skills <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <!-- Território -->\n    <div class=\"f-group\">\n      <button class=\"f-trigger\" id=\"trig-territory\" onclick=\"toggleDrop('territory')\">\n        Território <span class=\"chev\">▾</span>\n      </button>\n      <div class=\"f-dropdown\" id=\"drop-territory\">\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"futuro\" onclick=\"selectF(this)\">Visão de Futuro &amp; Estratégia <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"inovacao\" onclick=\"selectF(this)\">Inovação &amp; Criatividade <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"tecnologias\" onclick=\"selectF(this)\">Tecnologias Emergentes &amp; Transformação <span class=\"f-chk\"></span>\n</div>\n        <div class=\"f-opt\" data-cat=\"territory\" data-val=\"lideranca\" onclick=\"selectF(this)\">Liderança &amp; Cultura <span class=\"f-chk\"></span>\n</div>\n      </div>\n    </div>\n\n    <div class=\"f-sep\"></div>\n    <button class=\"f-clear\" id=\"clearBtn\" onclick=\"clearAll()\">✕ Limpar filtros</button>\n    <span class=\"f-count\" id=\"fCount\">8 cases</span>\n  </div>\n  <div class=\"f-chips\" id=\"fChips\"></div>\n</div>\n\n<!-- ============ CASES FEED ============ -->\n<main class=\"cases-feed\">\n\n  <div class=\"empty-state\" id=\"emptyState\">\n    <h3>NENHUM CASE ENCONTRADO</h3>\n    <p>Tente remover alguns filtros para ver mais resultados.</p>\n  </div>\n\n  <!-- ========== CASE 01 — ITAÚ ========== -->\n  <article class=\"case-item\" data-industry=\"financeiro\" data-type=\"jornada\" data-territory=\"lideranca\">\n    <div class=\"case-vis\">\n      <svg viewbox=\"0 0 600 600\" preserveas