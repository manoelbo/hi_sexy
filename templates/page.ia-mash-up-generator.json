      "settings": {
        "html": "<!-- HI Mash-up Generator — Hyper Island -->\n<div class=\"hi-mashup-root\" data-theme=\"light\" data-lang=\"pt\" id=\"hi-mashup-app\">\n\n<style>\n/* ─── RESET (scoped) ─────────────────────────────────────────── */\n.hi-mashup-root *, .hi-mashup-root *::before, .hi-mashup-root *::after {\n  box-sizing: border-box; margin: 0; padding: 0;\n}\n\n/* ─── TOKENS ─────────────────────────────────────────────────── */\n.hi-mashup-root {\n  --orange:      #FF7300;\n  --orange-dark: #E56500;\n  --black:       #0A0A0A;\n  --white:       #FFFFFF;\n  --off-white:   #F4F1EA;\n  --grey-light:  #D8D2C8;\n  --grey-mid:    #8C8C8C;\n\n  /* light theme defaults */\n  --bg:          #F4F1EA;\n  --surface:     #FFFFFF;\n  --surface-2:   #F4F1EA;\n  --border:      #D8D2C8;\n  --text-primary:#0A0A0A;\n  --text-muted:  #8C8C8C;\n  --shadow:      0 2px 0 #D8D2C8, 0 4px 0 #C8C2B8;\n  --shadow-card: 0 1px 3px rgba(0,0,0,.08), 0 4px 12px rgba(0,0,0,.06);\n  --tag-bg:      #F4F1EA;\n\n  font-family: Arial, Helvetica, sans-serif;\n  background: var(--bg);\n  color: var(--text-primary);\n  transition: background .3s, color .3s;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* dark theme */\n.hi-mashup-root[data-theme=\"dark\"] {\n  --bg:          #0A0A0A;\n  --surface:     #171717;\n  --surface-2:   #222222;\n  --border:      #2A2A2A;\n  --text-primary:#F4F1EA;\n  --text-muted:  #9A9A9A;\n  --shadow:      0 2px 0 #222, 0 4px 0 #1A1A1A;\n  --shadow-card: 0 1px 3px rgba(0,0,0,.4), 0 4px 16px rgba(0,0,0,.35);\n  --tag-bg:      #222222;\n}\n\n/* ─── WRAPPER ────────────────────────────────────────────────── */\n.hi-mashup-wrap {\n  max-width: 1500px;\n  margin: 0 auto;\n  padding: 60px 24px 72px;\n}\n\n/* ─── HEADER ─────────────────────────────────────────────────── */\n.hi-mashup-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n  margin-bottom: 48px;\n  flex-wrap: wrap;\n}\n\n.hi-mashup-header-left { flex: 1; min-width: 240px; }\n\n.hi-mashup-eyebrow {\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n  color: var(--orange);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n.hi-mashup-eyebrow::before {\n  content: '';\n  display: inline-block;\n  width: 20px; height: 2px;\n  background: var(--orange);\n}\n\n.hi-mashup-title {\n  font-family: \"Arial Narrow\", \"Roboto Condensed\", \"Helvetica Neue Condensed\", Impact, Arial Narrow, sans-serif;\n  font-size: clamp(36px, 6vw, 72px);\n  font-weight: 900;\n  letter-spacing: -.01em;\n  text-transform: uppercase;\n  line-height: .92;\n  color: var(--text-primary);\n  margin-bottom: 14px;\n}\n.hi-mashup-title span { color: var(--orange); }\n\n.hi-mashup-subtitle {\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--text-muted);\n  max-width: 480px;\n}\n\n/* controls block */\n.hi-mashup-controls {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 12px;\n  padding-top: 4px;\n}\n\n/* language tabs */\n.hi-mashup-lang {\n  display: flex;\n  border: 1.5px solid var(--border);\n  border-radius: 4px;\n  overflow: hidden;\n}\n.hi-mashup-lang button {\n  background: none;\n  border: none;\n  padding: 6px 13px;\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: background .15s, color .15s;\n  border-right: 1.5px solid var(--border);\n}\n.hi-mashup-lang button:last-child { border-right: none; }\n.hi-mashup-lang button.active, .hi-mashup-lang button:hover {\n  background: var(--orange);\n  color: var(--black);\n}\n\n/* theme toggle */\n.hi-mashup-theme {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n.hi-mashup-theme-switch {\n  position: relative;\n  width: 44px; height: 24px;\n  cursor: pointer;\n}\n.hi-mashup-theme-switch input {\n  opacity: 0; width: 0; height: 0;\n  position: absolute;\n}\n.hi-mashup-theme-slider {\n  position: absolute;\n  inset: 0;\n  background: var(--border);\n  border-radius: 12px;\n  transition: background .25s;\n}\n.hi-mashup-theme-slider::after {\n  content: '';\n  position: absolute;\n  top: 3px; left: 3px;\n  width: 18px; height: 18px;\n  background: var(--white);\n  border-radius: 50%;\n  transition: transform .25s;\n}\n.hi-mashup-theme-switch input:checked + .hi-mashup-theme-slider {\n  background: var(--orange);\n}\n.hi-mashup-theme-switch input:checked + .hi-mashup-theme-slider::after {\n  transform: translateX(20px);\n}\n.hi-mashup-theme-label { user-select: none; }\n\n/* ─── DIVIDER ────────────────────────────────────────────────── */\n.hi-mashup-divider {\n  width: 100%;\n  height: 1.5px;\n  background: var(--border);\n  margin-bottom: 40px;\n  position: relative;\n}\n.hi-mashup-divider::before {\n  content: '';\n  position: absolute;\n  left: 0; top: 0;\n  width: 48px; height: 100%;\n  background: var(--orange);\n}\n\n/* ─── CARDS ──────────────────────────────────────────────────── */\n.hi-mashup-cards {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n  margin-bottom: 40px;\n}\n\n.hi-mashup-card {\n  background: var(--surface);\n  border: 1.5px solid var(--border);\n  border-radius: 2px;\n  padding: 28px 24px 24px;\n  position: relative;\n  box-shadow: var(--shadow-card);\n  transition: border-color .2s, box-shadow .2s;\n  overflow: visible;\n  min-height: 160px;\n  display: flex;\n  flex-direction: column;\n}\n\n/* layered paper stack effect */\n.hi-mashup-card::before {\n  content: '';\n  position: absolute;\n  bottom: -6px; left: 6px; right: -6px;\n  height: 100%;\n  background: var(--surface-2);\n  border: 1.5px solid var(--border);\n  border-radius: 2px;\n  z-index: -1;\n}\n.hi-mashup-card::after {\n  content: '';\n  position: absolute;\n  bottom: -11px; left: 11px; right: -11px;\n  height: 100%;\n  background: var(--bg);\n  border: 1.5px solid var(--border);\n  border-radius: 2px;\n  z-index: -2;\n}\n\n/* orange top accent */\n.hi-mashup-card-accent {\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 3px;\n  background: var(--orange);\n}\n\n.hi-mashup-card-index {\n  font-family: \"Arial Narrow\", Impact, Arial, sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: .15em;\n  text-transform: uppercase;\n  color: var(--orange);\n  margin-bottom: 6px;\n}\n\n.hi-mashup-card-label {\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  color: var(--orange);\n  margin-bottom: 16px;\n  padding-bottom: 12px;\n  border-bottom: 2px solid var(--orange);\n  opacity: .85;\n}\n\n.hi-mashup-card-item {\n  font-family: \"Arial Narrow\", \"Roboto Condensed\", \"Helvetica Neue Condensed\", Impact, Arial, sans-serif;\n  font-size: clamp(26px, 3.8vw, 40px);\n  font-weight: 900;\n  text-transform: uppercase;\n  letter-spacing: -.01em;\n  line-height: 1.05;\n  color: var(--text-primary);\n  flex: 1;\n  word-break: break-word;\n  overflow-wrap: break-word;\n  hyphens: auto;\n}\n\n/* ─── SHUFFLE ANIMATION ──────────────────────────────────────── */\n@keyframes hi-mashup-shuffle {\n  0%   { opacity: 1; transform: translateY(0)   scale(1); }\n  30%  { opacity: 0; transform: translateY(-12px) scale(.97); }\n  60%  { opacity: 0; transform: translateY(10px)  scale(.97); }\n  100% { opacity: 1; transform: translateY(0)   scale(1); }\n}\n\n.hi-mashup-card.is-shuffling {\n  animation: hi-mashup-shuffle 420ms cubic-bezier(.4,0,.2,1) both;\n}\n.hi-mashup-card.is-shuffling:nth-child(2) { animation-delay: 60ms; }\n.hi-mashup-card.is-shuffling:nth-child(3) { animation-delay: 120ms; }\n\n@media (prefers-reduced-motion: reduce) {\n  .hi-mashup-card.is-shuffling {\n    animation: none;\n    opacity: 1;\n  }\n}\n\n/* ─── BUTTON AREA ────────────────────────────────────────────── */\n.hi-mashup-action {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 32px;\n  flex-wrap: wrap;\n}\n\n.hi-mashup-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  background: var(--orange);\n  color: var(--black);\n  border: none;\n  border-radius: 2px;\n  padding: 15px 32px;\n  font-family: \"Arial Narrow\", Impact, Arial, sans-serif;\n  font-size: 15px;\n  font-weight: 900;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  cursor: pointer;\n  box-shadow: 4px 4px 0 var(--black);\n  transition: transform .1s, box-shadow .1s, background .15s;\n  position: relative;\n  user-select: none;\n}\n.hi-mashup-btn:hover {\n  background: var(--orange-dark);\n  transform: translate(-1px,-1px);\n  box-shadow: 5px 5px 0 var(--black);\n}\n.hi-mashup-btn:active {\n  transform: translate(2px,2px);\n  box-shadow: 2px 2px 0 var(--black);\n}\n.hi-mashup-btn:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 3px;\n}\n.hi-mashup-btn-icon {\n  display: inline-block;\n  font-size: 18px;\n  line-height: 1;\n  transition: transform .35s;\n}\n.hi-mashup-btn:active .hi-mashup-btn-icon {\n  transform: rotate(180deg);\n}\n\n.hi-mashup-hint {\n  font-size: 11px;\n  color: var(--text-muted);\n  letter-spacing: .05em;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.hi-mashup-hint kbd {\n  display: inline-block;\n  padding: 2px 7px;\n  background: var(--surface);\n  border: 1.5px solid var(--border);\n  border-bottom-width: 3px;\n  border-radius: 3px;\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .05em;\n  color: var(--text-primary);\n}\n\n/* ─── PROMPT ─────────────────────────────────────────────────── */\n.hi-mashup-prompt-wrap {\n  background: var(--surface);\n  border: 1.5px solid var(--border);\n  border-left: 4px solid var(--orange);\n  border-radius: 2px;\n  padding: 20px 24px;\n  margin-bottom: 32px;\n}\n\n.hi-mashup-prompt-label {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n  color: var(--orange);\n  margin-bottom: 8px;\n}\n\n.hi-mashup-prompt-text {\n  font-family: \"Arial Narrow\", Impact, Arial, sans-serif;\n  font-size: clamp(15px, 2.5vw, 20px);\n  font-weight: 700;\n  line-height: 1.4;\n  color: var(--text-primary);\n  text-transform: uppercase;\n  letter-spacing: .01em;\n}\n.hi-mashup-prompt-text .hi-mashup-hl {\n  color: var(--orange);\n}\n\n/* ─── COUNTER ────────────────────────────────────────────────── */\n.hi-mashup-footer {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding-top: 24px;\n  border-top: 1px solid var(--border);\n}\n.hi-mashup-counter-label {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: .15em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n.hi-mashup-counter-value {\n  font-family: \"Arial Narrow\", Impact, Arial, sans-serif;\n  font-size: 28px;\n  font-weight: 900;\n  color: var(--text-primary);\n  letter-spacing: -.02em;\n  min-width: 44px;\n  display: inline-block;\n}\n.hi-mashup-counter-dots {\n  display: flex;\n  gap: 4px;\n  margin-left: 4px;\n}\n.hi-mashup-counter-dot {\n  width: 6px; height: 6px;\n  border-radius: 50%;\n  background: var(--border);\n  transition: background .3s;\n}\n.hi-mashup-counter-dot.active { background: var(--orange); }\n\n/* ─── MODE TOGGLE BAR ────────────────────────────────────────── */\n.hi-mashup-mode-bar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 28px;\n  flex-wrap: wrap;\n}\n\n.hi-mashup-btn-mode {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: none;\n  border: 1.5px solid var(--border);\n  border-radius: 2px;\n  padding: 10px 20px;\n  font-family: \"Arial Narrow\", Impact, Arial, sans-serif;\n  font-size: 13px;\n  font-weight: 900;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: border-color .15s, color .15s, background .15s, box-shadow .1s;\n  user-select: none;\n}\n.hi-mashup-btn-mode:hover {\n  border-color: var(--orange);\n  color: var(--text-primary);\n}\n.hi-mashup-btn-mode.active {\n  background: var(--black);\n  border-color: var(--black);\n  color: var(--orange);\n  box-shadow: 3px 3px 0 var(--orange);\n}\n.hi-mashup-root[data-theme=\"dark\"] .hi-mashup-btn-mode.active {\n  background: var(--orange);\n  border-color: var(--orange);\n  color: var(--black);\n  box-shadow: 3px 3px 0 var(--text-muted);\n}\n.hi-mashup-btn-mode-icon { font-size: 14px; }\n.hi-mashup-mode-sep {\n  width: 1px; height: 24px;\n  background: var(--border);\n  flex-shrink: 0;\n}\n.hi-mashup-mode-desc {\n  font-size: 11px;\n  color: var(--text-muted);\n  letter-spacing: .04em;\n  font-style: italic;\n}\n\n/* ─── ADVANCED: FUTURE SCENARIO CARD ────────────────────────── */\n/* Grid adapts to 4 columns in advanced mode */\n.hi-mashup-root[data-mode=\"advanced\"] .hi-mashup-cards {\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.hi-mashup-card-future {\n  display: none;\n  background: var(--black);\n  border: 1.5px solid var(--black);\n  border-radius: 2px;\n  padding: 28px 24px 24px;\n  position: relative;\n  box-shadow: 4px 4px 0 var(--orange);\n  min-height: 160px;\n  flex-direction: column;\n  overflow: visible;\n}\n.hi-mashup-root[data-mode=\"advanced\"] .hi-mashup-card-future {\n  display: flex;\n}\n.hi-mashup-root[data-theme=\"dark\"] .hi-mashup-card-future {\n  background: var(--surface);\n  border-color: var(--orange);\n  box-shadow: 4px 4px 0 var(--orange);\n}\n\n.hi-mashup-card-future .hi-mashup-card-accent {\n  background: var(--orange);\n}\n.hi-mashup-card-future .hi-mashup-card-index {\n  color: var(--orange);\n}\n.hi-mashup-card-future .hi-mashup-card-label {\n  color: var(--orange);\n  border-bottom-color: var(--orange);\n  opacity: 1;\n}\n.hi-mashup-card-future .hi-mashup-card-item {\n  color: var(--off-white);\n}\n.hi-mashup-root[data-theme=\"dark\"] .hi-mashup-card-future .hi-mashup-card-item {\n  color: var(--text-primary);\n}\n\n/* future card scenario sub-label */\n.hi-mashup-card-future-tag {\n  display: inline-block;\n  margin-top: 10px;\n  padding: 3px 8px;\n  background: var(--orange);\n  color: var(--black);\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  border-radius: 1px;\n}\n\n/* prompt adapts in advanced mode */\n.hi-mashup-root[data-mode=\"advanced\"] .hi-mashup-prompt-text {\n  /* slightly larger to accommodate the extra element */\n}\n\n/* ─── RESPONSIVE ─────────────────────────────────────────────── */\n@media (max-width: 768px) {\n  .hi-mashup-cards {\n    grid-template-columns: 1fr !important;\n    gap: 32px;\n  }\n  .hi-mashup-card::before,\n  .hi-mashup-card::after { display: none; }\n  .hi-mashup-header { flex-direction: column; gap: 20px; }\n  .hi-mashup-controls { align-items: flex-start; }\n  .hi-mashup-action { flex-direction: column; align-items: flex-start; }\n  .hi-mashup-btn { width: 100%; justify-content: center; }\n  .hi-mashup-btn-mode { width: 100%; justify-content: center; }\n}\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hi-mashup-cards {\n    grid-template-columns: 1fr 1fr !important;\n  }\n  .hi-mashup-cards .hi-mashup-card:last-child,\n  .hi-mashup-root[data-mode=\"advanced\"] .hi-mashup-cards .hi-mashup-card-future {\n    grid-column: span 2;\n  }\n}\n</style>\n\n<div class=\"hi-mashup-wrap\">\n\n  <!-- Header -->\n  <div class=\"hi-mashup-header\">\n    <div class=\"hi-mashup-header-left\">\n      <div class=\"hi-mashup-eyebrow\" data-i18n=\"eyebrow\">Ferramenta de ideação</div>\n      <h2 class=\"hi-mashup-title\">Mash-up<br><span>Generator</span>\n</h2>\n      <p class=\"hi-mashup-subtitle\" data-i18n=\"subtitle\">Combine necessidades humanas, fontes de dados e tecnologias para criar ideias improváveis, úteis e provocativas.</p>\n    