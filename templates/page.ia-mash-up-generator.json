"App bancário\",        es:\"App bancario\",             en:\"Banking app\",\n    dpt:\"Gastos, categorias de consumo e fluxo financeiro.\",\n    des:\"Gastos, categorías de consumo y flujo financiero.\",\n    den:\"Spending, consumption categories and cash flow.\" },\n  { pt:\"Apple Watch / Garmin\",es:\"Apple Watch / Garmin\",    en:\"Apple Watch / Garmin\",\n    dpt:\"Saúde contínua, movimento e padrões biométricos.\",\n    des:\"Salud continua, movimiento y patrones biométricos.\",\n    den:\"Continuous health, movement and biometric patterns.\" },\n  { pt:\"Smart TV\",            es:\"Smart TV\",                en:\"Smart TV\",\n    dpt:\"Conteúdo consumido, horários e preferências de tela.\",\n    des:\"Contenido consumido, horarios y preferencias de pantalla.\",\n    den:\"Content consumed, viewing times and screen preferences.\" },\n  { pt:\"Alexa / Google Assistant\", es:\"Alexa / Google Assistant\", en:\"Alexa / Google Assistant\",\n    dpt:\"Comandos de voz, rotinas e perguntas do dia a dia.\",\n    des:\"Comandos de voz, rutinas y preguntas del día a día.\",\n    den:\"Voice commands, daily routines and everyday questions.\" }\n];\n\nvar TECHNOLOGIES = [\n  { pt:\"Inteligência artificial\", es:\"Inteligencia artificial\", en:\"Artificial intelligence\",\n    dpt:\"Sistemas que aprendem e tomam decisões com base em dados.\",\n    des:\"Sistemas que aprenden y toman decisiones basados en datos.\",\n    den:\"Systems that learn and make decisions based on data.\" },\n  { pt:\"IA generativa\",       es:\"IA generativa\",            en:\"Generative AI\",\n    dpt:\"Cria textos, imagens, vídeos e áudios sob demanda.\",\n    des:\"Crea textos, imágenes, videos y audios bajo demanda.\",\n    den:\"Creates text, images, videos and audio on demand.\" },\n  { pt:\"Chatbots\",            es:\"Chatbots\",                 en:\"Chatbots\",\n    dpt:\"Interfaces conversacionais que automatizam atendimento.\",\n    des:\"Interfaces conversacionales que automatizan la atención.\",\n    den:\"Conversational interfaces that automate service interactions.\" },\n  { pt:\"Assistentes de voz\",  es:\"Asistentes de voz\",        en:\"Voice assistants\",\n    dpt:\"Interação natural por voz com dispositivos e serviços.\",\n    des:\"Interacción natural por voz con dispositivos y servicios.\",\n    den:\"Natural voice interaction with devices and services.\" },\n  { pt:\"Recomendação\",        es:\"Sistemas de recomendación\", en:\"Recommendation engines\",\n    dpt:\"Sugerem conteúdos e produtos baseados no perfil do usuário.\",\n    des:\"Sugieren contenidos y productos basados en el perfil del usuario.\",\n    den:\"Suggest content and products based on user profiles.\" },\n  { pt:\"Reconhecimento facial\", es:\"Reconocimiento facial\",  en:\"Facial recognition\",\n    dpt:\"Identifica pessoas a partir de características do rosto.\",\n    des:\"Identifica personas a partir de características del rostro.\",\n    den:\"Identifies people from facial characteristics.\" },\n  { pt:\"Reconhecimento de voz\", es:\"Reconocimiento de voz\",  en:\"Voice recognition\",\n    dpt:\"Converte fala em texto e identifica usuários pelo som.\",\n    des:\"Convierte habla en texto e identifica usuarios por el sonido.\",\n    den:\"Converts speech to text and identifies users by voice.\" },\n  { pt:\"Sensores inteligentes\", es:\"Sensores inteligentes\",  en:\"Smart sensors\",\n    dpt:\"Capturam dados físicos do ambiente em tempo real.\",\n    des:\"Capturan datos físicos del ambiente en tiempo real.\",\n    den:\"Capture physical environment data in real time.\" },\n  { pt:\"GPS\",                 es:\"GPS\",                      en:\"GPS\",\n    dpt:\"Localização precisa em tempo real para qualquer dispositivo.\",\n    des:\"Ubicación precisa en tiempo real para cualquier dispositivo.\",\n    den:\"Precise real-time location tracking for any device.\" },\n  { pt:\"Notificações push\",   es:\"Notificaciones push\",      en:\"Push notifications\",\n    dpt:\"Alertas personalizados entregues no momento certo.\",\n    des:\"Alertas personalizados entregados en el momento justo.\",\n    den:\"Personalized alerts delivered at exactly the right moment.\" },\n  { pt:\"Automação no-code\",   es:\"Automatización no-code\",   en:\"No-code automation\",\n    dpt:\"Fluxos automatizados sem necessidade de programação.\",\n    des:\"Flujos automatizados sin necesidad de programación.\",\n    den:\"Automated workflows without requiring any coding skills.\" },\n  { pt:\"APIs\",                es:\"APIs\",                     en:\"APIs\",\n    dpt:\"Conectam diferentes sistemas e serviços digitais.\",\n    des:\"Conectan diferentes sistemas y servicios digitales.\",\n    den:\"Connect different digital systems and services together.\" },\n  { pt:\"Cloud computing\",     es:\"Computación en la nube\",   en:\"Cloud computing\",\n    dpt:\"Processamento e armazenamento escalável sob demanda.\",\n    des:\"Procesamiento y almacenamiento escalable bajo demanda.\",\n    den:\"Scalable processing and storage available on demand.\" },\n  { pt:\"Wearables\",           es:\"Wearables\",                en:\"Wearables\",\n    dpt:\"Dispositivos vestíveis que monitoram o corpo.\",\n    des:\"Dispositivos que se usan puestos y monitorean el cuerpo.\",\n    den:\"Wearable devices that monitor the body continuously.\" },\n  { pt:\"IoT\",                 es:\"IoT\",                      en:\"IoT\",\n    dpt:\"Objetos cotidianos conectados à internet que coletam dados.\",\n    des:\"Objetos cotidianos conectados a internet que recopilan datos.\",\n    den:\"Everyday objects connected to the internet to collect data.\" },\n  { pt:\"Realidade aumentada\", es:\"Realidad aumentada\",       en:\"Augmented reality\",\n    dpt:\"Sobrepõe informações digitais ao mundo físico.\",\n    des:\"Superpone información digital sobre el mundo físico.\",\n    den:\"Overlays digital information onto the physical world.\" },\n  { pt:\"Realidade virtual\",   es:\"Realidad virtual\",         en:\"Virtual reality\",\n    dpt:\"Cria experiências imersivas em ambientes simulados.\",\n    des:\"Crea experiencias inmersivas en entornos simulados.\",\n    den:\"Creates immersive experiences in simulated environments.\" },\n  { pt:\"Pagamentos digitais\", es:\"Pagos digitales\",          en:\"Digital payments\",\n    dpt:\"Transações financeiras instantâneas e sem atrito.\",\n    des:\"Transacciones financieras instantáneas y sin fricción.\",\n    den:\"Instant and frictionless financial transactions.\" },\n  { pt:\"Blockchain\",          es:\"Blockchain\",               en:\"Blockchain\",\n    dpt:\"Registros descentralizados e auditáveis de transações.\",\n    des:\"Registros descentralizados y auditables de transacciones.\",\n    den:\"Decentralized and auditable records of transactions.\" },\n  { pt:\"Biometria\",           es:\"Biometría\",                en:\"Biometrics\",\n    dpt:\"Autenticação por características únicas do corpo.\",\n    des:\"Autenticación por características únicas del cuerpo.\",\n    den:\"Authentication using unique physical body characteristics.\" },\n  { pt:\"Machine learning\",    es:\"Machine learning\",         en:\"Machine learning\",\n    dpt:\"Modelos que aprendem padrões a partir de grandes volumes de dados.\",\n    des:\"Modelos que aprenden patrones de grandes volúmenes de datos.\",\n    den:\"Models that learn patterns from large volumes of data.\" },\n  { pt:\"Edge computing\",      es:\"Edge computing\",           en:\"Edge computing\",\n    dpt:\"Processa dados próximos à fonte, com baixa latência.\",\n    des:\"Procesa datos cerca de la fuente, con baja latencia.\",\n    den:\"Processes data close to the source with low latency.\" },\n  { pt:\"Low-code\",            es:\"Plataformas low-code\",     en:\"Low-code platforms\",\n    dpt:\"Ferramentas que aceleram o desenvolvimento de software.\",\n    des:\"Herramientas que aceleran el desarrollo de software.\",\n    den:\"Tools that accelerate software development cycles.\" },\n  { pt:\"Agentes de IA\",       es:\"Agentes autónomos de IA\",  en:\"AI agents\",\n    dpt:\"Sistemas autônomos que executam tarefas complexas por conta própria.\",\n    des:\"Sistemas autónomos que ejecutan tareas complejas por su cuenta.\",\n    den:\"Autonomous systems that execute complex tasks independently.\" },\n  { pt:\"Visão computacional\", es:\"Visión computacional\",     en:\"Computer vision\",\n    dpt:\"Analisa imagens e vídeos para extrair informações.\",\n    des:\"Analiza imágenes y videos para extraer información.\",\n    den:\"Analyzes images and video to extract actionable information.\" }\n];\n\n/* ─── FUTURE SCENARIOS ───────────────────────────────────────── */\nvar FUTURES = [\n  { pt:\"Crise climática\",         es:\"Crisis climática\",          en:\"Climate crisis\" },\n  { pt:\"Hiperpersonalização\",     es:\"Hiperpersonalización\",      en:\"Hyperpersonalization\" },\n  { pt:\"Cidades inteligentes\",    es:\"Ciudades inteligentes\",     en:\"Smart cities\" },\n  { pt:\"Carros autônomos\",        es:\"Vehículos autónomos\",       en:\"Autonomous vehicles\" },\n  { pt:\"Longevidade extrema\",     es:\"Longevidad extrema\",        en:\"Extreme longevity\" },\n  { pt:\"Colapso da privacidade\",  es:\"Colapso de la privacidad\",  en:\"Privacy collapse\" },\n  { pt:\"Automação do trabalho\",   es:\"Automatización del trabajo\",en:\"Work automation\" },\n  { pt:\"Escassez de água\",        es:\"Escasez de agua\",           en:\"Water scarcity\" },\n  { pt:\"Metaverso corporativo\",   es:\"Metaverso corporativo\",     en:\"Corporate metaverse\" },\n  { pt:\"Pandemia endêmica\",       es:\"Pandemia endémica\",         en:\"Endemic pandemic\" },\n  { pt:\"Democracia algorítmica\",  es:\"Democracia algorítmica\",    en:\"Algorithmic democracy\" },\n  { pt:\"Escassez de atenção\",     es:\"Escasez de atención\",       en:\"Attention scarcity\" },\n  { pt:\"Colapso da classe média\", es:\"Colapso de la clase media\", en:\"Middle class collapse\" },\n  { pt:\"Biohacking em massa\",     es:\"Biohacking masivo\",         en:\"Mass biohacking\" },\n  { pt:\"Migração climática\",      es:\"Migración climática\",       en:\"Climate migration\" },\n  { pt:\"Realidade sintética\",     es:\"Realidad sintética\",        en:\"Synthetic reality\" },\n  { pt:\"Trabalho 100% remoto\",    es:\"Trabajo 100% remoto\",       en:\"Fully remote work\" },\n  { pt:\"Hiperenvelhecimento\",     es:\"Hiperenvejecimiento\",       en:\"Hyperaging society\" },\n  { pt:\"Colapso da confiança\",    es:\"Colapso de la confianza\",   en:\"Trust collapse\" },\n  { pt:\"Abundância energética\",   es:\"Abundancia energética\",     en:\"Energy abundance\" }\n];\n\n/* ─── STATE ──────────────────────────────────────────────────── */\nvar root   = document.getElementById('hi-mashup-app');\nvar lang   = 'pt';\nvar mode   = 'classic'; // 'classic' | 'advanced'\nvar count  = 0;\nvar lastCombo = '';\nvar current = { need: null, data: null, tech: null, future: null };\n\n/* ─── DOM refs ───────────────────────────────────────────────── */\nvar cards      = [0,1,2].map(function(i){ return document.getElementById('hi-card-'+i); });\nvar items      = [0,1,2].map(function(i){ return document.getElementById('hi-item-'+i); });\nvar cardFuture = document.getElementById('hi-card-future');\nvar itemFuture = document.getElementById('hi-item-future');\nvar prompt     = document.getElementById('hi-prompt');\nvar counter    = document.getElementById('hi-count');\nvar dots       = document.querySelectorAll('#hi-mashup-app .hi-mashup-counter-dot');\nvar btn        = document.getElementById('hi-mashup-btn');\nvar themeChk   = document.getElementById('hi-mashup-theme-chk');\nvar btnClassic  = document.getElementById('hi-btn-classic');\nvar btnAdvanced = document.getElementById('hi-btn-advanced');\n\n/* ─── HELPERS ────────────────────────────────────────────────── */\nfunction pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }\nfunction pad(n){ return n<10?'0'+n:''+n; }\nfunction itemName(obj){ return obj['pt']===undefined ? obj : (lang==='pt'?obj.pt:lang==='es'?obj.es:obj.en); }\n\nfunction setMode(m){\n  mode = m;\n  root.setAttribute('data-mode', m);\n  btnClassic.classList.toggle('active',  m==='classic');\n  btnAdvanced.classList.toggle('active', m==='advanced');\n  btnClassic.setAttribute('aria-pressed',  m==='classic'  ? 'true':'false');\n  btnAdvanced.setAttribute('aria-pressed', m==='advanced' ? 'true':'false');\n  if(current.need){ updateCards(false); renderPrompt(); }\n}\n\nfunction setLang(l){\n  lang = l;\n  root.setAttribute('data-lang', l);\n  root.querySelectorAll('[data-lang-btn]').forEach(function(b){\n    var active = b.getAttribute('data-lang-btn')===l;\n    b.classList.toggle('active', active);\n    b.setAttribute('aria-pressed', active?'true':'false');\n  });\n  root.querySelectorAll('[data-i18n]').forEach(function(el){\n    var key = el.getAttribute('data-i18n');\n    if(I18N[l][key]) el.textContent = I18N[l][key];\n  });\n  if(current.need){ updateCards(false); renderPrompt(); }\n}\n\nfunction updateCards(animate){\n  var allCards = cards.concat(mode==='advanced' ? [cardFuture] : []);\n  if(animate){\n    allCards.forEach(function(c){ c.classList.remove('is-shuffling'); });\n    void cards[0].offsetWidth;\n    allCards.forEach(function(c){ c.classList.add('is-shuffling'); });\n    setTimeout(function(){ allCards.forEach(function(c){ c.classList.remove('is-shuffling'); }); }, 520);\n  }\n  items[0].textContent = itemName(current.need);\n  items[1].textContent = itemName(current.data);\n  items[2].textContent = itemName(current.tech);\n  if(mode==='advanced' && current.future){\n    itemFuture.textContent = itemName(current.future);\n  }\n}\n\nfunction renderPrompt(){\n  var t = I18N[lang];\n  var n = itemName(current.need);\n  var d = itemName(current.data);\n  var x = itemName(current.tech);\n  var base =\n    t.promptIntro + ' <span class=\"hi-mashup-hl\">' + x + '</span> ' +\n    t.promptMid   + ' <span class=\"hi-mashup-hl\">' + d + '</span> ' +\n    t.promptEnd   + ' <span class=\"hi-mashup-hl\">' + n + '</span>';\n  if(mode==='advanced' && current.future){\n    base += ' ' + t.promptFutureIn + ' <span class=\"hi-mashup-hl\">' + itemName(current.future) + '</span>';\n  }\n  prompt.innerHTML = base + '?';\n}\n\nfunction updateDots(){\n  var n = count % 5;\n  dots.forEach(function(d,i){ d.classList.toggle('active', i<n || (n===0 && count>0 && i===4)); });\n  if(n===0 && count>0){ dots.forEach(function(d){ d.classList.add('active'); }); }\n}\n\nfunction generate(){\n  var n, d, x, f, combo;\n  var tries = 0;\n  do {\n    n = pick(NEEDS); d = pick(DATASOURCES); x = pick(TECHNOLOGIES);\n    f = mode==='advanced' ? pick(FUTURES) : null;\n    combo = n.pt + d.pt + x.pt + (f ? f.pt : '');\n    tries++;\n  } while(combo===lastCombo && tries<10);\n  lastCombo = combo;\n  current = { need:n, data:d, tech:x, future:f };\n  count++;\n  counter.textContent = pad(count);\n  updateCards(true);\n  renderPrompt();\n  updateDots();\n}\n\n/* ─── EVENTS ─────────────────────────────────────────────────── */\nbtn.addEventListener('click', generate);\n\nbtnClassic.addEventListener('click',  function(){ setMode('classic'); });\nbtnAdvanced.addEventListener('click', function(){ setMode('advanced'); generate(); });\n\nroot.querySelectorAll('[data-lang-btn]').forEach(function(b){\n  b.addEventListener('click', function(){ setLang(b.getAttribute('data-lang-btn')); });\n});\n\nthemeChk.addEventListener('change', function(){\n  root.setAttribute('data-theme', themeChk.checked ? 'dark' : 'light');\n});\n\ndocument.addEventListener('keydown', function(e){\n  if(e.code==='Space'){\n    var tag = (document.activeElement||{}).tagName||'';\n    if(!['INPUT','TEXTAREA','SELECT'].includes(tag)){\n      e.preventDefault();\n      generate();\n    }\n  }\n});\n\n/* ─── INIT ───────────────────────────────────────────────────── */\nroot.setAttribute('data-mode', 'classic');\nsetLang('pt');\ngenerate();\n\n})();\n</script>",
