        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Seu Título<\/title>\n  <style>\n  #mashup-container {\n      background-color: #fff;\n      border-radius: 10px;\n      padding: 20px;\n      margin: 20px auto;\n      max-width: 800px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n      text-align: center;\n    }\n\n    h1 {\n      text-align: center;\n      color: #333;\n      margin-top: 20px;\n    }\n\n    p {\n      text-align: center;\n      color: #555;\n      margin-top: 10px;\n    }\n\n    .card-container {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      align-items: center;\n      margin-top: 30px;\n    }\n\n    .card {\n      flex: 1;\n      height: 200px;\n      background-color: #ff7300;\n      border-radius: 10px;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      margin: 10px;\n      padding: 10px;\n      color: #fff;\n      font-weight: bold;\n      font-size: 24px;\n      text-align: center;\n      transition: transform 0.3s ease;\n      cursor: pointer;\n\n    }\n\n    .card:hover {\n      transform: scale(1.05);\n    }\n\n    .card-title {\n      font-size: 36px;\n      margin-bottom: 10px;\n      color: #333;\n    }\n\n    .connector {\n      font-size: 36px;\n      color: #333;\n      margin: 10px 0;\n    }\n\n    #refreshButton {\n      background-color: #333;\n      color: #fff;\n      border: none;\n      border-radius: 5px;\n      padding: 10px 20px;\n      font-size: 16px;\n      cursor: pointer;\n      margin-top: 20px;\n    }\n  <\/style>\n\n\n  <div id=\"mashup-container\">\n    <h1>IA Mash-Up Generator<\/h1>\n<p>\n<\/p>\n    <p>Bem-vindo ao IA Mash-Up Generator da Hyper Island Brasil. <\/p>     \n<p> Use esta ferramenta para estimular o seu processo de pensamento criativo. Basta clicar em REFRESH e depois combinar os 3 elementos como base para gerar ideias para novos produtos, serviços e experiências.<\/p>\n\n    <div class=\"card-container\">\n      <div class=\"card\">\n        <h2 class=\"card-title\">Necessidades<\/h2>\n        <div id=\"humanNeedsCard\"><\/div>\n      <\/div>\n      <div class=\"connector\">+<\/div>\n      <div class=\"card\">\n        <h2 class=\"card-title\">Fonte de Dados<\/h2>\n        <div id=\"dataPointsCard\"><\/div>\n      <\/div>\n      <div class=\"connector\">+<\/div>\n      <div class=\"card\">\n        <h2 class=\"card-title\">Tecnologia<\/h2>\n        <div id=\"technologiesCard\"><\/div>\n      <\/div>\n<\/div>\n\n\n    <button id=\"refreshButton\">Refresh<\/button>\n  <\/div>\n\n  <script>\n    \/\/ Arrays de exemplos para cada card\n    const humanNeeds = [\n      \"Comida\",\n\"Água\",\n\"Abrigo\",\n\"Dormir\",\n\"Roupas\",\n\"Segurança\",\n\"Sefurança Financeira\",\n\"Saúde e Bem-estar\",\n\"Amizade\",\n\"Intimidade\",\n\"Família\",\n\"Conexão e Comunidade\",\n\"Respeito\",\n\"Conquista\",\n\"Reconhecimento\",\n\"Status\",\n\"Crescimento Pessoal\",\n\"Auto-aperfeiçoamento\",\n\"Criatividade\",\n\"Busca de Significado\",\n    ];\n\n    const dataPoints = [\n      \"Facebook\",\n\"Twitter\",\n\"Instagram\",\n\"LinkedIn\",\n\"Snapchat\",\n\"TikTok\",\n\"Pinterest\",\n\"WhatsApp\",\n\"Messenger\",\n\"Telegram\",\n\"WeChat\",\n\"Signal\",\n\"Fitbit\",\n\"MyFitnessPal\",\n\"Nike Run Club\",\n\"Calm\",\n\"Headspace\",\n\"Sleep Cycle\",\n\"Mint\",\n\"PayPal\",\n\"Acorns\",\n\"Coinbase\",\n\"Amazon\",\n\"eBay\",\n\"Etsy\",\n\"Shopify\",\n\"Wish\",\n\"Uber\",\n\"Lyft\",\n\"Airbnb\",\n\"Google Maps\",\n\"TripAdvisor\",\n\"Google Workspace\",\n\"Trello\",\n\"Evernote\",\n\"Netflix\",\n\"Spotify\",\n\"YouTube\",\n\"Twitch\",\n\"Audible\",\n\"Apple Music\",\n\"Tinder\",\n\"Bumble\",\n\"Hinge\",\n\"OkCupid\",\n\"Match.com\",\n\"Steam\",\n\"PlayStation Network\",\n\"Xbox Live\",\n\"Twitch\",\n\n    ];\n\n    const technologies = [\n      \"AI\",\n    ];\n\n    \/\/ Função para embaralhar os arrays\n    function shuffleArray(array) {\n      for (let i = array.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [array[i], array[j]] = [array[j], array[i]];\n      }\n      return array;\n    }\n\n    \/\/ Função para gerar as sugestões nos cards\n    function generateSuggestions() {\n      const humanNeedsCard = document.getElementById(\"humanNeedsCard\");\n      const dataPointsCard = document.getElementById(\"dataPointsCard\");\n      const technologiesCard = document.getElementById(\"technologiesCard\");\n\n      const shuffledHumanNeeds = shuffleArray(humanNeeds);\n      const shuffledDataPoints = shuffleArray(dataPoints);\n      const shuffledTechnologies = shuffleArray(technologies);\n\n      humanNeedsCard.textContent = shuffledHumanNeeds[0];\n      dataPointsCard.textContent = shuffledDataPoints[0];\n      technologiesCard.textContent = shuffledTechnologies[0];\n    }\n\n    \/\/ Evento de clique no botão Refresh\n    const refreshButton = document.getElementById(\"refreshButton\");\n    refreshButton.addEventListener(\"click\", generateSuggestions);\n\n    \/\/ Gerar as sugestões inicialmente\n    generateSuggestions();\n  <\/script>",
