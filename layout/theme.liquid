{% capture ymq_lock_login_require_template %}{% include 'ymq_lock' %}{% endcapture %}{% unless ymq_lock_login_require_template contains 'Liquid error' %}{{ ymq_lock_login_require_template }}{% endunless %}<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    
    {{ settings.header_scripts }}
	

    {% if request.design_mode != true %}
        <!-- AOS 3.0.0-beta.6 plugin CSS (Animations) -->
        <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    {% endif %}

    {%- unless settings.favicon == blank -%}
        <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: '32', height: '32' }}">
    {%- endunless -%}

    <title>
        {{ page_title }}
        {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
        <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <link href="{{ 'styles.min.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'vendor-bootstrap.min.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'variables.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'base.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'general.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'sections.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'collection.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'product.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'cart.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'custom.css' | asset_url }}" rel="stylesheet">
 

    <script>
        Shopify.money_format = "{{ shop.money_format }}"
        window.theme = {
            product: {
                addToCart: '{{ 'product.add_to_cart' | t }}',
                addedToCart: '{{ 'product.added_to_cart' | t }}',
                soldOut: '{{ 'product.sold_out' | t }}',
                unavailable: '{{ 'product.unavailable' | t }}',
                priceRegular: '{{ 'product.price_regular' | t }}',
                priceFrom: '{{ 'product.price_from' | t }}',
                priceSale: '{{ 'product.price_sale' | t }}',
                save: '{{ 'product.save' | t }}',
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="{{ 'moment.js' | asset_url }}" defer></script>
    <script src="{{ 'moment-timezone.js' | asset_url }}" defer></script>
    <script src="{{ 'base.js' | asset_url }}" defer></script>
    <script src="{{ 'general.js' | asset_url }}" defer></script>
    <script src="{{ 'search.js' | asset_url }}" defer></script>
    <script src="{{ 'sections.js' | asset_url }}" defer></script>
    <script src="{{ 'collection.js' | asset_url }}" defer></script>
    <script src="{{ 'product.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'custom.js' | asset_url }}" defer></script>
    <script src="{{ 'scripts.min.js' | asset_url }}" defer></script>

    {% if request.design_mode == true %}
        <script>
            AOS.init({disable: true})
        </script>
    {% endif %}

 {% capture adoricsnippet %}{% include "adoric-apps-common" %}{% endcapture %}{% unless adoricsnippet contains "Liquid error" %}{{ adoricsnippet }}{% endunless %}
<script>
    if(document.location.href.indexOf('toolbox.hyperisland.com.br') > -1) { 
        document.location.href = 'https://www.hyperisland.com.br/pages/toolbox';
    }
</script> 
<link rel="preload" href="{{ 'design-pack-styles.css' | asset_url }}" as="style">
{{ 'design-pack-styles.css' | asset_url | stylesheet_tag }} 
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "qk1knlupwd");
</script>
</head>

<body class="{{ request.page_type | prepend: 'page-type-' }}">
    <a class="visually-hidden-focusable" href="#main">
        {{ 'general.accessibility.skip_content' | t }}
    </a>
    
    {% liquid 
        section 'navbar' 
    %}

    <main id="main">
        {{ content_for_layout }}{% include 'ymq_lock_css_js' %}

    </main>

    {% liquid
        section 'footer'
    %}

    {% liquid
        render 'offcanvas-cart'
        render 'offcanvas-search'
    %}
    {{ settings.body_scripts }}
    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const isToolboxPage = window.location.pathname.includes("/pages/toolbox");

    if (isToolboxPage) {
      // Espera até que o Tawk_API esteja carregado
      const interval = setInterval(function () {
        if (typeof Tawk_API !== "undefined" && Tawk_API.hide) {
          Tawk_API.hide();
          clearInterval(interval);
        }
      }, 300);
    }
  });
</script>
  <style>
  /* Aguarda o botão do Typebot carregar e move ele */
  .typebot-bubble-button {
    bottom: 100px !important; /* Ajuste aqui a altura que você quiser */
    z-index: 9999 !important;
  }
</style>
  <style>
  body[data-tawk-hide="true"] #tawkchat-container,
  body[data-tawk-hide="true"] iframe[src*="tawk.to"] {
    display: none !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    if (currentPath.includes("/pages/toolbox")) {
      document.body.setAttribute("data-tawk-hide", "true");
    }
  });
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const repositionTypebot = setInterval(() => {
      const bubble = document.querySelector(".typebot-bubble-button");
      if (bubble) {
        bubble.style.bottom = "100px"; // Altere para a altura que desejar
        bubble.style.right = "20px";
        bubble.style.zIndex = "9999";
        clearInterval(repositionTypebot);
      }
    }, 300);
  });
</script>

</body>
</html>
    