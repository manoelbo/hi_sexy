{% doc %}
  @prompt
    I want you to build a mesh between card section + content section, where I can put a text on one side and the card on the other
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mesh-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-mesh-layout__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  {% if block.settings.layout == 'card_right' %}
    .ai-mesh-layout__content-{{ ai_gen_id }} {
      order: 1;
    }
    .ai-mesh-layout__card-{{ ai_gen_id }} {
      order: 2;
    }
  {% else %}
    .ai-mesh-layout__content-{{ ai_gen_id }} {
      order: 2;
    }
    .ai-mesh-layout__card-{{ ai_gen_id }} {
      order: 1;
    }
  {% endif %}

  .ai-mesh-layout__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_bg_color }};
    border-radius: {{ block.settings.content_border_radius }}px;
  }

  .ai-mesh-layout__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-mesh-layout__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
  }

  .ai-mesh-layout__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-mesh-layout__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-mesh-layout__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
  }

  .ai-mesh-layout__card-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.card_image_spacing }}px;
    border-radius: {{ block.settings.card_image_border_radius }}px;
    overflow: hidden;
  }

  .ai-mesh-layout__card-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-mesh-layout__card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-mesh-layout__card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-mesh-layout__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_spacing }}px 0;
    font-weight: 600;
  }

  .ai-mesh-layout__card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-mesh-layout__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    {% if block.settings.mobile_layout == 'card_top' %}
      .ai-mesh-layout__content-{{ ai_gen_id }} {
        order: 2;
      }
      .ai-mesh-layout__card-{{ ai_gen_id }} {
        order: 1;
      }
    {% else %}
      .ai-mesh-layout__content-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-mesh-layout__card-{{ ai_gen_id }} {
        order: 2;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-mesh-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-mesh-layout__container-{{ ai_gen_id }}">
    <div class="ai-mesh-layout__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-mesh-layout__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-mesh-layout__text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-mesh-layout__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-mesh-layout__card-{{ ai_gen_id }}">
      {% if block.settings.card_image != blank %}
        <div class="ai-mesh-layout__card-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.card_image | image_url: width: 800 }}"
            alt="{{ block.settings.card_image.alt | escape }}"
            class="ai-mesh-layout__card-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.card_image.width }}"
            height="{{ block.settings.card_image.height }}"
          >
        </div>
      {% else %}
        <div class="ai-mesh-layout__card-image-wrapper-{{ ai_gen_id }}">
          <div class="ai-mesh-layout__card-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.card_title != blank %}
        <h3 class="ai-mesh-layout__card-title-{{ ai_gen_id }}">
          {{ block.settings.card_title }}
        </h3>
      {% endif %}

      {% if block.settings.card_description != blank %}
        <div class="ai-mesh-layout__card-description-{{ ai_gen_id }}">
          {{ block.settings.card_description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

